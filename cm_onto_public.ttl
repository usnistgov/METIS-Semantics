                                          pmdco:abbreviation "CFN" ;
                                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Center_for_Measurement_Standards
chips:Center_for_Measurement_Standards rdf:type owl:Class ;
                                       rdfs:subClassOf chips:Standards_Organization ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty prov:actedOnBehalfOf ;
                                                         owl:someValuesFrom chips:Taiwan_National_Measurement_Laboratory
                                                       ] ;
                                       rdfs:label "Center for Measurement Standards"@en ;
                                       skos:definition "The Center for Measurement Standards is a national metrology institute that develops and maintains national measurement standards and provides calibration services and traceability for industrial and scientific measurements."@en ;
                                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Centeredness
chips:Centeredness rdf:type owl:Class ;
                   rdfs:subClassOf chips:Spatial_Concept ,
                                   [ owl:intersectionOf ( chips:Uncertainty
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty chips:measuredBy ;
                                                            owl:someValuesFrom chips:Grand_Challenge_3
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
                   rdfs:label "Centeredness"@en ;
                   skos:definition "Centeredness is a spatial attribute describing how closely the geometric center of a feature or pattern coincides with its nominal intended position on a wafer or substrate."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


