                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Magnetic_Tunnel_Junction
chips:Magnetic_Tunnel_Junction rdf:type owl:Class ;
                               rdfs:subClassOf chips:Engineered_Nanostructure ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty prov:wasUsedBy ;
                                                 owl:someValuesFrom chips:Grand_Challenge_3
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty prov:wasUsedBy ;
                                                 owl:someValuesFrom chips:Nonvolatile_Memory
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty pmdco:composed_of ;
                                                 owl:someValuesFrom chips:Magnetic_Material
                                               ] ;
                               rdfs:label "Magnetic Tunnel Junction"@en ;
                               skos:definition "A magnetic tunnel junction is an engineered nanostructure consisting of two ferromagnetic layers separated by a thin insulating tunnel barrier, in which the tunneling resistance depends on the relative orientation of the magnetizations."@en ;
                               pmdco:abbreviation "MTJ" ;
                               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Magnetic_Tunnel_Junction_Sensor
