###  https://w3id.org/pmd/co/Primrdaten
pmdco:Primrdaten rdf:type owl:Class ;
                 rdfs:subClassOf chips:Data ;
                 owl:disjointWith pmdco:Sekundrdaten ;
                 rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                 rdfs:label "Primary Data"@en ,
                            "Primärdaten"@de ;
                 skos:definition "Die Datenkategorie Primärdaten umfasst Daten, die vor / nach einem Prozess erfasst werden, entweder bezogen auf die Geometrie des Objekts (z.B. ao, bo, do, au, bu, du, Lu) oder als Register des gesamten Aufbaus (z.B. Skizzen, Fotos oder Videos)"@de ,
                                 "This data scope expresses that a ValueObject refers to data that is directly acquired during a process by sensors (time, force, length, temperature)"@en .


###  https://w3id.org/pmd/co/Principle_Investigator
pmdco:Principle_Investigator rdf:type owl:Class ;
                             rdfs:subClassOf [ owl:intersectionOf ( prov:Person
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty obo:has_role ;
                                                                      owl:someValuesFrom pmdco:InitiatorRole
                                                                    ]
                                                                  ) ;
                                               rdf:type owl:Class
                                             ] ;
                             rdfs:label "Principle Investigator"@en ;
                             skos:definition "The scientist in charge of an experiment or research project."@en ;
                             pmdco:definitionSource "\"principle investigator\" https://www.wordnik.com/words/principal%20investigator, accessed 2024-04-29."@en .


###  https://w3id.org/pmd/co/Probe
pmdco:Probe rdf:type owl:Class ;
            rdfs:subClassOf pmdco:Prfling ,
                            [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                     owl:onProperty prov:wasAssociateFor ;
                                                     owl:someValuesFrom chips:Grand_Challenge_1
                                                   ]
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty pmdco:output_of ;
                                                     owl:someValuesFrom [ rdf:type owl:Class ;
                                                                          owl:unionOf ( chips:Intel
                                                                                        chips:Kansas_City_National_Security_Campus
                                                                                        chips:Laboratory_for_Physical_Sciences
                                                                                        chips:Sandia_National_Laboratory
                                                                                      )
                                                                        ]
                                                   ]
                                                 ) ;
                              rdf:type owl:Class
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty pmdco:output_of ;
                              owl:someValuesFrom chips:National_Institute_of_Standards_and_Technology
                            ] ;
            rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
            rdfs:label "Probe"@de ,
                       "Sample"@en ;
            skos:definition "Portion of material, usually selected from a larger quantity of material, collected and taken away for testing"@en ;
            pmdco:definitionSource "ISO 18589-1:2019-11 (international standardization committee: ISO/TC 85/SC 2/WG 17)"@en .


###  https://w3id.org/pmd/co/Projekt
