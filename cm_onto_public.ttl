###  https://w3id.org/CHIPS/metrology-ontology/Surface
chips:Surface rdf:type owl:Class ;
              rdfs:subClassOf chips:Interface ;
              rdfs:label "Surface"@en ;
              skos:definition "A surface is the outermost atomic layer of a material at which the periodic bulk structure terminates and where chemical reactions, adsorption, and optical and electrical interface effects occur."@en ;
              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Surface_Capture_and_Preconcentration
chips:Surface_Capture_and_Preconcentration rdf:type owl:Class ;
                                           rdfs:subClassOf chips:Concentration_Process ;
                                           rdfs:label "Surface Capture and Preconcentration"@en ;
                                           skos:definition "Surface Capture and Preconcentration is a sample preparation process that selectively immobilizes target analytes from a dilute solution onto a functionalized surface or substrate to increase local concentration prior to detection."@en ;
                                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Surface_Characterization_Process
