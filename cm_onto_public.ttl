                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Simulated_Data
chips:Simulated_Data rdf:type owl:Class ;
                     rdfs:subClassOf chips:Computational_Data ;
                     rdfs:label "Simulated Data"@en ;
                     skos:definition "Simulated data is computational data generated by a model or simulation that represents the predicted behavior of a physical system, process, or material under specified conditions, used for comparison with experimental results or for predictions."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


