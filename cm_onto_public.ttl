                                         owl:onProperty chips:hasMathematicalRelationshipWith ;
                                         owl:someValuesFrom pmdco:Wrmekapazitt
                                       ] ;
                       rdfs:label "Heat Capacitance"@en ;
                       skos:definition "Heat capacitance is a thermal property defined as the quantity of heat required to raise the temperature of a body by one degree, equal to the product of mass and specific heat capacity."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Heat_Transfer
