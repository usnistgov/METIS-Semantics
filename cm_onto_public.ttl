                                             owl:someValuesFrom pmdco:Metadaten
                                           ] ;
                           rdfs:label "Crystalline Property"@en ;
                           skos:definition "A crystalline property is a physical property that arises from and is determined by the periodic atomic arrangement of a crystalline material, including lattice parameters, crystal symmetry, and orientation."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


