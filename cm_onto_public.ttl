                   rdfs:subClassOf mo:Strahl ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty pmdco:composed_of ;
                                     owl:someValuesFrom chips:Neutron
                                   ] ;
                   rdfs:label "Neutron Beam"@en ;
                   skos:definition "Neutron Beam is a collimated flux of free neutrons produced by a reactor or spallation source, directed onto a specimen for scattering, diffraction, or activation analysis experiments."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


