                                        ] ;
                        rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                        rdfs:label "Analyseprozess"@de ,
                                   "Analysing Process"@en ;
                        skos:definition "An analysing process is a process whose primary intent is to extract qualitative or quantitative information about a system, material, or dataset through measurement, observation, computation, or logical inference."@en .


