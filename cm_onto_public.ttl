                                rdfs:label "Public-Private Partnership"@en ;
                                skos:definition "Public-Private Partnership is an organizational model in which a government entity and one or more private-sector organizations collaborate on a defined program by sharing resources, risks, and responsibilities."@en ;
                                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Pulse_Generator
chips:Pulse_Generator rdf:type owl:Class ;
                      rdfs:subClassOf chips:Signal_Generator ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty prov:wasAssociateFor ;
                                        owl:someValuesFrom chips:Grand_Challenge_6
                                      ] ;
                      rdfs:label "Pulse Generator"@en ;
                      skos:definition "Pulse Generator is a signal generator instrument that produces electrical pulses of defined amplitude, width, rise time, and repetition rate for use in testing digital circuits and time-domain measurement setups."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Pulse_Length
chips:Pulse_Length rdf:type owl:Class ;
                   rdfs:subClassOf pmdco:Lnge ,
