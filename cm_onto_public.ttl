                                    rdfs:label "Orbital-polarized Neutron Beam"@en ;
                                    skos:altLabel "Vortex Neutron Beam"@en ;
                                    skos:definition "Orbital-Polarized Neutron Beam is a neutron beam in which the orbital angular momentum of the neutrons is prepared in a defined state for use in studies of orbital contributions to magnetic scattering."@en ;
                                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Orbitrap_Mass_Spectrometer
chips:Orbitrap_Mass_Spectrometer rdf:type owl:Class ;
