                                           pmdco:abbreviation "PTB"@de ;
                                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Picosecond
chips:Picosecond rdf:type owl:Class ;
                 rdfs:subClassOf chips:Time_Scale ;
                 rdfs:label "Picosecond"@en ;
                 skos:definition "A picosecond is a unit of time equal to 10⁻¹² seconds, relevant to ultrafast optical measurements, carrier thermalization in semiconductors, and picosecond laser processing."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Piezoelectric
chips:Piezoelectric rdf:type owl:Class ;
                    rdfs:subClassOf chips:Material ;
                    rdfs:label "Piezoelectric"@en ;
                    skos:definition "A piezoelectric is a material that generates an electric charge in response to applied mechanical stress and conversely deforms when subjected to an electric field, used in sensors, actuators, and resonators."@en ;
                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Piezoelectric_Coefficient
