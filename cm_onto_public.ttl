                       rdfs:label "Cyclical Process"@en ;
                       skos:definition "Cyclical Process is a time-dependent process in which a system is repeatedly driven through a defined sequence of states, used to study fatigue, hysteresis, or cyclic stability."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Cylindrical_Resonator
chips:Cylindrical_Resonator rdf:type owl:Class ;
