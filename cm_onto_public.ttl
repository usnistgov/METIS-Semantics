###  https://w3id.org/CHIPS/metrology-ontology/Sparse_Image
chips:Sparse_Image rdf:type owl:Class ;
                   rdfs:subClassOf pmdco:Bild ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty pmdco:output_of ;
                                     owl:someValuesFrom chips:Sparse_Image_Sampling
                                   ] ;
                   rdfs:label "Sparse Image"@en ;
                   skos:definition "A sparse image is an image reconstructed from a sub-Nyquist sampling of the specimen, using compressed sensing or other algorithms to recover the full image with fewer measurements."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Sparse_Image_Sampling
chips:Sparse_Image_Sampling rdf:type owl:Class ;
                            rdfs:subClassOf chips:Image_Processing ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty pmdco:belongsToProject ;
                                              owl:someValuesFrom chips:Grand_Challenge_5
                                            ] ;
                            rdfs:label "Sparse Image Sampling"@en ;
                            skos:definition "Sparse Image Sampling is an image processing technique that reconstructs a full image from a reduced number of measurements by exploiting the sparsity of the image in a transform domain, enabling low-dose or accelerated acquisition."@en ;
                            pmdco:definitionSource "claude-sonnet-4-6"@en .


