                     rdfs:subClassOf chips:Reliability ,
                                     chips:Stability ;
                     rdfs:label "Data Retention"@en ;
                     skos:definition "Data retention is the ability of a non-volatile memory device to maintain stored data without power for a specified period under specified environmental conditions."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


