                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty pmdco:relates_to ;
                                      owl:someValuesFrom chips:Research_Equipment_Network
                                    ] ;
                    rdfs:label "Data Plumbing"@en ;
                    skos:definition "Data Plumbing is a data movement service that automates the transfer, transformation, and routing of data between instruments, storage systems, and analysis platforms within a research data infrastructure."@en ;
                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Data_Reduction_Algorithm
chips:Data_Reduction_Algorithm rdf:type owl:Class ;
                               rdfs:subClassOf pmdco:Algorithmus ,
