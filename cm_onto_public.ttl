                                                   owl:someValuesFrom chips:Orbitrap_Mass_Spectrometry
                                                 ] ;
                                 rdfs:label "Orbitrap Mass Spectrometer"@en ;
                                 skos:definition "Orbitrap Mass Spectrometer is a high-resolution mass spectrometer in which ions orbit around a central electrode and their image current oscillation frequency determines mass-to-charge ratio with very high resolution and mass accuracy."@en ;
                                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Orbitrap_Mass_Spectrometry
chips:Orbitrap_Mass_Spectrometry rdf:type owl:Class ;
