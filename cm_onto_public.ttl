###  https://w3id.org/CHIPS/metrology-ontology/Calibrated_Data
chips:Calibrated_Data rdf:type owl:Class ;
                      rdfs:subClassOf chips:Data ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty prov:wasGeneratedBy ;
                                        owl:someValuesFrom chips:Calibration
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty prov:wasGeneratedBy ;
                                        owl:someValuesFrom chips:Calibration_Service
                                      ] ;
                      rdfs:label "Calibrated Data"@en ;
                      skos:definition "Calibrated data is measurement data that has been corrected or adjusted using a known reference standard or calibration procedure to reduce systematic errors and improve accuracy."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Calibration
chips:Calibration rdf:type owl:Class ;
                  rdfs:subClassOf pmdco:Prozess ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty pmdco:superordinate_process ;
                                    owl:someValuesFrom chips:Calibration_Service
                                  ] ;
                  rdfs:label "Calibration"@en ;
                  skos:definition """Calibration is a measurement process that
-    Involves comparing a device or instrument against a known standard
-   Adjusting the device or instrument to ensure accurate and reliable measurements
 -  Verifying and documenting the performance of the device or instrument."""@en ;
                  pmdco:definitionSource "CVCS 0.0.7"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Calibration_Service
chips:Calibration_Service rdf:type owl:Class ;
                          rdfs:subClassOf chips:Service ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty pmdco:subordinate_process ;
                                            owl:someValuesFrom chips:Calibration
                                          ] ;
                          rdfs:label "Calibration Service"@en ;
                          skos:definition "Calibration Service is a measurement service in which a calibration laboratory adjusts an instrument or measurement system and provides a certified calibration certificate relating its readings to national or international standards."@en ;
                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Calibration_Standard
chips:Calibration_Standard rdf:type owl:Class ;
                           rdfs:subClassOf chips:Standard ;
                           rdfs:label "Calibration Standard"@en ;
                           skos:definition "Calibration Standard is a reference artifact or material with a certified property value used to calibrate measurement instruments and establish traceability of measurement results to national or international standards."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Calibration_Unit
chips:Calibration_Unit rdf:type owl:Class ;
                       rdfs:subClassOf pmdco:Messgert ;
                       rdfs:label "Calibration Unit"@en ;
                       skos:definition "Calibration Unit is a measurement instrument or sub-assembly used to calibrate another instrument by providing a reference signal or artifact of known value."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Calorimeter
chips:Calorimeter rdf:type owl:Class ;
                  rdfs:subClassOf chips:Thermal_Property_Measurement_Instrument ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty prov:wasAssociateFor ;
                                    owl:someValuesFrom chips:Calorimetry
                                  ] ;
                  rdfs:label "Calorimeter"@en ;
                  skos:definition "Calorimeter is a measurement instrument that quantifies the heat released or absorbed during a physical, chemical, or nuclear process by measuring temperature changes or heat flow."@en ;
                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Calorimetry
chips:Calorimetry rdf:type owl:Class ;
                  rdfs:subClassOf chips:Thermal_Measurement_Process ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty prov:wasAssociatedWith ;
                                    owl:someValuesFrom chips:Calorimeter
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty prov:wasAssociatedWith ;
                                    owl:someValuesFrom chips:Differential_Scanning_Calorimeter
                                  ] ;
                  skos:definition "Calorimetry is a thermal measurement process that quantifies the heat exchanged by a system during physical or chemical transformations by monitoring temperature changes in a thermally controlled environment."@en ;
                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Camera
chips:Camera rdf:type owl:Class ;
             rdfs:subClassOf mo:Detector ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty prov:generated ;
                               owl:someValuesFrom pmdco:Bild
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty prov:wasAssociateFor ;
                               owl:someValuesFrom chips:Spatiallyresolved_Measurement_Process
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty pmdco:characteristic ;
                               owl:someValuesFrom chips:Acquisition_Speed
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty pmdco:characteristic ;
                               owl:someValuesFrom mo:Spatial_Resolution
                             ] ;
             rdfs:label "Camera"@en ;
