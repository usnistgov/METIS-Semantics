                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty pmdco:relates_to ;
                                       owl:someValuesFrom chips:Electrostatic_Potential
                                     ] ;
                     rdfs:label "Electric Field"@en ;
                     skos:definition "Electric field is a vector field that exerts a force on electric charges, characterized by its magnitude in volts per meter, and applied externally in semiconductor devices to control carrier transport."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Electric_Potential
chips:Electric_Potential rdf:type owl:Class ;
                         rdfs:subClassOf chips:Quantity_Kind ;
                         rdfs:label "Electric Potential"@en ;
                         skos:definition "Electric potential is a scalar quantity kind representing the amount of work needed per unit charge to move a test charge from a reference point to a specific point in an electric field."@en ;
                         pmdco:definitionSource "claude-opus-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Electric_Property
chips:Electric_Property rdf:type owl:Class ;
                        rdfs:subClassOf chips:Electromagnetic_Property ;
                        rdfs:label "Electric Property"@en ;
                        skos:definition "Electric Property is an electromagnetic property that characterizes the response of a material to an applied electric field, including permittivity, conductivity, polarizability, and dielectric loss."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Electrical_Cycling
chips:Electrical_Cycling rdf:type owl:Class ;
                         rdfs:subClassOf pmdco:Alterungsprozess ;
                         rdfs:label "Electrical Cycling"@en ;
                         skos:definition "Electrical Cycling is an aging process in which a device or memory cell is repeatedly programmed and erased by electrical stimulation to characterize endurance, retention degradation, and failure mechanisms."@en ;
                         pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Electrical_Insulator
chips:Electrical_Insulator rdf:type owl:Class ;
                           rdfs:subClassOf chips:Insulator ;
                           rdfs:label "Electrical Insulator"@en ;
                           skos:definition "An electrical insulator is a material that strongly resists the flow of electric current due to its large electronic bandgap, used to isolate conducting regions in semiconductor devices and packaging."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Electrical_Measuring_Device
chips:Electrical_Measuring_Device rdf:type owl:Class ;
                                  rdfs:subClassOf chips:Electromagnetic_Measurement_Device ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty chips:measured ;
                                                    owl:someValuesFrom chips:Electric_Property
                                                  ] ;
                                  rdfs:label "Electrical Measuring Device"@en ;
                                  skos:definition "Electrical Measuring Device is an electromagnetic measurement instrument that quantifies voltage, current, resistance, or related electrical quantities in circuits or materials."@en ;
                                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Electrical_Pulse
chips:Electrical_Pulse rdf:type owl:Class ;
                       rdfs:subClassOf mo:Strom ;
                       rdfs:label "Electrical Pulse"@en ;
                       skos:definition "Electrical Pulse is a transient, unidirectional deviation of an electrical signal from a baseline level with defined amplitude, duration, and rise and fall times, used to switch or write states in electronic devices."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Electrically_Detected_Magnetic_Resonance
chips:Electrically_Detected_Magnetic_Resonance rdf:type owl:Class ;
                                               rdfs:subClassOf chips:Resonanant_Process ;
                                               rdfs:label "Electrically Detected Magnetic Resonance"@en ;
                                               skos:definition "Electrically Detected Magnetic Resonance (EDMR) is a magnetic resonance technique that detects spin-dependent transitions in a semiconductor or organic material by monitoring changes in electrical conductivity or photoconductivity rather than microwave absorption."@en ;
                                               pmdco:abbreviation "EDMR"@en ;
                                               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Electrochemical_Cell
chips:Electrochemical_Cell rdf:type owl:Class ;
                           rdfs:subClassOf chips:Cell ;
                           rdfs:label "Electrochemical Cell"@en ;
                           skos:definition "Electrochemical Cell is a sample environment comprising electrodes immersed in an electrolyte solution that enables electrochemical deposition, corrosion, or impedance measurements under controlled potential or current."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Electrochemical_Deposition
chips:Electrochemical_Deposition rdf:type owl:Class ;
                                 rdfs:subClassOf chips:Deposition_and_Film_Growth ;
                                 rdfs:label "Electrochemical Deposition"@en ;
                                 skos:definition "Electrochemical Deposition is a thin film growth process that uses an electrochemical driving force to reduce dissolved ionic species or deposit materials from an electrolyte solution onto an electrode surface."@en ;
                                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Electrochemical_Impedance_Spectroscopy
chips:Electrochemical_Impedance_Spectroscopy rdf:type owl:Class ;
                                             rdfs:subClassOf mo:Spectroscopy ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty prov:wasInfluencedBy ;
                                                               owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                    owl:unionOf ( chips:Capacitance
                                                                                                  chips:Conductance
                                                                                                  chips:Inductance
                                                                                                  [ owl:intersectionOf ( chips:Derived_Data
                                                                                                                         [ rdf:type owl:Restriction ;
                                                                                                                           owl:onProperty prov:wasDerivedFrom ;
                                                                                                                           owl:someValuesFrom chips:Resistance
                                                                                                                         ]
                                                                                                                       ) ;
                                                                                                    rdf:type owl:Class
                                                                                                  ]
                                                                                                )
                                                                                  ]
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty chips:measured ;
                                                               owl:someValuesFrom [ owl:intersectionOf ( [ rdf:type owl:Class ;
                                                                                                           owl:unionOf ( chips:Capacitance
                                                                                                                         chips:Impedence
                                                                                                                       )
                                                                                                         ]
                                                                                                         [ rdf:type owl:Restriction ;
                                                                                                           owl:onProperty pmdco:characteristic_of ;
                                                                                                           owl:someValuesFrom chips:Interface
                                                                                                         ]
                                                                                                       ) ;
                                                                                    rdf:type owl:Class
                                                                                  ]
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty pmdco:belongsToProject ;
                                                               owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                    owl:unionOf ( chips:Grand_Challenge_2
                                                                                                  chips:Grand_Challenge_7
                                                                                                )
                                                                                  ]
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty pmdco:characteristic ;
                                                               owl:someValuesFrom [ owl:intersectionOf ( [ owl:intersectionOf ( chips:Dependent_Variable
                                                                                                                                [ rdf:type owl:Restriction ;
                                                                                                                                  owl:onProperty pmdco:composed_of ;
                                                                                                                                  owl:someValuesFrom chips:Impedence
                                                                                                                                ]
                                                                                                                              ) ;
                                                                                                           rdf:type owl:Class
                                                                                                         ]
                                                                                                         [ owl:intersectionOf ( chips:Independent_Variable
                                                                                                                                [ rdf:type owl:Restriction ;
