###  https://w3id.org/CHIPS/metrology-ontology/Ptychography
chips:Ptychography rdf:type owl:Class ;
                   rdfs:subClassOf chips:Coherent_Diffractive_Imaging ,
                                   mo:Rekonstruktion ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty prov:wasInformedBy ;
                                     owl:someValuesFrom chips:Coherent_Diffractive_Imaging
                                   ] ;
                   rdfs:label "Ptychography"@en ;
                   skos:definition "Ptychography is a coherent diffractive imaging technique that reconstructs the complex transmission function of a specimen and the illuminating probe simultaneously from a set of overlapping diffraction patterns recorded as the beam is scanned across the specimen."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


