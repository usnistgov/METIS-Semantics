                                                        owl:onProperty pmdco:composed_of ;
                                                        owl:someValuesFrom chips:Magnetic_Tunnel_Junction
                                                      ] ;
                                      rdfs:label "Magnetic Tunnel Junction Sensor"@en ;
                                      skos:definition "Magnetic Tunnel Junction Sensor is a magnetic measuring device that exploits the tunneling magnetoresistance of a thin insulating barrier between two ferromagnetic electrodes to detect weak magnetic fields with high sensitivity."@en ;
                                      pmdco:definitionSource "claude-sonnet-4-6"@en .


