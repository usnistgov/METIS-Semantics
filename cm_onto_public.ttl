                            ] ;
            rdfs:label "Oxide"@en ;
            skos:definition "An oxide is a chemical compound formed by the reaction of an element with oxygen, widely used in semiconductor devices as gate dielectrics, diffusion barriers, and surface passivation layers."@en ;
            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/PIDINST
chips:PIDINST rdf:type owl:Class ;
              rdfs:subClassOf chips:Schema ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty prov:wasUsedBy ;
                                owl:someValuesFrom chips:Grand_Challenge_2
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty pmdco:characteristic_of ;
                                owl:someValuesFrom chips:Instrument_Persistent_Identifier
                              ] ;
              rdfs:label "PIDINST"@en ;
              rdfs:seeAlso "https://github.com/rdawg-pidinst/schema"^^xsd:anyURI ,
                           "https://www.pidinst.org/"^^xsd:anyURI ,
                           "https://www.rd-alliance.org/wp-content/uploads/2022/01/pidinst-schema-1.0_Final.pdf"^^xsd:anyURI ;
              skos:definition "PIDINST is a metadata schema for persistent identification of scientific instruments, defining a standardized set of properties to describe and uniquely reference individual physical measurement devices in research data infrastructures."@en ;
              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Pacific_Northwest_National_Laboratory
chips:Pacific_Northwest_National_Laboratory rdf:type owl:Class ;
                                            rdfs:subClassOf chips:National_Laboratory ;
                                            rdfs:label "Pacific Northwest National Laboratory"@en ;
                                            skos:definition "Pacific Northwest National Laboratory is a DOE national laboratory in Richland, Washington, that conducts research in materials science, analytical chemistry, environmental science, and computational methods."@en ;
                                            pmdco:abbreviation "PNNL" ;
                                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Packaging_Instrument
chips:Packaging_Instrument rdf:type owl:Class ;
                           rdfs:subClassOf chips:Fabrication_Instrument ;
                           rdfs:label "Packaging Instrument"@en ;
                           skos:definition "Packaging Instrument is a fabrication instrument that performs die attach, wire bonding, flip-chip bonding, or encapsulation operations to assemble semiconductor devices into protective packages."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Packaging_Process
chips:Packaging_Process rdf:type owl:Class ;
                        rdfs:subClassOf chips:Backendofline_Process ;
                        rdfs:label "Packaging Process"@en ;
                        skos:definition "Packaging Process is a manufacturing process that encapsulates, electrically interconnects, and mechanically protects one or more semiconductor dice within a protective housing suitable for board-level assembly."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Parameter
chips:Parameter rdf:type owl:Class ;
                rdfs:subClassOf pmdco:Wertobjekt ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty pmdco:characteristic ;
                                  owl:someValuesFrom chips:Measurand
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty pmdco:characteristic ;
                                  owl:someValuesFrom pmdco:Messwert
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty pmdco:characteristic ;
                                  owl:someValuesFrom pmdco:Metadaten
                                ] ;
                rdfs:label "Parameter"@en ;
                skos:definition "Parameter is a value object representing a numerical quantity that characterizes a model, process, or system and whose value is either fixed or estimated from data."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Partial_Differential_Equation
chips:Partial_Differential_Equation rdf:type owl:Class ;
                                    rdfs:subClassOf chips:Equation ,
                                                    [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                             owl:onProperty prov:hadDerivation ;
                                                                             owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                                  owl:unionOf ( chips:Diffusion
                                                                                                                chips:Uncertainty
                                                                                                                [ owl:intersectionOf ( chips:Design_Document
                                                                                                                                       [ rdf:type owl:Restriction ;
                                                                                                                                         owl:onProperty prov:wasAttributedTo ;
                                                                                                                                         owl:someValuesFrom chips:Combo_Instrument
                                                                                                                                       ]
                                                                                                                                     ) ;
                                                                                                                  rdf:type owl:Class
                                                                                                                ]
                                                                                                              )
                                                                                                ]
                                                                           ]
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty prov:wasUsedBy ;
                                                                             owl:someValuesFrom chips:Grand_Challenge_2
                                                                           ]
                                                                         ) ;
                                                      rdf:type owl:Class
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty pmdco:characteristic ;
                                                      owl:someValuesFrom [ rdf:type owl:Class ;
                                                                           owl:unionOf ( chips:Analytical_Model
                                                                                         chips:Empirical_Model
                                                                                       )
                                                                         ]
                                                    ] ;
                                    rdfs:label "Partial Differential Equation"@en ;
                                    skos:definition "Partial Differential Equation Model is an empirical or analytical model that describes a physical system using one or more partial differential equations relating the system variables to their spatial and temporal derivatives."@en ;
                                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Partial_Pressure
chips:Partial_Pressure rdf:type owl:Class ;
                       rdfs:subClassOf chips:Pressure ,
                                       [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                owl:onProperty pmdco:output_of ;
                                                                owl:someValuesFrom chips:Grand_Challenge_5
                                                              ]
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty pmdco:relates_to ;
                                                                owl:someValuesFrom [ owl:intersectionOf ( chips:Plasma_Process
                                                                                                          [ rdf:type owl:Class ;
                                                                                                            owl:unionOf ( chips:Carrier_Gas
                                                                                                                          chips:Reactant
                                                                                                                          chips:Reaction_Product
                                                                                                                        )
                                                                                                          ]
                                                                                                        ) ;
                                                                                     rdf:type owl:Class
                                                                                   ]
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] ;
                       rdfs:label "Partial Pressure"@en ;
                       skos:definition "Partial Pressure is the contribution of a single gas component to the total pressure of a gas mixture, equal to the mole fraction of that component multiplied by the total pressure."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Particle
chips:Particle rdf:type owl:Class ;
               rdfs:subClassOf chips:Matter ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty pmdco:relates_to ;
                                 owl:someValuesFrom chips:Wave
                               ] ;
               rdfs:label "Particle"@en ;
               skos:definition "A particle is a small, localized physical object with definite mass and charge, including subatomic particles, nanoparticles, and aerosol particles relevant to radiation effects and contamination."@en ;
               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Pattern
chips:Pattern rdf:type owl:Class ;
              rdfs:subClassOf chips:Spatial_Concept ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty pmdco:characteristic_of ;
                                owl:someValuesFrom chips:Process_Metadata
                              ] ;
              rdfs:label "Pattern"@en ;
              skos:definition "A pattern is a spatial attribute describing the regular or designed spatial arrangement of features on a substrate, defined by its period, shape, and placement accuracy."@en ;
              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Pennsylvania_State_University
chips:Pennsylvania_State_University rdf:type owl:Class ;
                                    rdfs:subClassOf chips:Academia ;
                                    rdfs:label "Pennsylvania State University"@en ;
                                    skos:definition "Pennsylvania State University is a public research university in University Park, Pennsylvania, that conducts research in materials science, semiconductor devices, two-dimensional materials, and electronic packaging."@en ;
                                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Per_and_Polyfluoroalkyl_Substance
chips:Per_and_Polyfluoroalkyl_Substance rdf:type owl:Class ;
                                        rdfs:subClassOf chips:Organic_Material ;
                                        rdfs:label "Per- and Polyfluoroalkyl Substance"@en ;
                                        skos:altLabel "Forever Chemical"@en ;
                                        skos:definition "Per- and polyfluoroalkyl substances (PFAS) are a class of synthetic organic chemicals containing multiple carbon-fluorine bonds that are used in semiconductor manufacturing processes and photolithography but are subject to regulatory scrutiny due to environmental persistence."@en ;
                                        pmdco:abbreviation "PFAS"@en ;
                                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Period
chips:Period rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Restriction ;
                                   owl:onProperty chips:isMathematicalInverseOf ;
                                   owl:someValuesFrom chips:Frequency
                                 ] ;
             rdfs:subClassOf chips:Wave_Characteristic ,
                             pmdco:Dauer ;
             rdfs:label "Period"@en ;
             skos:altLabel "Cycle"@en ;
             skos:definition "Period is the time required for one complete oscillation cycle of a periodic wave or signal, equal to the reciprocal of frequency."@en ;
             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Perl
chips:Perl rdf:type owl:Class ;
           rdfs:subClassOf chips:Programming_Language ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty prov:wasUsedBy ;
                             owl:someValuesFrom chips:Grand_Challenge_4
                           ] ;
           rdfs:label "Perl"@en ;
           skos:definition "Perl is an interpreted, dynamically typed programming language originally designed for text processing and system administration scripting, featuring powerful regular expression support."@en ;
           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Permeability
chips:Permeability rdf:type owl:Class ;
                   rdfs:subClassOf chips:Magnetic_Property ;
                   rdfs:label "Permeability"@en ;
                   skos:definition "Permeability is a magnetic property defined as the ratio of magnetic flux density to applied magnetic field strength, characterizing the ease with which a material supports the formation of a magnetic field."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Permittivity
chips:Permittivity rdf:type owl:Class ;
                   rdfs:subClassOf chips:Complex_Permittivity ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty chips:hasRealPart ;
                                     owl:someValuesFrom xsd:float
                                   ] ;
                   rdfs:label "Permittivity"@en ;
                   skos:altLabel "Relative Permittivity"@en ;
                   skos:definition "Permittivity is a material property that describes the ability of a dielectric to store electrical energy in an electric field, expressed as the ratio of electric displacement to electric field strength."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Perpendicular_Anisotropy_Material
chips:Perpendicular_Anisotropy_Material rdf:type owl:Class ;
                                        rdfs:subClassOf chips:Magnetic_Material ;
                                        rdfs:label "Perpendicular Anisotropy Material"@en ;
                                        skos:definition "A perpendicular anisotropy material is a magnetic material in which the easy axis of magnetization is oriented perpendicular to the film plane, enabling higher areal density in perpendicular magnetic recording."@en ;
                                        pmdco:abbreviation "PMA Material" ;
                                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Perpendicular_Magnetic_Anisotropy
chips:Perpendicular_Magnetic_Anisotropy rdf:type owl:Class ;
                                        rdfs:subClassOf chips:Magnetic_Anisotropy ;
                                        rdfs:label "Perpendicular Magnetic Anisotropy"@en ;
                                        skos:definition "Perpendicular magnetic anisotropy is a magnetic anisotropy in which the easy magnetization axis points perpendicular to the film plane, enabling high-density perpendicular magnetic recording."@en ;
                                        pmdco:abbreviation "PMA" ;
                                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Phase_Boundary
chips:Phase_Boundary rdf:type owl:Class ;
                     rdfs:subClassOf pmdco:Materialstruktur ;
                     rdfs:label "Phase Boundary"@en ;
                     skos:definition "A phase boundary is the interface separating two distinct thermodynamic phases within a material, across which composition, structure, or physical state changes discontinuously."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Phase_Change_Material
chips:Phase_Change_Material rdf:type owl:Class ;
                            rdfs:subClassOf chips:Material ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty prov:wasUsedBy ;
                                              owl:someValuesFrom chips:Grand_Challenge_4
                                            ] ;
                            rdfs:label "Phase Change Material"@en ;
                            skos:definition "A phase change material is a material that stores and releases thermal energy during a reversible solid-liquid phase transition, or alternatively a material whose electrical resistance changes dramatically with crystallographic phase."@en ;
                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Phase_Diagram_Software
chips:Phase_Diagram_Software rdf:type owl:Class ;
                             rdfs:subClassOf chips:Modeling_and_Simulation_Software ;
                             rdfs:label "Phase Diagram Software"@en ;
                             skos:definition "Phase Diagram Software is a software agent that computes thermodynamic phase diagrams and equilibria for multi-component material systems using CALPHAD or other thermodynamic databases."@en ;
                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Phase_Material
chips:Phase_Material rdf:type owl:Class ;
                     rdfs:subClassOf pmdco:Materialstruktur ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty prov:influenced ;
                                       owl:someValuesFrom chips:Thermal_Conductivity
                                     ] ;
                     rdfs:label "Phase (Material)"@en ;
                     skos:definition "A phase is a thermodynamically distinct region of a material system with uniform composition and structure, separated from other phases by phase boundaries."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Phase_Wave
chips:Phase_Wave rdf:type owl:Class ;
                 rdfs:subClassOf chips:Wave_Characteristic ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty chips:measuredBy ;
                                   owl:someValuesFrom pmdco:Messprozess
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty pmdco:characteristic ;
                                   owl:someValuesFrom chips:Electromagnetic_Property
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty pmdco:characteristic ;
                                   owl:someValuesFrom chips:Inphase_and_Quadrature
                                 ] ;
                 rdfs:label "Phase [Wave]"@en ;
                 skos:definition "Wave phase is the fractional part of a cycle through which a wave has advanced relative to a reference point or reference wave, expressed in degrees or radians."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Phaseretrieval_Algorithm
chips:Phaseretrieval_Algorithm rdf:type owl:Class ;
                               rdfs:subClassOf pmdco:Algorithmus ,
                                               [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                        owl:onProperty prov:wasUsedBy ;
                                                                        owl:someValuesFrom chips:Grand_Challenge_1
                                                                      ]
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty pmdco:characteristic ;
                                                                        owl:someValuesFrom [ owl:intersectionOf ( chips:State_Variable
                                                                                                                  [ rdf:type owl:Restriction ;
                                                                                                                    owl:onProperty pmdco:characteristic ;
                                                                                                                    owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                                                                         owl:unionOf ( chips:Composition
                                                                                                                                                       chips:Density
                                                                                                                                                       [ owl:intersectionOf ( pmdco:Dicke
                                                                                                                                                                              [ rdf:type owl:Restriction ;
                                                                                                                                                                                owl:onProperty pmdco:characteristic_of ;
                                                                                                                                                                                owl:someValuesFrom pmdco:Probe
                                                                                                                                                                              ]
                                                                                                                                                                            ) ;
                                                                                                                                                         rdf:type owl:Class
                                                                                                                                                       ]
                                                                                                                                                       [ owl:intersectionOf ( [ rdf:type owl:Class ;
                                                                                                                                                                                owl:unionOf ( chips:Incident_Angle
                                                                                                                                                                                              chips:Parameter
                                                                                                                                                                                              mo:Strahlungsenergie
                                                                                                                                                                                            )
                                                                                                                                                                              ]
                                                                                                                                                                              [ rdf:type owl:Restriction ;
                                                                                                                                                                                owl:onProperty prov:wasAssociatedWith ;
                                                                                                                                                                                owl:someValuesFrom pmdco:Simulationsprozess
                                                                                                                                                                              ]
                                                                                                                                                                            ) ;
                                                                                                                                                         rdf:type owl:Class
                                                                                                                                                       ]
                                                                                                                                                     )
                                                                                                                                       ]
                                                                                                                  ]
                                                                                                                ) ;
                                                                                             rdf:type owl:Class
                                                                                           ]
                                                                      ]
                                                                    ) ;
                                                 rdf:type owl:Class
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty pmdco:characteristic ;
                                                 owl:someValuesFrom chips:Phase_Wave
                                               ] ;
                               rdfs:label "Phase-retrieval Algorithm"@en ;
                               skos:definition "Phase Retrieval Algorithm is a computational algorithm that recovers the phase of a complex-valued field from measured intensity data using iterative or analytical methods, enabling coherent imaging reconstruction from diffraction patterns."@en ;
                               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Phonon
chips:Phonon rdf:type owl:Class ;
             rdfs:subClassOf chips:Quasiparticle ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty chips:measuredBy ;
                               owl:someValuesFrom chips:Derived_Process
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty pmdco:characteristic ;
                               owl:someValuesFrom chips:Acoustic_Wave_Characteristic
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty pmdco:characteristic ;
                               owl:someValuesFrom chips:Phonon_Property
                             ] ;
             rdfs:label "Phonon"@en ;
             skos:altLabel "Accoustic Wave"@en ;
             skos:definition "A phonon is a quasiparticle representing a quantized lattice vibration in a crystalline solid, serving as the primary carrier of thermal energy and contributing to electrical resistivity through electron-phonon scattering."@en ;
             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Phonon_Frequency_Map
chips:Phonon_Frequency_Map rdf:type owl:Class ;
                           rdfs:subClassOf chips:Phonon_Map ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty pmdco:characteristic ;
                                             owl:someValuesFrom chips:Input_Data
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty pmdco:characteristic ;
                                             owl:someValuesFrom [ owl:intersectionOf ( chips:Phonon
                                                                                       [ rdf:type owl:Restriction ;
                                                                                         owl:onProperty pmdco:characteristic ;
                                                                                         owl:someValuesFrom chips:Frequency
                                                                                       ]
                                                                                     ) ;
                                                                  rdf:type owl:Class
                                                                ]
                                           ] ;
                           rdfs:label "Phonon Frequency Map"@en ;
                           skos:definition "Phonon Frequency Map is a spatially resolved image showing the local variation in phonon frequency across a material, obtained by scanning Raman spectroscopy or inelastic neutron scattering."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Phonon_Map
chips:Phonon_Map rdf:type owl:Class ;
                 rdfs:subClassOf chips:Map ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty pmdco:characteristic ;
                                   owl:someValuesFrom chips:Input_Data
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty pmdco:characteristic ;
                                   owl:someValuesFrom chips:Phonon
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty pmdco:characteristic ;
                                   owl:someValuesFrom [ rdf:type owl:Class ;
                                                        owl:unionOf ( <https://w3id.org/CHIPS/metrology-ontology/2D>
                                                                      <https://w3id.org/CHIPS/metrology-ontology/3D>
                                                                    )
                                                      ]
                                 ] ;
                 rdfs:label "Phonon Map"@en ;
                 skos:definition "Phonon Map is a spatially resolved image of phonon properties, such as lifetime or mean free path, across a material, used to identify spatial heterogeneity in thermal transport."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Phonon_Mode
chips:Phonon_Mode rdf:type owl:Class ;
                  rdfs:subClassOf chips:Phonon_Property ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty chips:calculatedBy ;
                                    owl:someValuesFrom [ rdf:type owl:Class ;
                                                         owl:unionOf ( chips:Computational_Process
                                                                       chips:Derived_Process
                                                                     )
                                                       ]
                                  ] ;
                  rdfs:label "Phonon Mode"@en ;
                  skos:definition "A phonon mode is a specific quantized lattice vibrational pattern in a crystal characterized by its wavevector, polarization, and frequency, observable by Raman or neutron scattering spectroscopy."@en ;
                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Phonon_Property
chips:Phonon_Property rdf:type owl:Class ;
                      rdfs:subClassOf chips:Physical_Property ,
                                      pmdco:Thermisch ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty pmdco:characteristic ;
                                        owl:someValuesFrom chips:Acoustic_Wave_Characteristic
                                      ] ;
                      rdfs:label "Phonon Property"@en ;
                      skos:definition "A phonon property is a physical property describing the characteristics of quantized lattice vibrational modes in a solid, including phonon frequency, dispersion, lifetime, and mean free path."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Phonon_Transport
chips:Phonon_Transport rdf:type owl:Class ;
                       rdfs:subClassOf chips:Phonon_Property ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty chips:calculatedBy ;
                                         owl:someValuesFrom chips:Computational_Process
                                       ] ;
                       rdfs:label "Phonon Transport"@en ;
                       skos:definition "Phonon transport is the propagation of quantized lattice vibrations through a solid as the primary mechanism of thermal conduction, governed by phonon dispersion, scattering, and mean free path."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Phonon_Vibration
chips:Phonon_Vibration rdf:type owl:Class ;
                       rdfs:subClassOf chips:Phonon_Property ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty chips:calculatedBy ;
                                         owl:someValuesFrom chips:Computational_Process
                                       ] ;
                       rdfs:label "Phonon Vibration"@en ;
                       skos:definition "Phonon vibration is the collective oscillatory motion of atoms in a crystal lattice quantized as phonons, determining thermal, acoustic, and certain optical properties of the material."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Photo
chips:Photo rdf:type owl:Class ;
            rdfs:subClassOf pmdco:Bild ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty pmdco:characteristic ;
                              owl:someValuesFrom [ owl:intersectionOf ( pmdco:Metadaten
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty pmdco:characteristic ;
                                                                          owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                               owl:unionOf ( chips:Geolocation
                                                                                                             pmdco:Zeit
                                                                                                           )
                                                                                             ]
                                                                        ]
                                                                      ) ;
                                                   rdf:type owl:Class
                                                 ]
                            ] ;
            rdfs:label "Photo"@en ;
            skos:definition "A photo is a digital or analog image captured by a camera using visible or other electromagnetic radiation, serving as a visual record of a sample, experiment, or instrument."@en ;
            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Photodiode
chips:Photodiode rdf:type owl:Class ;
                 rdfs:subClassOf chips:Device ;
                 rdfs:label "Photodiode"@en ;
                 skos:definition "Photodiode is a semiconductor device that converts incident photons into an electric current through the photovoltaic or photoconductive effect, used in optical detection and energy harvesting applications."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Photoemission_Electron_Microscope
chips:Photoemission_Electron_Microscope rdf:type owl:Class ;
                                        rdfs:subClassOf pmdco:Mikroskop ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty prov:wasAssociateFor ;
                                                          owl:someValuesFrom chips:Photoemission_Electron_Microscopy
                                                        ] ;
                                        rdfs:label "Photoemission Electron Microscope"@en ;
                                        skos:altLabel "Photoelectron Microscope"@en ;
                                        skos:definition "Photoemission Electron Microscope (PEEM) is an electron microscope instrument that images surface electronic structure and magnetic domains by collecting photoelectrons emitted from a specimen surface under X-ray or UV illumination."@en ;
                                        pmdco:abbreviation "PEEM"@en ;
                                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Photoemission_Electron_Microscopy
chips:Photoemission_Electron_Microscopy rdf:type owl:Class ;
                                        rdfs:subClassOf pmdco:Mikroskopie ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty prov:generated ;
                                                          owl:someValuesFrom chips:Electron
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty prov:used ;
                                                          owl:someValuesFrom [ rdf:type owl:Class ;
                                                                               owl:unionOf ( chips:Laser
                                                                                             chips:Photon_Beam
                                                                                           )
                                                                             ]
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty chips:measured ;
                                                          owl:someValuesFrom [ rdf:type owl:Class ;
                                                                               owl:unionOf ( chips:Defect
                                                                                             chips:Valence_Band_Position
                                                                                             chips:Work_Function
                                                                                           )
                                                                             ]
                                                        ] ;
                                        rdfs:label "Photoemission Electron Microscopy"@en ;
                                        skos:altLabel "Photoelectron Microscopy"@en ;
                                        skos:definition "Photoemission Electron Microscopy (PEEM) is an electron microscopy technique that images the surface of a specimen by collecting photoelectrons excited by X-ray or UV photons, providing chemical and magnetic contrast."@en ;
                                        pmdco:abbreviation "PEEM"@en ;
                                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Photoemission_Electron_Microscopy_Image
chips:Photoemission_Electron_Microscopy_Image rdf:type owl:Class ;
                                              rdfs:subClassOf pmdco:Bild ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty prov:wasGeneratedBy ;
                                                                owl:someValuesFrom mo:Ionenmikroskopie
                                                              ] ;
                                              rdfs:label "Photoemission Electron Microscopy Image"@en ;
                                              skos:definition "A photoemission electron microscopy (PEEM) image is a surface-sensitive image formed by mapping the spatial distribution of photoelectrons emitted from a surface, providing elemental and magnetic contrast."@en ;
                                              pmdco:abbreviation "PEEM Image"@en ;
                                              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Photoemission_Spectroscopy
chips:Photoemission_Spectroscopy rdf:type owl:Class ;
                                 rdfs:subClassOf chips:Electron_Spectroscopy ,
                                                 chips:Optical_Spectroscopy ;
                                 rdfs:label "Photoemission Spectroscopy"@en ;
                                 skos:definition "Photoemission Spectroscopy is an electron spectroscopy technique that measures the kinetic energy distribution of electrons emitted from a material upon irradiation by photons, providing information on electronic band structure and chemical state."@en ;
                                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Photoluminescence
chips:Photoluminescence rdf:type owl:Class ;
                        rdfs:subClassOf chips:Luminescence ;
                        rdfs:label "Photoluminescence"@en ;
                        skos:definition "Photoluminescence is a luminescence process in which a material absorbs photons of sufficient energy and re-emits photons at longer wavelengths after internal relaxation, used to characterize bandgap, defects, and carrier dynamics."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Photoluminescence_Spectrum
chips:Photoluminescence_Spectrum rdf:type owl:Class ;
                                 rdfs:subClassOf chips:Spectrum ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty prov:wasGeneratedBy ;
                                                   owl:someValuesFrom chips:Photoluminescence
                                                 ] ;
                                 rdfs:label "Photoluminescence Spectrum"@en ;
                                 skos:definition "A photoluminescence (PL) spectrum is a dataset of emitted light intensity as a function of wavelength following optical excitation, used to characterize bandgap, defect states, and alloy composition."@en ;
                                 pmdco:abbreviation "PL"@en ;
                                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Photolysis
chips:Photolysis rdf:type owl:Class ;
                 rdfs:subClassOf chips:Chemical_Reaction ;
                 rdfs:label "Photolysis"@en ;
                 skos:definition "Photolysis is a chemical reaction in which a molecular species is dissociated or decomposed by the absorption of one or more photons of sufficient energy."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Photon
chips:Photon rdf:type owl:Class ;
             rdfs:subClassOf chips:Force_Carrier ;
             rdfs:label "Photon"@en ;
             skos:definition "A photon is a quantum of electromagnetic radiation with energy proportional to its frequency, serving as the probe in optical spectroscopy, the signal carrier in photonics, and the patterning agent in photolithography."@en ;
             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Photon_Beam
chips:Photon_Beam rdf:type owl:Class ;
                  rdfs:subClassOf mo:Strahl ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty pmdco:composed_of ;
                                    owl:someValuesFrom chips:Photon
                                  ] ;
                  rdfs:label "Photon Beam"@en ;
                  skos:definition "Photon Beam is a directed flux of photons propagating through space with defined spatial, spectral, and temporal properties, used as the primary probe or excitation source in optical, X-ray, and infrared measurement techniques."@en ;
                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Photonic_Coupling
