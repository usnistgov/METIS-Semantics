                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Degree_of_Cure
chips:Degree_of_Cure rdf:type owl:Class ;
                     rdfs:subClassOf chips:Chemical_Property ,
                                     [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                              owl:onProperty prov:wasUsedBy ;
                                                              owl:someValuesFrom chips:Grand_Challenge_3
                                                            ]
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty pmdco:characteristic ;
                                                              owl:someValuesFrom chips:State_Variable
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty chips:calculatedBy ;
                                       owl:someValuesFrom chips:Computational_Process
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty chips:measuredBy ;
                                       owl:someValuesFrom pmdco:Messprozess
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty pmdco:characteristic ;
                                       owl:someValuesFrom pmdco:Metadaten
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty pmdco:relates_to ;
                                       owl:someValuesFrom chips:Residual_Stress
                                     ] ;
                     rdfs:label "Degree of Cure"@en ;
                     skos:definition "Degree of cure is a chemical property of a thermosetting polymer quantifying the fraction of reactive groups that have participated in crosslinking reactions, ranging from zero (uncured) to one (fully cured)."@en ;
                     pmdco:abbreviation "DOC"@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Deguassing_Process
chips:Deguassing_Process rdf:type owl:Class ;
                         rdfs:subClassOf chips:Timedependent_Process ;
                         rdfs:label "Deguassing Process"@en ;
                         skos:definition "Degaussing Process is a time-dependent process that applies a decreasing alternating magnetic field to a ferromagnetic material to reduce its remanent magnetization toward zero."@en ;
                         pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Denoise_Process
chips:Denoise_Process rdf:type owl:Class ;
                      rdfs:subClassOf chips:Signal_Process ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty prov:wasAssociatedWith ;
                                        owl:someValuesFrom chips:Noise_Analysis
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty prov:wasInfluencedBy ;
                                        owl:someValuesFrom chips:Noise
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty pmdco:relates_to ;
                                        owl:someValuesFrom chips:AI_and_Machine_Learning
                                      ] ;
                      rdfs:label "De-noise Process"@en ;
                      skos:definition "Denoise Process is a signal processing operation that reduces unwanted stochastic noise in a measurement signal by applying filters, wavelet thresholding, or machine learning-based methods while preserving signal features."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Densimeter
chips:Densimeter rdf:type owl:Class ;
                 rdfs:subClassOf pmdco:Messgert ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty prov:wasAssociateFor ;
                                   owl:someValuesFrom chips:Grand_Challenge_1
                                 ] ;
                 rdfs:label "Densimeter"@en ;
                 skos:definition "Densimeter is a measurement instrument that determines the density of a liquid or gas by measuring its mass per unit volume using hydrostatic, oscillating tube, or ultrasonic methods."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Density
chips:Density rdf:type owl:Class ;
              rdfs:subClassOf chips:Physical_Property ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty chips:measuredBy ;
                                owl:someValuesFrom chips:Grand_Challenge_1
                              ] ;
              rdfs:label "Density"@en ;
              skos:definition "Density is a physical property defined as the mass per unit volume of a material, used to characterize packing efficiency, identify phases, and validate thin-film stoichiometry."@en ;
              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Density_Functional_Theory
chips:Density_Functional_Theory rdf:type owl:Class ;
                                rdfs:subClassOf chips:Atomistic_Model ,
                                                [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                         owl:onProperty prov:hadDerivation ;
                                                                         owl:someValuesFrom chips:Thermal_Conductivity
                                                                       ]
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty prov:wasUsedBy ;
                                                                         owl:someValuesFrom chips:Grand_Challenge_4
                                                                       ]
                                                                     ) ;
                                                  rdf:type owl:Class
                                                ] ,
                                                [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                         owl:onProperty prov:hadDerivation ;
                                                                         owl:someValuesFrom [ owl:intersectionOf ( chips:Band_Offset
                                                                                                                   chips:Carrier_Transport
                                                                                                                   chips:Defect
                                                                                                                   chips:Defect_Levels
                                                                                                                   chips:Dielectric_Property
                                                                                                                   chips:Work_of_Adhesion
                                                                                                                   pmdco:Kristalline_Struktur
                                                                                                                 ) ;
                                                                                              rdf:type owl:Class
                                                                                            ]
                                                                       ]
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty prov:wasUsedBy ;
                                                                         owl:someValuesFrom chips:Grand_Challenge_4
                                                                       ]
                                                                     ) ;
                                                  rdf:type owl:Class
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty prov:wasUsedBy ;
                                                  owl:someValuesFrom chips:Grand_Challenge_2
                                                ] ;
                                rdfs:label "Density Functional Theory"@en ;
                                skos:definition "Density Functional Theory (DFT) is a quantum mechanical model that maps the interacting many-electron problem onto a set of non-interacting single-electron equations using the electron density as the fundamental variable, via the exchange-correlation functional."@en ;
                                pmdco:abbreviation "DFT"@en ;
                                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Density_Functional_Theory_Software
chips:Density_Functional_Theory_Software rdf:type owl:Class ;
                                         rdfs:subClassOf chips:Atomistic_Simulation_Software ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty pmdco:relates_to ;
                                                           owl:someValuesFrom chips:Density_Functional_Theory
                                                         ] ;
                                         rdfs:label "Density Functional Theory Software"@en ;
                                         skos:definition "Density Functional Theory Software is a software agent that implements DFT algorithms to compute electronic structure, total energies, forces, and material properties of atoms, molecules, and solids from first principles."@en ;
                                         pmdco:definitionSource "claude-sonnet-4-6"@en .


