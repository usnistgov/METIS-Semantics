                             ] ;
             rdfs:label "Strain"@en ;
             skos:definition "Strain is a dimensionless measure of the deformation of a solid body, defined as the fractional change in a linear dimension, shear angle, or volume relative to the undeformed state."@en ;
             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Strain_Map
chips:Strain_Map rdf:type owl:Class ;
