                                      pmdco:abbreviation "EFRC" ;
                                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Engineered_Nanostructure
chips:Engineered_Nanostructure rdf:type owl:Class ;
                               rdfs:subClassOf chips:Engineered_Structure ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty pmdco:input_of ;
                                                 owl:someValuesFrom [ owl:intersectionOf ( chips:Grand_Challenge_1
                                                                                           chips:Ptychography
                                                                                         ) ;
                                                                      rdf:type owl:Class
                                                                    ]
                                               ] ;
                               rdfs:label "Engineered Nanostructure"@en ;
