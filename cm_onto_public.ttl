###  https://w3id.org/pmd/mo/Spannung
mo:Spannung rdf:type owl:Class ;
            rdfs:subClassOf chips:Electric_Potential ,
                            [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                     owl:onProperty prov:wasUsedBy ;
                                                     owl:someValuesFrom [ rdf:type owl:Class ;
                                                                          owl:unionOf ( chips:Grand_Challenge_4
                                                                                        chips:Grand_Challenge_5
                                                                                      )
                                                                        ]
                                                   ]
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty pmdco:characteristic ;
                                                     owl:someValuesFrom chips:Independent_Variable
                                                   ]
                                                 ) ;
                              rdf:type owl:Class
                            ] ,
                            [ rdf:type owl:Class ;
                              owl:unionOf ( [ rdf:type owl:Restriction ;
                                              owl:onProperty chips:calculatedBy ;
                                              owl:someValuesFrom chips:Computational_Process
                                            ]
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty chips:measuredBy ;
                                              owl:someValuesFrom pmdco:Messprozess
                                            ]
                                          )
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty pmdco:characteristic ;
                              owl:someValuesFrom pmdco:Metadaten
                            ] ;
            rdfs:isDefinedBy <https://w3id.org/pmd/mo> ;
            rdfs:label "Spannung"@de ,
                       "Voltage"@en ;
            skos:altLabel "Stromspannung"@de ;
            skos:definition """Die Spannung, auch elektrische Potentialdifferenz, ist ein Maß für die elektrische potentielle Energie pro Ladungseinheit in einem elektrischen Stromkreis. Sie ist die Kraft, die den elektrischen Strom durch einen Leiter treibt. 

Hinweis: Die Spannung wird in Volt (V) gemessen und stellt die potenzielle Energiedifferenz zwischen zwei Punkten in einem Stromkreis dar. Je höher die Spannung ist, desto größer ist die Kraft, die die elektrischen Ladungen antreibt, und desto höher ist folglich auch das Potenzial für einen Stromfluss."""@de ,
                            """Voltage, also known as electric potential difference, is a measure of the electric potential energy per unit charge in an electrical circuit. It is the force or pressure that drives electric current through a conductor. 

Note: Voltage is measured in volts (V), and it represents the potential energy difference between two points in a circuit. The higher the voltage, the greater the force pushing the electric charges, and consequently, the higher the potential for current to flow."""@en ;
            pmdco:definitionSource "ChatGPT 3.5"@en .


###  https://w3id.org/pmd/mo/Spatial_Resolution
mo:Spatial_Resolution rdf:type owl:Class ;
                      rdfs:subClassOf mo:Auflsung ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty pmdco:characteristic_of ;
                                        owl:someValuesFrom chips:Spatial_Concept
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty pmdco:characteristic_of ;
                                        owl:someValuesFrom chips:Spatiallyresolved_Measurement_Process
                                      ] ;
                      rdfs:isDefinedBy <https://w3id.org/pmd/mo> ;
                      rdfs:label "Ortsauflösung"@de ,
                                 "Spatial Resolution"@en ;
                      skos:definition "Die Fähigkeit eines Bildgebungssystems, feine Details in einem Objekt anzuzeigen. Sie bezieht sich auf das kleinste wahrnehmbare Detail in einem Bild."@de ,
                                      "The ability of an imaging system to discern fine details in an object. It refers to the smallest discernible detail in an image."@en ;
                      pmdco:definitionSource "ChatGPT 3.5"@en .


###  https://w3id.org/pmd/mo/Spectroscopy
mo:Spectroscopy rdf:type owl:Class ;
                rdfs:subClassOf pmdco:Messprozess ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty prov:generated ;
                                  owl:someValuesFrom chips:Spectrum
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty prov:wasAssociatedWith ;
                                  owl:someValuesFrom mo:Spektrometer
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty pmdco:relates_to ;
                                  owl:someValuesFrom chips:Spectrometry
                                ] ;
                rdfs:isDefinedBy <https://w3id.org/pmd/mo> ;
                skos:altLabel "Spectrometry"@en ,
                              "Spektrometrie"@de ;
                skos:definition "Spectroscopy is a scientific technique used to study and analyze the interaction of matter with electromagnetic radiation, such as light. It involves measuring the way in which different substances absorb, emit, or scatter light at various wavelengths or frequencies. By examining the spectrum of light emitted, absorbed, or transmitted by a sample, scientists can gain insights into its chemical composition, molecular structure, and physical properties. Spectroscopy is widely utilized in various fields, including chemistry, physics, astronomy, and biochemistry, to investigate the characteristics and behavior of materials at the atomic and molecular level."@en ;
                skos:prefLabel "Spectroscopy"@en ,
                               "Spektroskopie"@de ;
                pmdco:definitionSource "ChatGPT 3.5"@en .


###  https://w3id.org/pmd/mo/Spektrometer
mo:Spektrometer rdf:type owl:Class ;
                rdfs:subClassOf chips:Analysis_Instrument ,
                                mo:Detector ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty prov:wasAssociateFor ;
                                  owl:someValuesFrom [ rdf:type owl:Class ;
                                                       owl:unionOf ( chips:Spectrometry
                                                                     mo:Spectroscopy
                                                                   )
                                                     ]
                                ] ;
                rdfs:isDefinedBy <https://w3id.org/pmd/mo> ;
                rdfs:label "Spectrometer"@en ,
                           "Spektrometer"@de ;
