###  https://w3id.org/pmd/co/Optisch
pmdco:Optisch rdf:type owl:Class ;
              rdfs:subClassOf chips:Electromagnetic_Property ;
              rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
              rdfs:label "Optical Property"@en ,
                         "Optisch"@de ;
              skos:definition "An optical property is a physical property that characterizes how a material interacts with electromagnetic radiation in or near the visible spectrum, including refractive index, absorption coefficient, reflectance, transmittance, and photoluminescence."@en ;
              pmdco:definitionSource "“Optical.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/optical. Accessed 13 Jan. 2023."@en .


###  https://w3id.org/pmd/co/Optische_Mikroskopie
pmdco:Optische_Mikroskopie rdf:type owl:Class ;
                           rdfs:subClassOf pmdco:Mikroskopie ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty prov:used ;
                                             owl:someValuesFrom [ rdf:type owl:Class ;
                                                                  owl:unionOf ( chips:Photon
                                                                                chips:Photon_Beam
                                                                              )
                                                                ]
                                           ] ;
                           rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                           rdfs:label "Optical Microscopy"@en ,
                                      "Optische Mikroskopie"@de ;
                           skos:definition "A microscopy process in which light rays are seen directly by the observer as distinguished from one (as an electron microscope) in which some transformation or system of indirect viewing is use."@en ;
                           pmdco:definitionSource "“Optical microscope.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/optical%20microscope. Accessed 24 Nov. 2022."@en .


###  https://w3id.org/pmd/co/Partikelnummer
pmdco:Partikelnummer rdf:type owl:Class ;
                     rdfs:subClassOf pmdco:Index ;
                     rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                     rdfs:label "Particle Number"@en ,
                                "Partikelnummer"@de ;
                     skos:definition "Die Partikelnummer ermöglicht die eindeutige Zuordnung der gemessenen Eigenschaften zu einem bestimmten Partikel."@de ,
                                     "The particle number enables the explicit assignment of measured properties to a specific particle."@en .


###  https://w3id.org/pmd/co/Percentage_Extension
pmdco:Percentage_Extension rdf:type owl:Class ;
                           rdfs:subClassOf pmdco:Verlngerung_der_ExtensometerMesslnge ;
                           rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                           rdfs:label "Extensometer-Dehnung"@de ,
                                      "Percentage Extension"@en ;
                           skos:altLabel "(engineering) strain"@en ,
                                         "technische Dehnung"@de ;
                           skos:definition """extension expressed as a percentage of the extensometer gauge length

Note: The percentage extension is commonly called engineering strain."""@en ,
                                           """in Prozent angegebene Verlängerung der Extensometer-Messlänge

Anmerkung: Die Extensometer-Dehnung wird oftmals auch als technische Dehnung bezeichnet."""@de ;
                           pmdco:definitionSource "DIN EN ISO 6892-1:2019"@en .


