###  https://w3id.org/CHIPS/metrology-ontology/University_of_Minnesota
chips:University_of_Minnesota rdf:type owl:Class ;
                              rdfs:subClassOf chips:Academia ;
                              rdfs:label "University of Minnesota"@en ;
                              skos:definition "The University of Minnesota is a public research university in Minneapolis, Minnesota, that conducts research in magnetic materials, spintronics, semiconductor devices, and nanofabrication."@en ;
                              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/University_of_Missouri
