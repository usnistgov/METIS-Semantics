                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Orbital_Angular_Momentum_Polarization
chips:Orbital_Angular_Momentum_Polarization rdf:type owl:Class ;
                                            rdfs:subClassOf chips:Beamformation_Process ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty prov:generated ;
                                                              owl:someValuesFrom chips:Orbitalpolarized_Electron_Beam
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty prov:generated ;
                                                              owl:someValuesFrom chips:Orbitalpolarized_Neutron_Beam
                                                            ] ;
                                            rdfs:label "Orbital Angular Momentum Polarization"@en ;
                                            skos:altLabel "Orbital Polarization"@en ;
                                            skos:definition "Orbital Angular Momentum Polarization is a beam formation process that imparts a defined orbital angular momentum state to a photon or electron beam, producing a helical wavefront used in advanced spectroscopy and microscopy."@en ;
                                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Orbitalpolarized_Electron_Beam
chips:Orbitalpolarized_Electron_Beam rdf:type owl:Class ;
