                                                            owl:someValuesFrom chips:Grand_Challenge_5
                                                          ] ;
                                          rdfs:label "Computational Fluid Dynamics Module"@en ;
                                          skos:definition "The Computational Fluid Dynamics Module is a COMSOL Multiphysics add-on module that provides solvers and physics interfaces for simulating fluid flow, heat transfer in fluids, and related transport phenomena."@en ;
                                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Computational_Process
chips:Computational_Process rdf:type owl:Class ;
                            rdfs:subClassOf pmdco:Prozess ;
                            rdfs:label "Computational Process"@en ;
                            skos:definition "Computational Process is a process that uses computation—algorithms, simulations, or data analysis—to transform input information into results or predictions."@en ;
                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Compute_Environment
chips:Compute_Environment rdf:type owl:Class ;
                          rdfs:subClassOf prov:Software_Agent ;
                          rdfs:label "Compute Environment"@en ;
                          skos:definition "Compute Environment is a software agent that provides an interactive or batch computing platform—such as a Jupyter notebook server or HPC job scheduler—for executing scientific code and workflows."@en ;
                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Computer
chips:Computer rdf:type owl:Class ;
               rdfs:subClassOf pmdco:Computing_Node ;
               rdfs:label "Computer"@en ;
               skos:definition "Computer is a computing node comprising a processor, memory, and input/output interfaces that executes stored programs to perform general-purpose data processing, simulation, and instrument control."@en ;
               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Computer_Aided_Design
chips:Computer_Aided_Design rdf:type owl:Class ;
                            rdfs:subClassOf chips:Computational_Process ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty prov:generated ;
                                              owl:someValuesFrom chips:Computer_Aided_Design_Drawing
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty prov:wasAssociatedWith ;
                                              owl:someValuesFrom chips:Computer_Aided_Design_Software
                                            ] ;
                            rdfs:label "Computer Aided Design"@en ;
                            skos:definition "Computer-Aided Design (CAD) is a computational process that uses software tools to create, analyze, and optimize geometric models of physical objects or electronic circuits for engineering design and manufacturing."@en ;
                            pmdco:abbreviation "CAD"@en ;
                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Computer_Aided_Design_Drawing
chips:Computer_Aided_Design_Drawing rdf:type owl:Class ;
                                    rdfs:subClassOf chips:Design_Document ,
                                                    [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
