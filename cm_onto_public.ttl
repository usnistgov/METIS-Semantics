                                      ] ;
                      rdfs:label "Custom Software"@en ;
                      skos:definition "Custom Software is a software agent developed for a specific measurement, instrument, or workflow that is not commercially available and is maintained by the originating research group or institution."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


