                   skos:definition "Chemical Map is a spatially resolved representation of the chemical composition or bonding state of a material surface or cross-section, obtained by scanning spectroscopic techniques."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Chemical_Polishing
chips:Chemical_Polishing rdf:type owl:Class ;
                         rdfs:subClassOf pmdco:Manufacture_Process ;
                         rdfs:label "Chemical Polishing"@en ;
                         skos:definition "Chemical Polishing is a manufacture process that smooths a material surface by controlled dissolution of surface asperities in a chemical reagent bath, producing a reflective finish without mechanical abrasion."@en ;
                         pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Chemical_Process
chips:Chemical_Process rdf:type owl:Class ;
                       rdfs:subClassOf pmdco:Prozess ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty prov:wasInformedBy ;
                                         owl:someValuesFrom chips:Chemistry
                                       ] ;
                       rdfs:label "Chemical Process"@en ;
                       skos:definition "Chemical Process is a process that transforms one or more chemical species into different species through the formation or breaking of chemical bonds."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Chemical_Property
chips:Chemical_Property rdf:type owl:Class ;
                        rdfs:subClassOf chips:Property ;
                        rdfs:label "Chemical Property"@en ;
                        skos:definition "Chemical Property is a property that describes the reactivity, stability, or chemical composition of a material, including oxidation state, solubility, and electronegativity."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Chemical_Reaction
chips:Chemical_Reaction rdf:type owl:Class ;
                        rdfs:subClassOf chips:Chemical_Process ;
                        rdfs:label "Chemical Reaction"@en ;
                        skos:definition "Chemical Reaction is a process in which one or more reactant substances are converted into different product substances through the breaking and forming of chemical bonds."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Chemical_Vapor_Deposition
chips:Chemical_Vapor_Deposition rdf:type owl:Class ;
                                rdfs:subClassOf chips:Deposition_and_Film_Growth ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty prov:wasAssociatedWith ;
                                                  owl:someValuesFrom chips:Chemical_Vapor_Deposition_Tool
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty pmdco:belongsToProject ;
                                                  owl:someValuesFrom chips:Grand_Challenge_5
                                                ] ;
                                rdfs:label "Chemical Vapor Deposition"@en ;
                                skos:definition "Chemical Vapor Deposition (CVD) is a thin film growth process in which volatile precursor gases are introduced into a reactor and undergo thermally or plasma-activated chemical reactions at the substrate surface to deposit a solid film."@en ;
                                pmdco:abbreviation "CVD" ;
                                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Chemical_Vapor_Deposition_Tool
chips:Chemical_Vapor_Deposition_Tool rdf:type owl:Class ;
                                     rdfs:subClassOf chips:Deposition_Tool ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty prov:wasAssociateFor ;
                                                       owl:someValuesFrom chips:Chemical_Vapor_Deposition
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty prov:wasAssociateFor ;
                                                       owl:someValuesFrom chips:Grand_Challenge_5
                                                     ] ;
                                     rdfs:label "Chemical Vapor Deposition Tool"@en ;
                                     skos:definition "Chemical Vapor Deposition Tool is a fabrication instrument that introduces gaseous precursors into a heated reactor where they undergo chemical reactions at the substrate surface to deposit a thin solid film."@en ;
                                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Chemistry
chips:Chemistry rdf:type owl:Class ;
                rdfs:subClassOf chips:Domain_Activities ;
                rdfs:label "Chemistry"@en ;
                skos:definition "Chemistry is the scientific discipline that investigates the composition, structure, properties, and transformations of matter at the atomic and molecular level."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Chemorheology
chips:Chemorheology rdf:type owl:Class ;
                    owl:equivalentClass chips:Chemoviscosity ;
                    rdfs:subClassOf chips:Viscosity ;
                    rdfs:label "Chemorheology"@en ;
                    skos:definition "Chemorheology is the study of how the rheological properties of a reactive polymer system evolve as a function of cure conversion and crosslink density during a thermosetting reaction."@en ;
                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Chemoviscosity
chips:Chemoviscosity rdf:type owl:Class ;
                     rdfs:subClassOf chips:Viscosity ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty chips:calculatedBy ;
                                       owl:someValuesFrom chips:Computational_Process
                                     ] ;
                     rdfs:label "Chemoviscosity"@en ;
                     skos:definition "Chemoviscosity is the viscosity of a reactive polymer system as a function of time and temperature during cure, governing flow and void formation during semiconductor encapsulation."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Chiplet
chips:Chiplet rdf:type owl:Class ;
              rdfs:subClassOf chips:Device ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty prov:wasAssociateFor ;
                                owl:someValuesFrom chips:Grand_Challenge_7
                              ] ;
              rdfs:label "Chiplet"@en ;
              skos:definition "Chiplet is a modular hardware device comprising a small, independently manufactured die designed to be integrated with other chiplets or a base die in a multi-chip package to provide a specific functional block."@en ;
              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Chromatography
chips:Chromatography rdf:type owl:Class ;
                     rdfs:subClassOf chips:Identification_Process ,
                                     chips:Separation_Process ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty prov:informed ;
                                       owl:someValuesFrom [ rdf:type owl:Class ;
                                                            owl:unionOf ( chips:Contaminant_Identification
                                                                          chips:Element_Identification
                                                                        )
                                                          ]
                                     ] ;
                     rdfs:label "Chromatography"@en ;
                     skos:definition "Chromatography is an identification process that separates components of a mixture by differential migration through a stationary phase driven by a mobile phase, enabling identification and quantification of individual species."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Chromatography_Instrument
chips:Chromatography_Instrument rdf:type owl:Class ;
                                rdfs:subClassOf pmdco:Messgert ;
                                rdfs:label "Chromatography Instrument"@en ;
                                skos:definition "Chromatography Instrument is a measurement device that separates the components of a mixture by differential migration through a stationary phase driven by a mobile phase, enabling identification and quantification."@en ;
                                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Circular_Economy_Process
chips:Circular_Economy_Process rdf:type owl:Class ;
                               rdfs:subClassOf chips:Recovery_Process ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty prov:wasInfluencedBy ;
                                                 owl:someValuesFrom chips:Circularity_Design_Process
