                                                 ]
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty pmdco:composes ;
                              owl:someValuesFrom chips:Magnetic_Tunnel_Junction
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty pmdco:composes ;
                              owl:someValuesFrom chips:Metaloxidesemiconductor_Fieldeffect_Transistor
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty pmdco:composes ;
                              owl:someValuesFrom pmdco:Metallic_Bond
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty pmdco:input_of ;
                              owl:someValuesFrom [ owl:intersectionOf ( chips:Grand_Challenge_4
                                                                        pmdco:Simulationsprozess
                                                                      ) ;
                                                   rdf:type owl:Class
                                                 ]
                            ] ;
            rdfs:label "Metal"@en ;
            skos:definition "A metal is a material characterized by high electrical and thermal conductivity, metallic luster, ductility, and malleability, resulting from a lattice of positive ions surrounded by a delocalized electron cloud."@en ;
            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Metallization
chips:Metallization rdf:type owl:Class ;
