                                                                         rdf:type owl:Class
                                                                       ] ;
                                                       rdfs:label "Intelligence Advanced Research Projects Activity"@en ;
                                                       skos:definition "The Intelligence Advanced Research Projects Activity (IARPA) is a U.S. intelligence community research organization that invests in high-risk, high-payoff research in quantum computing, superconducting electronics, and advanced sensing."@en ;
                                                       pmdco:abbreviation "IARPA" ;
                                                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Intelligence_Agency
chips:Intelligence_Agency rdf:type owl:Class ;
                          rdfs:subClassOf chips:Government ;
                          rdfs:label "Intelligence Agency"@en ;
                          skos:definition "An intelligence agency is a government organization that conducts research in trusted microelectronics, secure hardware, and semiconductor supply chain integrity for national security purposes."@en ;
                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Intensity
chips:Intensity rdf:type owl:Class ;
                rdfs:subClassOf pmdco:Wertobjekt ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty pmdco:characteristic ;
                                  owl:someValuesFrom [ rdf:type owl:Class ;
                                                       owl:unionOf ( chips:Measurand
                                                                     pmdco:Messwert
                                                                   )
                                                     ]
                                ] ;
                rdfs:label "Intensity"@en ;
                skos:definition "Intensity is a radiometric or photometric quantity expressing the power of electromagnetic radiation per unit area incident upon or emitted from a surface, or per unit solid angle in a specified direction."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Interatomic_Potential
chips:Interatomic_Potential rdf:type owl:Class ;
                            rdfs:subClassOf chips:Force-field_Model ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty pmdco:characteristic_of ;
                                              owl:someValuesFrom chips:Interatomic_Potential_Repository
                                            ] ;
                            rdfs:label "Interatomic Potential"@en ;
                            skos:definition "Interatomic Potential is an empirical or semi-empirical mathematical function that describes the potential energy of a system of atoms as a function of their positions, parameterized to reproduce structural and thermodynamic properties."@en ;
                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Interatomic_Potential_Repository
chips:Interatomic_Potential_Repository rdf:type owl:Class ;
                                       rdfs:subClassOf chips:Repository ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty chips:calculatedBy ;
                                                         owl:someValuesFrom chips:Force-field-based_Simulation
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty pmdco:composed_of ;
                                                         owl:someValuesFrom [ owl:intersectionOf ( pmdco:Datensatz
                                                                                                   [ rdf:type owl:Restriction ;
                                                                                                     owl:onProperty pmdco:characteristic ;
                                                                                                     owl:someValuesFrom chips:Interatomic_Potential
                                                                                                   ]
                                                                                                 ) ;
                                                                              rdf:type owl:Class
                                                                            ]
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty pmdco:output_of ;
                                                         owl:someValuesFrom chips:Grand_Challenge_4
                                                       ] ;
                                       rdfs:comment "https://doi.org/10.18434/m37"^^xsd:anyURI ,
                                                    "https://www.ctcms.nist.gov/potentials/"^^xsd:anyURI ;
                                       rdfs:label "Interatomic Potential Repository"@en ;
                                       skos:definition "Interatomic Potential Repository is a curated online database that archives and distributes validated interatomic potential parameter sets for use in molecular dynamics and atomistic simulations."@en ;
                                       pmdco:abbreviation "IPR" ;
                                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Interconnect
chips:Interconnect rdf:type owl:Class ;
                   rdfs:subClassOf chips:Engineered_Structure ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty prov:wasUsedBy ;
                                     owl:someValuesFrom chips:Grand_Challenge_2
                                   ] ;
                   rdfs:label "Interconnect"@en ;
                   skos:definition "An interconnect is a conductive structure in an integrated circuit that electrically connects different devices or circuit elements, typically composed of metal lines and vias embedded in a dielectric material."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Interface
chips:Interface rdf:type owl:Class ;
                rdfs:subClassOf chips:Defect ,
                                chips:Engineered_Structure ,
                                [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                         owl:onProperty prov:wasUsedBy ;
                                                         owl:someValuesFrom chips:Grand_Challenge_4
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty pmdco:characteristic ;
                                                         owl:someValuesFrom chips:State_Variable
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty prov:wasUsedBy ;
                                  owl:someValuesFrom [ rdf:type owl:Class ;
                                                       owl:unionOf ( chips:Grand_Challenge_1
                                                                     chips:Grand_Challenge_2
                                                                   )
                                                     ]
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty chips:measuredBy ;
                                  owl:someValuesFrom [ rdf:type owl:Class ;
                                                       owl:unionOf ( chips:Computational_Process
                                                                     pmdco:Messprozess
                                                                   )
                                                     ]
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty pmdco:characteristic ;
                                  owl:someValuesFrom <https://w3id.org/CHIPS/metrology-ontology/2D>
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty pmdco:relates_to ;
                                  owl:someValuesFrom pmdco:Metadaten
                                ] ;
                rdfs:label "Interface"@en ;
                skos:definition "An interface is a two-dimensional boundary region between two distinct materials or phases in a device or sample, where discontinuities in composition, structure, or electrical potential govern device behavior."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Interfacial_Thermal_Conductance
chips:Interfacial_Thermal_Conductance rdf:type owl:Class ;
                                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                                            owl:onProperty chips:isMathematicalInverseOf ;
                                                            owl:someValuesFrom chips:Interfacial_Thermal_Resistance
                                                          ] ;
                                      rdfs:subClassOf chips:Thermal_Conductance ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty prov:wasDerivedFrom ;
                                                        owl:someValuesFrom chips:Interface
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty pmdco:output_of ;
                                                        owl:someValuesFrom chips:Derived_Process
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty pmdco:output_of ;
                                                        owl:someValuesFrom chips:Grand_Challenge_3
                                                      ] ;
                                      rdfs:label "Interfacial Thermal Conductance"@en ;
                                      skos:definition "Interfacial thermal conductance is the thermal conductance per unit area at the interface between two dissimilar materials, quantifying the ability of the interface to conduct heat across it."@en ;
                                      pmdco:definitionSource "claude-sonnet-4-6"@en ;
                                      pmdco:symbol "G" .


###  https://w3id.org/CHIPS/metrology-ontology/Interfacial_Thermal_Resistance
chips:Interfacial_Thermal_Resistance rdf:type owl:Class ;
                                     owl:equivalentClass [ rdf:type owl:Restriction ;
                                                           owl:onProperty chips:isMathematicalInverseOf ;
                                                           owl:someValuesFrom chips:Interfacial_Thermal_Conductance
                                                         ] ;
                                     rdfs:subClassOf chips:Electric_Property ,
                                                     chips:Thermal_Resistance ,
                                                     pmdco:Materialeigenschaft ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty chips:calculatedBy ;
                                                       owl:someValuesFrom [ owl:intersectionOf ( chips:Computational_Process
                                                                                                 chips:Grand_Challenge_4
                                                                                               ) ;
                                                                            rdf:type owl:Class
                                                                          ]
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty pmdco:characteristic ;
                                                       owl:someValuesFrom <https://w3id.org/CHIPS/metrology-ontology/2D>
                                                     ] ;
                                     rdfs:label "Interfacial Thermal Resistance"@en ;
                                     skos:altLabel "Kapitza Resistance"@en ;
                                     skos:definition "Interfacial thermal resistance (Kapitza resistance) is the thermal resistance per unit area at an interface between two dissimilar materials, inversely related to interfacial thermal conductance."@en ;
                                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Interference
chips:Interference rdf:type owl:Class ;
                   rdfs:subClassOf mo:Physikalischer_Prozess ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty prov:informed ;
                                     owl:someValuesFrom chips:Interferometric_Imaging
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty prov:informed ;
                                     owl:someValuesFrom chips:Interferometry
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty prov:wasAssociatedWith ;
                                     owl:someValuesFrom chips:Interferometer
                                   ] ;
                   skos:definition "Interference is a physical process in which two or more coherent waves superpose to produce a resultant wave whose amplitude distribution reflects the constructive or destructive combination of the constituent wave phases."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Interferometer
chips:Interferometer rdf:type owl:Class ;
                     rdfs:subClassOf pmdco:Messgert ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty prov:wasAssociateFor ;
                                       owl:someValuesFrom chips:Interferometry
                                     ] ;
                     rdfs:label "Interferometer"@en ;
                     skos:definition "Interferometer is a measurement instrument that uses the interference of coherent electromagnetic waves to measure optical path differences, surface topographies, or refractive indices with high precision."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Interferometric_Imaging
chips:Interferometric_Imaging rdf:type owl:Class ;
                              rdfs:subClassOf chips:Imaging_Process ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty pmdco:output ;
                                                owl:someValuesFrom chips:Coefficient_of_Thermal_Expansion_Map
                                              ] ;
                              rdfs:label "Interferometric Imaging"@en ;
                              skos:definition "Interferometric Imaging is an imaging process that exploits the interference of coherent radiation to encode phase information, enabling measurement of surface topography, refractive index distributions, and internal structure with sub-wavelength sensitivity."@en ;
                              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Interferometric_Light_Microscope
chips:Interferometric_Light_Microscope rdf:type owl:Class ;
                                       rdfs:subClassOf chips:Interferometer ,
                                                       mo:Light_Microscope ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty prov:wasAssociateFor ;
                                                         owl:someValuesFrom chips:Grand_Challenge_5
                                                       ] ;
                                       rdfs:label "Interferometric Light Microscope"@en ;
                                       skos:definition "Interferometric Light Microscope is an optical microscope that uses the interference of coherent light beams to measure surface topography and thin film thickness with sub-nanometer vertical resolution."@en ;
                                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Interferometry
chips:Interferometry rdf:type owl:Class ;
                     rdfs:subClassOf pmdco:Messprozess ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty prov:wasInformedBy ;
                                       owl:someValuesFrom chips:Interference
                                     ] ;
                     rdfs:label "Interferometry"@en ;
                     skos:definition "Interferometry is an optical measurement technique that exploits the superposition of coherent electromagnetic waves to measure displacements, surface topographies, wavelengths, or optical path differences with sub-wavelength precision."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Interlaboratory_Comparison
chips:Interlaboratory_Comparison rdf:type owl:Class ;
                                 rdfs:subClassOf chips:Multiparty_Measuring_Process ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty pmdco:belongsToProject ;
                                                   owl:someValuesFrom chips:Grand_Challenge_6
                                                 ] ;
                                 rdfs:label "Inter-laboratory Comparison"@en ;
                                 skos:altLabel "Inter-laboratory Study" ;
                                 skos:definition "Interlaboratory Comparison is a multiparty measurement process in which the same measurand is measured independently by two or more laboratories using their own equipment and procedures to assess measurement consistency and detect bias."@en ;
                                 pmdco:abbreviation "ILC"@en ;
                                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Intermetallic
chips:Intermetallic rdf:type owl:Class ;
                    rdfs:subClassOf chips:Metal ,
                                    [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                             owl:onProperty prov:wasUsedBy ;
                                                             owl:someValuesFrom chips:Grand_Challenge_5
                                                           ]
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty pmdco:composes ;
                                                             owl:someValuesFrom chips:Superfilling
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty pmdco:characteristic_of ;
                                      owl:someValuesFrom chips:Solder_Joint
                                    ] ;
                    rdfs:label "Intermetallic"@en ;
                    skos:definition "An intermetallic is a compound formed between two or more metals in defined stoichiometric ratios with ordered crystal structures, commonly forming at solder joints in semiconductor packaging."@en ;
                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Internal_Stress
chips:Internal_Stress rdf:type owl:Class ;
                      rdfs:subClassOf pmdco:Spannung ,
