                                                 owl:onProperty prov:wasUsedBy ;
                                                 owl:someValuesFrom chips:Data_Analysis_and_Reduction
                                               ] ;
                               rdfs:label "Data Reduction Algorithm"@en ;
                               skos:definition "Data Reduction Algorithm is a computational algorithm that transforms raw measurement data into a more compact or interpretable form by applying calibration, background subtraction, averaging, or dimensionality reduction."@en ;
                               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Data_Retention
