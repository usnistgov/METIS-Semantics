###  https://w3id.org/CHIPS/metrology-ontology/Bit
chips:Bit rdf:type owl:Class ;
          rdfs:subClassOf chips:Memory ;
          rdfs:label "Bit"@en ;
          skos:definition "Bit is the fundamental unit of digital information, representing one of two possible binary values (0 or 1) stored as a physical state in a memory cell."@en ;
          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Bit_Error_Distribution
chips:Bit_Error_Distribution rdf:type owl:Class ;
                             rdfs:subClassOf chips:Distribution ,
                                             chips:Magnetic_Property ;
                             rdfs:label "Bit Error Distribution"@en ;
                             skos:definition "Bit error distribution is a magnetic property describing the statistical distribution of write or read errors in a magnetic recording system as a function of applied field or switching probability."@en ;
                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Bit_Error_Rate
chips:Bit_Error_Rate rdf:type owl:Class ;
                     rdfs:subClassOf chips:Magnetic_Property ;
                     rdfs:label "Bit Error Rate"@en ;
                     skos:definition "Bit error rate is a magnetic property quantifying the fraction of bits incorrectly written to or read from a magnetic storage medium, used as a key figure of merit for data storage reliability."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Blur
chips:Blur rdf:type owl:Class ;
           rdfs:subClassOf chips:Optic_System_Parameter ;
           rdfs:label "Blur"@en ;
           skos:definition "Blur is an optical system parameter quantifying the loss of spatial resolution and sharpness in an image caused by aberrations, diffraction, defocus, or detector limitations."@en ;
           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Boiling_Point
chips:Boiling_Point rdf:type owl:Class ;
                    rdfs:subClassOf pmdco:Thermisch ;
                    rdfs:label "Boiling Point"@en ;
                    skos:definition "Boiling point is the temperature at which the vapor pressure of a liquid equals the surrounding atmospheric pressure, at which the liquid undergoes a phase transition to vapor."@en ;
                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Bond
chips:Bond rdf:type owl:Class ;
           rdfs:subClassOf chips:Engineered_Structure ;
           rdfs:label "Bond"@en ;
           skos:definition "A bond is a structural and electrical connection element used in semiconductor packaging to join components, including wire bonds, solder bumps, and direct bonds."@en ;
           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Bond_Material
chips:Bond_Material rdf:type owl:Class ;
                    rdfs:subClassOf pmdco:Engineered_Material ;
                    rdfs:label "Bond Material"@en ;
                    skos:definition "A bond material is a material used to mechanically or electrically join two or more components, including solders, adhesives, and intermetallics used in semiconductor packaging."@en ;
                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Bond_Strength
chips:Bond_Strength rdf:type owl:Class ;
                    rdfs:subClassOf chips:Physical_Property ,
                                    [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                             owl:onProperty pmdco:output_of ;
                                                             owl:someValuesFrom pmdco:Analysing_Process
                                                           ]
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty pmdco:relates_to ;
                                                             owl:someValuesFrom [ owl:intersectionOf ( pmdco:Kraft
                                                                                                       mo:Energie
                                                                                                     ) ;
                                                                                  rdf:type owl:Class
                                                                                ]
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty pmdco:output_of ;
                                      owl:someValuesFrom chips:Grand_Challenge_3
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty pmdco:relates_to ;
                                      owl:someValuesFrom chips:Mechanical_Property
                                    ] ;
                    rdfs:label "Bond Strength"@en ;
                    skos:definition "Bond strength is a physical property that quantifies the force per unit area required to separate two bonded surfaces, characterizing adhesion quality in semiconductor packaging and thin-film interfaces."@en ;
                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Bonder
chips:Bonder rdf:type owl:Class ;
             rdfs:subClassOf chips:Packaging_Instrument ;
             rdfs:label "Bonder"@en ;
             skos:definition "Bonder is a packaging instrument that forms electrical and mechanical connections between a semiconductor die and its package or substrate using wire bonding, flip-chip, or thermo-compression bonding."@en ;
             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Bonding
chips:Bonding rdf:type owl:Class ;
              rdfs:subClassOf chips:Backendofline_Process ;
              rdfs:label "Bonding"@en ;
              skos:definition "Bonding is a back-end-of-line semiconductor process that mechanically and electrically joins two or more chips, wafers, or substrates together using direct bonding, adhesive bonding, or solder interconnects."@en ;
              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Boulder_Microfab
chips:Boulder_Microfab rdf:type owl:Class ;
                       rdfs:subClassOf chips:Fabrication_Facility ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty prov:actedOnBehalfOf ;
                                         owl:someValuesFrom chips:National_Institute_of_Standards_and_Technology
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty prov:wasAssociateFor ;
                                         owl:someValuesFrom [ rdf:type owl:Class ;
                                                              owl:unionOf ( chips:Grand_Challenge_1
                                                                            chips:Grand_Challenge_2
                                                                            chips:Grand_Challenge_3
                                                                            chips:Grand_Challenge_4
                                                                          )
                                                            ]
                                       ] ;
                       rdfs:label "Boulder Microfab"@en ;
                       skos:definition "Boulder Microfab is a NIST-operated nanofabrication facility in Boulder, Colorado, that provides micro- and nanofabrication services and tools for research in MEMS, photonics, and semiconductor devices."@en ;
                       pmdco:abbreviation "BMF"@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Boundary_Condition
chips:Boundary_Condition rdf:type owl:Class ;
                         rdfs:subClassOf chips:Mathematical_Concept ,
                                         chips:Spatial_Concept ;
                         rdfs:label "Boundary Condition"@en ;
                         skos:definition "A boundary condition is a mathematical constraint applied at the boundary of a domain in a partial differential equation or simulation, defining the physical conditions at the edge of the modeled region."@en ;
                         pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Boundary_Scattering
chips:Boundary_Scattering rdf:type owl:Class ;
                          rdfs:subClassOf pmdco:Thermisch ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty prov:hadDerivation ;
                                            owl:someValuesFrom chips:Defect
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty chips:calculatedBy ;
                                            owl:someValuesFrom chips:Computational_Process
                                          ] ;
                          rdfs:label "Boundary Scattering"@en ;
                          skos:definition "Boundary scattering is the thermal resistance mechanism arising from phonon scattering at grain boundaries, interfaces, or sample surfaces, becoming dominant when feature sizes approach the phonon mean free path."@en ;
                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Brillion_Light_Scattering_Spectrometer
chips:Brillion_Light_Scattering_Spectrometer rdf:type owl:Class ;
                                             rdfs:subClassOf mo:Spektrometer ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty prov:generated ;
                                                               owl:someValuesFrom chips:Brillouin_Light_Scattering_Data
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty prov:wasAssociateFor ;
                                                               owl:someValuesFrom chips:Brillouin_Light_Scattering
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty pmdco:relates_to ;
                                                               owl:someValuesFrom chips:Brillouin_Light_Scattering_and_Low_Frequency_Raman_Microscope
                                                             ] ;
                                             rdfs:label "Brillion Light Scattering Spectrometer"@en ;
                                             skos:definition "Brillouin Light Scattering Spectrometer is a high-resolution optical spectrometer that uses a multi-pass Fabry-Perot interferometer to resolve the small frequency shifts of light inelastically scattered by acoustic phonons or magnons in a material."@en ;
                                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Brillouin_Light_Scattering
chips:Brillouin_Light_Scattering rdf:type owl:Class ;
                                 rdfs:subClassOf chips:Optical_Spectroscopy ,
                                                 chips:Scattering ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty prov:used ;
                                                   owl:someValuesFrom chips:Microwave
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty prov:wasAssociatedWith ;
                                                   owl:someValuesFrom chips:Brillion_Light_Scattering_Spectrometer
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty prov:wasAssociatedWith ;
                                                   owl:someValuesFrom chips:Brillouin_Light_Scattering_and_Low_Frequency_Raman_Microscope
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty chips:measured ;
                                                   owl:someValuesFrom chips:Viscoelastic_Property
                                                 ] ;
                                 rdfs:label "Brillouin Light Scattering"@en ;
                                 skos:definition "Brillouin Light Scattering is an optical spectroscopy technique that measures the inelastic scattering of light from thermally excited acoustic phonons or magnons in a material to determine elastic constants, sound velocities, and magnetic properties with high spectral resolution."@en ;
                                 pmdco:abbreviation "BLS"@en ;
                                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Brillouin_Light_Scattering_Data
chips:Brillouin_Light_Scattering_Data rdf:type owl:Class ;
                                      rdfs:subClassOf chips:Spectrum ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty prov:wasGeneratedBy ;
                                                        owl:someValuesFrom chips:Brillouin_Light_Scattering
                                                      ] ;
                                      rdfs:label "Brillouin Light Scattering Data"@en ;
                                      skos:definition "Brillouin light scattering data is a spectrum of scattered light intensity as a function of frequency shift from acoustic phonons, used to measure elastic constants and magnon dispersion."@en ;
                                      pmdco:abbreviation "BLS Data"@en ;
                                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Brillouin_Light_Scattering_and_Low_Frequency_Raman_Microscope
chips:Brillouin_Light_Scattering_and_Low_Frequency_Raman_Microscope rdf:type owl:Class ;
                                                                    rdfs:subClassOf mo:Optisches_Mikroskop ,
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty prov:wasAssociateFor ;
                                                                                      owl:someValuesFrom chips:Grand_Challenge_3
                                                                                    ] ,
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty prov:wasAssociateFor ;
                                                                                      owl:someValuesFrom [ owl:intersectionOf ( chips:Brillouin_Light_Scattering
                                                                                                                                chips:Raman_Spectroscopy
                                                                                                                              ) ;
                                                                                                           rdf:type owl:Class
                                                                                                         ]
                                                                                    ] ;
                                                                    rdfs:label "Brillouin Light Scattering and Low Frequency Raman Microscope"@en ;
                                                                    skos:definition "Brillouin Light Scattering and Low-Frequency Raman Microscope is an optical microscope instrument that combines Brillouin and low-frequency Raman spectroscopy to measure acoustic phonon and magnon frequencies for mapping elastic, magnetic, and thermal properties at the micrometer scale."@en ;
                                                                    pmdco:abbreviation "BLS-LFR Microscope" ;
                                                                    pmdco:definitionSource "claude-sonnet-4-6"@en .


