                                  owl:onProperty pmdco:hasFunction ;
                                  owl:someValuesFrom chips:Specimen_Preparation_Process
                                ] ;
                rdfs:label "Sintering"@en ;
                skos:definition "Sintering is a heat treatment process in which compacted powder particles are heated below the melting point to bond them through atomic diffusion, increasing density and mechanical strength."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


