pmdco:Startzeit rdf:type owl:Class ;
                rdfs:subClassOf pmdco:Zeit ;
                rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                rdfs:label "Start Time"@en ,
                           "Startzeit"@de ;
                skos:definition "The date and time when a plan/recipe or process is executed."@en .


###  https://w3id.org/pmd/co/Steifigkeit
pmdco:Steifigkeit rdf:type owl:Class ;
                  rdfs:subClassOf chips:Mechanical_Property ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty prov:wasGeneratedBy ;
                                    owl:someValuesFrom chips:Derived_Process
                                  ] ;
                  rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                  rdfs:label "Steifigkeit"@de ,
                             "Stiffness"@en ;
                  skos:definition "Die Steifigkeit ist das Maß, bis zu dem ein Objekt einer Verformung als Reaktion auf eine einwirkende Kraft widersteht."@de ,
                                  "Stiffness is the extent to which an object resists deformation in response to an applied force."@en .


###  https://w3id.org/pmd/co/Temperatur
pmdco:Temperatur rdf:type owl:Class ;
                 rdfs:subClassOf chips:Processing_Parameter ,
                                 chips:Quantity_Kind ,
                                 [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                          owl:onProperty prov:wasUsedBy ;
                                                          owl:someValuesFrom [ owl:intersectionOf ( chips:Cavity_Ringdown_Spectroscopy
                                                                                                    chips:Grand_Challenge_1
                                                                                                  ) ;
                                                                               rdf:type owl:Class
                                                                             ]
                                                        ]
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty pmdco:characteristic ;
                                                          owl:someValuesFrom chips:Independent_Variable
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ,
                                 [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                          owl:onProperty prov:wasUsedBy ;
                                                          owl:someValuesFrom [ rdf:type owl:Class ;
                                                                               owl:unionOf ( chips:Grand_Challenge_1
                                                                                             chips:Grand_Challenge_3
                                                                                             chips:Grand_Challenge_4
                                                                                             chips:Grand_Challenge_6
                                                                                           )
                                                                             ]
                                                        ]
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty pmdco:characteristic ;
                                                          owl:someValuesFrom chips:State_Variable
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty prov:influenced ;
                                   owl:someValuesFrom pmdco:Thermisch
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty prov:influenced ;
                                   owl:someValuesFrom [ rdf:type owl:Class ;
                                                        owl:unionOf ( chips:Lattice_Parameter
                                                                      chips:Molar_Volume
                                                                      chips:Thermal_Conductance
                                                                      chips:Thermal_Expansion
                                                                      chips:Thermoreflectance_Process
                                                                      pmdco:Messprozess
                                                                    )
                                                      ]
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty pmdco:characteristic ;
                                   owl:someValuesFrom [ rdf:type owl:Class ;
                                                        owl:unionOf ( chips:Independent_Variable
                                                                      chips:State_Variable
                                                                    )
                                                      ]
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty pmdco:characteristic_of ;
                                   owl:someValuesFrom chips:Variable
                                 ] ;
                 rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                 rdfs:label "Temperatur"@de ,
                            "Temperature"@en ;
                 skos:definition "The degree of hotness or coldness measured on a definite scale."@en ;
                 pmdco:definitionSource "“Temperature.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/temperature. Accessed 25 Nov. 2022."@en .


###  https://w3id.org/pmd/co/Temperaturmesswerkzeug
pmdco:Temperaturmesswerkzeug rdf:type owl:Class ;
                             rdfs:subClassOf chips:Thermal_Property_Measurement_Instrument ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty chips:measured ;
                                               owl:someValuesFrom pmdco:Temperatur
                                             ] ;
                             rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                             rdfs:label "Temperature Measuring Device"@en ,
                                        "Temperaturmesswerkzeug"@de ;
                             skos:definition "Diese Entität beschreibt allgemein jedes Werkzeug, das zur Messung der Temperatur eines materiellen Objekts oder der Umgebung verwendet wird, z. B. ein Thermoelement und Thermometer."@de ,
                                             "This entity generically describes any tool that is used for the measurement of the temperature of a tangible object or the environment, e.g., a thermocouple and thermometers."@en .


###  https://w3id.org/pmd/co/Temperaturnderungsprozess
pmdco:Temperaturnderungsprozess rdf:type owl:Class ;
                                rdfs:subClassOf chips:Timedependent_Process ,
                                                pmdco:Konditionierungsprozess ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty prov:wasAssociatedWith ;
                                                  owl:someValuesFrom pmdco:Temperaturnderungswerkzeug
                                                ] ;
                                rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                                rdfs:label "Temperature Changing Process"@en ,
                                           "Temperaturänderungsprozess"@de ;
                                skos:definition "A conditioning process which is run to increase or decrease the temperature of an object or a space. Usually, this involves heating or cooling devices such as furnaces or cooling media."@en .


###  https://w3id.org/pmd/co/Temperaturnderungswerkzeug
pmdco:Temperaturnderungswerkzeug rdf:type owl:Class ;
                                 rdfs:subClassOf chips:Temperature_Treatment_Node ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty prov:wasAssociateFor ;
                                                   owl:someValuesFrom pmdco:Temperaturnderungsprozess
                                                 ] ;
                                 rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                                 rdfs:label "Temperature Change Device"@en ,
                                            "Temperaturänderungswerkzeug"@de ;
                                 skos:definition "Diese Entität beschreibt allgemein jedes Werkzeug, das zur Änderung und Einstellung der Temperatur eines materiellen Objekts oder der Umgebung verwendet wird, z. B. einen Ofen und Kühlmittel."@de ,
                                                 "This entity generically describes any tool that is used for the alteration and adjustment of the temperature of a tangible object or the environment, e.g., a furnace and cooling media."@en .


###  https://w3id.org/pmd/co/Test_Piece
pmdco:Test_Piece rdf:type owl:Class ;
                 rdfs:subClassOf pmdco:Probe ;
                 rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                 rdfs:label "Prüfkörper"@de ,
                            "Test Piece"@en ;
                 skos:definition "Part of a sample with specified dimensions, machined or un-machined, brought to a required condition for submission to a given test."@en ,
                                 "Teil einer Probe mit bestimmten Dimensionen, bearbeitet oder unbearbeitet, der in einen erforderlichen Zustand gebracht wird, um einer bestimmten Prüfung unterzogen zu werden."@de ;
                 pmdco:definitionSource "EN 10021:2006-12 (European standardization committee: CEN/TC 459/SC 12/WG 4)"@en .


###  https://w3id.org/pmd/co/Test_Piece_Classification
pmdco:Test_Piece_Classification rdf:type owl:Class ;
                                rdfs:subClassOf pmdco:Test_Piece_Info ;
                                rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                                rdfs:label "Prüfkörperklassifizierung"@de ,
                                           "Test Piece Classification"@en ;
                                skos:definition "Diese Eigenschaft wird verwendet, um Informationen über einen Prüfkörper bezüglich seiner Einordnung gemäß entsprechender Normen zu liefern."@de ,
                                                "This property is used to provide information on a test piece concerning its graduation in accordance with corresponding standards."@en .


###  https://w3id.org/pmd/co/Test_Piece_Info
pmdco:Test_Piece_Info rdf:type owl:Class ;
                      rdfs:subClassOf pmdco:Metadaten ;
                      rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                      rdfs:label "Prüfkörperinformationen"@de ,
                                 "Test Piece Info"@en ;
                      skos:definition "Diese Eigenschaft wird verwendet, um Informationen über einen Prüfkörper zu liefern, wie z. B. seine geometrische Form, seine Klassifizierung und andere Parameter, einschließlich von Spezifikationen und Nennwerte. Die Informationen werden in Bezug auf die entsprechenden Normen bereitgestellt."@de ,
                                      "This property is used to provide information on a test piece such as its geometric shape, classification, and other parameters, including specifications and nominal values. The information is provided with respect to corresponding standards."@en .


###  https://w3id.org/pmd/co/Test_Piece_Name
