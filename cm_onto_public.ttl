###  https://w3id.org/CHIPS/metrology-ontology/CALPHAD_Database
chips:CALPHAD_Database rdf:type owl:Class ;
                       rdfs:subClassOf chips:Database ;
                       rdfs:label "CALPHAD Database"@en ;
                       skos:definition "CALPHAD Database is a thermodynamic database containing assessed Gibbs energy functions for phases in multi-component material systems, used as input for CALPHAD-based phase diagram calculations and materials design."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/CALPHAD_Method
chips:CALPHAD_Method rdf:type owl:Class ;
                     rdfs:subClassOf chips:Empirical_Model ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty prov:wasAttributedTo ;
                                       owl:someValuesFrom chips:CALPHAD_Software
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty prov:wasUsedBy ;
                                       owl:someValuesFrom chips:CALPHAD_Modeling
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty pmdco:characteristic ;
                                       owl:someValuesFrom chips:Multiscale_Simulation_Software
                                     ] ;
                     rdfs:label "CALPHAD Method"@en ;
                     skos:definition "The CALPHAD method is an empirical model approach that calculates phase diagrams and thermodynamic properties of multicomponent systems by fitting Gibbs energy functions to assessed experimental and computational data."@en ;
                     pmdco:definitionSource "claude-opus-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/CALPHAD_Modeling
chips:CALPHAD_Modeling rdf:type owl:Class ;
                       rdfs:subClassOf chips:Thermodynamic_Modeling ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty prov:generated ;
                                         owl:someValuesFrom chips:CALPHAD_Database
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty prov:generated ;
                                         owl:someValuesFrom chips:Code
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty prov:used ;
                                         owl:someValuesFrom chips:CALPHAD_Method
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty pmdco:belongsToProject ;
                                         owl:someValuesFrom chips:Grand_Challenge_6
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty pmdco:belongsToProject ;
                                         owl:someValuesFrom chips:Grand_Challenge_7
                                       ] ;
                       dcterms:bibliographicCitation "https://calphad.org/"^^xsd:anyURI ;
                       rdfs:label "CALPHAD Modeling"@en ;
                       skos:definition "CALPHAD (Calculation of Phase Diagrams) is a computational modeling process that assesses the thermodynamic properties of multi-component alloy systems by combining assessed Gibbs energy functions to calculate phase diagrams and equilibria."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/CALPHAD_Software
chips:CALPHAD_Software rdf:type owl:Class ;
                       rdfs:subClassOf chips:Phase_Diagram_Software ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty prov:influenced ;
                                         owl:someValuesFrom chips:CALPHAD_Method
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty prov:wasAssociateFor ;
                                         owl:someValuesFrom chips:CALPHAD_Modeling
                                       ] ;
                       rdfs:label "CALPHAD Software"@en ;
                       skos:definition "CALPHAD software is a phase diagram software tool that implements the CALPHAD method to compute thermodynamic equilibria, phase diagrams, and transformation paths for multicomponent alloy and materials systems."@en ;
                       pmdco:definitionSource "claude-opus-4-6"@en .


