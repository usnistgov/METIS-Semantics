                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty prov:wasAssociatedWith ;
                                           owl:someValuesFrom chips:Sputtering_Tool
                                         ] ;
                         rdfs:label "Sputtering Process"@en ;
                         skos:definition "Sputtering Process is a physical vapor deposition technique in which energetic ions from a plasma bombard a target material, ejecting atoms that travel to a substrate surface and deposit as a thin film."@en ;
                         pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Sputtering_Tool
chips:Sputtering_Tool rdf:type owl:Class ;
                      rdfs:subClassOf chips:Physical_Vapor_Deposition_Tool ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty prov:wasAssociateFor ;
