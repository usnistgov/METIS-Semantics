                              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Forcedisplacement_Curve
chips:Forcedisplacement_Curve rdf:type owl:Class ;
                              rdfs:subClassOf chips:Plot ,
                                              [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                       owl:onProperty pmdco:input_of ;
                                                                       owl:someValuesFrom chips:Finite_Element_Analysis
                                                                     ]
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty pmdco:relates_to ;
                                                                       owl:someValuesFrom chips:Grand_Challenge_3
                                                                     ]
                                                                   ) ;
                                                rdf:type owl:Class
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty pmdco:characteristic ;
                                                owl:someValuesFrom pmdco:Messwert
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty pmdco:output_of ;
                                                owl:someValuesFrom [ owl:intersectionOf ( chips:Grand_Challenge_3
                                                                                          chips:Microelectromechanical_System
                                                                                        ) ;
                                                                     rdf:type owl:Class
                                                                   ]
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty pmdco:relates_to ;
                                                owl:someValuesFrom chips:Mechanical_Property
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty pmdco:relates_to ;
                                                owl:someValuesFrom pmdco:Mechanischer_Testprozess
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty pmdco:relates_to ;
                                                owl:someValuesFrom pmdco:Messprozess
                                              ] ;
                              rdfs:label "Force-displacement Curve"@en ;
                              skos:definition "Force-Displacement Curve is a graphical representation of the relationship between applied force and resulting displacement measured during mechanical loading of a material or device, used to extract elastic modulus, hardness, and adhesion energy."@en ;
                              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Formfactor
chips:Formfactor rdf:type owl:Class ;
                 rdfs:subClassOf pmdco:Hersteller ;
                 rdfs:label "Formfactor"@en ;
                 skos:definition "FormFactor is a semiconductor test equipment company that designs and manufactures probe cards, analytical probes, and wafer-level test systems used for electrical characterization of semiconductor devices."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Fortran
chips:Fortran rdf:type owl:Class ;
              rdfs:subClassOf chips:Programming_Language ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty prov:wasUsedBy ;
                                owl:someValuesFrom chips:Grand_Challenge_1
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty prov:wasUsedBy ;
                                owl:someValuesFrom chips:Grand_Challenge_4
                              ] ;
              rdfs:label "Fortran"@en ;
              skos:definition "Fortran is a compiled, statically typed programming language designed for numerical and scientific computation, notable for its array processing capabilities and long history in computational physics and engineering simulation."@en ;
              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Forum_of_Incident_Response_and_Security_Teams
chips:Forum_of_Incident_Response_and_Security_Teams rdf:type owl:Class ;
                                                    rdfs:subClassOf chips:Standards_Organization ;
                                                    rdfs:comment "https://www.first.org/"^^xsd:anyURI ;
                                                    rdfs:label "Forum of Incident Response and Security Teams"@en ;
                                                    skos:definition "The Forum of Incident Response and Security Teams (FIRST) is an international organization that brings together computer security incident response teams from government, commercial, and educational organizations to share information about vulnerabilities and security incidents."@en ;
                                                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Four_Point_Probe
chips:Four_Point_Probe rdf:type owl:Class ;
                       rdfs:subClassOf chips:Probe_Station ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty prov:wasAssociateFor ;
                                         owl:someValuesFrom chips:Four_Point_Probe_Measurement
                                       ] ;
                       rdfs:label "Four Point Probe"@en ;
                       skos:definition "Four-Point Probe is an electrical measurement instrument with four collinear contact tips used to determine sheet resistance or resistivity of a conducting thin film or semiconductor wafer without contact resistance errors."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Four_Point_Probe_Measurement
chips:Four_Point_Probe_Measurement rdf:type owl:Class ;
                                   rdfs:subClassOf chips:Electromagnetic_Measurement_Process ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty prov:wasAssociatedWith ;
                                                     owl:someValuesFrom chips:Four_Point_Probe
                                                   ] ;
                                   rdfs:label "Four Point Probe Measurement"@en ;
                                   skos:definition "Four-Point Probe Measurement is an electrical measurement process that passes current through an outer pair of probes while measuring voltage with an inner pair, eliminating contact resistance to accurately determine sheet resistance or resistivity."@en ;
                                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Fourier_Analysis
chips:Fourier_Analysis rdf:type owl:Class ;
                       rdfs:subClassOf chips:Mathematical_Analysis ;
                       rdfs:label "Fourier Analysis"@en ;
                       skos:definition "Fourier Analysis is a mathematical analysis method that decomposes a function or signal into a sum or integral of sinusoidal components, revealing its frequency content and enabling convolution, filtering, and spectral characterization."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Fourier_Transform_Infrared_Spectrometer
chips:Fourier_Transform_Infrared_Spectrometer rdf:type owl:Class ;
                                              rdfs:subClassOf mo:Spektrometer ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty prov:wasAssociateFor ;
                                                                owl:someValuesFrom chips:Fourier_Analysis
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty prov:wasAssociateFor ;
                                                                owl:someValuesFrom mo:FourierTransformationsInfrarotspektroskopie
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty prov:wasAssociateFor ;
                                                                owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                     owl:unionOf ( chips:Grand_Challenge_2
                                                                                                   chips:Grand_Challenge_5
                                                                                                 )
                                                                                   ]
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty chips:measured ;
                                                                owl:someValuesFrom [ owl:intersectionOf ( [ rdf:type owl:Class ;
                                                                                                            owl:unionOf ( chips:Capacitance
                                                                                                                          chips:Impedence
                                                                                                                        )
                                                                                                          ]
                                                                                                          [ rdf:type owl:Restriction ;
                                                                                                            owl:onProperty pmdco:characteristic_of ;
                                                                                                            owl:someValuesFrom chips:Interface
                                                                                                          ]
                                                                                                        ) ;
                                                                                     rdf:type owl:Class
                                                                                   ]
                                                              ] ;
                                              rdfs:label "Fourier Transform Infrared Spectrometer"@en ;
                                              skos:definition "Fourier Transform Infrared Spectrometer (FTIR) is an optical spectrometer that records an interferogram by scanning the path length difference in a Michelson interferometer and computes the infrared absorption spectrum by Fourier transformation."@en ;
                                              pmdco:abbreviation "FTIR Spectrometer"@en ;
                                              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Fourier_Transform_Spectroscopy
chips:Fourier_Transform_Spectroscopy rdf:type owl:Class ;
                                     rdfs:subClassOf chips:Optical_Spectroscopy ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty prov:wasInformedBy ;
                                                       owl:someValuesFrom chips:Fourier_Analysis
                                                     ] ;
                                     rdfs:label "Fourier Transform Spectroscopy"@en ;
                                     skos:definition "Fourier Transform Spectroscopy is an optical spectroscopy technique that records an interferogram as a function of mirror displacement and computes the spectrum by Fourier transformation, providing high throughput and wavenumber accuracy across a broad spectral range."@en ;
                                     pmdco:abbreviation "FTS"@en ;
                                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Fracture_Toughness
chips:Fracture_Toughness rdf:type owl:Class ;
                         rdfs:subClassOf chips:Mechanical_Property ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty prov:wasGeneratedBy ;
                                           owl:someValuesFrom chips:Derived_Process
                                         ] ;
                         rdfs:label "Fracture Toughness"@en ;
                         skos:definition "Fracture Toughness is a material property that quantifies the critical stress intensity factor at which a pre-existing crack begins to propagate catastrophically, serving as a measure of resistance to brittle failure."@en ;
                         pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Frame
chips:Frame rdf:type owl:Class ;
            rdfs:subClassOf chips:Detection_Property ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty pmdco:characteristic ;
                              owl:someValuesFrom mo:Temporal_Resolution
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty pmdco:characteristic_of ;
                              owl:someValuesFrom chips:Camera
                            ] ;
            rdfs:label "Frame"@en ;
            skos:definition "A frame is a detection property that represents a single image or data array captured by a camera or area detector in one acquisition interval, constituting the basic unit of a time-resolved or multi-frame measurement sequence."@en ;
            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Framework
chips:Framework rdf:type owl:Class ;
                rdfs:subClassOf chips:Conceptual_Entity ;
                rdfs:label "Framework"@en ;
                skos:definition "Framework is a design document or conceptual structure that defines the organizing principles, workflows, and interfaces of a system or methodology to guide its consistent implementation."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Free_Radical
chips:Free_Radical rdf:type owl:Class ;
                   rdfs:subClassOf obo:Chemical_Entity ;
                   rdfs:label "Free Radical"@en ;
                   skos:definition "A free radical is a chemical species with one or more unpaired electrons, making it highly reactive, generated in plasma processes during semiconductor etching and deposition."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Frequency
chips:Frequency rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty chips:isInverselyProportionalTo ;
                                      owl:someValuesFrom chips:Wavelength
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty chips:isMathematicalInverseOf ;
                                      owl:someValuesFrom chips:Period
                                    ] ;
                rdfs:subClassOf chips:Temporal_Concept ,
                                chips:Wave_Characteristic ,
                                [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                         owl:onProperty prov:wasUsedBy ;
                                                         owl:someValuesFrom chips:Grand_Challenge_1
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty prov:wasUsedBy ;
                                                         owl:someValuesFrom [ rdf:type owl:Class ;
                                                                              owl:unionOf ( chips:Cavity_Ringdown_Spectroscopy
                                                                                            chips:Fourier_Transform_Spectroscopy
                                                                                          )
                                                                            ]
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty pmdco:characteristic ;
                                                         owl:someValuesFrom chips:Independent_Variable
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ,
                                [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                         owl:onProperty prov:wasUsedBy ;
                                                         owl:someValuesFrom chips:Grand_Challenge_4
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty pmdco:characteristic ;
                                                         owl:someValuesFrom chips:Independent_Variable
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ,
                                [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                         owl:onProperty prov:wasUsedBy ;
                                                         owl:someValuesFrom chips:Grand_Challenge_4
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty pmdco:characteristic ;
                                                         owl:someValuesFrom chips:Independent_Variable
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty pmdco:characteristic_of ;
                                                         owl:someValuesFrom chips:Electromagnetic_Property
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ,
                                [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                         owl:onProperty chips:calculatedBy ;
                                                         owl:someValuesFrom [ owl:intersectionOf ( chips:Finite_Element_Analysis
                                                                                                   [ rdf:type owl:Restriction ;
                                                                                                     owl:onProperty pmdco:belongsToProject ;
                                                                                                     owl:someValuesFrom chips:Grand_Challenge_3
                                                                                                   ]
                                                                                                 ) ;
                                                                              rdf:type owl:Class
                                                                            ]
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty pmdco:characteristic_of ;
                                                         owl:someValuesFrom chips:Resonance
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty pmdco:characteristic ;
                                  owl:someValuesFrom chips:Measurand
                                ] ;
                rdfs:label "Frequency"@en ;
                skos:definition "Frequency is a physical property describing the number of cycles of a periodic phenomenon per unit time, measured in hertz, relevant to resonators, oscillators, and wave-based measurement techniques."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Frequency_Comb_Spectrometer
chips:Frequency_Comb_Spectrometer rdf:type owl:Class ;
                                  rdfs:subClassOf mo:Spektrometer ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty prov:wasAssociateFor ;
                                                    owl:someValuesFrom chips:Frequency_Comb_Spectroscopy
                                                  ] ;
                                  rdfs:label "Frequency Comb Spectrometer"@en ;
                                  skos:definition "Frequency Comb Spectrometer is an optical spectrometer that uses an optical frequency comb as a broadband, precisely calibrated light source to perform high-resolution spectroscopy across a wide spectral range."@en ;
                                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Frequency_Comb_Spectroscopy
chips:Frequency_Comb_Spectroscopy rdf:type owl:Class ;
                                  rdfs:subClassOf chips:Optical_Spectroscopy ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty prov:wasAssociateFor ;
                                                    owl:someValuesFrom chips:Optical_Frequency_Comb
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty prov:wasAssociatedWith ;
                                                    owl:someValuesFrom chips:Frequency_Comb_Spectrometer
                                                  ] ;
                                  rdfs:label "Frequency Comb Spectroscopy"@en ;
                                  skos:definition "Frequency Comb Spectroscopy is an optical spectroscopy technique that uses an optical frequency comb as a broadband, highly accurate frequency ruler to measure molecular absorption spectra with high resolution and precision."@en ;
                                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Frontendofline_Process
chips:Frontendofline_Process rdf:type owl:Class ;
                             rdfs:subClassOf chips:Semiconductor_Manufacturing_Process ;
                             rdfs:label "Front-end-of-line Process"@en ;
                             skos:definition "Front-End-of-Line (FEOL) Process is a semiconductor manufacturing process sequence that defines and fabricates the active devices—transistors, capacitors, and isolation regions—in and on the semiconductor substrate."@en ;
                             pmdco:abbreviation "FEOL"@en ;
                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Functionalized_Nanoparticle_Trap
chips:Functionalized_Nanoparticle_Trap rdf:type owl:Class ;
                                       rdfs:subClassOf chips:Surface_Capture_and_Preconcentration ;
                                       rdfs:label "Functionalized Nanoparticle Trap"@en ;
                                       skos:definition "Functionalized Nanoparticle Trap is a surface capture device in which nanoparticles bearing reactive surface groups selectively bind and preconcentrate target analytes from a solution or aerosol for subsequent analysis."@en ;
                                       pmdco:abbreviation "FNT"@en ;
                                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/G-factor
chips:G-factor rdf:type owl:Class ;
               rdfs:subClassOf chips:Magnetic_Property ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty chips:isProportionalTo ;
                                 owl:someValuesFrom chips:Gyromagnetic_Ratio
                               ] ;
               rdfs:label "G-factor"@en ;
               skos:definition "The g-factor is a dimensionless magnetic property that characterizes the ratio of a particle's or system's magnetic moment to its angular momentum in units of the Bohr magneton and reduced Planck constant, and is proportional to the gyromagnetic ratio."@en ;
               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/GMW_Associates
chips:GMW_Associates rdf:type owl:Class ;
                     rdfs:subClassOf pmdco:Hersteller ;
                     rdfs:label "GMW Associates"@en ;
                     skos:definition "GMW Associates is a scientific instruments company that supplies electromagnets, magnetic field measurement instruments, and Hall-effect probes for research and industrial magnetic field applications."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Gamma_particle
chips:Gamma_particle rdf:type owl:Class ;
                     rdfs:subClassOf chips:Photon ;
                     rdfs:label "Gamma particle"@en ;
                     skos:definition "A gamma particle (gamma ray) is a high-energy photon emitted by a radioactive nucleus during gamma decay or nuclear reactions, used in gamma-ray spectroscopy and radiation hardness testing."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Gammaray_Spectroscopy
chips:Gammaray_Spectroscopy rdf:type owl:Class ;
                            rdfs:subClassOf mo:Spectroscopy ;
                            rdfs:label "Gamma-ray Spectroscopy"@en ;
                            skos:definition "Gamma-Ray Spectroscopy is a nuclear analytical technique that measures the energy spectrum of gamma rays emitted by radioactive nuclides to identify and quantify radionuclides in a sample."@en ;
                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Gas
chips:Gas rdf:type owl:Class ;
          rdfs:subClassOf chips:Matter ;
          rdfs:label "Gas"@en ;
          skos:definition "A gas is a state of matter in which molecules move freely and fill any container, characterized by low density and high compressibility, including process gases and ambient environments in semiconductor fabrication."@en ;
          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Gas_Chromatography
chips:Gas_Chromatography rdf:type owl:Class ;
                         rdfs:subClassOf chips:Chromatography ;
                         rdfs:label "Gas Chromatography"@en ;
                         skos:definition "Gas Chromatography (GC) is a separation technique in which a vaporized sample is carried by an inert gas through a stationary phase column, separating components based on their differential partitioning between the mobile and stationary phases."@en ;
                         pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Gas_ChromatographyMass_Spectrometry
chips:Gas_ChromatographyMass_Spectrometry rdf:type owl:Class ;
                                          rdfs:subClassOf chips:Chromatography ,
                                                          chips:Mass_Spectrometry ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty pmdco:characteristic ;
                                                            owl:someValuesFrom [ owl:intersectionOf ( chips:Independent_Variable
                                                                                                      [ rdf:type owl:Restriction ;
                                                                                                        owl:onProperty pmdco:characteristic ;
                                                                                                        owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                                                             owl:unionOf ( chips:Pressure
                                                                                                                                           pmdco:Temperatur
                                                                                                                                           [ owl:intersectionOf ( chips:Composition
                                                                                                                                                                  [ rdf:type owl:Restriction ;
                                                                                                                                                                    owl:onProperty pmdco:characteristic_of ;
                                                                                                                                                                    owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                                                                                                                         owl:unionOf ( chips:Liquid
                                                                                                                                                                                                       chips:Material
                                                                                                                                                                                                     )
                                                                                                                                                                                       ]
                                                                                                                                                                  ]
                                                                                                                                                                ) ;
                                                                                                                                             rdf:type owl:Class
                                                                                                                                           ]
                                                                                                                                         )
                                                                                                                           ]
                                                                                                      ]
                                                                                                    ) ;
                                                                                 rdf:type owl:Class
                                                                               ]
                                                          ] ;
                                          rdfs:label "Gas Chromatography–Mass Spectrometry"@en ;
                                          skos:definition "Gas Chromatography-Mass Spectrometry (GC-MS) is a hyphenated analytical technique that combines gas chromatographic separation with mass spectrometric detection to identify and quantify volatile and semi-volatile compounds in complex mixtures."@en ;
                                          pmdco:abbreviation "GC-MS" ;
                                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Gas_Chromatography_Instrument
chips:Gas_Chromatography_Instrument rdf:type owl:Class ;
                                    rdfs:subClassOf chips:Chromatography_Instrument ;
                                    rdfs:label "Gas Chromatography Instrument"@en ;
                                    skos:definition "Gas Chromatography Instrument is an analytical instrument that separates the components of a vaporized mixture by passing them with a carrier gas through a heated column containing a stationary phase, detecting eluted components by flame ionization or other detectors."@en ;
                                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Gas_Chromatography_Tandem_Mass_Spectrometry
chips:Gas_Chromatography_Tandem_Mass_Spectrometry rdf:type owl:Class ;
                                                  rdfs:subClassOf chips:Chromatography ,
                                                                  chips:Mass_Spectrometry ;
                                                  rdfs:label "Gas Chromatography Tandem Mass Spectrometry"@en ;
                                                  skos:definition "Gas Chromatography-Tandem Mass Spectrometry (GC-MS/MS) is an analytical technique that couples gas chromatographic separation with two sequential stages of mass spectrometric analysis to achieve enhanced selectivity and sensitivity for trace compound detection."@en ;
                                                  pmdco:abbreviation "GC-MS/MS"@en ;
                                                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Gas_Controller
chips:Gas_Controller rdf:type owl:Class ;
                     rdfs:subClassOf chips:Controller ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty pmdco:relates_to ;
                                       owl:someValuesFrom chips:Gas
                                     ] ;
                     rdfs:label "Gas Controller"@en ;
                     skos:definition "Gas Controller is a hardware device that regulates the flow, pressure, or mixture ratio of gases supplied to a process chamber or instrument."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Gas_Flow_Measurement_Device
chips:Gas_Flow_Measurement_Device rdf:type owl:Class ;
                                  rdfs:subClassOf chips:Mass_Flow_Measurement_Device ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty pmdco:characteristic ;
                                                    owl:someValuesFrom chips:Gas
                                                  ] ;
                                  rdfs:label "Gas Flow Measurement Device"@en ;
                                  skos:definition "Gas Flow Measurement Device is a mass flow measurement instrument that quantifies the volumetric or mass flow rate of a gas stream using thermal, differential pressure, or Coriolis sensing principles."@en ;
                                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Gas_Flow_Meter
chips:Gas_Flow_Meter rdf:type owl:Class ;
                     rdfs:subClassOf chips:Gas_Flow_Measurement_Device ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty prov:wasAssociateFor ;
                                       owl:someValuesFrom chips:Grand_Challenge_1
                                     ] ;
                     rdfs:label "Gas Flow Meter"@en ;
                     skos:definition "Gas Flow Meter is a measurement instrument that quantifies the volumetric or mass flow rate of a gas stream passing through a conduit, using thermal, differential pressure, or ultrasonic sensing principles."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Gas_Regulator
chips:Gas_Regulator rdf:type owl:Class ;
                    rdfs:subClassOf chips:Gas_Controller ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty prov:wasAssociateFor ;
                                      owl:someValuesFrom chips:Grand_Challenge_1
                                    ] ;
                    rdfs:label "Gas Regulator"@en ;
                    skos:definition "Gas Regulator is a hardware device that reduces and stabilizes the pressure of a gas from a high-pressure supply cylinder to a lower, controlled working pressure for delivery to an instrument or process."@en ;
                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Geolocation
chips:Geolocation rdf:type owl:Class ;
