                                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Loss
chips:Loss rdf:type owl:Class ;
           rdfs:subClassOf chips:Instability ;
           rdfs:label "Loss"@en ;
           skos:definition "Loss is a measure of signal attenuation or energy dissipation in a system, expressed as the ratio of output to input power in decibels."@en ;
           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Loss_Angle
chips:Loss_Angle rdf:type owl:Class ;
                 rdfs:subClassOf chips:Dielectric_Loss ;
                 rdfs:label "Loss Angle"@en ;
                 skos:definition "Loss angle is the phase angle between the applied electric field and the resulting polarization in a lossy dielectric, equal to the arctangent of the loss tangent."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Loss_Modulus
chips:Loss_Modulus rdf:type owl:Class ;
                   rdfs:subClassOf chips:Mechanical_Property ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty prov:wasGeneratedBy ;
                                     owl:someValuesFrom chips:Derived_Process
                                   ] ;
                   rdfs:label "Loss Modulus"@en ;
                   skos:definition "Loss Modulus is a viscoelastic material parameter representing the out-of-phase component of the complex dynamic modulus, quantifying the energy dissipated as heat per unit deformation cycle."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Loss_Tangent
chips:Loss_Tangent rdf:type owl:Class ;
                   rdfs:subClassOf chips:Dielectric_Loss ;
                   rdfs:label "Loss Tangent"@en ;
                   skos:definition "Loss tangent is the ratio of the imaginary to the real part of the complex permittivity of a dielectric material, quantifying the fraction of energy dissipated as heat per cycle of the applied field."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Low_Frequency_Raman
chips:Low_Frequency_Raman rdf:type owl:Class ;
                          rdfs:subClassOf chips:Raman_Spectroscopy ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty chips:measured ;
                                            owl:someValuesFrom [ owl:intersectionOf ( chips:Toughness
                                                                                      chips:Viscoelastic_Property
                                                                                    ) ;
                                                                 rdf:type owl:Class
                                                               ]
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty pmdco:relates_to ;
                                            owl:someValuesFrom chips:Brillouin_Light_Scattering_and_Low_Frequency_Raman_Microscope
                                          ] ;
                          rdfs:label "Low Frequency Raman"@en ;
                          skos:definition "Low Frequency Raman is a Raman spectroscopy modality that measures inelastic scattering at small Raman shifts typically below 200 cm⁻¹ to probe low-energy vibrational modes including acoustic phonons, intermolecular vibrations, and lattice dynamics in crystalline and soft matter."@en ;
                          pmdco:abbreviation "LFR"@en ;
                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Lowdose_Imaging
chips:Lowdose_Imaging rdf:type owl:Class ;
                      rdfs:subClassOf chips:Imaging_Process ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty pmdco:subordinate_process ;
                                        owl:someValuesFrom chips:Soft_Xray_Spectroscopy
                                      ] ;
                      rdfs:label "Low-dose Imaging"@en ;
                      skos:definition "Low-dose imaging is an imaging process that minimises the incident electron, photon, or ion fluence on a radiation-sensitive specimen below the damage threshold while preserving sufficient signal for structural analysis, typically using cryo-conditions and dose-efficient detectors."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Lowdose_Imaging_Mode
chips:Lowdose_Imaging_Mode rdf:type owl:Class ;
                           rdfs:subClassOf chips:Soft_Xray_Spectroscopy ;
                           rdfs:label "Low-dose Imaging Mode"@en ;
                           skos:definition "Low-Dose Imaging Mode is an electron microscopy acquisition strategy that minimizes the total electron fluence delivered to a radiation-sensitive specimen by performing focusing and alignment on a sacrificial region adjacent to the area of interest."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


