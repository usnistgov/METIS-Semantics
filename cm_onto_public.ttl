###  https://w3id.org/CHIPS/metrology-ontology/Statistical_Dispersion
chips:Statistical_Dispersion rdf:type owl:Class ;
                             rdfs:subClassOf chips:Statistical_Concept ;
                             rdfs:label "Statistical Dispersion"@en ;
                             skos:definition "Statistical dispersion is a statistical concept that describes the extent to which values in a distribution are spread out from a central tendency, encompassing measures such as variance, standard deviation, and interquartile range."@en ;
                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Steadystate_Thermal_Transmission
chips:Steadystate_Thermal_Transmission rdf:type owl:Class ;
