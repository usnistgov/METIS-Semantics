                                rdfs:subClassOf chips:Electromagnetic_Property ,
                                                chips:Mechanical_Property ;
                                rdfs:label "Piezoelectric Coefficient"@en ;
                                skos:definition "Piezoelectric Coefficient is a tensor quantity relating the mechanical stress or strain in a piezoelectric material to the resulting electric polarization, or conversely the applied electric field to the induced mechanical deformation."@en ;
                                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Pitch
chips:Pitch rdf:type owl:Class ;
            rdfs:subClassOf pmdco:Lnge ;
            rdfs:label "Pitch"@en ;
            skos:definition "Pitch is the center-to-center spacing between adjacent repeating features in a periodic pattern, a critical dimension in semiconductor lithography that determines device packing density."@en ;
            pmdco:definitionSource "claude-sonnet-4-6"@en .


