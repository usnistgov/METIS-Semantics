             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Metrology
chips:Metrology rdf:type owl:Class ;
                rdfs:subClassOf chips:Domain_Activities ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty pmdco:relates_to ;
                                  owl:someValuesFrom pmdco:Messprozess
                                ] ;
                rdfs:label "Metrology"@en ;
