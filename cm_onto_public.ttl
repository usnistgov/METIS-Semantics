###  https://w3id.org/CHIPS/metrology-ontology/Small_Angle_Xray_Scattering_Instrument
chips:Small_Angle_Xray_Scattering_Instrument rdf:type owl:Class ;
                                             rdfs:subClassOf chips:Scattering_Instrument ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty prov:wasAssociateFor ;
                                                               owl:someValuesFrom chips:Smallangle_Xray_Scattering
                                                             ] ;
                                             rdfs:comment "SAXS Instrument"@en ;
                                             rdfs:label "Small Angle X-ray Scattering Instrument"@en ;
                                             skos:definition "Small-Angle X-ray Scattering Instrument is a scattering measurement device that measures the intensity of X-rays scattered at small angles from a specimen to determine the size, shape, and spatial correlations of nanoscale structures."@en ;
                                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Smallangle_Xray_Scattering
chips:Smallangle_Xray_Scattering rdf:type owl:Class ;
                                 rdfs:subClassOf chips:Xray_Scattering ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty prov:wasAssociatedWith ;
                                                   owl:someValuesFrom chips:Small_Angle_Xray_Scattering_Instrument
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty pmdco:belongsToProject ;
                                                   owl:someValuesFrom [ rdf:type owl:Class ;
                                                                        owl:unionOf ( chips:Grand_Challenge_2
                                                                                      chips:Grand_Challenge_6
                                                                                      chips:Grand_Challenge_7
                                                                                    )
                                                                      ]
                                                 ] ;
                                 rdfs:label "Small-angle X-ray Scattering"@en ;
                                 skos:definition "Small-Angle X-ray Scattering (SAXS) is an X-ray scattering technique that measures scattered intensity at small angles to probe structural features at the 1–100 nm scale, including particle size, shape, and inter-particle correlations."@en ;
                                 pmdco:abbreviation "SAXS"@en ;
                                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/SmartUSA
