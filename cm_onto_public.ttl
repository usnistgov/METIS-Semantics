                                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/FiberBragg_Technique
chips:FiberBragg_Technique rdf:type owl:Class ;
                           rdfs:subClassOf chips:Optical_Measuring_Process ,
                                           chips:Scattering ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty prov:used ;
                                             owl:someValuesFrom chips:Fiber_Bragg_Grating
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty chips:measured ;
                                             owl:someValuesFrom chips:Viscoelastic_Bulk_Modulus
                                           ] ;
                           rdfs:label "Fiber-Bragg Technique"@en ;
                           skos:definition "Fiber Bragg Technique is an optical sensing method that uses the narrowband wavelength-selective reflection of a fiber Bragg grating to transduce physical perturbations such as strain or temperature into measurable spectral shifts."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Fiber_Bragg_Grating
