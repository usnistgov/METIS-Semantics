                                  owl:onProperty prov:wasGeneratedBy ;
                                  owl:someValuesFrom mo:Ionenmikroskopie
                                ] ;
                rdfs:label "Ion Image"@en ;
                skos:definition "An ion image is a spatially resolved map of secondary ion signals from a specific mass channel obtained in secondary ion mass spectrometry, used to visualize elemental or isotopic distributions."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Ion_Implantation
chips:Ion_Implantation rdf:type owl:Class ;
