chips:Robotic_Arm rdf:type owl:Class ;
                  rdfs:subClassOf chips:Robotic_Agent ;
                  rdfs:label "Robotic Arm"@en ;
                  skos:definition "Robotic Arm is a robotic agent comprising a multi-joint mechanical manipulator that moves and positions objects, tools, or specimens under computer control for automated laboratory or manufacturing operations."@en ;
                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Root_Cause_Analysis
chips:Root_Cause_Analysis rdf:type owl:Class ;
                          rdfs:subClassOf pmdco:Analysing_Process ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty pmdco:relates_to ;
                                            owl:someValuesFrom chips:Failure_Analysis
                                          ] ;
                          rdfs:label "Root Cause Analysis"@en ;
                          skos:definition "Root Cause Analysis is a systematic analytical process that identifies the fundamental underlying cause of a problem or failure by working backward from observed symptoms through a causal chain."@en ;
                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Rotation_Angle
chips:Rotation_Angle rdf:type owl:Class ;
                     rdfs:subClassOf mo:Winkel ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty pmdco:characteristic ;
                                       owl:someValuesFrom pmdco:Metadaten
                                     ] ;
                     rdfs:label "Rotation Angle"@en ;
                     skos:definition "Rotation angle is the angular displacement of a sample or component about a specified axis, used to define measurement geometry in diffraction, polarimetry, and tomography."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Roundrobin
chips:Roundrobin rdf:type owl:Class ;
                 rdfs:subClassOf chips:Multiparty_Measuring_Process ;
                 rdfs:label "Round-robin"@en ;
                 skos:definition "Round-Robin is a multiparty measurement process in which a single specimen or set of specimens is circulated sequentially among multiple laboratories, each performing measurements under its own conditions, to assess inter-laboratory variability."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


