                                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Daffodil
chips:Daffodil rdf:type owl:Class ;
               rdfs:subClassOf chips:Customized_Hardware_Measurement_Platform ,
                               chips:Opensource_Hardware ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty prov:wasAssociateFor ;
                                 owl:someValuesFrom chips:Grand_Challenge_6
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty chips:isOpenSource ;
                                 owl:hasValue "true"^^xsd:boolean
                               ] ;
               rdfs:label "Daffodil"@en ;
               skos:definition "Daffodil is a customized hardware measurement platform developed at NIST for automated, high-throughput characterization of magnetic properties and thin films."@en ;
               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Damping
chips:Damping rdf:type owl:Class ;
              rdfs:subClassOf chips:Relaxation_Process ;
              rdfs:label "Damping"@en ;
              skos:definition "Damping is a relaxation process by which the amplitude of an oscillation or perturbation in a physical system decreases over time due to the dissipation of energy, typically through friction, viscosity, or magnetic relaxation mechanisms."@en ;
              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Damping_Constant
chips:Damping_Constant rdf:type owl:Class ;
                       rdfs:subClassOf chips:Constant ;
                       rdfs:label "Damping Constant"@en ;
                       skos:definition "A damping constant is a fixed parameter that quantifies the rate of energy dissipation in a damped system, appearing as a coefficient in exponential decay or oscillatory decay equations."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Damping_Factor
chips:Damping_Factor rdf:type owl:Class ;
                     owl:equivalentClass chips:Damping_Parameter ;
                     rdfs:subClassOf chips:Parameter ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty chips:calculatedBy ;
                                       owl:someValuesFrom chips:Derived_Process
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty pmdco:characteristic_of ;
                                       owl:someValuesFrom chips:Magnetic_Property
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty pmdco:characteristic_of ;
                                       owl:someValuesFrom chips:Mechanical_Property
                                     ] ;
                     rdfs:label "Damping Factor"@en ;
                     skos:definition "Damping Factor is a dimensionless parameter that quantifies the ratio of actual mechanical or magnetic damping to the critical damping value, characterizing the rate of oscillation decay. It is equivalent to the Damping Parameter and may be applied to both mechanical systems (as the ratio of viscous damping to critical damping) and magnetic systems (as a measure of energy dissipation rate)."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Damping_Parameter
chips:Damping_Parameter rdf:type owl:Class ;
                        rdfs:subClassOf chips:Parameter ;
                        rdfs:label "Damping Parameter"@en ;
                        skos:definition "A damping parameter is a quantitative parameter that characterizes the strength of damping in a physical system, used in equations of motion to describe the rate at which oscillatory amplitude or precession magnitude decreases over time."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Dark_Uncertainty
chips:Dark_Uncertainty rdf:type owl:Class ;
                       rdfs:subClassOf chips:Uncertainty ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty chips:measuredBy ;
                                         owl:someValuesFrom chips:Grand_Challenge_2
                                       ] ;
                       rdfs:label "Dark Uncertainty"@en ;
                       skos:definition "Dark Uncertainty is a component of measurement uncertainty that is not explicitly identified or quantified in a standard uncertainty analysis, arising from unknown systematic effects or model inadequacies that may cause results to be inconsistent across laboratories."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Data
chips:Data rdf:type owl:Class ;
           rdfs:subClassOf pmdco:Digital_Entity ;
           rdfs:label "Data"@en ;
           skos:definition "Data is a digital entity consisting of recorded, measured, or computed values that represent facts, observations, or signals and serve as input to or output from a process."@en ;
           pmdco:definitionSource "claude-opus-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Data_Acquisition
chips:Data_Acquisition rdf:type owl:Class ;
                       rdfs:subClassOf chips:Experiment_Process ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty prov:wasAssociatedWith ;
                                         owl:someValuesFrom chips:Data_Acquisition_Software
