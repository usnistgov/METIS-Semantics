                                     owl:onProperty pmdco:characteristic_of ;
                                     owl:someValuesFrom chips:Electrical_Pulse
                                   ] ;
                   rdfs:label "Pulse Length"@en ;
                   skos:definition "Pulse length is the temporal duration of a pulsed signal or radiation burst, determining the time resolution of pulsed measurement techniques."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Pulsed_Measurement
chips:Pulsed_Measurement rdf:type owl:Class ;
                         rdfs:subClassOf pmdco:Messprozess ;
                         rdfs:label "Pulsed Measurement"@en ;
                         skos:definition "Pulsed Measurement is a measurement process in which the stimulus is applied as a short pulse to reduce heating effects, minimize stress, or achieve time-resolved characterization of a device or material."@en ;
                         pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Pump
chips:Pump rdf:type owl:Class ;
           rdfs:subClassOf mo:Source ;
           rdfs:label "Pump"@en ;
           skos:definition "A pump is a source that delivers energy, matter, or a signal to a system, including mechanical devices that move fluids and excitation pulses that initiate transient processes in time-resolved experiments."@en ;
           pmdco:definitionSource "claude-opus-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Pumpprobe_Instrument
chips:Pumpprobe_Instrument rdf:type owl:Class ;
                           rdfs:subClassOf chips:Time_Measurement_Instrument ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty prov:wasAssociateFor ;
                                             owl:someValuesFrom chips:Pumpprobe_Process
                                           ] ;
                           rdfs:label "Pump-probe Instrument"@en ;
                           skos:definition "Pump-probe Instrument is a time-resolved measurement instrument that uses a pump pulse to excite a specimen and a variably delayed probe pulse to interrogate its transient response, enabling measurement of ultrafast dynamics with time resolution determined by the pulse duration."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Pumpprobe_Process
chips:Pumpprobe_Process rdf:type owl:Class ;
                        rdfs:subClassOf chips:Temporallyresolved_Measurement_Process ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty prov:wasAssociatedWith ;
                                          owl:someValuesFrom chips:Pumpprobe_Instrument
                                        ] ;
                        rdfs:label "Pump-probe Process"@en ;
                        skos:definition "Pump-Probe Process is a time-resolved spectroscopic technique in which an intense pump pulse initiates a transient state in a material and a subsequent weaker probe pulse interrogates the evolving system as a function of the pump-probe time delay."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Purge_and_Trap
chips:Purge_and_Trap rdf:type owl:Class ;
                     rdfs:subClassOf chips:Concentration_Process ;
                     rdfs:label "Purge and Trap"@en ;
                     skos:definition "Purge and Trap is a sample preconcentration technique in which volatile analytes are purged from a liquid matrix by an inert gas stream, then trapped on a sorbent, thermally desorbed, and introduced into an analytical instrument."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Purity
chips:Purity rdf:type owl:Class ;
             rdfs:subClassOf chips:Confidence_Concept ;
             rdfs:label "Purity"@en ;
             skos:definition "Purity is a confidence concept quantifying the fraction of a substance that is the intended compound or material, with the remainder comprising impurities, expressed as a percentage or in parts per million."@en ;
             pmdco:definitionSource "claude-sonnet-4-6"@en .


