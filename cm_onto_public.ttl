                               pmdco:definitionSource "claude-opus-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Digital_Image_Correlation
chips:Digital_Image_Correlation rdf:type owl:Class ;
                                rdfs:subClassOf chips:Image_Analysis ,
                                                [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                         owl:onProperty prov:wasInfluencedBy ;
                                                                         owl:someValuesFrom pmdco:Geometry_Changing_Process
                                                                       ]
                                                                       [ rdf:type owl:Restriction ;
