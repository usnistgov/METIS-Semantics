###  https://w3id.org/CHIPS/metrology-ontology/Derived_Data
chips:Derived_Data rdf:type owl:Class ;
                   owl:equivalentClass pmdco:Sekundrdaten ;
                   rdfs:subClassOf chips:Data ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty prov:wasGeneratedBy ;
                                     owl:someValuesFrom chips:Derived_Process
                                   ] ;
                   rdfs:label "Derived Data"@en ;
                   skos:definition "Derived data is data obtained by mathematical processing or analysis of primary measured data, such as fitted parameters, transformed spectra, or statistically analyzed results."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Derived_Process
chips:Derived_Process rdf:type owl:Class ;
                      rdfs:subClassOf pmdco:Analysing_Process ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty prov:generated ;
                                        owl:someValuesFrom chips:Derived_Data
                                      ] ;
                      rdfs:label "Derived Process"@en ;
