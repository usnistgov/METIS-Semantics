                                                                              )
                                                                ]
                                           ] ;
                           rdfs:label "Optical Spectroscopy"@en ;
                           skos:definition "Optical Spectroscopy is a class of spectroscopic techniques that use visible, infrared, or ultraviolet light to probe the optical, electronic, and vibrational properties of materials through absorption, emission, or scattering."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Optical_Transient_Thermoreflectance
chips:Optical_Transient_Thermoreflectance rdf:type owl:Class ;
                                          rdfs:subClassOf chips:Optical_Measuring_Process ,
                                                          chips:Pumpprobe_Process ,
                                                          chips:Thermoreflectance_Process ;
                                          rdfs:label "Optical Transient Thermoreflectance"@en ;
                                          skos:definition "Optical Transient Thermoreflectance (OTTR) is a pump-probe thermal measurement technique in which a pulsed pump laser deposits heat in a specimen and a probe laser monitors the time-dependent surface reflectance to extract thermal conductivity and interface thermal resistance."@en ;
                                          pmdco:definitionSource "claude-sonnet-4-6"@en .


