###  https://w3id.org/pmd/co/Chemical_Bond
pmdco:Chemical_Bond rdf:type owl:Class ;
                    rdfs:subClassOf obo:Chemical_Entity ;
                    rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                    rdfs:label "Bindungstyp"@de ,
                               "Chemical BondingType"@en ;
                    skos:definition "Any of several forces, especially the ionic bond, covalent bond, and metallic bond, by which atoms or ions are bound in a molecule or crystal."@en ,
                                    "Eine von mehreren Bindungen, insbesondere die Ionenbindung, die kovalente Bindung und die Metallbindung, durch die Atome oder Ionen in einem Molekül oder Kristall gebunden sind."@de ;
                    pmdco:definitionSource "\"Bond types.” American Heritage® Dictionary of the English Language, Fifth Edition, https://www.thefreedictionary.com/Bond+Types. Accessed 13 Jan. 2023."@en .


###  https://w3id.org/pmd/co/Chemische_Zusammensetzung
pmdco:Chemische_Zusammensetzung rdf:type owl:Class ;
                                rdfs:subClassOf chips:Chemical_Property ;
                                rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                                rdfs:label "Chemical Composition"@en ,
                                           "Chemische Zusammensetzung"@de ;
                                skos:definition "Chemical composition refers to the arrangement, type, and ratio of atoms in molecules of chemical substances. Chemical composition varies when chemicals are added or subtracted from a substance, when the ratio of substances changes, or when other chemical changes occur in chemicals."@en ;
                                skos:example """ex:proc1 a pmd:Process .
ex:proc1 pmd:chacteristic ex:vo1 .

ex:vo1 a ValueObject .
ex:vo1 pmd:resource ex:chemComp1 .
ex:chemComp1 a pmd:ChemicalComposition .

ex:vo2 dcterm:partOf ex:chemComp1 .
ex:vo2 a pmd:ChemicalElement .
ex:vo2 pmd:relatesToElement CHEBI:28984 .
ex:vo2 pmd:relatesTo ex:vo3 .

pmd:MassFraction rdf:subClassOf ValueObject .
ex:vo3 a pmd:MassFraction .
ex:vo3 qudt:upperBound \"0.3\" .
ex:vo3 qudt:lowerBound \"0\" .
ex:vo3 qudt:unit qudt:PERCENT .

ex:vo4 a pmd:MassFraction .
ex:vo4 pmd:resource pmd:NotDetected .""" ;
                                pmdco:definitionSource "https://chem.libretexts.org/Courses/College_of_Marin/CHEM_114%3A_Introductory_Chemistry/06%3A_Chemical_Composition" .


###  https://w3id.org/pmd/co/Computing_Node
pmdco:Computing_Node rdf:type owl:Class ;
                     rdfs:subClassOf chips:Hardware ;
                     rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                     rdfs:label "Computerknoten"@de ,
                                "Computing Node"@en ;
                     skos:definition """A computing system that provides an execution environment for, e.g., simulation processes or prediction models.
A Computing Node can be virtual (e.g., a container or virtual machine) or physical (e.g., a bare-metal servers), uses digital represenations of objects as inputs and produces digital measurements, such as simulation results or predictions, as outputs."""@en ,
                                     """Ein Rechnersystem, das eine Ausführungsumgebung bspw. für Simulationsprozesse oder Vorhersagemodelle bereitstellt.
Ein Rechenknoten kann virtuell (bspw. ein Container oder eine virtuelle Maschine) oder physisch (z. B. ein Bare-Metal-Server) ausgestaltet sein und verwendet in der Regel digitale Repräsentationen von Objekten als Eingaben und erzeugt digitale Messungen, wie z.B. Simulationsergebnisse oder Vorhersagen, als Ausgaben."""@de .


###  https://w3id.org/pmd/co/DataCite_Metadata
pmdco:DataCite_Metadata rdf:type owl:Class ;
                        rdfs:subClassOf pmdco:Metadaten ;
                        rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                        rdfs:label "Data Cite Metadaten"@de ,
                                   "DataCite Metadata"@en ;
                        skos:definition "This value object refers to metadata which can be provided as DataCite element."@en ;
                        skos:example """For example, to refer to a ISBN number, following triples might be created:

    :p1 a pmd:Process .
    :p1 pmd:characteristic :doc_vo1 .
    :doc_vo1 a pmd:Document .
    :doc_vo1 pmd:characteristic :isbn_vo1 .
    :doc_vo1 pmd:resource \"http://example.org/book.pdf\" .
    :isbn_vo1 a pmd:DataCiteMetadata .
    :isbn_vo1 pmd:relatesTo <http://purl.org/spar/datacite/isbn> .
    :isbn_vo1 pmd:value \"9780262012423\". 

\"a document related to process :p1 has a ISBN number 9780262012423\""""@en .


###  https://w3id.org/pmd/co/Datenerfassungsrate
pmdco:Datenerfassungsrate rdf:type owl:Class ;
                          rdfs:subClassOf pmdco:Node_Info ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty prov:wasInfluencedBy ;
                                            owl:someValuesFrom chips:Data_Acquisition
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty pmdco:characteristic ;
                                            owl:someValuesFrom pmdco:Zeit
                                          ] ;
                          rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                          rdfs:label "Data Acquisition Rate"@en ,
                                     "Datenerfassungsrate"@de ;
                          skos:definition "Diese Eigenschaft bezeichnet die Anzahl der Messungen / Abfragen pro Zeiteinheit bei einer betrachteten Messung einer Messgröße (Abtast-/Abfragerate bei der Datenerfassung)."@de ,
                                          "This property denotes the number of measurements / queries per time period for a considered measurement of a measurement parameter (sampling / query rate during data acquisition)."@en .


###  https://w3id.org/pmd/co/Datenkategorie
pmdco:Datenkategorie rdf:type owl:Class ;
                     rdfs:subClassOf prov:Entity ;
                     rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                     rdfs:label "Data Scope"@en ,
                                "Datenkategorie"@de ;
                     skos:definition "Die Entität Datenkategorie dient der Kategorisierung von Daten im Hinblick auf ihren Verwendungszweck in Übereinstimmung mit einem betrachteten Objekt oder Prozess."@de ,
                                     "This class is used to categorize data with respect to their intended usage in accordance with a regarded object or process."@en .


###  https://w3id.org/pmd/co/Datensatz
pmdco:Datensatz rdf:type owl:Class ;
                rdfs:subClassOf chips:Data ,
                                [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                         owl:onProperty prov:wasGeneratedBy ;
                                                         owl:someValuesFrom chips:Frontendofline_Process
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty prov:wasUsedBy ;
                                                         owl:someValuesFrom chips:Grand_Challenge_5
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty pmdco:relates_to ;
                                  owl:someValuesFrom pmdco:Metadaten
                                ] ;
                rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                rdfs:label "Dataset"@en ,
                           "Datensatz"@de ;
                skos:definition "A collection of data published in one or more files. Usually instances of this class are also instances of DCAT dataset (see https://www.w3.org/TR/vocab-dcat-2/)."@en .


###  https://w3id.org/pmd/co/Datenschnittstellenhinweis
pmdco:Datenschnittstellenhinweis rdf:type owl:Class ;
                                 rdfs:subClassOf pmdco:Node_Info ;
                                 rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                                 rdfs:label "Collection Interface Hint"@en ,
                                            "Datenschnittstellenhinweis"@de ;
                                 skos:definition "A label in support of identifying a network interface and/or address used by a process node to provide primary data stored in ontologies"@en .


###  https://w3id.org/pmd/co/Datum
pmdco:Datum rdf:type owl:Class ;
            rdfs:subClassOf chips:Temporal_Concept ;
            rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
            rdfs:label "Date"@en ,
                       "Datum"@de ;
            skos:definition "A statement of the day of execution or making. Based on an the gregorian calender system."@en ,
                            "Eine Erklärung über den Tag der Ausführung oder Herstellung. Basierend auf dem gregorianischen Kalendersystem."@de .


###  https://w3id.org/pmd/co/Dauer
pmdco:Dauer rdf:type owl:Class ;
            rdfs:subClassOf chips:Temporal_Concept ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty pmdco:characteristic ;
                              owl:someValuesFrom pmdco:Metadaten
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty pmdco:characteristic ;
                              owl:someValuesFrom [ owl:intersectionOf ( pmdco:Endzeit
                                                                        pmdco:Startzeit
                                                                      ) ;
                                                   rdf:type owl:Class
                                                 ]
                            ] ;
            rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
            rdfs:label "Dauer"@de ,
                       "Duration"@en ;
            skos:definition "A period of time with its own timescale and an epoch anchored in another timescale. A duration can be expressed via a single value as it represents the time difference between two points in time, e.g. the difference between EndTime and StartTime or the difference between the current, momentary time and the StartTime."@en ,
                            "Eine Zeitspanne mit einer eigenen Zeitskala und einer in einer anderen Zeitskala verankerten Epoche. Eine Dauer kann durch einen einzigen Wert ausgedrückt werden, da sie die Zeitdifferenz zwischen zwei Zeitpunkten darstellt, z. B. die Differenz zwischen Endzeit und Startzeit oder die Differenz zwischen der aktuellen, momentanen Zeit und der Startzeit."@de .


###  https://w3id.org/pmd/co/Demounting_Process
pmdco:Demounting_Process rdf:type owl:Class ;
                         rdfs:subClassOf pmdco:Assembling_Process ;
                         rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                         rdfs:label "Demontageprozess"@de ,
                                    "Demounting Process"@en ;
                         skos:definition "An assembling process in which a test piece or specimen is removed from a test machine."@en .


###  https://w3id.org/pmd/co/Dicke
pmdco:Dicke rdf:type owl:Class ;
            rdfs:subClassOf pmdco:Lnge ;
            rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
            rdfs:label "Dicke"@de ,
                       "Thickness"@en ;
            skos:definition "Diese Entität beschreibt die gemessene Dimension in einer Richtung eines Prüfstücks."@de ,
                            "This entity describes the measured dimension in one direction of a test piece."@en .


###  https://w3id.org/pmd/co/Digital_Entity
pmdco:Digital_Entity rdf:type owl:Class ;
                     rdfs:subClassOf prov:Entity ;
                     rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                     rdfs:label "Digital Entity"@en ;
                     skos:definition "An entity with digital representation."@en .


###  https://w3id.org/pmd/co/Digital_Material_Identifier
pmdco:Digital_Material_Identifier rdf:type owl:Class ;
                                  rdfs:subClassOf chips:Material_Identifier ;
                                  rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                                  rdfs:label "Digital Material Identifier"@en ;
                                  skos:definition """The DigitalMaterialIdentifier value object refers to a dmi:DigitalMaterialIdentifier.

A dmi:DigitalMaterialIdentifier is a resource identifier (IRI) that represents the specification of a material (in the sense of a material class) described in a specification document. The specification document can be, e.g., a standard, a datasheet, or any other citable document. Typically, a specification document requires some qualities that a material (in the sense of a portion of matter) has to comply with. Typical requirements include chemical compositions or physical properties."""@en .


###  https://w3id.org/pmd/co/Dimensionsmesswerkzeug
pmdco:Dimensionsmesswerkzeug rdf:type owl:Class ;
                             rdfs:subClassOf pmdco:Messgert ;
                             rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                             rdfs:label "Dimension Measuring Device"@en ,
                                        "Dimensionsmesswerkzeug"@de ;
                             skos:definition "Diese Entität beschreibt allgemein jedes Werkzeug, das für die Messung der Abmessungen eines greifbaren Objekts verwendet wird, z. B. eines Messschiebers."@de ,
                                             "This entity generically describes any tool that is used for the measurement of the dimensions of a tangible object, e.g., a caliper."@en .


###  https://w3id.org/pmd/co/Dokument
pmdco:Dokument rdf:type owl:Class ;
               rdfs:subClassOf pmdco:Digital_Entity ;
               rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
               rdfs:label "Document"@en ,
                          "Dokument"@de ;
               skos:definition "An original or official paper relied on as the basis, proof, or support of something"@en ,
                               "Ein Original oder offizielles Papier, auf das man sich als Grundlage, Beweis oder Unterstützung von etwas stützt."@de ;
               pmdco:definitionSource "“Document.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/document. Accessed 16 Jan. 2023."@en .


###  https://w3id.org/pmd/co/Durchmesser
pmdco:Durchmesser rdf:type owl:Class ;
                  rdfs:subClassOf pmdco:Lnge ;
                  rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                  rdfs:label "Diameter"@en ,
                             "Durchmesser"@de ;
                  skos:definition "The length of a straight line through the center of an object or space."@en ;
                  prov:constraints "TesileTest" ;
                  pmdco:definitionSource "“Diameter.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/diameter. Accessed 5 Dec. 2022."@en .


###  https://w3id.org/pmd/co/Elektronenmikroskop
pmdco:Elektronenmikroskop rdf:type owl:Class ;
                          rdfs:subClassOf pmdco:Mikroskop ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty prov:generated ;
                                            owl:someValuesFrom pmdco:Bild
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty prov:wasAssociateFor ;
                                            owl:someValuesFrom pmdco:Elektronenmikroskopie
                                          ] ;
                          rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                          rdfs:label "Electron Microscope"@en ,
                                     "Elektronenmikroskop"@de ;
                          skos:definition "An electron-optical instrument in which a beam of electrons is used to produce an enlarged image of a minute object."@en ;
                          pmdco:definitionSource "“Electron microscope.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/electron%20microscope. Accessed 24 Nov. 2022."@en .


###  https://w3id.org/pmd/co/Elektronenmikroskopie
pmdco:Elektronenmikroskopie rdf:type owl:Class ;
                            rdfs:subClassOf pmdco:Mikroskopie ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty prov:informed ;
                                              owl:someValuesFrom [ rdf:type owl:Class ;
                                                                   owl:unionOf ( mo:Elektronenenergieverlustspektroskopie
                                                                                 mo:Energy_Dispersive_Xray_Spectroscopy
                                                                               )
                                                                 ]
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty prov:used ;
                                              owl:someValuesFrom mo:Elektronenstrahl
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty prov:wasAssociatedWith ;
                                              owl:someValuesFrom pmdco:Elektronenmikroskop
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty chips:measured ;
                                              owl:someValuesFrom [ owl:intersectionOf ( chips:Defect
                                                                                        chips:Defect_Density
                                                                                        chips:Interface
                                                                                        pmdco:Kristalline_Struktur
                                                                                      ) ;
                                                                   rdf:type owl:Class
                                                                 ]
                                            ] ;
                            rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                            rdfs:label "Electron Microscopy"@en ,
                                       "Elektronenmikroskopie"@de ;
                            skos:definition "A microscopy process using an electron-optical instrument in which a beam of accelerated electrons as a source of illumination is applied to produce a magnified image of a tiny object."@en ,
                                            "Die Verwendung eines elektronenoptischen Instruments, bei dem ein Strahl beschleunigter Elektronen als Beleuchtungsquelle eingesetzt wird, um ein vergrößertes Bild eines kleinen Objekts zu erzeugen."@de ;
                            pmdco:definitionSource "“Electron microscope.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/electron%20microscope. Accessed 13 Jan. 2023."@en .


###  https://w3id.org/pmd/co/Elliptisch
pmdco:Elliptisch rdf:type owl:Class ;
                 rdfs:subClassOf pmdco:Form ;
                 rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                 rdfs:label "Elliptical"@en ,
                            "Elliptisch"@de ;
                 skos:definition "Geformt wie eine Ellipse."@de ,
                                 "Shaped like an ellipse."@en ;
                 pmdco:definitionSource "“Elliptical.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/elliptical. Accessed 13 Jan. 2023."@en .


###  https://w3id.org/pmd/co/Endzeit
pmdco:Endzeit rdf:type owl:Class ;
              rdfs:subClassOf pmdco:Zeit ;
              rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
              rdfs:label "End Time"@en ,
                         "Endzeit"@de ;
              skos:definition "The date and time when the plan/recipe is supposed to have been finished"@en .


###  https://w3id.org/pmd/co/Engineered_Material
pmdco:Engineered_Material rdf:type owl:Class ;
                          rdfs:subClassOf chips:Material ;
                          rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                          rdfs:label "Engineered Material"@en ;
                          skos:definition "A material that is synthesized within a manufacturing process."@en ,
                                          "Ein Material, das im Rahmen eines Herstellungsprozesses synthetisiert wird."@de .


###  https://w3id.org/pmd/co/Extensometer
pmdco:Extensometer rdf:type owl:Class ;
                   rdfs:subClassOf pmdco:Dimensionsmesswerkzeug ;
                   rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                   rdfs:label "Extensometer"@en ;
                   skos:definition "An instrument for measuring minute deformations of test specimens caused by tension, compression, bending, or twisting."@en ;
                   pmdco:definitionSource "“Extensometer.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/extensometer. Accessed 5 Dec. 2022."@en .


###  https://w3id.org/pmd/co/Fehlerberichtdokument
pmdco:Fehlerberichtdokument rdf:type owl:Class ;
                            rdfs:subClassOf chips:Report ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty pmdco:characteristic ;
                                              owl:someValuesFrom chips:Error
                                            ] ;
                            rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                            rdfs:label "Error Report Document"@en ,
                                       "Fehlerberichtdokument"@de ;
                            skos:definition "Diese Entität beschreibt ein Dokument, das Informationen über Fehler bereitstellt, die während der Anwendung eines Prozessknotens aufgetreten sind, wie z. B. eine Überschreitung des Arbeitsbereichs eines Messgeräts."@de ,
                                            "This entity describes a document used to provide information on errors that occurred during the application of a process node, such as, e.g., an overshooting exceeding the working range of a measurement device."@en .


###  https://w3id.org/pmd/co/Filter
pmdco:Filter rdf:type owl:Class ;
             rdfs:subClassOf pmdco:Algorithmus ;
             rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
             rdfs:label "Filter"@de ,
                        "Filter"@en ;
             skos:definition "A filter is a computer program or subroutine to process a stream, producing another stream. While a single filter can be used individually, they are frequently strung together to form a pipeline."@en ;
             skos:example "Smoothing algorithm"@en ;
             pmdco:definitionSource "https://en.wikipedia.org/wiki/Filter_%28software%29"@en .


###  https://w3id.org/pmd/co/Flche
pmdco:Flche rdf:type owl:Class ;
            rdfs:subClassOf chips:Quantity_Kind ,
                            chips:Spatial_Concept ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty pmdco:characteristic ;
                              owl:someValuesFrom chips:Measurand
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty pmdco:characteristic ;
                              owl:someValuesFrom <https://w3id.org/CHIPS/metrology-ontology/2D>
                            ] ;
            rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
            rdfs:label "Area"@en ,
                       "Fläche"@de ;
            skos:definition "The extent or measurement of a surface."@en .


###  https://w3id.org/pmd/co/Form
pmdco:Form rdf:type owl:Class ;
           rdfs:subClassOf chips:Spatial_Concept ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty pmdco:characteristic ;
                             owl:someValuesFrom <https://w3id.org/CHIPS/metrology-ontology/3D>
                           ] ;
           rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
           rdfs:label "Form"@de ,
                      "Shape"@en ;
           skos:definition "Das sichtbare Ausstattungsmerkmal (räumliche Form oder Kontur) eines bestimmten Objektes oder einer Art von Objekt."@de ,
                           "The visible makeup characteristic (spatial form or contour) of a particular item or kind of item."@en ;
           pmdco:definitionSource "“Shape.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/shape. Accessed 13 Jan. 2023."@en .


###  https://w3id.org/pmd/co/Fraction
pmdco:Fraction rdf:type owl:Class ;
               rdfs:subClassOf pmdco:Wertobjekt ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty pmdco:characteristic ;
                                 owl:someValuesFrom [ rdf:type owl:Class ;
                                                      owl:unionOf ( chips:Measurand
                                                                    pmdco:Messwert
                                                                  )
                                                    ]
                               ] ;
               rdfs:isDefinedBy <https://w3id.org/pmd/co> .


###  https://w3id.org/pmd/co/Genauigkeit
pmdco:Genauigkeit rdf:type owl:Class ;
                  rdfs:subClassOf chips:Confidence_Concept ;
                  rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                  rdfs:label "Genauigkeit"@de ,
                             "Precision"@en ;
                  skos:definition "Der Grad der Verfeinerung, mit dem eine Operation durchgeführt oder eine Messung angegeben wird."@de ,
                                  "The degree of refinement with which an operation is performed or a measurement stated."@en ;
                  pmdco:definitionSource "“Precision.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/precision. Accessed 13 Jan. 2023."@en .


###  https://w3id.org/pmd/co/Geometry_Changing_Process
pmdco:Geometry_Changing_Process rdf:type owl:Class ;
                                rdfs:subClassOf chips:Change_Process ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty prov:influenced ;
                                                  owl:someValuesFrom chips:Mechanical_Property
                                                ] ;
                                rdfs:isDefinedBy "https://w3id.org/pmd/co" ;
                                rdfs:label "Geometry Changing Process"@en ;
                                skos:definition "A process that is modifing the geometry of an object."@en .


###  https://w3id.org/pmd/co/Gewicht
pmdco:Gewicht rdf:type owl:Class ;
              rdfs:subClassOf chips:Physical_Property ;
              rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
              rdfs:label "Gewicht"@de ,
                         "Weight"@en ;
              skos:definition "The force with which a body is attracted toward the earth or a celestial body by gravitation and which is equal to the product of the mass and the local gravitational acceleration."@en ;
              pmdco:definitionSource "“Weight.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/weight. Accessed 5 Dec. 2022."@en .


###  https://w3id.org/pmd/co/Grips_Alignment
pmdco:Grips_Alignment rdf:type owl:Class ;
                      rdfs:subClassOf pmdco:Assembling_Process ;
                      rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                      rdfs:label "Ausrichtung Der Halterungen"@de ,
                                 "Grips Alignment"@en ;
                      skos:definition "An assembly process in which the grips used to grasp a tangible object, such as a sample, specimen or test piece, are arranged in a line. This process is usually part of the assembly process during testing, if applicable."@en ,
                                      "Diese Klasse beschreibt den Prozess der Ausrichtung von Halterungen, die zum Fest-/Einspannen eines materiellen Objekts, wie z. B. einer Probe, eines Prüfkörpers oder eines Prüfstücks, verwendet werden. Dieser Vorgang ist in der Regel Teil des Montageprozesses während der Prüfung, falls ein solcher durchgeführt wird."@de .


###  https://w3id.org/pmd/co/Hersteller
pmdco:Hersteller rdf:type owl:Class ;
                 rdfs:subClassOf chips:Industry ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty obo:has_role ;
                                   owl:someValuesFrom pmdco:Manufacturer_Role
                                 ] ;
                 rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                 rdfs:label "Hersteller"@de ,
                            "Manufacturer"@en ;
                 skos:definition "Processing Node's manufacturer name, e.g.: \"Ipsen\", \"UPC\" or \"Bosch\""@en .


###  https://w3id.org/pmd/co/Identifikator
pmdco:Identifikator rdf:type owl:Class ;
                    rdfs:subClassOf pmdco:Digital_Entity ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty prov:contributed ;
                                      owl:someValuesFrom chips:Provenance
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty pmdco:characteristic_of ;
                                      owl:someValuesFrom pmdco:Metadaten
                                    ] ;
                    rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                    rdfs:label "Identifier"@en ,
                               "Identifikator"@de ;
                    skos:definition "A named value intended to distinguish between entities."@en .


###  https://w3id.org/pmd/co/Index
pmdco:Index rdf:type owl:Class ;
            rdfs:subClassOf pmdco:Datenkategorie ;
            rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
            rdfs:label "Index"@de ,
                       "Index"@en ;
            skos:definition "Some running number."@en .


###  https://w3id.org/pmd/co/Initiator
pmdco:Initiator rdf:type owl:Class ;
                rdfs:subClassOf [ owl:intersectionOf ( prov:Person
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty obo:has_role ;
                                                         owl:someValuesFrom pmdco:InitiatorRole
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ;
                rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                rdfs:label "Initiator"@de ,
                           "Initiator"@en ;
                skos:definition "The person that commisioned the process."@en .


###  https://w3id.org/pmd/co/InitiatorRole
pmdco:InitiatorRole rdf:type owl:Class ;
                    rdfs:subClassOf chips:Agent_Role ;
                    skos:definition "A role indicating that its bearer has inititated a process."@en ,
                                    "Initiator Role"@en .


###  https://w3id.org/pmd/co/Inspektionsdokument
pmdco:Inspektionsdokument rdf:type owl:Class ;
                          rdfs:subClassOf chips:Report ;
                          rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                          rdfs:label "Inspection Document"@en ,
                                     "Inspektionsdokument"@de ;
                          skos:definition "Diese Entität beschreibt ein Dokument, das Informationen über die Prüfung eines materiellen Objekts enthält, in der Regel versehen mit einem Prüfungsdatum, einem typischen Prüfungsintervall und dem Zustand des geprüften Objekts. Typischerweise wird ein solches Dokument für Prozessknoten verwendet."@de ,
                                          "This entity describes a document used to give information on the examination of a tangible object, usually including an examination date, a typical examination interval and the state of the examined object. Typically, this is used for processing nodes."@en .


###  https://w3id.org/pmd/co/Ionische_Bindung
pmdco:Ionische_Bindung rdf:type owl:Class ;
                       rdfs:subClassOf pmdco:Chemical_Bond ;
                       rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                       rdfs:label "Ionic Bond"@en ,
                                  "Ionische Bindung"@de ;
                       skos:definition "Eine Ionenbindung ist eine chemische Bindung, die zwischen entgegengesetzt geladenen Stoffen aufgrund ihrer gegenseitigen elektrostatischen Anziehung entsteht."@de ,
                                       "Ionic bond is a chemical bond formed between oppositely charged species because of their mutual electrostatic attraction."@en ;
                       pmdco:definitionSource "\"Ionic bond.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/ionic%20bond. Accessed 13 Jan. 2023."@en .


###  https://w3id.org/pmd/co/Kalibrierbereich
pmdco:Kalibrierbereich rdf:type owl:Class ;
                       rdfs:subClassOf pmdco:Datenkategorie ;
                       rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                       rdfs:label "Calibration Range"@en ,
                                  "Kalibrierbereich"@de ;
                       skos:definition "Diese Eigenschaft beschreibt den Bereich zwischen den Grenzen, innerhalb derer eine Größe gemessen, empfangen oder übertragen wird (typischerweise von einem Prozessknoten, z. B. einer Maschine), ausgedrückt durch die Angabe des unteren und oberen Bereichswertes."@de ,
                                       "This property describes the region between the limits within which a quantity is measured, received or transmitted (typically by a process node, e.g. a machine), expressed by stating the lower and upper range values."@en .


###  https://w3id.org/pmd/co/Kalibrierungsdokument
pmdco:Kalibrierungsdokument rdf:type owl:Class ;
                            rdfs:subClassOf pmdco:Dokument ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty prov:wasGeneratedBy ;
                                              owl:someValuesFrom chips:Grand_Challenge_3
                                            ] ;
                            rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                            rdfs:label "Calibration Document"@en ,
                                       "Kalibrierschein"@de ,
                                       "Kalibrierungsdokument"@de ;
                            skos:definition "Diese Entität beschreibt ein Dokument, welches Abweichungen eines Messgerätes oder einer Maßverkörperung gegenüber einem anderen Gerät oder einer anderen Maßverkörperung feststellt und dokumentiert. Typischerweise ist die Person, welche die Kalibrierung durchführte, angegeben."@de ,
                                            "This entity describes a document used to state that a set of graduations to indicate values or positions has been performed. Typically, the calibration operator is included."@en ;
                            pmdco:definitionSource "https://www.merriam-webster.com/dictionary/calibration"@en .


###  https://w3id.org/pmd/co/Klassifzierungsdokument
pmdco:Klassifzierungsdokument rdf:type owl:Class ;
                              rdfs:subClassOf pmdco:Dokument ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty prov:wasGeneratedBy ;
                                                owl:someValuesFrom chips:Classification_Process
                                              ] ;
                              rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                              rdfs:label "Classification Document"@en ,
                                         "Klassifzierungsdokument"@de ;
                              skos:definition "Diese Entität beschreibt ein Dokument, das dazu dient, den Arbeits- oder Anwendungsbereich eines Prozessknotens in Übereinstimmung mit genormten Abstufungen zu definieren."@de ,
                                              "This entity describes a document used to define the working or application range of a process node in accordance with standardized graduations."@en .


###  https://w3id.org/pmd/co/Kommissionszeit
pmdco:Kommissionszeit rdf:type owl:Class ;
                      rdfs:subClassOf pmdco:Startzeit ;
                      rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                      rdfs:label "Commission Time"@en ,
                                 "Kommissionszeit"@de ;
                      skos:definition "Date and time an order or plan has been dispatched at."@en .


###  https://w3id.org/pmd/co/Konditionierungsprozess
pmdco:Konditionierungsprozess rdf:type owl:Class ;
                              rdfs:subClassOf pmdco:Prozess ;
                              rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                              rdfs:label "Conditioning Process"@en ,
                                         "Konditionierungsprozess"@de ;
                              skos:definition "A process that comprises the procedure and measures by which a material object is adapted to predefined environmental conditions."@en ,
                                              "Diese Aktivität beschreibt den Prozess und die Maßnahmen, die ergriffen werden, um einen materiellen Gegenstand auf vordefinierte Umgebungsbedingungen einzustellen."@de .


###  https://w3id.org/pmd/co/Kovalente_Bindung
pmdco:Kovalente_Bindung rdf:type owl:Class ;
                        rdfs:subClassOf pmdco:Chemical_Bond ;
                        rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                        rdfs:label "Covalent Bond"@en ,
                                   "Kovalente Bindung"@de ;
                        skos:definition "Covalent bond is a chemical bond formed between atoms by the sharing of electrons."@en ,
                                        "Eine kovalente Bindung ist eine chemische Verbindung zwischen Atomen, die durch die gemeinsame Nutzung von Elektronen entsteht."@de ;
                        pmdco:definitionSource "\"Covalent bond.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/covalent%20bond. Accessed 13 Jan. 2023."@en .


###  https://w3id.org/pmd/co/Kraft
pmdco:Kraft rdf:type owl:Class ;
            rdfs:subClassOf chips:Quantity_Kind ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty pmdco:characteristic ;
                              owl:someValuesFrom pmdco:Metadaten
                            ] ;
            rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
            rdfs:label "Force"@en ,
                       "Kraft"@de ;
            skos:definition "Strength or energy exerted or brought to bear : cause of motion or change : active power."@en ;
            pmdco:definitionSource "“Force.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/force. Accessed 5 Dec. 2022."@en .


###  https://w3id.org/pmd/co/Kreisfrmig
pmdco:Kreisfrmig rdf:type owl:Class ;
                 rdfs:subClassOf pmdco:Form ;
                 rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                 rdfs:label "Circular"@en ,
                            "Kreisförmig"@de ;
                 skos:definition "Geformt wie ein Kreis."@de ,
                                 "Having the form of a circle."@en ;
                 pmdco:definitionSource "“Circular.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/circular. Accessed 13 Jan. 2023."@en .


###  https://w3id.org/pmd/co/Kriechspannung
pmdco:Kriechspannung rdf:type owl:Class ;
                     rdfs:subClassOf pmdco:Spannung ;
                     rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                     rdfs:label "Creep Stress"@en ,
                                "Kriechspannung"@de ;
                     skos:definition "Is the strain occuring with time, when a constant force is applied to a physical body."@en .


###  https://w3id.org/pmd/co/Kristalline_Struktur
pmdco:Kristalline_Struktur rdf:type owl:Class ;
                           rdfs:subClassOf chips:Crystalline_Property ,
                                           pmdco:Materialstruktur ,
                                           [ rdf:type owl:Class ;
                                             owl:unionOf ( [ rdf:type owl:Restriction ;
                                                             owl:onProperty chips:calculatedBy ;
                                                             owl:someValuesFrom chips:Computational_Process
                                                           ]
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty chips:measuredBy ;
                                                             owl:someValuesFrom pmdco:Messprozess
                                                           ]
                                                         )
                                           ] ;
                           rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                           rdfs:label "Crystalline Structure"@en ,
                                      "Kristalline Struktur"@de ;
                           skos:altLabel "Crystal Structure"@en ;
                           skos:definition "In crystallography, crystal structure is a description of the ordered arrangement of atoms, ions or molecules in a crystalline material. Ordered structures occur from the intrinsic nature of the constituent particles to form symmetric patterns that repeat along the principal directions of three-dimensional space in matter."@en ,
                                           "In der Kristallographie ist die Kristallstruktur eine Beschreibung der geordneten Anordnung von Atomen, Ionen oder Molekülen in einem kristallinen Material. Geordnete Strukturen ergeben sich aus der intrinsischen Natur der konstituierenden Teilchen, die symmetrische Muster bilden, die sich entlang der Hauptrichtungen des dreidimensionalen Raums in der Materie wiederholen."@de ;
                           pmdco:definitionSource "“Crystal structure.” Wikipedia The Free Encyclopedia, https://en.wikipedia.org/wiki/Crystal_structure. Accessed 13 Jan. 2023."@en .


###  https://w3id.org/pmd/co/Labor
pmdco:Labor rdf:type owl:Class ;
            rdfs:subClassOf [ owl:intersectionOf ( prov:Organization
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty obo:has_role ;
                                                     owl:someValuesFrom pmdco:Laboratory_Role
                                                   ]
                                                 ) ;
                              rdf:type owl:Class
                            ] ;
            rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
            rdfs:label "Labor"@de ,
                       "Laboratory"@en ;
            skos:definition "A place equipped for experimental study in a science or for testing and analysis."@en ;
            pmdco:definitionSource "“Laboratory.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/laboratory. Accessed 24 Nov. 2022."@en .


###  https://w3id.org/pmd/co/Laboratory_Role
pmdco:Laboratory_Role rdf:type owl:Class ;
                      rdfs:subClassOf chips:Agent_Role ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty [ owl:inverseOf obo:has_role
                                                       ] ;
                                        owl:someValuesFrom prov:Organization
                                      ] ;
                      rdfs:label "Laboratory Role"@en ;
                      skos:definition "A role indicating that an organization participates in a process as laboratory."@de .


###  https://w3id.org/pmd/co/Length_Changing_Process
pmdco:Length_Changing_Process rdf:type owl:Class ;
                              rdfs:subClassOf pmdco:Geometry_Changing_Process ;
                              rdfs:comment "This class is used as an example of SWRL based reasoning. An instance belongs to the class if there are two embracing processes (previous and next) that determine different values after a length measurement (see SWRL rule)." ;
                              rdfs:isDefinedBy "https://w3id.org/pmd/co" ;
                              rdfs:label "Length Changing Process"@en ;
                              skos:definition "A geometry changing process which changes the length characteristic of an object."@en .


###  https://w3id.org/pmd/co/Lnge
pmdco:Lnge rdf:type owl:Class ;
           rdfs:subClassOf chips:Quantity_Kind ,
                           chips:Spatial_Concept ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty pmdco:characteristic ;
                             owl:someValuesFrom chips:Scalar
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty pmdco:characteristic ;
                             owl:someValuesFrom <https://w3id.org/CHIPS/metrology-ontology/1D>
                           ] ;
           rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
           rdfs:label "Length"@en ,
                      "Länge"@de ;
           skos:definition "A measured distance or dimension of an object, usually the longer or longest dimension of the object."@en ,
                           "Eine gemessene Entfernung oder Abmessung eines Objekts, normalerweise die längere oder längste Abmessung des Objekts."@de ;
           pmdco:definitionSource "https://www.merriam-webster.com/dictionary/length"@de .


###  https://w3id.org/pmd/co/Load_Cell
pmdco:Load_Cell rdf:type owl:Class ;
                rdfs:subClassOf chips:Mechanical_Testing_Instrument ;
                rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                rdfs:label "Kraftmessdose"@de ,
                           "Load Cell"@en ;
                skos:definition "A load cell converts a force such as tension, compression, pressure, or torque into an electrical signal that can be measured and standardized. It is a force transducer. As the force applied to the load cell increases, the electrical signal changes proportionally. The most common types of load cell are pneumatic, hydraulic, and strain gauges."@en ;
                pmdco:definitionSource "https://en.wikipedia.org/wiki/Load_cell"@en .


###  https://w3id.org/pmd/co/Load_cell_capacity
pmdco:Load_cell_capacity rdf:type owl:Class ;
                         rdfs:subClassOf pmdco:Node_Info ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty pmdco:characteristic_of ;
                                           owl:someValuesFrom pmdco:Load_Cell
                                         ] ;
                         rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                         rdfs:label "Load cell capacity"@en .


###  https://w3id.org/pmd/co/Major_axis_diameter
pmdco:Major_axis_diameter rdf:type owl:Class ;
                          rdfs:subClassOf pmdco:Durchmesser ;
                          rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                          rdfs:label "Hauptachsendurchmesser"@de ,
                                     "Major axis diameter"@en ;
                          skos:definition "The longest diameter of an ellipse."@en .


###  https://w3id.org/pmd/co/Manufacture_Process
pmdco:Manufacture_Process rdf:type owl:Class ;
                          rdfs:subClassOf pmdco:Prozess ;
                          rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                          rdfs:label "Herstellungsprozess"@de ,
                                     "Manufacture Process"@en ;
                          skos:definition "A process that is driven by the primary intent to transform objects."@en .


###  https://w3id.org/pmd/co/Manufacturer_Role
pmdco:Manufacturer_Role rdf:type owl:Class ;
                        rdfs:subClassOf chips:Agent_Role ;
                        rdfs:label "Manufacturer Role"@en ;
                        skos:definition "A role indicating that its bearer is a manufacturer. The role is realized in a manufacturing process."@en .


###  https://w3id.org/pmd/co/Manufacturing_Node
pmdco:Manufacturing_Node rdf:type owl:Class ;
                         rdfs:subClassOf pmdco:Prozessknoten ;
                         rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                         rdfs:label "Herstellungsknoten"@de ,
                                    "Manufacturing Node"@en ;
                         skos:definition """A processing node that implements transformative processes as well as consumes and creates tangible objects and typically requires inputs
In general but not necessarily, a manufacture node includes intrinsic analysis nodes that create corresponding measurements with respect to the process implemented by the manufacture node."""@en .


###  https://w3id.org/pmd/co/Masse_Anteil
pmdco:Masse_Anteil rdf:type owl:Class ;
                   rdfs:subClassOf pmdco:Fraction ;
                   rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                   rdfs:label "Mass Fraction"@en ,
                              "Masse Anteil"@de ;
                   skos:definition "This value object describes one of several portions of the property of a body that is a measure of the amount of material it contains and causes it to have weight in a gravitational field."@en .


###  https://w3id.org/pmd/co/Materialeigenschaft
pmdco:Materialeigenschaft rdf:type owl:Class ;
                          rdfs:subClassOf chips:Property ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty prov:influenced ;
                                            owl:someValuesFrom chips:Mechanical_Property
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty prov:wasDerivedFrom ;
                                            owl:someValuesFrom chips:Material
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty prov:wasInfluencedBy ;
                                            owl:someValuesFrom chips:Defect
                                          ] ;
                          rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                          rdfs:label "Material Property"@en ,
                                     "Materialbezug"@de ,
                                     "Materialeigenschaft"@de ;
                          skos:definition "A materials property is an intensive property of a material, i.e., a physical property that does not depend on the amount of the material. These quantitative properties may be used as a metric by which the benefits of one material versus another can be compared, thereby aiding in materials selection."@en ,
                                          "Diese Klasse dient der qualitativen und quantitativen Beschreibung eines Materials, indem sie Informationen über ein Material angibt, z. B. durch die Einbeziehung von Materialeigenschaften, Materialstruktur usw."@de ,
                                          "Eine Materialeigenschaft ist eine intensive Eigenschaft eines Materials, d. h. eine physikalische Eigenschaft, die nicht von der Menge des Materials abhängt. Diese quantitativen Eigenschaften können als Maßstab verwendet werden, um die Vorteile eines Materials mit denen eines anderen zu vergleichen und so die Materialauswahl zu erleichtern."@de ,
                                          "This property is used to qualitatively and quantitatively describe a material by providing information on a material, e.g., by including material properties, material structure, etc."@en ;
                          pmdco:definitionSource "“List of materials properties.” Wikipedia The Free Encyclopedia, https://en.wikipedia.org/wiki/List_of_materials_properties. Accessed 13 Jan. 2023."@en .


###  https://w3id.org/pmd/co/Materialstruktur
pmdco:Materialstruktur rdf:type owl:Class ;
                       rdfs:subClassOf chips:Material ,
                                       chips:Physical_Property ;
                       rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                       rdfs:label "Material Structure"@en ,
                                  "Materialstruktur"@de ;
                       skos:definition "Die relevante Struktur von Materialien hat je nach Material eine unterschiedliche Längenskala. Die Struktur und Zusammensetzung eines Materials kann durch Mikroskopie oder Spektroskopie bestimmt werden."@de ,
                                       "The relevant structure of materials has a different length scale depending on the material. The structure and composition of a material can be determined by microscopy or spectroscopy."@en ;
                       pmdco:definitionSource "“Material - Classification by structure.” Wikipedia The Free Encyclopedia, https://en.wikipedia.org/wiki/Material#Classification_by_structure. Accessed 13 Jan. 2023."@en .


###  https://w3id.org/pmd/co/Mechanischer_Testprozess
pmdco:Mechanischer_Testprozess rdf:type owl:Class ;
                               rdfs:subClassOf pmdco:Messprozess ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty chips:measured ;
                                                 owl:someValuesFrom chips:Mechanical_Property
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty pmdco:belongsToProject ;
                                                 owl:someValuesFrom chips:Grand_Challenge_3
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty pmdco:relates_to ;
                                                 owl:someValuesFrom pmdco:Geometry_Changing_Process
                                               ] ;
                               rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                               rdfs:label "Mechanical Testing Process"@en ,
                                          "Mechanischer Testprozess"@de ;
                               skos:definition "A mechanical testing process ia process that determines mechanical properties."@en .


###  https://w3id.org/pmd/co/Medienbewegung
pmdco:Medienbewegung rdf:type owl:Class ;
                     rdfs:subClassOf pmdco:Ofencharakteristik ;
                     rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                     rdfs:label "Media Movement"@en ,
                                "Medienbewegung"@de ;
                     skos:definition "Displacement of media surrounding objects inside the system boundaries of a processing node."@en ;
                     skos:example "Circulation of a gaseous media within the systems boundaries."@en .


###  https://w3id.org/pmd/co/Medium
pmdco:Medium rdf:type owl:Class ;
             rdfs:subClassOf chips:Matter ;
             rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
             rdfs:label "Medium"@de ,
                        "Medium"@en ;
             skos:definition "Substance that surrounds an object inside the system boundaries of a processing node."@en .


###  https://w3id.org/pmd/co/Messgert
pmdco:Messgert rdf:type owl:Class ;
               rdfs:subClassOf chips:Instrument ;
               rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
               rdfs:label "Measuring Device"@en ,
                          "Messgerät"@de ;
               skos:definition "A processing node capable of determining a specific quality." .


###  https://w3id.org/pmd/co/Messprozess
pmdco:Messprozess rdf:type owl:Class ;
                  rdfs:subClassOf chips:Characterization_Process ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty prov:wasInfluencedBy ;
                                    owl:someValuesFrom chips:Metrology
                                  ] ;
                  rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                  rdfs:label "Measuring Process"@en ,
                             "Messprozess"@de ;
                  skos:definition "A measurement process is a characterization process that systematically acquires quantitative or qualitative data about a property of a system, material, or device through the controlled application of instruments, sensors, or analytical methods."@en ;
                  pmdco:definitionSource "claude-opus-4-6"@en .


###  https://w3id.org/pmd/co/Messschieber
pmdco:Messschieber rdf:type owl:Class ;
                   rdfs:subClassOf pmdco:Dimensionsmesswerkzeug ;
                   rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                   rdfs:label "Caliper"@en ,
                              "Messschieber"@de ;
                   skos:definition "any of various measuring instruments having two usually adjustable arms, legs, or jaws used especially to measure the dimensions of objects, such as diameters or thicknesses"@en ,
                                   "ein Messgerät mit zwei in der Regel verstellbaren Armen, Schenkeln oder Klemmbacken, das vor allem zur Messung der Abmessungen von Gegenständen, wie z. B. des Durchmessers oder der Dicke, verwendet wird"@de ;
                   pmdco:definitionSource "https://www.merriam-webster.com/dictionary/caliper"@en .


###  https://w3id.org/pmd/co/Messwert
pmdco:Messwert rdf:type owl:Class ;
               rdfs:subClassOf pmdco:Wertobjekt ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty prov:wasAttributedTo ;
                                 owl:someValuesFrom chips:Digital_Twin
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty prov:wasGeneratedBy ;
                                 owl:someValuesFrom pmdco:Messprozess
                               ] ;
               rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
               rdfs:label "Measurement"@en ,
                          "Messwert"@de ;
               skos:definition """Die Wertekategorie Messung ermöglicht die Kategorisierung von ValueObjects als gemessen.
Messung ist die Quantifizierung von Eigenschaften eines Objekts oder Ereignisses, die zum Vergleich mit anderen Objekten oder Ereignissen verwendet werden können."""@de ,
                               """The ValueScope category Measurement enables the categorization of ValueObjects as measured.
Measurement is the quantification of attributes of an object or event, which can be used to compare with other objects or events."""@en ,
                               "This value scope describes that a :ValueObject is the quantification of attributes of an object or event, which can be used to compare with other objects or events."@en ;
               pmdco:definitionSource "https://en.wikipedia.org/wiki/Measurement"@en .


###  https://w3id.org/pmd/co/Metadaten
pmdco:Metadaten rdf:type owl:Class ;
                rdfs:subClassOf pmdco:Digital_Entity ,
                                [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                         owl:onProperty prov:wasAttributedTo ;
                                                         owl:someValuesFrom chips:Electronic_Lab_Notebook
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty prov:wasGeneratedBy ;
                                                         owl:someValuesFrom chips:Grand_Challenge_4
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty pmdco:characteristic_of ;
                                  owl:someValuesFrom pmdco:Wertekategorie
                                ] ;
                owl:disjointWith pmdco:Primrdaten ;
                rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                rdfs:label "Metadata"@en ,
                           "Metadaten"@de ;
                skos:definition "Metadata is a digital entity that provides structured descriptive, administrative, or provenance information about other data or resources, enabling their discovery, assessment, and interpretation."@en ;
                pmdco:definitionSource "claude-opus-4-6"@en .


###  https://w3id.org/pmd/co/Metallic_Bond
pmdco:Metallic_Bond rdf:type owl:Class ;
                    rdfs:subClassOf pmdco:Chemical_Bond ;
                    rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                    rdfs:label "Metallbindung"@de ,
                               "Metallic Bond"@en ;
                    skos:definition "Metallic bond is the chemical bond typical of the metallic state and characterized by mobile valence electrons that hold the atoms together usually in crystal lattices and are responsible for the good electrical and heat conductivity of metals."@en ,
                                    "Metallische Bindung ist die für den metallischen Zustand typische chemische Bindung, die durch bewegliche Valenzelektronen gekennzeichnet ist, die die Atome in der Regel in Kristallgittern zusammenhalten und für die gute elektrische und Wärmeleitfähigkeit von Metallen verantwortlich sind."@de ;
                    pmdco:definitionSource "\"Metallic bond.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/metallic%20bond. Accessed 13 Jan. 2023."@en .


###  https://w3id.org/pmd/co/Micrometer_Gauge
pmdco:Micrometer_Gauge rdf:type owl:Class ;
                       rdfs:subClassOf pmdco:Dimensionsmesswerkzeug ;
                       rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                       rdfs:label "Bügelmessschraube"@de ,
                                  "Micrometer Gauge"@en ;
                       skos:definition "Diese Entität beschreibt ein Werkzeug zur Durchführung präziser Messungen mit einer Spindel, die durch eine Feingewindeschraube bewegt wird."@de ,
                                       "This entity describes a tool for making precise measurements having a spindle moved by a finely threaded screw."@en ;
                       pmdco:definitionSource "https://www.merriam-webster.com/dictionary/micrometer%20caliper"@en .


###  https://w3id.org/pmd/co/Mikroskop
pmdco:Mikroskop rdf:type owl:Class ;
                rdfs:subClassOf chips:Instrument ;
                rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                rdfs:label "Microscope"@en ,
                           "Mikroskop"@de ;
                skos:definition "An optical instrument consisting of a lens or combination of lenses for making enlarged images of minute objects."@en ;
                pmdco:definitionSource "“Microscope.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/microscope. Accessed 5 Dec. 2022."@en .


###  https://w3id.org/pmd/co/Mikroskopie
pmdco:Mikroskopie rdf:type owl:Class ;
                  rdfs:subClassOf chips:Imaging_Process ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty chips:measured ;
                                    owl:someValuesFrom chips:Morphology
                                  ] ;
                  rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                  rdfs:label "Microscopy Process"@en ,
                             "Mikroskopie"@de ;
                  skos:definition "An analysing process in which an investigation is made with a microscope."@en ;
                  pmdco:definitionSource "“Microscopy.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/microscopy. Accessed 24 Nov. 2022."@en .


###  https://w3id.org/pmd/co/Minor_axis_diameter
pmdco:Minor_axis_diameter rdf:type owl:Class ;
                          rdfs:subClassOf pmdco:Durchmesser ;
                          rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                          rdfs:label "Halbachsendurchmesser"@de ,
                                     "Minor axis diameter"@en ;
                          skos:definition "The shortest diameter of an ellipse."@en .


###  https://w3id.org/pmd/co/Modulus_Of_Elasticity
pmdco:Modulus_Of_Elasticity rdf:type owl:Class ;
                            rdfs:subClassOf chips:Mechanical_Property ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty prov:wasGeneratedBy ;
                                              owl:someValuesFrom chips:Derived_Process
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty chips:measuredBy ;
                                              owl:someValuesFrom pmdco:Messprozess
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty pmdco:characteristic ;
                                              owl:someValuesFrom chips:Measurand
                                            ] ;
                            rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                            rdfs:label "Elastizitätsmodul"@de ,
                                       "Modulus Of Elasticity"@en ;
                            skos:altLabel "E-Modul"@de ,
                                          "Elastic Modulus"@en ;
                            skos:definition """Quotient der Änderung der Spannung ΔR und Änderung der prozentualen Dehnung Δe in dem untersuchten Bereich multipliziert mit 100 % 

Anmerkung: Es wird empfohlen, den Wert in GPa, gerundet auf 0,1 GPa, und nach ISO 80000-1 anzugeben."""@de ,
                                            """quotient of change of stress ΔR and change of percentage extension Δe in the range of evaluation, multiplied by 100 %

Note: It is recommended to report the value in GPa rounded to the nearest 0.1 GPa and according to ISO 80000-1."""@en ;
                            pmdco:definitionSource "DIN EN ISO 6892-1:2019"@en ;
                            pmdco:symbol "E" .


###  https://w3id.org/pmd/co/Mounting_Process
pmdco:Mounting_Process rdf:type owl:Class ;
                       rdfs:subClassOf pmdco:Assembling_Process ;
                       rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                       rdfs:label "Montageprozess"@de ,
                                  "Mounting Process"@en ;
                       skos:definition "An assembly process in which a test piece or specimen is installed or otherwise integrated into a testing machine. This may also include the use of other processing nodes and components (e.g. grips)."@en .


