                               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Cyclic_Voltammetry
chips:Cyclic_Voltammetry rdf:type owl:Class ;
                         rdfs:subClassOf chips:Voltammetry ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty prov:generated ;
                                           owl:someValuesFrom chips:Voltammogram
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty chips:measured ;
                                           owl:someValuesFrom [ owl:intersectionOf ( [ rdf:type owl:Class ;
                                                                                       owl:unionOf ( chips:Capacitance
                                                                                                     chips:Impedence
                                                                                                   )
                                                                                     ]
                                                                                     [ rdf:type owl:Restriction ;
                                                                                       owl:onProperty prov:wasAssociatedWith ;
                                                                                       owl:someValuesFrom chips:Interface
                                                                                     ]
                                                                                   ) ;
                                                                rdf:type owl:Class
                                                              ]
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty pmdco:belongsToProject ;
                                           owl:someValuesFrom [ rdf:type owl:Class ;
                                                                owl:unionOf ( chips:Grand_Challenge_2
                                                                              chips:Grand_Challenge_7
                                                                            )
                                                              ]
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty pmdco:characteristic ;
                                           owl:someValuesFrom [ owl:intersectionOf ( [ owl:intersectionOf ( chips:Dependent_Variable
                                                                                                            [ rdf:type owl:Restriction ;
                                                                                                              owl:onProperty pmdco:composed_of ;
                                                                                                              owl:someValuesFrom mo:Strom
                                                                                                            ]
                                                                                                          ) ;
                                                                                       rdf:type owl:Class
                                                                                     ]
                                                                                     [ owl:intersectionOf ( chips:Independent_Variable
                                                                                                            [ rdf:type owl:Restriction ;
                                                                                                              owl:onProperty pmdco:composed_of ;
                                                                                                              owl:someValuesFrom [ owl:intersectionOf ( pmdco:Zeit
                                                                                                                                                        mo:Spannung
                                                                                                                                                      ) ;
                                                                                                                                   rdf:type owl:Class
                                                                                                                                 ]
                                                                                                            ]
                                                                                                          ) ;
                                                                                       rdf:type owl:Class
                                                                                     ]
                                                                                   ) ;
                                                                rdf:type owl:Class
                                                              ]
                                         ] ;
                         rdfs:label "Cyclic Voltammetry"@en ;
                         skos:definition "Cyclic Voltammetry is a voltammetric electrochemical technique in which the electrode potential is swept linearly between two limits at a fixed scan rate and the resulting current is recorded, revealing oxidation and reduction potentials of electroactive species."@en ;
                         pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Cyclical_Process
chips:Cyclical_Process rdf:type owl:Class ;
