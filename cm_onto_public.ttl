                                                   owl:someValuesFrom chips:Grand_Challenge_7
                                                 ] ;
                                 rdfs:label "Circularity Design Process"@en ;
                                 skos:definition "Circularity Design Process is a design methodology that integrates principles of circular economy into product development, aiming to minimize waste, enable material recovery, and extend product lifetime."@en ;
                                 pmdco:definitionSource "claude-sonnet-4-6"@en .


