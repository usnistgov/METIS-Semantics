               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Molar_Volume
chips:Molar_Volume rdf:type owl:Class ;
                   rdfs:subClassOf chips:Chemical_Property ,
                                   pmdco:Materialeigenschaft ;
                   rdfs:label "Molar Volume"@en ;
                   skos:definition "Molar volume is the volume occupied by one mole of a substance, used to characterize the packing density of crystal structures and calculate phase compositions from lattice parameters."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Molecular_Beam_Epitaxy
chips:Molecular_Beam_Epitaxy rdf:type owl:Class ;
                             rdfs:subClassOf chips:Deposition_and_Film_Growth ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty prov:generated ;
                                               owl:someValuesFrom [ owl:intersectionOf ( chips:Film
                                                                                         [ rdf:type owl:Restriction ;
                                                                                           owl:onProperty pmdco:characteristic ;
                                                                                           owl:someValuesFrom chips:Epitaxiality
                                                                                         ]
                                                                                       ) ;
                                                                    rdf:type owl:Class
                                                                  ]
                                             ] ;
                             rdfs:label "Molecular Beam Epitaxy"@en ;
                             skos:definition "Molecular Beam Epitaxy (MBE) is a thin film epitaxial growth process conducted in ultra-high vacuum in which directed thermal beams of atoms or molecules impinge on a heated crystalline substrate to grow single-crystal films with atomic-layer precision."@en ;
                             pmdco:abbreviation "MBE" ;
                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Molecular_Beam_Epitaxy_Tool
chips:Molecular_Beam_Epitaxy_Tool rdf:type owl:Class ;
                                  rdfs:subClassOf chips:Deposition_Tool ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty prov:wasAssociateFor ;
                                                    owl:someValuesFrom chips:Grand_Challenge_4
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty prov:wasAssociateFor ;
                                                    owl:someValuesFrom chips:Molecular_Beam_Epitaxy
                                                  ] ;
                                  rdfs:label "Molecular Beam Epitaxy Tool"@en ;
                                  skos:definition "Molecular Beam Epitaxy Tool is a high-vacuum fabrication instrument in which effusion cells evaporate elemental sources to produce directed molecular beams that impinge on a heated substrate, enabling layer-by-layer epitaxial thin film growth."@en ;
                                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Molecular_Dynamics_Simulation
chips:Molecular_Dynamics_Simulation rdf:type owl:Class ;
