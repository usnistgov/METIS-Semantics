###  https://w3id.org/pmd/co/Projektidentifikator
pmdco:Projektidentifikator rdf:type owl:Class ;
                           rdfs:subClassOf [ owl:intersectionOf ( pmdco:Identifikator
                                                                  [ rdf:type owl:Restriction ;
