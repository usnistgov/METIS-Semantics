                                                    rdfs:subClassOf mo:Scanning_Probe_Microscopy ;
                                                    rdfs:label "Electrochemical Scanning Tunneling Microscopy"@en ;
                                                    skos:definition "Electrochemical Scanning Tunneling Microscopy (EC-STM) is a scanning probe technique that operates a tunneling microscope with the tip and sample immersed in an electrolyte under potential control, enabling atomic-resolution imaging of electrode surfaces during electrochemical reactions."@en ;
                                                    pmdco:abbreviation "ECSTM"@en ;
                                                    pmdco:definitionSource "claude-sonnet-4-6"@en .


