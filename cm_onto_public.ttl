                              pmdco:abbreviation "ELN"@en ;
                              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Electronic_Structure
chips:Electronic_Structure rdf:type owl:Class ;
                           rdfs:subClassOf chips:Electromagnetic_Property ,
                                           pmdco:Materialeigenschaft ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty chips:calculatedBy ;
                                             owl:someValuesFrom chips:Computational_Process
                                           ] ;
                           rdfs:label "Electronic Structure"@en ;
                           skos:definition "Electronic structure is the distribution of electrons among the allowed energy levels of a material or molecule, determining its optical, electrical, and chemical properties."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Electronic_Transition
chips:Electronic_Transition rdf:type owl:Class ;
                            rdfs:subClassOf chips:Electric_Property ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty pmdco:characteristic ;
                                              owl:someValuesFrom chips:Derived_Data
                                            ] ;
                            rdfs:label "Electronic Transition"@en ;
                            skos:definition "An electronic transition is a quantum mechanical event in which an electron changes from one energy level to another within an atom, molecule, or solid, accompanied by the absorption or emission of a photon or energy transfer."@en ;
                            pmdco:definitionSource "claude-opus-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Electrostatic_Potential
chips:Electrostatic_Potential rdf:type owl:Class ;
                              rdfs:subClassOf chips:Electric_Potential ,
                                              [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                       owl:onProperty pmdco:characteristic ;
                                                                       owl:someValuesFrom chips:Electric_Field
                                                                     ]
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty pmdco:characteristic_of ;
                                                                       owl:someValuesFrom chips:Solid
                                                                     ]
                                                                   ) ;
                                                rdf:type owl:Class
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty pmdco:relates_to ;
                                                owl:someValuesFrom chips:Electric_Field
                                              ] ;
                              rdfs:label "Electrostatic Potential"@en ;
                              skos:definition "Electrostatic potential is the potential energy per unit charge at a point in space due to the configuration of static charges, governing band bending and carrier distribution in semiconductor devices."@en ;
                              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Element_Identification
chips:Element_Identification rdf:type owl:Class ;
                             rdfs:subClassOf chips:Identification_Process ;
                             rdfs:label "Element Identification"@en ;
                             skos:definition "Element Identification is an identification process that determines the elemental composition of a material by measuring characteristic emission lines, absorption edges, or mass-to-charge ratios of its constituent atoms."@en ;
                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Elemental_Composition
chips:Elemental_Composition rdf:type owl:Class ;
                            rdfs:subClassOf chips:Physical_Property ;
                            rdfs:label "Elemental Composition"@en ;
                            skos:definition "Elemental composition is the specification of which chemical elements are present in a material and their relative concentrations, determined by analytical techniques such as XRF, EDX, or SIMS."@en ;
                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Elemental_Map
chips:Elemental_Map rdf:type owl:Class ;
                    rdfs:subClassOf chips:Composition_Map ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty prov:wasGeneratedBy ;
                                      owl:someValuesFrom chips:Imaging_Process
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty prov:wasGeneratedBy ;
                                      owl:someValuesFrom chips:Tomography_Process
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty prov:wasGeneratedBy ;
                                      owl:someValuesFrom mo:Spectroscopy
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty pmdco:characteristic ;
                                      owl:someValuesFrom chips:Atomic_Map
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty pmdco:characteristic ;
                                      owl:someValuesFrom chips:Chemical_Map
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty pmdco:relates_to ;
                                      owl:someValuesFrom mo:Xray_Analysis
                                    ] ;
                    rdfs:label "Elemental Map"@en ;
                    skos:definition "Elemental Map is a spatially resolved image in which signal intensity represents the local concentration of a specific element across a material cross-section or surface, obtained by energy-dispersive X-ray spectroscopy or related techniques."@en ;
                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Elemental_Sensitivity
chips:Elemental_Sensitivity rdf:type owl:Class ;
                            rdfs:subClassOf chips:Sensitivity ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty prov:influenced ;
                                              owl:someValuesFrom chips:Element_Identification
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty prov:wasAttributedTo ;
                                              owl:someValuesFrom mo:Spektrometer
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty pmdco:characteristic_of ;
                                              owl:someValuesFrom mo:SiliziumDriftdetektor
                                            ] ;
                            rdfs:label "Elemental Sensitivity"@en ;
                            skos:definition "Elemental Sensitivity is a measurement property expressing the minimum detectable concentration or mass of a specific element that a given analytical technique can reliably quantify above the background noise."@en ;
                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Elementspecific_Heat_Flow
chips:Elementspecific_Heat_Flow rdf:type owl:Class ;
                                rdfs:subClassOf chips:Heat_Transfer ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty pmdco:characteristic_of ;
                                                  owl:someValuesFrom chips:Chemical_Element
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty pmdco:output_of ;
                                                  owl:someValuesFrom chips:Derived_Process
                                                ] ;
                                rdfs:label "Element-specific Heat Flow"@en ;
                                skos:definition "Element-specific heat flow is the thermal energy transported through a specific elemental constituent of a composite or multilayer structure, resolved by element-selective measurement techniques."@en ;
                                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Ellipsometer
chips:Ellipsometer rdf:type owl:Class ;
                   rdfs:subClassOf chips:Optical_Measuring_Device ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty prov:generated ;
                                     owl:someValuesFrom chips:Ellipsometry_Data
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty prov:wasAssociateFor ;
                                     owl:someValuesFrom chips:Ellipsometry
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty chips:measured ;
                                     owl:someValuesFrom [ rdf:type owl:Class ;
                                                          owl:unionOf ( chips:Film_Thickness
                                                                        chips:Surface_Roughness
                                                                      )
                                                        ]
                                   ] ;
                   rdfs:label "Ellipsometer"@en ;
                   skos:definition "Ellipsometer is an optical measuring device that analyzes the change in polarization state of light reflected from a surface to determine the optical constants and thickness of thin film layers."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Ellipsometry
chips:Ellipsometry rdf:type owl:Class ;
                   rdfs:subClassOf chips:Optical_Measuring_Process ,
                                   chips:Scattering ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty prov:wasAssociatedWith ;
                                     owl:someValuesFrom chips:Ellipsometer
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty chips:measured ;
                                     owl:someValuesFrom chips:Film_Thickness
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty pmdco:characteristic ;
                                     owl:someValuesFrom <https://w3id.org/CHIPS/metrology-ontology/1D>
                                   ] ;
                   rdfs:label "Ellipsometry"@en ;
                   skos:definition "Ellipsometry is an optical measurement technique that determines the optical constants and thickness of thin films by analyzing the change in polarization state of a light beam upon oblique reflection from a surface."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Ellipsometry_Data
chips:Ellipsometry_Data rdf:type owl:Class ;
                        rdfs:subClassOf chips:Spectrum ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty prov:wasAttributedTo ;
                                          owl:someValuesFrom chips:Ellipsometer
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty prov:wasGeneratedBy ;
                                          owl:someValuesFrom chips:Ellipsometry
                                        ] ;
                        rdfs:label "Ellipsometry Data"@en ;
                        skos:definition "Ellipsometry data is a dataset of ellipsometric angles (Ψ, Δ) as a function of wavelength or angle of incidence, used to determine optical constants and thickness of thin films."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Empirical_Model
chips:Empirical_Model rdf:type owl:Class ;
                      rdfs:subClassOf chips:Model ;
                      rdfs:label "Empirical Model"@en ;
                      skos:definition "Empirical Model is a mathematical model whose form and parameters are derived primarily from fitting to experimental data rather than from first-principles physical theory."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


