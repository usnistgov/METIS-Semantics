###  https://w3id.org/CHIPS/metrology-ontology/Concentration
chips:Concentration rdf:type owl:Class ;
                    rdfs:subClassOf chips:Chemical_Property ,
                                    chips:Physical_Property ;
                    rdfs:label "Concentration"@en ;
                    skos:definition "Concentration is a property quantifying the relative amount of a constituent, whether chemical species, particles, or other entities, within a defined volume, area, or mass of a mixture or medium."@en ;
                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Concentration_Process
chips:Concentration_Process rdf:type owl:Class ;
                            rdfs:subClassOf mo:Physikalischer_Prozess ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty pmdco:relates_to ;
                                              owl:someValuesFrom chips:Separation_Process
                                            ] ;
                            rdfs:label "Concentration Process"@en ;
                            skos:definition "Concentration Process is a physical or chemical process that increases the concentration of a target species in a sample or on a surface to enhance detection sensitivity."@en ;
                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Conceptual_Entity
chips:Conceptual_Entity rdf:type owl:Class ;
                        rdfs:subClassOf prov:Entity ;
                        rdfs:label "Conceptual Entity"@en ;
                        skos:definition "Conceptual Entity is an abstract entity defined within a formal knowledge or ontological framework, representing a concept, idea, or relationship rather than a tangible physical object."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Conductance
chips:Conductance rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty chips:isMathematicalInverseOf ;
                                        owl:someValuesFrom chips:Resistance
                                      ] ;
                  rdfs:subClassOf chips:Electric_Property ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty prov:hadDerivation ;
                                    owl:someValuesFrom chips:Conductivity
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty pmdco:characteristic ;
                                    owl:someValuesFrom chips:Direct_Current
                                  ] ;
                  rdfs:label "Conductance"@en ;
                  skos:definition "Conductance is a direct current electrical property defined as the reciprocal of resistance, measuring the ease with which current flows through a conductor or semiconductor element."@en ;
                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Conductivity
chips:Conductivity rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty chips:isMathematicalInverseOf ;
                                         owl:someValuesFrom chips:Resistivity
                                       ] ;
                   rdfs:subClassOf chips:Electric_Property ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty chips:hasMathematicalRelationshipWith ;
                                     owl:someValuesFrom chips:Conductance
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty pmdco:characteristic ;
                                     owl:someValuesFrom chips:Direct_Current
                                   ] ;
                   rdfs:label "Conductivity"@en ;
                   skos:definition "Conductivity is a material property defined as the reciprocal of resistivity, measuring the ability of a material to conduct electric current per unit cross-sectional area per unit applied field."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Conference_and_Workshop
chips:Conference_and_Workshop rdf:type owl:Class ;
                              rdfs:subClassOf prov:Activity ;
                              rdfs:label "Conference and Workshop"@en ;
                              skos:definition "Conference and Workshop is an organized activity in which researchers and practitioners convene to present, discuss, and exchange scientific and technical results in a specific domain."@en ;
                              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Confidence_Concept
chips:Confidence_Concept rdf:type owl:Class ;
                         rdfs:subClassOf chips:Conceptual_Entity ,
                                         pmdco:Wertekategorie ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty pmdco:characteristic ;
                                           owl:someValuesFrom chips:Distribution
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty pmdco:characteristic ;
                                           owl:someValuesFrom pmdco:Wertobjekt
                                         ] ;
                         rdfs:label "Confidence Concept"@en ;
                         skos:definition "Confidence Concept is a conceptual entity that quantifies the degree of certainty or reliability associated with a measurement result, model prediction, or assigned classification."@en ;
                         pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Consensus_Model
chips:Consensus_Model rdf:type owl:Class ;
                      rdfs:subClassOf chips:Model ;
                      rdfs:label "Consensus Model"@en ;
                      skos:definition "Consensus Model is a model that combines the predictions of multiple independent models or expert judgements using averaging or voting schemes to improve robustness and reduce individual model bias."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Consortium
chips:Consortium rdf:type owl:Class ;
                 rdfs:subClassOf prov:Organization ;
                 rdfs:label "Consortium"@en ;
                 skos:definition "Consortium is an organization formed by an association of independent entities—companies, universities, or government agencies—that cooperate on a defined project or research program while retaining their individual identities."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Constant
chips:Constant rdf:type owl:Class ;
               rdfs:subClassOf pmdco:Wertobjekt ;
               rdfs:label "Constant"@en ;
               skos:definition "A constant is a fixed numerical value object that does not change within the context of a given model or calculation, used to parameterize physical laws, material properties, or mathematical relationships."@en ;
               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Contact_Angle_Measurement
chips:Contact_Angle_Measurement rdf:type owl:Class ;
                                rdfs:subClassOf pmdco:Mechanischer_Testprozess ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty chips:measured ;
                                                  owl:someValuesFrom chips:Adhesion
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty chips:measured ;
                                                  owl:someValuesFrom chips:Surface_Energy
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty pmdco:belongsToProject ;
                                                  owl:someValuesFrom chips:Grand_Challenge_2
                                                ] ;
                                rdfs:label "Contact Angle Measurement"@en ;
                                skos:definition "Contact Angle Measurement is a mechanical surface test that quantifies the wettability of a solid surface by measuring the angle formed between a sessile liquid droplet and the substrate at the three-phase contact line."@en ;
                                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Contact_Resonance_Microscopy
chips:Contact_Resonance_Microscopy rdf:type owl:Class ;
                                   rdfs:subClassOf mo:Scanning_Probe_Microscopy ;
                                   rdfs:label "Contact Resonance Microscopy"@en ;
                                   skos:definition "Contact Resonance Microscopy is a scanning probe microscopy technique that measures the contact resonance frequency of a vibrating cantilever tip pressed against a surface to map local elastic and viscoelastic properties at the nanoscale."@en ;
                                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Contaminant
chips:Contaminant rdf:type owl:Class ;
                  rdfs:subClassOf chips:Material ;
                  rdfs:label "Contaminant"@en ;
                  skos:definition "A contaminant is an unwanted substance present in a material, process environment, or on a device surface that degrades performance, introduces defects, or compromises measurement accuracy."@en ;
                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Contaminant_Identification
chips:Contaminant_Identification rdf:type owl:Class ;
                                 rdfs:subClassOf chips:Identification_Process ;
                                 rdfs:label "Contaminant Identification"@en ;
                                 skos:definition "Contaminant Identification is an identification process that determines the chemical identity, concentration, and spatial distribution of unwanted trace species in a material, device, or environment."@en ;
                                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Continuum_Simulation
chips:Continuum_Simulation rdf:type owl:Class ;
                           rdfs:subClassOf pmdco:Simulationsprozess ;
                           rdfs:label "Continuum Simulation"@en ;
                           skos:definition "Continuum Simulation is a computational simulation process that models a physical system as a continuous medium by solving field equations such as Navier-Stokes, Maxwell's equations, or elastic wave equations on a discretized domain."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Continuum_Software
chips:Continuum_Software rdf:type owl:Class ;
                         rdfs:subClassOf chips:Modeling_and_Simulation_Software ;
                         rdfs:label "Continuum Software"@en ;
                         skos:definition "Continuum Software is a software agent that implements numerical methods such as finite element or finite difference techniques to solve partial differential equations describing continuum physical phenomena."@en ;
                         pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Contrast
chips:Contrast rdf:type owl:Class ;
               rdfs:subClassOf chips:Optic_System_Parameter ;
               skos:definition "Contrast is an optical system parameter quantifying the difference in intensity between the brightest and darkest regions of an image, determining the visibility of features in microscopy."@en ;
               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Controller
chips:Controller rdf:type owl:Class ;
                 rdfs:subClassOf chips:Instrument ;
                 rdfs:label "Controller"@en ;
                 skos:definition "Controller is an instrument that regulates a physical quantity such as temperature, gas flow, or position within a process system by monitoring sensor feedback and adjusting an actuator output."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Convergence_Semiangle
chips:Convergence_Semiangle rdf:type owl:Class ;
                            rdfs:subClassOf chips:Optic_System_Parameter ;
                            rdfs:label "Convergence Semiangle"@en ;
                            skos:definition "Convergence semiangle is the half-angle subtended by the focused electron beam at the specimen plane in STEM, controlling probe size and depth sensitivity."@en ;
                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Convolutional_Neural_Networks
chips:Convolutional_Neural_Networks rdf:type owl:Class ;
                                    rdfs:subClassOf chips:Neural_Network ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty prov:activity ;
                                                      owl:someValuesFrom chips:Grand_Challenge_7
                                                    ] ;
                                    rdfs:label "Convolutional Neural Networks"@en ;
                                    skos:definition "Convolutional Neural Network (CNN) is a neural network architecture that uses learned convolutional filters applied across the spatial or temporal dimensions of an input to extract hierarchical local features for image recognition and signal processing."@en ;
                                    pmdco:abbreviation "CNN"@en ;
                                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Coordinate_Measuring_Machine
chips:Coordinate_Measuring_Machine rdf:type owl:Class ;
                                   rdfs:subClassOf pmdco:Dimensionsmesswerkzeug ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty prov:wasAssociateFor ;
                                                     owl:someValuesFrom chips:Grand_Challenge_3
                                                   ] ;
                                   rdfs:label "Coordinate Measuring Machine"@en ;
                                   skos:definition "Coordinate Measuring Machine (CMM) is a dimensional measurement instrument that determines the three-dimensional coordinates of points on a workpiece surface using a contact probe or non-contact sensor to verify geometric tolerances."@en ;
                                   pmdco:abbreviation "CMM"@en ;
                                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Coordinates_and_Location
chips:Coordinates_and_Location rdf:type owl:Class ;
                               rdfs:subClassOf chips:Quantity_Kind ,
                                               chips:Spatial_Concept ,
                                               [ rdf:type owl:Restriction ;
