###  https://w3id.org/pmd/co/Simulationsprozess
pmdco:Simulationsprozess rdf:type owl:Class ;
                         rdfs:subClassOf chips:Computational_Process ,
                                         [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                  owl:onProperty prov:wasAssociatedWith ;
                                                                  owl:someValuesFrom [ owl:intersectionOf ( chips:Independent_Variable
                                                                                                            [ rdf:type owl:Restriction ;
                                                                                                              owl:onProperty pmdco:relates_to ;
                                                                                                              owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                                                                   owl:unionOf ( chips:Geometry
                                                                                                                                                 pmdco:Materialeigenschaft
                                                                                                                                                 [ owl:intersectionOf ( pmdco:Optisch
                                                                                                                                                                        [ rdf:type owl:Restriction ;
                                                                                                                                                                          owl:onProperty pmdco:relates_to ;
                                                                                                                                                                          owl:someValuesFrom mo:Source
                                                                                                                                                                        ]
                                                                                                                                                                      ) ;
                                                                                                                                                   rdf:type owl:Class
                                                                                                                                                 ]
                                                                                                                                               )
                                                                                                                                 ]
                                                                                                            ]
                                                                                                          ) ;
                                                                                       rdf:type owl:Class
                                                                                     ]
                                                                ]
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty pmdco:belongsToProject ;
                                                                  owl:someValuesFrom chips:Grand_Challenge_3
                                                                ]
                                                              ) ;
                                           rdf:type owl:Class
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty prov:wasAssociatedWith ;
                                           owl:someValuesFrom chips:Modeling_Process
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty prov:wasAssociatedWith ;
                                           owl:someValuesFrom chips:Prediction_Process
                                         ] ;
                         rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                         rdfs:label "Simulation Process"@en ,
                                    "Simulationsprozess"@de ;
                         skos:definition "A process that is used for a simulation." .


###  https://w3id.org/pmd/co/Sollwert
pmdco:Sollwert rdf:type owl:Class ;
               rdfs:subClassOf pmdco:Datenkategorie ;
               rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
               rdfs:label "Set Point"@en ,
                          "Sollwert"@de ;
               skos:definition "A setpoint is a data category representing the prescribed target value of a controlled variable in a process or system, against which the actual measured value is compared to determine deviation."@en ;
               pmdco:definitionSource "claude-opus-4-6"@en .


###  https://w3id.org/pmd/co/Spannung
pmdco:Spannung rdf:type owl:Class ;
               rdfs:subClassOf chips:Mechanical_Property ,
                               [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                        owl:onProperty prov:wasGeneratedBy ;
                                                        owl:someValuesFrom chips:Derived_Process
                                                      ]
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty chips:measuredBy ;
                                                        owl:someValuesFrom chips:Grand_Challenge_3
                                                      ]
                                                    ) ;
                                 rdf:type owl:Class
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty chips:calculatedBy ;
                                 owl:someValuesFrom chips:Computational_Process
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty chips:hasMathematicalRelationshipWith ;
                                 owl:someValuesFrom [ owl:intersectionOf ( pmdco:Flche
                                                                           pmdco:Kraft
                                                                         ) ;
                                                      rdf:type owl:Class
                                                    ]
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty chips:measuredBy ;
                                 owl:someValuesFrom pmdco:Messprozess
                               ] ;
               rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
               rdfs:label "Spannung"@de ,
                          "Stress"@en ;
               skos:definition """At any moment during the test, force divided by the original cross-sectional area, S_o, of the test piece

Note: Here, all references to stress are to engineering stress."""@en ,
                               """Dimensional Analysis: 
ML*-1T*-2"""@en ,
                               """Kraft zu einem beliebigen Zeitpunkt während des Versuchs dividiert durch den Anfangsquerschnitt (S_o) der Probe

Anmerkung: Mit dem Begriff Spannung ist hier die technische Spannung ('Ingenieur-Spannung') gemeint."""@de ,
                               "Units: Pa (SI), psi"@en ;
               pmdco:definitionSource "DIN EN ISO 6892-1:2019"@en ;
               pmdco:symbol "R"@en .


###  https://w3id.org/pmd/co/Specimen_Name
pmdco:Specimen_Name rdf:type owl:Class ;
                    rdfs:subClassOf chips:Material_Identifier ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty pmdco:characteristic_of ;
                                      owl:someValuesFrom pmdco:Prfling
                                    ] ;
                    rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                    rdfs:label "Prüfstück Name"@de ,
                               "Specimen Name"@en ;
                    skos:definition "Diese Eigenschaft beschreibt die Bezeichnung eines Prüfstücks, die in der Regel von Menschen als von Menschen lesbarer Identifikator vergeben wird."@de ,
                                    "This property describes the designation of a specimen, usually given as human-readable identifier by humans."@de .


