chips:Optic_System_Parameter rdf:type owl:Class ;
                             rdfs:subClassOf chips:Parameter ;
                             rdfs:label "Optic System Parameter"@en ;
                             skos:definition "Optic System Parameter is a measurable quantity that characterizes the performance or configuration of an optical system, such as numerical aperture, focal length, or point spread function."@en ;
                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Optical_Absorption_Imaging
chips:Optical_Absorption_Imaging rdf:type owl:Class ;
                                 rdfs:subClassOf pmdco:Optische_Mikroskopie ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty chips:measured ;
                                                   owl:someValuesFrom [ owl:intersectionOf ( chips:Partial_Pressure
                                                                                             [ rdf:type owl:Restriction ;
                                                                                               owl:onProperty pmdco:characteristic_of ;
                                                                                               owl:someValuesFrom [ owl:intersectionOf ( chips:Reactant
                                                                                                                                         chips:Reaction_Product
                                                                                                                                       ) ;
                                                                                                                    rdf:type owl:Class
                                                                                                                  ]
                                                                                             ]
                                                                                           ) ;
                                                                        rdf:type owl:Class
                                                                      ]
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty chips:measured ;
                                                   owl:someValuesFrom [ owl:intersectionOf ( chips:Uniformity
                                                                                             [ rdf:type owl:Restriction ;
                                                                                               owl:onProperty pmdco:characteristic_of ;
                                                                                               owl:someValuesFrom chips:Mass_Flow_Process
                                                                                             ]
                                                                                           ) ;
                                                                        rdf:type owl:Class
                                                                      ]
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty pmdco:belongsToProject ;
                                                   owl:someValuesFrom chips:Grand_Challenge_5
                                                 ] ;
                                 rdfs:label "Optical Absorption Imaging"@en ;
                                 skos:definition "Optical Absorption Imaging is an optical microscopy technique that maps the spatial distribution of optical absorption across a specimen by recording transmitted or reflected light intensity at one or more wavelengths."@en ;
                                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Optical_Beam_Induced_Current_Microscopy
chips:Optical_Beam_Induced_Current_Microscopy rdf:type owl:Class ;
                                              rdfs:subClassOf pmdco:Optische_Mikroskopie ;
                                              rdfs:label "Optical Beam Induced Current Microscopy"@en ;
                                              skos:definition "Optical Beam Induced Current (OBIC) Microscopy is an optical microscopy technique that scans a focused laser beam across a semiconductor device and maps the photocurrent generated to image junctions, defects, and minority carrier diffusion lengths."@en ;
                                              pmdco:abbreviation "OBIC Microscopy"@en ;
                                              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Optical_Cantilever_Method
chips:Optical_Cantilever_Method rdf:type owl:Class ;
                                rdfs:subClassOf chips:Cantilever_Bending ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty chips:measured ;
                                                  owl:someValuesFrom [ owl:intersectionOf ( pmdco:Spannung
                                                                                            [ rdf:type owl:Restriction ;
                                                                                              owl:onProperty pmdco:characteristic_of ;
                                                                                              owl:someValuesFrom chips:Film
                                                                                            ]
                                                                                          ) ;
                                                                       rdf:type owl:Class
                                                                     ]
                                                ] ;
                                rdfs:label "Optical Cantilever Method"@en ;
                                skos:definition "Optical Cantilever Method is a mechanical testing technique that uses the optical deflection of a microfabricated cantilever beam to measure adhesion forces, surface energies, or elastic properties at the micro- or nanoscale."@en ;
                                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Optical_Emission_Spectroscopy
chips:Optical_Emission_Spectroscopy rdf:type owl:Class ;
                                    rdfs:subClassOf chips:Optical_Spectroscopy ,
                                                    chips:Plasma_Diagnostic_Process ,
                                                    chips:Spatiallyresolved_Measurement_Process ,
                                                    chips:Temporallyresolved_Measurement_Process ;
                                    rdfs:label "Optical Emission Spectroscopy"@en ;
                                    skos:definition "Optical Emission Spectroscopy (OES) is an analytical technique that measures the wavelengths and intensities of photons emitted by atoms or ions excited in a plasma or flame discharge to identify and quantify elemental composition."@en ;
                                    pmdco:abbreviation "OES"@en ;
                                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Optical_Extinction_Coefficient
chips:Optical_Extinction_Coefficient rdf:type owl:Class ;
                                     rdfs:subClassOf pmdco:Optisch ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty chips:measuredBy ;
                                                       owl:someValuesFrom pmdco:Messprozess
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty chips:hasImaginaryPart ;
                                                       owl:someValuesFrom xsd:float
                                                     ] ;
                                     rdfs:label "Optical Extinction Coefficient"@en ;
                                     skos:definition "Optical extinction coefficient is the imaginary part of the complex refractive index, quantifying the rate of optical power attenuation per unit length as light propagates through a material."@en ;
                                     pmdco:definitionSource "claude-sonnet-4-6"@en ;
                                     pmdco:symbol "k" .


###  https://w3id.org/CHIPS/metrology-ontology/Optical_Frequency_Comb
chips:Optical_Frequency_Comb rdf:type owl:Class ;
                             rdfs:subClassOf chips:Device ,
                                             mo:Optical_Element ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty prov:wasAssociateFor ;
                                               owl:someValuesFrom chips:Frequency_Comb_Spectroscopy
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty pmdco:composed_of ;
                                               owl:someValuesFrom chips:Laser
                                             ] ;
                             rdfs:label "Optical Frequency Comb"@en ;
                             skos:definition "Optical Frequency Comb is a hardware device that generates a spectrum of equally spaced, phase-coherent optical frequency lines, used as a precision ruler in frequency metrology, spectroscopy, and optical clocks."@en ;
                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Optical_Lithography
chips:Optical_Lithography rdf:type owl:Class ;
                          rdfs:subClassOf chips:Lithography ;
                          rdfs:label "Optical Lithography"@en ;
                          skos:definition "Optical Lithography is a lithographic technique that projects or contacts an ultraviolet light image of a mask pattern onto a photosensitive resist layer on a wafer to define micro- and nanoscale features."@en ;
                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Optical_Loss
chips:Optical_Loss rdf:type owl:Class ;
                   rdfs:subClassOf chips:Loss ;
                   rdfs:label "Optical Loss"@en ;
                   skos:definition "Optical loss is the attenuation of optical power as light propagates through a waveguide, fiber, or optical component, arising from absorption, scattering, and coupling inefficiencies."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Optical_Measuring_Device
chips:Optical_Measuring_Device rdf:type owl:Class ;
