                                                                              )
                                                                ]
                                           ] ;
                           rdfs:label "Statistical Analysis"@en ;
                           skos:definition "Statistical Analysis is a data analysis process that applies mathematical statistics to summarize, describe, and draw inferences from datasets, including hypothesis testing, regression, and uncertainty quantification."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


