                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty prov:wasUsedBy ;
                                            owl:someValuesFrom mo:Diffraktion
                                          ] ;
                          rdfs:label "Fiber Bragg Grating"@en ;
                          skos:definition "Fiber Bragg Grating is a periodic refractive index modulation inscribed in the core of an optical fibre that reflects a narrow wavelength band determined by the grating period, used as a wavelength-selective filter or distributed sensing element for strain and temperature measurement."@en ;
                          pmdco:abbreviation "FBG"@en ;
                          pmdco:definitionSource "claude-sonnet-4-6"@en .


