                                  owl:onProperty pmdco:relates_to ;
                                  owl:someValuesFrom chips:Flatness
                                ] ;
                rdfs:label "Planarity"@en ;
                skos:definition "Planarity is a spatial attribute quantifying the degree to which a surface or set of features lies in a common plane, critical for lithography depth of focus and bonding."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Plasma
