                                pmdco:abbreviation "DAQ Software"@en ;
                                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Data_Analysis_and_Reduction
chips:Data_Analysis_and_Reduction rdf:type owl:Class ;
                                  rdfs:subClassOf chips:Computational_Process ,
