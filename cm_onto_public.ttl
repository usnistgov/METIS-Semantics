                               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Cornell_Nanofab
chips:Cornell_Nanofab rdf:type owl:Class ;
                      rdfs:subClassOf chips:Fabrication_Facility ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty prov:wasAssociateFor ;
                                        owl:someValuesFrom chips:Grand_Challenge_3
                                      ] ;
                      rdfs:label "Cornell Nanofab"@en ;
                      skos:definition "The Cornell NanoScale Science and Technology Facility (CNF) is a shared-use nanofabrication facility at Cornell University that provides open access to advanced fabrication and characterization equipment for research."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Coulometry
chips:Coulometry rdf:type owl:Class ;
                 rdfs:subClassOf chips:DC_Electrical_Measurement ;
                 rdfs:label "Coulometry"@en ;
                 skos:definition "Coulometry is a DC electrochemical measurement technique that determines the quantity of an analyte by measuring the total charge passed during a complete electrochemical reaction at a controlled potential or constant current."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Count
chips:Count rdf:type owl:Class ;
            rdfs:subClassOf pmdco:Messwert ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty pmdco:characteristic ;
                              owl:someValuesFrom <https://w3id.org/CHIPS/metrology-ontology/0D>
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty pmdco:characteristic ;
                              owl:someValuesFrom pmdco:Messwert
                            ] ;
            rdfs:label "Count"@en ;
            skos:definition "Count is a measurement value representing the number of detected events such as photons, ions, or particles in a specified time window, the primary output of counting instruments."@en ;
            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Counting_Instrument
chips:Counting_Instrument rdf:type owl:Class ;
                          rdfs:subClassOf pmdco:Messgert ;
                          rdfs:label "Counting Instrument"@en ;
                          skos:definition "Counting Instrument is a measurement device that detects and tallies individual discrete events such as photon, ion, or particle arrivals, producing a count rate or total count as the measurement output."@en ;
                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Creep_Process
chips:Creep_Process rdf:type owl:Class ;
                    rdfs:subClassOf chips:Failure_Process ;
                    rdfs:label "Creep Process"@en ;
                    skos:definition "Creep Process is a time-dependent failure mechanism in which a material under constant applied stress below its yield point undergoes slow permanent plastic deformation, leading to dimensional change or fracture over extended periods."@en ;
                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Critical_Dimension_Scanning_Electron_Microscopy
chips:Critical_Dimension_Scanning_Electron_Microscopy rdf:type owl:Class ;
                                                      rdfs:subClassOf mo:Scanning_Electron_Microscopy ;
                                                      rdfs:label "Critical Dimension Scanning Electron Microscopy"@en ;
                                                      skos:definition "Critical-Dimension Scanning Electron Microscopy (CD-SEM) is a specialized SEM technique calibrated for high-precision dimensional measurement of sub-100 nm feature widths in semiconductor patterning processes."@en ;
                                                      pmdco:abbreviation "CD-SEM"@en ;
                                                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Critical_Dimension_Smallangle_Xray_Scattering
chips:Critical_Dimension_Smallangle_Xray_Scattering rdf:type owl:Class ;
                                                    rdfs:subClassOf chips:Smallangle_Xray_Scattering ;
                                                    rdfs:label "Critical Dimension Small-angle X-ray Scattering"@en ;
                                                    skos:definition "Critical-Dimension Small-Angle X-ray Scattering (CD-SAXS) is a non-destructive metrological technique that measures the diffraction pattern of a periodic nanostructure on a semiconductor wafer at small X-ray scattering angles to extract critical dimensions with high accuracy."@en ;
                                                    pmdco:abbreviation "CDSAX" ;
                                                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Critical_Material
chips:Critical_Material rdf:type owl:Class ;
                        rdfs:subClassOf chips:Material ;
                        rdfs:label "Critical Material"@en ;
                        skos:definition "A critical material is a material deemed essential for high-technology manufacturing and national security for which supply chain risks exist due to limited sources, geopolitical factors, or production constraints."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Cross_Sectioning
chips:Cross_Sectioning rdf:type owl:Class ;
                       rdfs:subClassOf chips:Sectioning_Process ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty prov:wasAssociatedWith ;
                                         owl:someValuesFrom chips:Specimen_Preparation_Instrument
                                       ] ;
                       rdfs:label "Cross Sectioning"@en ;
                       skos:definition "Cross Sectioning is a specimen preparation process that cuts a material perpendicular to a surface of interest to expose the subsurface microstructure for microscopic examination."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Crosscorrelation
chips:Crosscorrelation rdf:type owl:Class ;
                       rdfs:subClassOf chips:Data_Analysis_and_Reduction ;
                       rdfs:label "Cross-correlation"@en ;
                       skos:definition "Cross-Correlation is a data analysis operation that measures the similarity between two signals as a function of the time lag or spatial shift applied to one of them, used for signal alignment and feature matching."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Crossdispersed_Spectrometer
chips:Crossdispersed_Spectrometer rdf:type owl:Class ;
                                  rdfs:subClassOf mo:Spektrometer ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty prov:wasAssociateFor ;
                                                    owl:someValuesFrom chips:Crossdispersion_Spectroscopy
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty prov:wasAssociateFor ;
                                                    owl:someValuesFrom chips:Grand_Challenge_5
                                                  ] ;
                                  rdfs:label "Cross-dispersed Spectrometer"@en ;
                                  skos:definition "Cross-Dispersed Spectrometer is an optical spectrometer that uses two dispersive elements oriented perpendicularly to separate overlapping diffraction orders and record a wide spectral range without free spectral range limitations."@en ;
                                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Crossdispersion_Spectroscopy
chips:Crossdispersion_Spectroscopy rdf:type owl:Class ;
                                   rdfs:subClassOf mo:Spectroscopy ;
                                   rdfs:label "Cross-dispersion Spectroscopy"@en ;
                                   skos:definition "Cross-Dispersion Spectroscopy is an optical spectroscopy technique that uses two dispersive elements oriented perpendicular to each other to separate overlapping spectral orders and record a wide spectral range simultaneously on a two-dimensional detector."@en ;
                                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Crosslink_Density
chips:Crosslink_Density rdf:type owl:Class ;
                        rdfs:subClassOf chips:Chemical_Property ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty chips:measuredBy ;
                                          owl:someValuesFrom [ owl:intersectionOf ( chips:Infrared_Spectroscopy
                                                                                    chips:SolidState_Nuclear_Magnetic_Resonance
                                                                                  ) ;
                                                               rdf:type owl:Class
                                                             ]
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty pmdco:relates_to ;
                                          owl:someValuesFrom chips:Degree_of_Cure
                                        ] ;
                        rdfs:label "Crosslink Density"@en ;
                        skos:definition "Crosslink density is a chemical property of a polymer network defined as the number of crosslinks per unit volume, governing mechanical stiffness, swelling resistance, and glass transition temperature."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Crystal_Axes
chips:Crystal_Axes rdf:type owl:Class ;
                   rdfs:subClassOf chips:Crystalline_Property ,
                                   [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                            owl:onProperty prov:wasUsedBy ;
                                                            owl:someValuesFrom chips:Grand_Challenge_4
                                                          ]
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty pmdco:characteristic ;
                                                            owl:someValuesFrom chips:State_Variable
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty pmdco:characteristic ;
                                     owl:someValuesFrom pmdco:Metadaten
                                   ] ;
                   rdfs:label "Crystal Axes"@en ;
                   skos:definition "Crystal axes are the reference axes defined by the unit cell geometry of a crystal, used to specify directions, planes, and orientations using Miller index notation."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Crystalline_Phase
chips:Crystalline_Phase rdf:type owl:Class ;
                        rdfs:subClassOf chips:Crystalline_Property ;
                        rdfs:label "Crystalline Phase"@en ;
                        skos:definition "A crystalline phase is a thermodynamically stable form of a crystalline material with a specific crystal structure and composition, distinguishable from other phases by its diffraction pattern and properties."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Crystalline_Plane
chips:Crystalline_Plane rdf:type owl:Class ;
                        rdfs:subClassOf chips:Crystalline_Property ;
                        rdfs:label "Crystalline Plane"@en ;
                        skos:definition "A crystalline plane is a planar array of atoms in a crystal lattice described by Miller indices, relevant to X-ray diffraction peak assignment, surface orientation, and cleaving behavior."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Crystalline_Property
chips:Crystalline_Property rdf:type owl:Class ;
