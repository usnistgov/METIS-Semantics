                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Energy_Barrier
chips:Energy_Barrier rdf:type owl:Class ;
                     rdfs:subClassOf mo:Energie ;
                     rdfs:label "Energy Barrier"@en ;
                     skos:definition "An energy barrier is the minimum energy that must be supplied to a system to drive a transition between two stable states, such as the activation energy required for a chemical reaction, a phase transition, or a magnetic switching event."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Energy_Dispersive_Xray_Spectrum
chips:Energy_Dispersive_Xray_Spectrum rdf:type owl:Class ;
                                      rdfs:subClassOf chips:Spectrum ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty prov:wasGeneratedBy ;
