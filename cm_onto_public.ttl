                                 rdfs:subClassOf chips:Neutron_Beam ;
                                 rdfs:label "Spin-polarized Neutron Beam"@en ;
                                 skos:definition "Spin-Polarized Neutron Beam is a neutron beam in which the spin angular momentum of the neutrons is aligned along a preferred axis, used in polarized neutron reflectometry and magnetic structure determination."@en ;
                                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Spintransfer_Torque_Magnetoresistive_Random_Access_Memory
chips:Spintransfer_Torque_Magnetoresistive_Random_Access_Memory rdf:type owl:Class ;
                                                                rdfs:subClassOf chips:Magnetoresistive_Random_Access_Memory ;
                                                                rdfs:label "Spin-transfer Torque Magnetoresistive Random Access Memory"@en ;
                                                                skos:definition "Spin-Transfer Torque Magnetoresistive Random Access Memory (STT-MRAM) is a non-volatile memory device in which data bits are stored as the relative orientation of magnetic layers in a magnetic tunnel junction, switched by a spin-polarized current."@en ;
                                                                pmdco:abbreviation "STT-MRAM"@en ;
                                                                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Split_Cylinder_Resonator
chips:Split_Cylinder_Resonator rdf:type owl:Class ;
                               rdfs:subClassOf chips:Cavity_and_Resonator ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty prov:wasAssociateFor ;
                                                 owl:someValuesFrom chips:Split_Cylinder_Resonator_SCR_Measurement
                                               ] ;
                               rdfs:label "Split Cylinder Resonator"@en ;
                               skos:definition "Split Cylinder Resonator is a microwave resonant instrument in which a hollow metallic cylinder is split along its axis to allow insertion of a flat dielectric specimen, enabling measurement of in-plane permittivity and loss tangent."@en ;
                               pmdco:abbreviation "SCR" ;
                               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Split_Cylinder_Resonator_SCR_Measurement
chips:Split_Cylinder_Resonator_SCR_Measurement rdf:type owl:Class ;
                                               rdfs:subClassOf chips:Resonator_Measurements ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty prov:wasAssociatedWith ;
                                                                 owl:someValuesFrom chips:Split_Cylinder_Resonator
                                                               ] ;
                                               rdfs:label "Split Cylinder Resonator (SCR) Measurement"@en ;
                                               skos:definition "Split Cylinder Resonator (SCR) Measurement is a microwave measurement in which a flat dielectric sheet is placed in the gap of a split cylindrical cavity resonator and the resonant frequency and Q-factor shifts are used to determine in-plane permittivity and loss tangent."@en ;
                                               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Splitpost_Dielectric_Resonator
chips:Splitpost_Dielectric_Resonator rdf:type owl:Class ;
                                     rdfs:subClassOf chips:Cavity_and_Resonator ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty prov:wasAssociateFor ;
                                                       owl:someValuesFrom chips:Splitpost_Dielectric_ResonatorSPDR_Measurement
                                                     ] ;
                                     rdfs:label "Split-post Dielectric Resonator"@en ;
                                     skos:definition "Splitpost Dielectric Resonator is a microwave fixture in which two dielectric pucks are held coaxially in a metallic housing with a gap to accommodate a flat specimen, used to measure the complex permittivity of dielectric sheets."@en ;
                                     pmdco:abbreviation "SPDR" ;
                                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Splitpost_Dielectric_ResonatorSPDR_Measurement
chips:Splitpost_Dielectric_ResonatorSPDR_Measurement rdf:type owl:Class ;
                                                     rdfs:subClassOf chips:Resonator_Measurements ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty prov:wasAssociatedWith ;
                                                                       owl:someValuesFrom chips:Splitpost_Dielectric_Resonator
                                                                     ] ;
                                                     rdfs:label "Split-post Dielectric Resonator(SPDR) Measurement"@en ;
                                                     skos:definition "Splitpost Dielectric Resonator (SPDR) Measurement is a microwave measurement in which a flat dielectric sheet is placed between two dielectric puck resonators in a metallic housing, and the frequency and Q-factor shifts are used to extract the complex permittivity of the sheet."@en ;
                                                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Spot_Size
chips:Spot_Size rdf:type owl:Class ;
                rdfs:subClassOf chips:Optic_System_Parameter ;
                rdfs:label "Spot Size"@en ;
                skos:definition "Spot size is an optical system parameter defining the diameter of the focused beam at the specimen plane in a scanning probe or electron beam instrument, limiting the lateral spatial resolution."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Spreading_Resistance_Profiling
chips:Spreading_Resistance_Profiling rdf:type owl:Class ;
                                     rdfs:subClassOf chips:Profiling_Process ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty pmdco:belongsToProject ;
                                                       owl:someValuesFrom chips:Grand_Challenge_6
                                                     ] ;
                                     rdfs:label "Spreading Resistance Profiling"@en ;
                                     skos:definition "Spreading Resistance Profiling (SRP) is a destructive electrical profiling technique that measures the local resistivity of a semiconductor as a function of depth by beveling the sample and making two-point probe contact at successive positions along the bevel."@en ;
                                     pmdco:abbreviation "SRP"@en ;
                                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Sputtering_Process
chips:Sputtering_Process rdf:type owl:Class ;
