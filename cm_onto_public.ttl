                                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Surface_Chemistry
chips:Surface_Chemistry rdf:type owl:Class ;
                        rdfs:subClassOf chips:Chemistry ;
                        rdfs:label "Surface Chemistry"@en ;
                        skos:definition "Surface Chemistry is the branch of chemistry that investigates the chemical composition, reactions, and electronic structure of solid surfaces and interfaces at the atomic and molecular scale."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Surface_Energy
chips:Surface_Energy rdf:type owl:Class ;
                     rdfs:subClassOf mo:Energie ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty pmdco:characteristic_of ;
                                       owl:someValuesFrom chips:Surface
                                     ] ;
                     rdfs:label "Surface Energy"@en ;
                     skos:definition "Surface energy is the excess free energy per unit area of a surface relative to the bulk, arising from unsatisfied bonds at the surface and determining wettability, adhesion, and surface reactivity."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


