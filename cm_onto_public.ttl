                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty prov:wasAttributedTo ;
                                           owl:someValuesFrom mo:Detector
                                         ] ;
                         rdfs:label "Detection Property"@en ;
                         skos:definition "A detection property is a property that characterises the performance of a radiation or signal detection process, including sensitivity, quantum efficiency, noise equivalent power, dynamic range, and energy or spatial resolution."@en ;
                         pmdco:definitionSource "claude-opus-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Development_Process
chips:Development_Process rdf:type owl:Class ;
