                                                               owl:someValuesFrom [ owl:intersectionOf ( chips:Photonics_Technology
                                                                                                         chips:Test_Structure
                                                                                                       ) ;
                                                                                    rdf:type owl:Class
                                                                                  ]
                                                             ]
