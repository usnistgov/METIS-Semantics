                              rdfs:subClassOf chips:Nuclear_Analysis ,
                                              chips:Profiling_Process ;
                              rdfs:label "Neutron Depth Profiling"@en ;
                              skos:definition "Neutron Depth Profiling (NDP) is a non-destructive nuclear analysis technique that measures the depth distribution of light isotopes such as boron, lithium, or nitrogen in a near-surface region by detecting charged particles from neutron-induced reactions."@en ;
                              pmdco:abbreviation "NDP"@en ;
                              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Neutron_Facility
