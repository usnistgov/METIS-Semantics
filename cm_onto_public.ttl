###  https://w3id.org/CHIPS/metrology-ontology/Gilbert_Damping
chips:Gilbert_Damping rdf:type owl:Class ;
                      rdfs:subClassOf chips:Damping ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty chips:measuredBy ;
                                        owl:someValuesFrom pmdco:Messprozess
                                      ] ;
                      rdfs:label "Gilbert Damping"@en ;
                      skos:definition "Gilbert Damping is the phenomenological magnetic damping mechanism described by the Gilbert term in the Landau-Lifshitz-Gilbert equation, quantifying the rate at which precessing magnetization relaxes toward the effective field direction."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Gilbert_Damping_Parameter
chips:Gilbert_Damping_Parameter rdf:type owl:Class ;
                                rdfs:subClassOf chips:Damping_Parameter ,
                                                chips:Magnetic_Property ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty prov:wasInfluencedBy ;
                                                  owl:someValuesFrom chips:Gilbert_Damping
                                                ] ;
                                rdfs:label "Gilbert Damping Parameter"@en ;
                                skos:definition "The Gilbert damping parameter is a dimensionless magnetic property that quantifies the strength of the Gilbert damping term in the Landau-Lifshitz-Gilbert equation, characterizing the rate of energy dissipation from precessing magnetization to the lattice."@en ;
                                pmdco:definitionSource "claude-sonnet-4-6"@en .


