                                                                    owl:onProperty prov:wasAssociateFor ;
                                                                    owl:someValuesFrom chips:Grand_Challenge_6
                                                                  ] ;
                                                  rdfs:label "Superconducting Quantum Interference Device"@en ;
                                                  skos:definition "Superconducting Quantum Interference Device (SQUID) is an extremely sensitive magnetometer that uses the Josephson effect in a superconducting loop to detect magnetic flux changes on the order of a flux quantum."@en ;
                                                  pmdco:abbreviation "SQUID" ;
                                                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Superconductor
chips:Superconductor rdf:type owl:Class ;
                     rdfs:subClassOf chips:Material ;
                     rdfs:label "Superconductor"@en ;
                     skos:definition "A superconductor is a material that, below a critical temperature, exhibits zero electrical resistance and expels magnetic fields, enabling lossless current flow used in quantum computing and sensitive magnetometry."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Superconformal_Filling
chips:Superconformal_Filling rdf:type owl:Class ;
                             rdfs:subClassOf chips:Filling ;
                             rdfs:label "Superconformal Filling"@en ;
                             skos:definition "Superconformal Filling is an electrodeposition or CVD process that preferentially deposits material at the bottom of a via or trench faster than at the sidewalls, achieving void-free filling of high-aspect-ratio features."@en ;
                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Superfilling
chips:Superfilling rdf:type owl:Class ;
                   rdfs:subClassOf chips:Filling ;
                   skos:definition "Superfilling is an electroplating phenomenon in which the deposition rate is enhanced at recessed features such as trenches and vias relative to the field, enabling bottom-up void-free fill of interconnect structures."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Superresolution_Optical_Microscopy
chips:Superresolution_Optical_Microscopy rdf:type owl:Class ;
