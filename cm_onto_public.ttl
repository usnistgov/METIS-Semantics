###  https://w3id.org/CHIPS/metrology-ontology/Shear
chips:Shear rdf:type owl:Class ;
            rdfs:subClassOf pmdco:Geometry_Changing_Process ;
            rdfs:label "Shear"@en ;
            skos:definition "Shear is a geometry-changing mechanical process in which parallel layers of a material are displaced relative to each other by a tangential force, used in rheological testing and material forming."@en ;
            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Shear_Modulus
chips:Shear_Modulus rdf:type owl:Class ;
                    rdfs:subClassOf pmdco:Modulus_Of_Elasticity ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty pmdco:characteristic ;
                                      owl:someValuesFrom chips:Shear
                                    ] ;
                    rdfs:label "Shear Modulus"@en ;
                    skos:definition "Shear modulus is the ratio of shear stress to shear strain in a material under elastic deformation, characterizing resistance to shape change without volume change."@en ;
                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Shear_Rate
chips:Shear_Rate rdf:type owl:Class ;
                 rdfs:subClassOf chips:Mechanical_Property ,
                                 [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                          owl:onProperty prov:wasUsedBy ;
                                                          owl:someValuesFrom chips:Grand_Challenge_3
                                                        ]
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty pmdco:characteristic ;
                                                          owl:someValuesFrom chips:Independent_Variable
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty prov:wasGeneratedBy ;
                                   owl:someValuesFrom chips:Rate_Of_Change_Process
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty pmdco:characteristic ;
                                   owl:someValuesFrom pmdco:Messwert
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty pmdco:characteristic ;
                                   owl:someValuesFrom pmdco:Metadaten
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty pmdco:characteristic ;
                                   owl:someValuesFrom [ owl:intersectionOf ( chips:Shear
                                                                             pmdco:Zeit
                                                                           ) ;
                                                        rdf:type owl:Class
                                                      ]
                                 ] ;
                 rdfs:label "Shear Rate"@en ;
                 skos:definition "Shear Rate is the spatial gradient of velocity in a direction perpendicular to the flow of a fluid, quantifying the rate of shear deformation and determining the viscous stress in Newtonian and non-Newtonian fluids."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Shellisolated_Nanoparticleenhanced_Raman_Spectroscopy
chips:Shellisolated_Nanoparticleenhanced_Raman_Spectroscopy rdf:type owl:Class ;
                                                            rdfs:subClassOf chips:Raman_Spectroscopy ;
                                                            rdfs:label "Shell-isolated Nanoparticle-enhanced Raman Spectroscopy"@en ;
                                                            skos:definition "Shell-Isolated Nanoparticle-Enhanced Raman Spectroscopy (SHINERS) is a surface-enhanced Raman technique in which gold nanoparticles coated with a pinhole-free dielectric shell are deposited on an arbitrary surface to amplify the Raman signal of adsorbed molecules without direct contact between the nanoparticle and the analyte."@en ;
                                                            pmdco:abbreviation "SHINERS"@en ;
                                                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Shrinkage
chips:Shrinkage rdf:type owl:Class ;
