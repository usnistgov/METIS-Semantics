                                                   owl:onProperty prov:influenced ;
                                                   owl:someValuesFrom chips:Nuclear_Magnetic_Resonance_Spectroscopy
                                                 ] ;
                                 rdfs:label "Nuclear Magnetic Resonance"@en ;
                                 skos:definition "Nuclear Magnetic Resonance is a resonance spectroscopy technique that detects the absorption and re-emission of radiofrequency radiation by atomic nuclei with non-zero spin in a static magnetic field, providing information on chemical structure, molecular dynamics, and atomic-scale composition."@en ;
                                 pmdco:abbreviation "NMR"@en ;
                                 pmdco:definitionSource "claude-sonnet-4-6"@en .


