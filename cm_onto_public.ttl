                                rdfs:label "Digital Image Correlation"@en ;
                                skos:definition "Digital Image Correlation is an optical metrology technique that tracks the displacement of a random speckle pattern on a specimen surface between successive images to compute full-field strain and displacement maps during mechanical loading."@en ;
                                pmdco:abbreviation "DIC"@en ;
                                pmdco:definitionSource "claude-sonnet-4-6"@en .


