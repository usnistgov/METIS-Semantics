                               rdfs:subClassOf chips:Magnetization ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty chips:measuredBy ;
                                                 owl:someValuesFrom pmdco:Messprozess
                                               ] ;
                               rdfs:label "Saturation Magnetization"@en ;
                               skos:definition "Saturation magnetization is the maximum magnetization achieved in a ferromagnetic material when all magnetic moments are aligned parallel by a sufficiently large applied field."@en ;
                               pmdco:definitionSource "claude-sonnet-4-6"@en .


