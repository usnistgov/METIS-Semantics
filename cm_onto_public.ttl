chips:Solid_Phase_Extraction rdf:type owl:Class ;
                             rdfs:subClassOf chips:Concentration_Process ;
                             rdfs:label "Solid Phase Extraction"@en ;
                             skos:definition "Solid Phase Extraction (SPE) is a sample preparation technique that selectively retains target analytes on a sorbent material from a liquid matrix, then elutes them in a concentrated form for analysis."@en ;
                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Solidstate_Drive
chips:Solidstate_Drive rdf:type owl:Class ;
                       rdfs:subClassOf chips:Data_Storage_Device ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty pmdco:composed_of ;
