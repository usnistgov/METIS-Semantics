                            skos:definition "Crystalline Solutions is a Thorlabs division or affiliated entity that supplies crystalline optical components and mirror coatings for precision metrology and laser applications."@en ;
                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Cure_Schedule
chips:Cure_Schedule rdf:type owl:Class ;
                    rdfs:subClassOf chips:Curing_Property ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty chips:calculatedBy ;
                                      owl:someValuesFrom chips:Computational_Process
                                    ] ;
                    rdfs:label "Cure Schedule"@en ;
                    skos:definition "Cure schedule is the prescribed time-temperature protocol applied to a thermosetting polymer to achieve a specified degree of crosslinking and final mechanical properties."@en ;
                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Cure_Temperature
chips:Cure_Temperature rdf:type owl:Class ;
                       rdfs:subClassOf chips:Curing_Property ;
                       rdfs:label "Cure Temperature"@en ;
                       skos:definition "Cure temperature is the prescribed temperature at which a thermosetting polymer is held during crosslinking to achieve the desired degree of cure and mechanical properties."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Cure_Time
chips:Cure_Time rdf:type owl:Class ;
                rdfs:subClassOf chips:Curing_Property ;
                rdfs:label "Cure Time"@en ;
                skos:definition "Cure time is the duration for which a thermosetting polymer is held at the cure temperature to reach a specified degree of crosslinking and dimensional stability."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Curing_Property
chips:Curing_Property rdf:type owl:Class ;
                      rdfs:subClassOf chips:Chemical_Property ;
                      rdfs:label "Curing Property"@en ;
                      skos:definition "A curing property is a chemical property that characterizes the cross-linking or hardening behavior of a material during a thermally, photochemically, or chemically initiated curing process."@en ;
                      pmdco:definitionSource "claude-opus-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Current_Leakage_Process
chips:Current_Leakage_Process rdf:type owl:Class ;
                              rdfs:subClassOf chips:Failure_Process ;
                              rdfs:label "Current Leakage Process"@en ;
                              skos:definition "Current Leakage Process is a failure mechanism in which unintended electrical current flows through a dielectric or insulating region due to imperfections, hot carriers, or electric field-driven tunneling."@en ;
                              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Custom_Software
chips:Custom_Software rdf:type owl:Class ;
