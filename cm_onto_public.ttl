                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty prov:wasInformedBy ;
                                                     owl:someValuesFrom pmdco:Assembling_Process
                                                   ] ;
                                   rdfs:label "Specimen Preparation Process"@en ;
                                   skos:definition "Specimen Preparation Process is an assembling or modification process that transforms a raw sample into a form suitable for microscopic or analytical examination, including sectioning, polishing, coating, or chemical treatment."@en ;
                                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Spectrometry
