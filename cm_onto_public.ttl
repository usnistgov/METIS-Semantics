                                                       owl:onProperty pmdco:belongsToProject ;
                                                       owl:someValuesFrom chips:Grand_Challenge_2
                                                     ] ;
                                     rdfs:label "Photothermal Induced Resonance"@en ;
                                     skos:definition "Photothermal Induced Resonance is an infrared spectroscopy technique that uses a pulsed infrared beam to locally heat a specimen and detects the resulting thermal expansion through the deflection of a contact-mode atomic force microscope cantilever, providing nanoscale-resolution chemical imaging."@en ;
                                     pmdco:abbreviation "PTIR"@en ;
                                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Photothermal_Microscope
