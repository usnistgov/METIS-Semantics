chips:End_Station rdf:type owl:Class ;
                  rdfs:subClassOf chips:Combo_Instrument ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty dcterms:isPartOf ;
                                    owl:someValuesFrom chips:Light_Source
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty prov:wasAssociateFor ;
                                    owl:someValuesFrom chips:Grand_Challenge_2
                                  ] ;
