                                                                        ]
                                                                      ) ;
                                                   rdf:type owl:Class
                                                 ] ;
                                 rdfs:label "Inverse Gas Chromatography"@en ;
                                 skos:definition "Inverse Gas Chromatography (IGC) is a gas chromatographic technique in which the solid material to be characterized is packed as the stationary phase and known probe molecules are injected to determine surface energy, diffusion coefficients, and solubility parameters."@en ;
                                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Ion
chips:Ion rdf:type owl:Class ;
