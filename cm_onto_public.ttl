###  https://w3id.org/CHIPS/metrology-ontology/Data_Pattern
chips:Data_Pattern rdf:type owl:Class ;
                   rdfs:subClassOf chips:Pattern ;
                   rdfs:label "Data Pattern"@en ;
                   skos:definition "Data Pattern is a structured sequence or arrangement of digital values defined for use in testing, training, or analysis, such as a standardized bit sequence used to characterize memory or transmission system behavior."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Data_Plumbing
chips:Data_Plumbing rdf:type owl:Class ;
                    rdfs:subClassOf chips:Data_Movement_Service ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty prov:wasAssociateFor ;
                                      owl:someValuesFrom chips:Grand_Challenge_6
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty prov:wasAssociateFor ;
                                      owl:someValuesFrom chips:NIST_EM_Nexus
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty prov:wasAssociatedWith ;
                                      owl:someValuesFrom chips:Research_Equipment_Network
