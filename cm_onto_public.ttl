###  https://w3id.org/CHIPS/metrology-ontology/Keysight
chips:Keysight rdf:type owl:Class ;
               rdfs:subClassOf pmdco:Hersteller ;
               rdfs:label "Keysight"@en ;
               skos:definition "Keysight Technologies is a test and measurement company that designs and manufactures electronic measurement instruments including signal analyzers, network analyzers, oscilloscopes, and semiconductor parametric test systems."@en ;
               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Kinetic_Energy
chips:Kinetic_Energy rdf:type owl:Class ;
                     rdfs:subClassOf mo:Energie ;
                     rdfs:label "Kinetic Energy"@en ;
                     skos:definition "Kinetic energy is the energy possessed by a particle by virtue of its motion, equal to one-half the product of mass and velocity squared, relevant to ion implantation energy and electron beam energy."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Kinetic_Process
chips:Kinetic_Process rdf:type owl:Class ;
                      rdfs:subClassOf mo:Physikalischer_Prozess ;
                      rdfs:label "Kinetic Process"@en ;
                      skos:definition "A kinetic process is a physical process governed primarily by the rates of change of its constituent reactions, transformations, or transport phenomena rather than by equilibrium thermodynamics alone."@en ;
                      pmdco:definitionSource "claude-opus-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Kinetics
chips:Kinetics rdf:type owl:Class ;
               rdfs:subClassOf chips:Chemical_Property ,
                               chips:Physical_Property ,
                               pmdco:Thermisch ;
               rdfs:label "Kinetics"@en ;
               skos:definition "Kinetics is the study of the rates and mechanisms of chemical reactions or physical processes, describing how quickly a system evolves toward equilibrium."@en ;
               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Korean_Research_Institute_of_Standards_and_Science
chips:Korean_Research_Institute_of_Standards_and_Science rdf:type owl:Class ;
                                                         rdfs:subClassOf chips:National_Metrology_Institute ,
                                                                         chips:NonUS_Government ;
                                                         rdfs:label "Korean Research Institute of Standards and Science"@en ;
                                                         skos:definition "The Korean Research Institute of Standards and Science (KRISS) is South Korea's national metrology institute that maintains national measurement standards and conducts research in physical, chemical, and biomedical metrology."@en ;
                                                         pmdco:abbreviation "KRISS" ;
                                                         pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/L2X_Labs
chips:L2X_Labs rdf:type owl:Class ;
               rdfs:subClassOf pmdco:Hersteller ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty pmdco:relates_to ;
                                 owl:someValuesFrom [ rdf:type owl:Class ;
                                                      owl:unionOf ( chips:Extreme_Ultraviolet_Source
                                                                    [ owl:intersectionOf ( mo:Source
                                                                                           [ rdf:type owl:Restriction ;
                                                                                             owl:onProperty pmdco:characteristic ;
                                                                                             owl:someValuesFrom chips:Soft_Xray
                                                                                           ]
                                                                                         ) ;
                                                                      rdf:type owl:Class
                                                                    ]
                                                                  )
                                                    ]
                               ] ;
               rdfs:label "L2X Labs"@en ;
               rdfs:seeAlso "https://l2xlabs.com/"^^xsd:anyURI ;
               skos:definition "L2X Labs is a manufacturer that develops compact extreme ultraviolet and soft X-ray light sources for semiconductor metrology, lithography research, and materials characterization applications."@en ;
               pmdco:definitionSource "claude-opus-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/LAM_Research
chips:LAM_Research rdf:type owl:Class ;
                   rdfs:subClassOf pmdco:Hersteller ;
                   rdfs:label "LAM Research"@en ;
                   skos:definition "Lam Research is a semiconductor equipment company that designs and manufactures plasma etch, deposition, and photoresist strip systems used in the fabrication of memory, logic, and foundry semiconductor devices."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Laboratory_Information_Management_System
chips:Laboratory_Information_Management_System rdf:type owl:Class ;
                                               rdfs:subClassOf prov:Software_Agent ,
                                                               chips:Research_Data_Infrastructure ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty pmdco:composed_of ;
                                                                 owl:someValuesFrom chips:Database
                                                               ] ;
                                               rdfs:label "Laboratory Information Management System"@en ;
                                               skos:definition "Laboratory Information Management System (LIMS) is a software agent that manages samples, associated data, workflows, and quality control information within a laboratory, maintaining traceability from sample receipt to reported results."@en ;
                                               pmdco:abbreviation "LIMS"@en ;
                                               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Laboratory_for_Physical_Sciences
chips:Laboratory_for_Physical_Sciences rdf:type owl:Class ;
                                       rdfs:subClassOf chips:Research_Facility ,
                                                       [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                owl:onProperty prov:contributed ;
                                                                                owl:someValuesFrom chips:Integrated_Circuit
                                                                              ]
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty chips:collaboratesWith ;
                                                                                owl:someValuesFrom chips:Grand_Challenge_3
                                                                              ]
                                                                            ) ;
                                                         rdf:type owl:Class
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty prov:actedOnBehalfOf ;
                                                         owl:someValuesFrom [ owl:intersectionOf ( chips:Department_of_Defense
                                                                                                   chips:University_of_Maryland
                                                                                                 ) ;
                                                                              rdf:type owl:Class
                                                                            ]
                                                       ] ;
                                       rdfs:label "Laboratory for Physical Sciences"@en ;
                                       skos:definition "The Laboratory for Physical Sciences is a federally funded research center co-located with the University of Maryland that conducts research in semiconductor materials, quantum computing, and advanced electronics for national security."@en ;
                                       pmdco:abbreviation "LPS" ;
                                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Laminography
chips:Laminography rdf:type owl:Class ;
                   rdfs:subClassOf chips:Tomography_Process ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty chips:measured ;
                                     owl:someValuesFrom [ owl:intersectionOf ( [ rdf:type owl:Class ;
                                                                                 owl:unionOf ( chips:Dimension
                                                                                               pmdco:Form
                                                                                             )
                                                                               ]
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty pmdco:characteristic ;
                                                                                 owl:someValuesFrom chips:Defect
                                                                               ]
                                                                             ) ;
                                                          rdf:type owl:Class
                                                        ]
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty pmdco:belongsToProject ;
                                     owl:someValuesFrom chips:Grand_Challenge_7
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty pmdco:output ;
                                     owl:someValuesFrom [ owl:intersectionOf ( pmdco:Bild
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty pmdco:characteristic ;
                                                                                 owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                                      owl:unionOf ( <https://w3id.org/CHIPS/metrology-ontology/2D>
                                                                                                                    <https://w3id.org/CHIPS/metrology-ontology/3D>
                                                                                                                  )
                                                                                                    ]
                                                                               ]
                                                                             ) ;
                                                          rdf:type owl:Class
                                                        ]
                                   ] ;
                   rdfs:label "Laminography"@en ;
                   skos:definition "Laminography is an X-ray tomographic imaging process adapted for flat or extended specimens in which the X-ray beam and detector are tilted relative to the specimen plane to reconstruct interior structure without rotating the sample through 180 degrees."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Langmuir_Probe
chips:Langmuir_Probe rdf:type owl:Class ;
                     rdfs:subClassOf chips:Electrical_Measuring_Device ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty prov:generated ;
                                       owl:someValuesFrom chips:IV_Curve
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty prov:wasAssociateFor ;
                                       owl:someValuesFrom chips:Grand_Challenge_5
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty chips:measured ;
                                       owl:someValuesFrom chips:Plasma
                                     ] ;
                     rdfs:label "Langmuir Probe"@en ;
                     skos:definition "Langmuir Probe is an electrical measuring device comprising a small electrode inserted into a plasma to measure electron density, electron temperature, and plasma potential from the probe's current-voltage characteristic."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Large_Signal_Network_Analyzer
chips:Large_Signal_Network_Analyzer rdf:type owl:Class ;
                                    rdfs:subClassOf chips:Vector_Network_Analyzer ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty prov:wasAssociateFor ;
                                                      owl:someValuesFrom chips:Grand_Challenge_5
                                                    ] ;
                                    rdfs:label "Large Signal Network Analyzer"@en ;
                                    skos:definition "Large Signal Network Analyzer (LSNA) is a vector network analyzer variant that measures the amplitude and phase of all harmonics of a nonlinear device's input and output signals under large-signal drive conditions."@en ;
                                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Laser
chips:Laser rdf:type owl:Class ;
            rdfs:subClassOf chips:Photon_Beam ,
                            mo:Kohrenter_Strahl ,
                            [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                     owl:onProperty prov:wasUsedBy ;
                                                     owl:someValuesFrom chips:Grand_Challenge_1
                                                   ]
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty pmdco:characteristic ;
                                                     owl:someValuesFrom [ rdf:type owl:Class ;
                                                                          owl:unionOf ( chips:Midinfrared
                                                                                        chips:Nearinfrared
                                                                                      )
                                                                        ]
                                                   ]
                                                 ) ;
                              rdf:type owl:Class
                            ] ;
            rdfs:label "Laser"@en ;
            skos:definition "Laser is a coherent, directional, and spectrally narrow photon beam produced by stimulated emission of radiation in an optical gain medium between reflective mirrors, used as a precision light source for spectroscopy, metrology, materials processing, and pump-probe experiments."@en ;
            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Laser_Ablation_Inductively_Coupled_Plasma_Mass_Spectrometry
chips:Laser_Ablation_Inductively_Coupled_Plasma_Mass_Spectrometry rdf:type owl:Class ;
                                                                  rdfs:subClassOf chips:Combo_Instrument ,
                                                                                  chips:Mass_Spectrometry ,
                                                                                  [ rdf:type owl:Restriction ;
                                                                                    owl:onProperty prov:wasInfluencedBy ;
                                                                                    owl:someValuesFrom chips:Laser_Induced_Breakdown_Spectroscopy
                                                                                  ] ,
                                                                                  [ rdf:type owl:Restriction ;
                                                                                    owl:onProperty pmdco:output ;
                                                                                    owl:someValuesFrom [ owl:intersectionOf ( pmdco:Datensatz
                                                                                                                              [ rdf:type owl:Restriction ;
                                                                                                                                owl:onProperty pmdco:characteristic ;
                                                                                                                                owl:someValuesFrom [ owl:intersectionOf ( chips:Assay
                                                                                                                                                                          [ rdf:type owl:Class ;
                                                                                                                                                                            owl:unionOf ( chips:Impurity
                                                                                                                                                                                          chips:Purity
                                                                                                                                                                                        )
                                                                                                                                                                          ]
                                                                                                                                                                        ) ;
                                                                                                                                                     rdf:type owl:Class
                                                                                                                                                   ]
                                                                                                                              ]
                                                                                                                            ) ;
                                                                                                         rdf:type owl:Class
                                                                                                       ]
                                                                                  ] ,
                                                                                  [ rdf:type owl:Restriction ;
                                                                                    owl:onProperty pmdco:output ;
                                                                                    owl:someValuesFrom [ owl:intersectionOf ( pmdco:Datensatz
                                                                                                                              [ rdf:type owl:Restriction ;
                                                                                                                                owl:onProperty pmdco:relates_to ;
                                                                                                                                owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                                                                                     owl:unionOf ( chips:Contaminant_Identification
                                                                                                                                                                   chips:Element_Identification
                                                                                                                                                                   chips:Elemental_Map
                                                                                                                                                                 )
                                                                                                                                                   ]
                                                                                                                              ]
                                                                                                                            ) ;
                                                                                                         rdf:type owl:Class
                                                                                                       ]
                                                                                  ] ;
                                                                  rdfs:label "Laser Ablation Inductively Coupled Plasma Mass Spectrometry"@en ;
                                                                  skos:definition "Laser Ablation Inductively Coupled Plasma Mass Spectrometry (LA-ICP-MS) is a combined instrument that uses a focused laser pulse to ablate material from a solid sample, transports the aerosol into an inductively coupled plasma for atomization and ionization, and quantifies elemental and isotopic composition by mass spectrometry."@en ;
                                                                  pmdco:abbreviation "LA-ICP-MS"@en ;
                                                                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Laser_Absoption_Spectroscopy
chips:Laser_Absoption_Spectroscopy rdf:type owl:Class ;
                                   rdfs:subClassOf chips:Optical_Spectroscopy ;
                                   rdfs:label "Laser Absoption Spectroscopy"@en ;
                                   skos:definition "Laser Absorption Spectroscopy is an optical spectroscopy technique that measures the wavelength-dependent attenuation of a laser beam passing through a gas or condensed-phase sample to identify and quantify absorbing species."@en ;
                                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Laser_Doppler_Vibrometry
chips:Laser_Doppler_Vibrometry rdf:type owl:Class ;
                               rdfs:subClassOf chips:Interferometry ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty prov:used ;
                                                 owl:someValuesFrom mo:Kohrenter_Strahl
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty prov:wasInformedBy ;
                                                 owl:someValuesFrom chips:Acoustic_Process
                                               ] ;
                               rdfs:label "Laser Doppler Vibrometry"@en ;
                               skos:definition "Laser Doppler Vibrometry is a non-contact acoustic measurement technique that uses the Doppler frequency shift of a focused laser beam reflected from a vibrating surface to determine surface velocity and displacement as a function of time or frequency."@en ;
                               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Laser_Induced_Breakdown_Spectroscopy
chips:Laser_Induced_Breakdown_Spectroscopy rdf:type owl:Class ;
                                           rdfs:subClassOf chips:Mass_Spectrometry ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty prov:influenced ;
                                                             owl:someValuesFrom chips:Laser_Ablation_Inductively_Coupled_Plasma_Mass_Spectrometry
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty pmdco:characteristic ;
                                                             owl:someValuesFrom [ owl:intersectionOf ( chips:Independent_Variable
                                                                                                       [ rdf:type owl:Restriction ;
                                                                                                         owl:onProperty pmdco:characteristic ;
                                                                                                         owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                                                              owl:unionOf ( chips:Z_Coordinate
                                                                                                                                            pmdco:X_Korrdinate
                                                                                                                                            pmdco:Y_Koordinate
                                                                                                                                          )
                                                                                                                            ]
                                                                                                       ]
                                                                                                     ) ;
                                                                                  rdf:type owl:Class
                                                                                ]
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty pmdco:output ;
                                                             owl:someValuesFrom [ owl:intersectionOf ( chips:Spectrum
                                                                                                       [ rdf:type owl:Restriction ;
                                                                                                         owl:onProperty pmdco:characteristic_of ;
                                                                                                         owl:someValuesFrom <https://w3id.org/CHIPS/metrology-ontology/1D>
                                                                                                       ]
                                                                                                     ) ;
                                                                                  rdf:type owl:Class
                                                                                ]
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty pmdco:output ;
                                                             owl:someValuesFrom [ owl:intersectionOf ( pmdco:Datensatz
                                                                                                       [ rdf:type owl:Restriction ;
                                                                                                         owl:onProperty pmdco:characteristic ;
                                                                                                         owl:someValuesFrom [ owl:intersectionOf ( chips:Assay
                                                                                                                                                   [ rdf:type owl:Class ;
                                                                                                                                                     owl:unionOf ( chips:Impurity
                                                                                                                                                                   chips:Purity
                                                                                                                                                                 )
                                                                                                                                                   ]
                                                                                                                                                 ) ;
                                                                                                                              rdf:type owl:Class
                                                                                                                            ]
                                                                                                       ]
                                                                                                     ) ;
                                                                                  rdf:type owl:Class
                                                                                ]
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty pmdco:output ;
                                                             owl:someValuesFrom [ owl:intersectionOf ( pmdco:Datensatz
                                                                                                       [ rdf:type owl:Restriction ;
                                                                                                         owl:onProperty pmdco:characteristic ;
                                                                                                         owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                                                              owl:unionOf ( chips:Intensity
                                                                                                                                            chips:Mass
                                                                                                                                          )
                                                                                                                            ]
                                                                                                       ]
                                                                                                     ) ;
                                                                                  rdf:type owl:Class
                                                                                ]
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty pmdco:output ;
                                                             owl:someValuesFrom [ owl:intersectionOf ( pmdco:Datensatz
                                                                                                       [ rdf:type owl:Restriction ;
                                                                                                         owl:onProperty pmdco:relates_to ;
                                                                                                         owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                                                              owl:unionOf ( chips:Contaminant_Identification
                                                                                                                                            chips:Element_Identification
                                                                                                                                            chips:Elemental_Map
                                                                                                                                          )
                                                                                                                            ]
                                                                                                       ]
                                                                                                     ) ;
                                                                                  rdf:type owl:Class
                                                                                ]
                                                           ] ;
                                           rdfs:label "Laser Induced Breakdown Spectroscopy"@en ;
                                           skos:definition "Laser-Induced Breakdown Spectroscopy (LIBS) is an analytical technique that focuses a high-power laser pulse onto a sample surface to generate a microplasma, whose optical emission spectrum reveals the elemental composition of the ablated material."@en ;
                                           pmdco:abbreviation "LIBS"@en ;
                                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Laser_Micromachining
chips:Laser_Micromachining rdf:type owl:Class ;
                           rdfs:subClassOf chips:Etch_Process ,
                                           [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                    owl:onProperty prov:generated ;
                                                                    owl:someValuesFrom [ owl:intersectionOf ( chips:Defect
                                                                                                              [ rdf:type owl:Restriction ;
                                                                                                                owl:onProperty pmdco:characteristic_of ;
                                                                                                                owl:someValuesFrom pmdco:Probe
                                                                                                              ]
                                                                                                            ) ;
                                                                                         rdf:type owl:Class
                                                                                       ]
                                                                  ]
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty pmdco:belongsToProject ;
                                                                    owl:someValuesFrom chips:Grand_Challenge_3
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ;
                           rdfs:label "Laser Micromachining"@en ;
                           skos:definition "Laser Micromachining is an etch process that uses focused pulsed laser radiation to ablate material from a substrate with micrometer-scale spatial precision for cutting, drilling, or patterning applications."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Laser_Scanning_Confocal_Light_Microscope
chips:Laser_Scanning_Confocal_Light_Microscope rdf:type owl:Class ;
                                               rdfs:subClassOf mo:Light_Microscope ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty prov:wasAssociateFor ;
                                                                 owl:someValuesFrom mo:Konfokale_LaserScanningMikroskopie
                                                               ] ;
                                               rdfs:label "Laser Scanning Confocal Light Microscope"@en ;
                                               skos:definition "Laser Scanning Confocal Light Microscope is an optical microscope that uses a focused laser beam, a pinhole aperture conjugate to the focal plane, and raster scanning to reject out-of-focus light and acquire three-dimensional optical sections of a specimen."@en ;
                                               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Laser_Source
chips:Laser_Source rdf:type owl:Class ;
                   rdfs:subClassOf chips:Light_Source ;
                   rdfs:label "Laser Source"@en ;
                   skos:definition "Laser Source is a coherent, highly directional light source that generates monochromatic radiation through stimulated emission in a gain medium within an optical cavity."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Laser_Thermal
chips:Laser_Thermal rdf:type owl:Class ;
                    rdfs:subClassOf pmdco:Hersteller ;
                    rdfs:label "Laser Thermal"@en ;
                    skos:definition "Laser Thermal is a scientific instruments company that develops laser-based thermal measurement instruments for characterizing thermal conductivity and diffusivity of thin films and materials."@en ;
                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Latent_Image
chips:Latent_Image rdf:type owl:Class ;
                   rdfs:subClassOf pmdco:Bild ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty prov:wasDerivedFrom ;
                                     owl:someValuesFrom chips:Soft_Xray
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty prov:wasGeneratedBy ;
                                     owl:someValuesFrom chips:Synchrotron_Process
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty prov:wasGeneratedBy ;
                                     owl:someValuesFrom pmdco:Messprozess
                                   ] ;
                   rdfs:label "Latent Image"@en ;
                   skos:definition "A latent image is the spatial pattern of chemical changes formed in a photoresist film upon exposure to radiation, which becomes visible only after chemical development."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Lattice_Expansion
chips:Lattice_Expansion rdf:type owl:Class ;
                        rdfs:subClassOf chips:Crystalline_Property ,
                                        chips:Physical_Property ;
                        rdfs:label "Lattice Expansion"@en ;
                        skos:definition "Lattice expansion is the increase in lattice parameter of a crystal relative to its equilibrium value, caused by thermal effects, strain, or the incorporation of larger substitute atoms."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Lattice_Parameter
chips:Lattice_Parameter rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty chips:isMathematicalInverseOf ;
                                              owl:someValuesFrom chips:Reciprocal_Lattice_Vector
                                            ] ;
                        rdfs:subClassOf chips:Parameter ,
                                        pmdco:Materialeigenschaft ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty pmdco:characteristic ;
                                          owl:someValuesFrom pmdco:Lnge
                                        ] ;
                        rdfs:label "Lattice Parameter"@en ;
                        skos:definition "A lattice parameter is the characteristic length that defines the dimensions of the unit cell of a crystal structure, measurable by X-ray diffraction and serving as a fingerprint for phase identification and strain quantification."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Lattice_Potential
chips:Lattice_Potential rdf:type owl:Class ;
                        rdfs:subClassOf chips:Map ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty pmdco:input_of ;
                                          owl:someValuesFrom chips:Grand_Challenge_4
                                        ] ;
                        rdfs:label "Lattice Potential"@en ;
                        skos:definition "Lattice Potential is a spatially periodic potential energy field experienced by electrons or ions in a crystalline solid, arising from the periodic arrangement of atomic nuclei."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Lattice_Vibration_Data
chips:Lattice_Vibration_Data rdf:type owl:Class ;
                             rdfs:subClassOf chips:Physical_Property ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty pmdco:characteristic ;
                                               owl:someValuesFrom chips:Derived_Data
                                             ] ;
                             rdfs:label "Lattice Vibration Data"@en ;
