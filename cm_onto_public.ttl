###  https://w3id.org/CHIPS/metrology-ontology/Research_and_Development_Agents
chips:Research_and_Development_Agents rdf:type owl:Class ;
                                      rdfs:subClassOf chips:Industry ;
                                      rdfs:label "Research & Development Agents"@en ;
                                      skos:definition "Research and development agents is an industry category comprising organizations whose primary activity is the creation of new knowledge, technologies, or products through systematic investigation and innovation."@en ;
                                      pmdco:definitionSource "claude-opus-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Residual_Gas_Analyzer
chips:Residual_Gas_Analyzer rdf:type owl:Class ;
                            rdfs:subClassOf mo:Detector ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty prov:wasAssociateFor ;
                                              owl:someValuesFrom chips:Grand_Challenge_5
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty chips:measured ;
                                              owl:someValuesFrom chips:Gas
                                            ] ;
                            rdfs:label "Residual Gas Analyzer"@en ;
                            skos:definition "Residual Gas Analyzer (RGA) is a detector instrument comprising a quadrupole or magnetic sector mass spectrometer used to identify and quantify residual gas species in a vacuum system."@en ;
                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Residual_Stress
chips:Residual_Stress rdf:type owl:Class ;
                      rdfs:subClassOf pmdco:Spannung ;
                      rdfs:label "Residual Stress"@en ;
                      skos:definition "Residual stress is the stress remaining in a material after the original cause of the stress has been removed, measurable by X-ray diffraction or wafer curvature methods and affecting device reliability."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Resistance
chips:Resistance rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty chips:isMathematicalInverseOf ;
                                       owl:someValuesFrom chips:Conductance
                                     ] ;
                 rdfs:subClassOf chips:Electric_Property ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty prov:hadDerivation ;
                                   owl:someValuesFrom chips:Resistivity
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty pmdco:characteristic ;
                                   owl:someValuesFrom chips:Direct_Current
                                 ] ;
                 rdfs:label "Resistance"@en ;
                 skos:definition "Resistance is a direct current electrical property defined as the ratio of voltage across to current through a circuit element, quantifying opposition to current flow."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Resistive_Randomaccess_Memory
chips:Resistive_Randomaccess_Memory rdf:type owl:Class ;
                                    rdfs:subClassOf chips:Nonvolatile_Memory ;
                                    rdfs:label "Resistive Random-access Memory"@en ;
                                    skos:definition "Resistive Random-Access Memory (ReRAM) is a non-volatile memory device that stores data as the electrical resistance state of a metal-oxide switching layer, altered by applied voltage pulses that form or dissolve conductive filaments."@en ;
                                    pmdco:abbreviation "ReRAM"@en ;
                                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Resistivity
chips:Resistivity rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty chips:isMathematicalInverseOf ;
                                        owl:someValuesFrom chips:Conductivity
                                      ] ;
                  rdfs:subClassOf chips:Electric_Property ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty prov:wasDerivedFrom ;
                                    owl:someValuesFrom chips:Resistance
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty chips:hasMathematicalRelationshipWith ;
                                    owl:someValuesFrom chips:Resistance
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty pmdco:characteristic ;
                                    owl:someValuesFrom chips:Direct_Current
                                  ] ;
                  rdfs:label "Resistivity"@en ;
                  skos:definition "Resistivity is an intrinsic material property defined as the resistance of a unit cube of material, independent of geometry, characterizing the inherent ability of a material to impede current flow."@en ;
                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Resonanant_Process
chips:Resonanant_Process rdf:type owl:Class ;
                         rdfs:subClassOf mo:Physikalischer_Prozess ;
                         rdfs:label "Resonanant Process"@en ;
                         skos:definition "Resonanant Process is a physical process in which a system absorbs energy most efficiently at a characteristic natural frequency determined by its structural or electronic properties, producing a sharp amplitude maximum exploited to probe material properties in spectroscopy and sensor applications."@en ;
                         pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Resonance
chips:Resonance rdf:type owl:Class ;
                rdfs:subClassOf chips:Physical_Property ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty pmdco:characteristic_of ;
                                  owl:someValuesFrom chips:Wave
                                ] ;
                rdfs:label "Resonance"@en ;
                skos:definition "Resonance is a physical property describing the tendency of a system to oscillate with greater amplitude at specific frequencies where it absorbs energy most efficiently from an oscillating driving force."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Resonance_Linewidth
chips:Resonance_Linewidth rdf:type owl:Class ;
                          rdfs:subClassOf chips:Linewidth ,
                                          chips:Magnetic_Property ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty prov:hadDerivation ;
                                            owl:someValuesFrom chips:Resonance_Linewidth_Broadening
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty chips:measuredBy ;
                                            owl:someValuesFrom pmdco:Messprozess
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty pmdco:output_of ;
                                            owl:someValuesFrom chips:Ferromagnetic_Resonance
                                          ] ;
                          rdfs:label "Resonance Linewidth"@en ;
                          skos:definition "Resonance linewidth is the full-width at half-maximum of a ferromagnetic or spin resonance absorption peak, quantifying damping and energy dissipation in magnetic systems."@en ;
                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Resonance_Linewidth_Broadening
chips:Resonance_Linewidth_Broadening rdf:type owl:Class ;
                                     rdfs:subClassOf chips:Distribution ,
                                                     chips:Magnetic_Property ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty prov:wasDerivedFrom ;
                                                       owl:someValuesFrom chips:Resonance_Linewidth
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty pmdco:output_of ;
                                                       owl:someValuesFrom chips:Ferromagnetic_Resonance
                                                     ] ;
                                     rdfs:label "Resonance Linewidth Broadening"@en ;
                                     skos:definition "Resonance Linewidth Broadening is the increase in the spectral width of a resonant feature due to damping mechanisms, inhomogeneous broadening from structural disorder, or coupling to a dissipative environment."@en ;
                                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Resonant_Soft_Xray_Scattering
chips:Resonant_Soft_Xray_Scattering rdf:type owl:Class ;
                                    rdfs:subClassOf chips:Xray_Scattering ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty prov:used ;
                                                      owl:someValuesFrom chips:Soft_Xray
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty prov:wasInformedBy ;
                                                      owl:someValuesFrom chips:Transmission_Process_Scattering_of_Particles
                                                    ] ;
                                    rdfs:label "Resonant Soft X-ray Scattering"@en ;
                                    skos:definition "Resonant Soft X-ray Scattering is a soft X-ray scattering technique that tunes the incident photon energy to an absorption edge of a specific element to enhance sensitivity to chemical order, composition fluctuations, and electronic structure in complex materials."@en ;
                                    pmdco:definitionSource "claude-sonnet-4-6"@en ;
                                    pmdco:symbol "RSoXS"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Resonator_Measurements
chips:Resonator_Measurements rdf:type owl:Class ;
                             rdfs:subClassOf chips:RF_Measurement_Process ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty prov:wasAssociatedWith ;
                                               owl:someValuesFrom chips:Cavity_and_Resonator
                                             ] ;
                             rdfs:label "Resonator Measurements"@en ;
                             skos:definition "Resonator Measurements is an electromagnetic measurement process in which a material specimen is placed within or in contact with a resonant cavity or resonator, and the shift in resonant frequency and quality factor is used to extract complex permittivity or permeability."@en ;
                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Response_Parameter
chips:Response_Parameter rdf:type owl:Class ;
                         rdfs:subClassOf chips:Parameter ;
                         rdfs:label "Response Parameter"@en ;
                         skos:definition "A response parameter is a measurable or computable quantity that characterizes how a system, material, or device reacts to an applied stimulus, input, or perturbation, such as gain, susceptibility, or transfer function value."@en ;
                         pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Retarding_Field_Analyzer
chips:Retarding_Field_Analyzer rdf:type owl:Class ;
                               rdfs:subClassOf mo:Spektrometer ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty prov:wasAssociateFor ;
                                                 owl:someValuesFrom chips:Grand_Challenge_5
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty chips:measured ;
                                                 owl:someValuesFrom [ owl:intersectionOf ( chips:Kinetic_Energy
                                                                                           [ rdf:type owl:Restriction ;
                                                                                             owl:onProperty prov:wasAssociatedWith ;
                                                                                             owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                                                  owl:unionOf ( chips:Charged_Particle_Beam
                                                                                                                                chips:Plasma
                                                                                                                              )
                                                                                                                ]
                                                                                           ]
                                                                                         ) ;
                                                                      rdf:type owl:Class
                                                                    ]
                                               ] ;
                               rdfs:label "Retarding Field Analyzer"@en ;
                               skos:altLabel "Retarding Potential Analyzer"@en ;
                               skos:definition "Retarding Field Analyzer (RFA) is an electron energy analyzer that uses a series of retarding grids to energy-select electrons or ions passing through it, producing a retarding field characteristic from which the energy distribution is derived."@en ;
                               pmdco:abbreviation "RFA"@en ;
                               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Reverse_Osmosis
chips:Reverse_Osmosis rdf:type owl:Class ;
                      rdfs:subClassOf chips:Membrane_Separation ;
                      rdfs:label "Reverse Osmosis"@en ;
                      skos:definition "Reverse Osmosis is a filtration process in which pressurized water is forced through a semipermeable membrane that rejects dissolved salts and contaminants, producing high-purity water."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Rheological_Property
chips:Rheological_Property rdf:type owl:Class ;
                           rdfs:subClassOf chips:Chemical_Property ,
                                           chips:Mechanical_Property ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty prov:wasAttributedTo ;
                                             owl:someValuesFrom chips:Rheometer
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty chips:measuredBy ;
                                             owl:someValuesFrom chips:Rheology
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty pmdco:characteristic_of ;
                                             owl:someValuesFrom chips:Polymer
                                           ] ;
                           rdfs:label "Rheological Property"@en ;
                           skos:definition "Rheological Property is a material characteristic that describes the flow and deformation behavior of a substance under applied stress or strain, encompassing viscosity, viscoelasticity, and yield stress."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Rheology
chips:Rheology rdf:type owl:Class ;
               rdfs:subClassOf pmdco:Mechanischer_Testprozess ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty chips:measured ;
                                 owl:someValuesFrom chips:Rheological_Property
                               ] ;
               rdfs:label "Rheology"@en ;
               skos:definition "Rheology is the mechanical test discipline that studies the flow and deformation of matter under applied stress or strain, measuring viscosity, elasticity, and yield behavior of complex fluids and soft solids."@en ;
               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Rheometer
chips:Rheometer rdf:type owl:Class ;
                rdfs:subClassOf chips:Liquid_Flow_Measurement_Device ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty prov:wasAssociateFor ;
                                  owl:someValuesFrom chips:Rheology
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty chips:measured ;
                                  owl:someValuesFrom chips:Rheological_Property
                                ] ;
                rdfs:label "Rheometer"@en ;
                skos:definition "Rheometer is a liquid flow measurement instrument that applies controlled stress or strain to a fluid and measures the resulting deformation or flow to characterize viscosity, viscoelasticity, and yield behavior."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


