                                     owl:someValuesFrom chips:Grand_Challenge_3
                                   ] ;
                   rdfs:label "Spin Coating"@en ;
                   skos:definition "Spin Coating is a thin film deposition technique in which a liquid precursor is dispensed onto a rotating substrate and spread uniformly by centrifugal force, with film thickness controlled by spin speed, duration, and solution viscosity."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Spin_Transport
chips:Spin_Transport rdf:type owl:Class ;
