                                      owl:disjointWith chips:Nondestructive_Measurement_Process ;
                                      rdfs:label "Destructive Measurement Process"@en ;
                                      skos:definition "Destructive Measurement Process is a measurement operation that irreversibly alters or consumes the specimen during analysis, such as cross-sectioning, chemical digestion, or sputtering."@en ;
                                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Detection_Limit
chips:Detection_Limit rdf:type owl:Class ;
                      rdfs:subClassOf chips:Detection_Property ;
                      rdfs:label "Detection Limit"@en ;
                      skos:definition "Detection Limit is the lowest concentration or quantity of an analyte that an analytical method can reliably distinguish from the background noise at a defined level of statistical confidence."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Detection_Process
chips:Detection_Process rdf:type owl:Class ;
                        rdfs:subClassOf pmdco:Messprozess ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty prov:wasAssociatedWith ;
                                          owl:someValuesFrom mo:Detector
                                        ] ;
                        rdfs:label "Detection Process"@en ;
                        skos:definition "Detection Process is a measurement operation that registers the presence or arrival of a particle, photon, or signal above a defined threshold, converting it into a recordable electronic event."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Detection_Property
chips:Detection_Property rdf:type owl:Class ;
