###  https://w3id.org/CHIPS/metrology-ontology/Dislocation
chips:Dislocation rdf:type owl:Class ;
                  rdfs:subClassOf chips:Defect ;
                  rdfs:label "Dislocation"@en ;
                  skos:definition "A dislocation is a crystallographic line defect representing a boundary between a slipped and unslipped region of a crystal lattice, which affects mechanical strength and serves as a source of electrical trap states."@en ;
                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Dispersion
chips:Dispersion rdf:type owl:Class ;
