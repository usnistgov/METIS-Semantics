                                                                                            owl:someValuesFrom chips:Polymer
                                                                                          ]
                                                                                        ) ;
                                                                     rdf:type owl:Class
                                                                   ]
                                              ] ;
                              rdfs:label "Rubber Process Analyzer"@en ;
