                                   owl:someValuesFrom chips:Raman_Spectroscopy
                                 ] ;
                 rdfs:label "Strain Map"@en ;
                 skos:definition "Strain Map is a spatially resolved image showing the distribution of mechanical strain within a material or device, obtained by diffraction, electron microscopy, or digital image correlation."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Strain_Tensor
chips:Strain_Tensor rdf:type owl:Class ;
