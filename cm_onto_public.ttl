                                                     owl:someValuesFrom chips:Grand_Challenge_5
                                                   ] ;
                                   rdfs:label "Electron Backscattered Image"@en ;
                                   skos:definition "An electron backscattered image is an SEM image formed using backscattered electrons whose intensity depends on atomic number, providing atomic-number contrast for phase identification."@en ;
                                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Electron_Beam_Induced_Current_Microscopy
chips:Electron_Beam_Induced_Current_Microscopy rdf:type owl:Class ;
                                               rdfs:subClassOf pmdco:Elektronenmikroskopie ;
                                               rdfs:label "Electron Beam Induced Current Microscopy"@en ;
                                               skos:definition "Electron Beam Induced Current (EBIC) Microscopy is an electron microscopy technique in which the current generated by electron-hole pairs created by the focused electron beam in a semiconductor device is mapped to reveal p-n junctions, depletion regions, and recombination centers."@en ;
                                               pmdco:abbreviation "EBIC Microscopy"@en ;
                                               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Electron_Beam_Lithography
chips:Electron_Beam_Lithography rdf:type owl:Class ;
                                rdfs:subClassOf chips:Lithography ,
                                                [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                         owl:onProperty prov:generated ;
                                                                         owl:someValuesFrom [ owl:intersectionOf ( pmdco:Probe
                                                                                                                   [ rdf:type owl:Restriction ;
                                                                                                                     owl:onProperty pmdco:characteristic ;
                                                                                                                     owl:someValuesFrom chips:Void
                                                                                                                   ]
                                                                                                                 ) ;
                                                                                              rdf:type owl:Class
                                                                                            ]
                                                                       ]
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty pmdco:belongsToProject ;
                                                                         owl:someValuesFrom chips:Grand_Challenge_3
                                                                       ]
                                                                     ) ;
                                                  rdf:type owl:Class
                                                ] ;
                                rdfs:label "Electron Beam Lithography"@en ;
                                skos:definition "Electron Beam Lithography (EBL) is a lithographic technique that scans a focused beam of electrons across an electron-sensitive resist to write nanoscale patterns without a physical mask."@en ;
                                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Electron_Eneegy_Loss_Spectrum
chips:Electron_Eneegy_Loss_Spectrum rdf:type owl:Class ;
                                    rdfs:subClassOf chips:Spectrum ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty prov:wasGeneratedBy ;
                                                      owl:someValuesFrom mo:Elektronenenergieverlustspektroskopie
                                                    ] ;
                                    rdfs:label "Electron Eneegy Loss Spectrum"@en ;
                                    skos:definition "An electron energy loss spectrum (EELS) is a dataset of electron intensity as a function of energy loss in a TEM, used to characterize elemental composition and electronic structure."@en ;
                                    pmdco:abbreviation "EELS"@en ;
                                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Electron_Nuclear_Double_Resonance
chips:Electron_Nuclear_Double_Resonance rdf:type owl:Class ;
                                        rdfs:subClassOf chips:Resonanant_Process ;
                                        rdfs:label "Electron Nuclear Double Resonance"@en ;
                                        skos:definition "Electron Nuclear Double Resonance (ENDOR) is a magnetic resonance technique that combines electron paramagnetic resonance with radiofrequency nuclear resonance to resolve hyperfine interactions between unpaired electrons and nearby nuclei with enhanced resolution."@en ;
                                        pmdco:abbreviation "ENDOR"@en ;
                                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Electron_Paramagnetic_Resonance
chips:Electron_Paramagnetic_Resonance rdf:type owl:Class ;
                                      owl:equivalentClass chips:Electron_Spin_Resonance ;
                                      rdfs:subClassOf chips:Resonanant_Process ;
                                      rdfs:label "Electron Paramagnetic Resonance"@en ;
                                      skos:definition "Electron Paramagnetic Resonance is a resonance spectroscopy technique that detects the absorption of microwave radiation by unpaired electrons in a static magnetic field, used to characterise free radicals, transition-metal ions, and paramagnetic defect states in materials."@en ;
                                      pmdco:abbreviation "EPR"@en ;
                                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Electron_Source
chips:Electron_Source rdf:type owl:Class ;
                      rdfs:subClassOf mo:Source ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty prov:generated ;
                                        owl:someValuesFrom chips:Electron
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty pmdco:component ;
                                        owl:someValuesFrom pmdco:Elektronenmikroskop
                                      ] ;
                      rdfs:isDefinedBy "https://w3id.org/pmd/mo" ;
                      rdfs:label "Electron Source"@en ;
                      skos:definition "The electron source, such as a tungsten filament or field-emission cathode, that emits electrons in an electron microscope."@en ;
                      pmdco:definitionSource "ChatGPT 3.5" .


###  https://w3id.org/CHIPS/metrology-ontology/Electron_Spectroscopy
chips:Electron_Spectroscopy rdf:type owl:Class ;
                            rdfs:subClassOf mo:Spectroscopy ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty prov:used ;
                                              owl:someValuesFrom mo:Elektronenstrahl
                                            ] ;
                            rdfs:label "Electron Spectroscopy"@en ;
                            skos:definition "Electron Spectroscopy is a spectroscopic technique that analyzes the energy distribution of electrons emitted from or scattered by a surface to obtain information about electronic structure, chemical bonding, and elemental composition."@en ;
                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Electron_Spin_Resonance
chips:Electron_Spin_Resonance rdf:type owl:Class ;
                              rdfs:subClassOf chips:Resonanant_Process ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty prov:influenced ;
                                                owl:someValuesFrom [ owl:intersectionOf ( pmdco:Analysing_Process
                                                                                          [ rdf:type owl:Restriction ;
                                                                                            owl:onProperty pmdco:characteristic ;
                                                                                            owl:someValuesFrom chips:Defect
                                                                                          ]
                                                                                        ) ;
                                                                     rdf:type owl:Class
                                                                   ]
                                              ] ;
                              rdfs:label "Electron Spin Resonance"@en ;
                              skos:definition "Electron Spin Resonance is a resonance spectroscopy technique synonymous with electron paramagnetic resonance that detects transitions between electron spin energy levels in a static magnetic field induced by resonant microwave irradiation, used to identify and quantify paramagnetic species."@en ;
                              pmdco:abbreviation "ESR"@en ;
                              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Electron_Spin_Resonance_Spectrum
chips:Electron_Spin_Resonance_Spectrum rdf:type owl:Class ;
                                       rdfs:subClassOf chips:Spectrum ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty prov:wasGeneratedBy ;
                                                         owl:someValuesFrom chips:Electron_Paramagnetic_Resonance
                                                       ] ;
                                       rdfs:label "Electron Spin Resonance Spectrum"@en ;
                                       skos:definition "An electron spin resonance spectrum is a dataset of microwave absorption as a function of applied magnetic field, used to identify and quantify paramagnetic defects and radical species."@en ;
                                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Electron_Yield
chips:Electron_Yield rdf:type owl:Class ;
                     rdfs:subClassOf chips:Physical_Property ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty prov:wasGeneratedBy ;
                                       owl:someValuesFrom mo:Scanning_Electron_Microscopy
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty prov:wasInfluencedBy ;
                                       owl:someValuesFrom chips:Scattering
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty chips:measuredBy ;
                                       owl:someValuesFrom chips:Grand_Challenge_2
                                     ] ;
                     rdfs:label "Electron Yield"@en ;
                     skos:definition "Electron yield is a physical property that describes the number of electrons emitted per incident photon or particle during photoemission or secondary electron emission processes."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Electron_Yield_Mode
chips:Electron_Yield_Mode rdf:type owl:Class ;
                          rdfs:subClassOf chips:Soft_Xray_Spectroscopy ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty prov:used ;
                                            owl:someValuesFrom chips:Electron_Yield
                                          ] ;
                          rdfs:label "Electron Yield Mode"@en ;
                          skos:definition "Electron Yield Mode is a soft X-ray spectroscopy detection mode that measures the yield of secondary or Auger electrons emitted from a specimen surface as a function of photon energy, providing a surface-sensitive probe of element-specific electronic structure."@en ;
                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Electronbeam_Evaporator
chips:Electronbeam_Evaporator rdf:type owl:Class ;
                              rdfs:subClassOf chips:Physical_Vapor_Deposition_Tool ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty prov:wasAssociateFor ;
                                                owl:someValuesFrom chips:Evaporation_Process
                                              ] ;
                              rdfs:label "Electron-beam Evaporator"@en ;
                              skos:definition "Electron-Beam Evaporator is a physical vapor deposition tool in which a high-energy electron beam is focused onto a source material in a crucible, heating it to evaporation to deposit high-purity thin films."@en ;
                              pmdco:abbreviation "E-beam Evaporator"@en ;
                              pmdco:definitionSource "claude-sonnet-4-6"@en .


