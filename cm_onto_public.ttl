                                                                             )
                                                               ]
                                          ] ;
                          rdfs:label "Thermal Conductance"@en ;
                          skos:definition "Thermal conductance is a property of a specific body or interface quantifying the rate of heat transfer per unit temperature difference, dependent on geometry and material thermal conductivity."@en ;
                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Thermal_Conductivity
