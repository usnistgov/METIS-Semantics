chips:National_Semiconductor_Technology_Center rdf:type owl:Class ;
                                               rdfs:subClassOf chips:PublicPrivate_Partnership ;
                                               rdfs:label "National Semiconductor Technology Center"@en ;
                                               skos:definition "The National Semiconductor Technology Center (NSTC) is a public-private partnership established under the CHIPS and Science Act to conduct research and development in advanced semiconductor technology and workforce development."@en ;
