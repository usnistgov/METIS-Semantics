                                                                         owl:someValuesFrom chips:Grand_Challenge_5
                                                                       ] ;
                                                       rdfs:label "Ambient Pressure X-ray Photoelectron Spectroscopy"@en ;
                                                       skos:definition "Ambient Pressure X-ray Photoelectron Spectroscopy (AP-XPS) is an XPS technique that uses differential pumping to allow measurement of photoelectron spectra from surfaces under gas pressures up to the millibar range, enabling in situ studies of surface reactions."@en ;
                                                       pmdco:abbreviation "AP XPS"@en ;
                                                       pmdco:definitionSource "claude-sonnet-4-6"@en .


