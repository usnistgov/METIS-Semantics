                               owl:onProperty prov:wasUsedBy ;
                               owl:someValuesFrom chips:Grand_Challenge_5
                             ] ;
             rdfs:label "Plasma"@en ;
             skos:definition "Plasma is a state of matter consisting of a quasi-neutral collection of free electrons, ions, and neutral species that exhibits collective electromagnetic behavior, distinct from solid, liquid, and gas phases."@en ;
             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Plasma_Cleaner
chips:Plasma_Cleaner rdf:type owl:Class ;
                     rdfs:subClassOf chips:Specimen_Preparation_Instrument ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty pmdco:composed_of ;
                                       owl:someValuesFrom chips:Plasma
                                     ] ;
                     rdfs:label "Plasma Cleaner"@en ;
                     skos:definition "Plasma Cleaner is a specimen preparation instrument that exposes a specimen surface to a low-pressure oxygen or argon plasma to remove organic contaminants and improve surface wettability before imaging or bonding."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


