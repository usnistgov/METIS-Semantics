                              rdfs:label "Photothermal Microscope"@en ;
                              skos:altLabel "O-PTIR" ;
                              skos:definition "Photothermal Microscope is a scanning probe or optical microscope that detects the local refractive index change induced by photothermal heating of a nano-absorber to image and identify nanostructures with chemical contrast."@en ;
                              pmdco:definitionSource "claude-sonnet-4-6"@en .


