###  https://w3id.org/pmd/mo/Field_Ion_Microscopy
mo:Field_Ion_Microscopy rdf:type owl:Class ;
                        rdfs:subClassOf mo:Ionenmikroskopie ;
                        rdfs:isDefinedBy <https://w3id.org/pmd/mo> ;
                        rdfs:label "Feldionenmikroskopie"@de ,
                                   "Field Ion Microscopy"@en ;
                        skos:definition "Field Ion Microscopy is a specialized microscopy technique that uses a strong electric field to ionize atoms on the surface of a metal sample. These ionized atoms are then repelled from the surface and can be detected to create an image of the sample's surface topography at atomic resolution. FIM is especially powerful for imaging the arrangement of atoms on metallic surfaces."@en ;
                        pmdco:definitionSource "ChatGPT 3.5"@en ;
                        mo:abbreviation "FIM"@en .


