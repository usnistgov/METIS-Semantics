                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Epitaxiality
chips:Epitaxiality rdf:type owl:Class ;
                   rdfs:subClassOf chips:Crystalline_Property ;
                   rdfs:label "Epitaxiality"@en ;
                   skos:definition "Epitaxiality is a crystalline property describing the degree to which a deposited thin film adopts the crystallographic orientation and lattice registry of its single-crystal substrate."@en ;
                   pmdco:definitionSource "claude-opus-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Equation
chips:Equation rdf:type owl:Class ;
               rdfs:subClassOf chips:Mathematical_Concept ;
               rdfs:label "Equation"@en ;
               skos:definition "An equation is a mathematical statement asserting the equality of two expressions, used to relate physical quantities and define physical laws in computational models."@en ;
               pmdco:definitionSource "claude-sonnet-4-6"@en .


