                                         owl:onProperty prov:wasAssociatedWith ;
                                         owl:someValuesFrom chips:Vector_Network_Analyzer
                                       ] ;
                       rdfs:label "Network Analysis"@en ;
                       skos:definition "Network Analysis is a signal analysis process that characterizes the frequency-domain behavior of an electrical network by measuring its scattering parameters, impedance, or transfer functions using a network analyzer."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


