                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Isothermal_Titration_Calorimeter
chips:Isothermal_Titration_Calorimeter rdf:type owl:Class ;
                                       rdfs:subClassOf chips:Calorimeter ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty prov:wasAssociateFor ;
                                                         owl:someValuesFrom chips:Isothermal_Titration_Calorimetry
                                                       ] ;
                                       rdfs:label "Isothermal Titration Calorimeter"@en ;
                                       skos:definition "Isothermal Titration Calorimeter is a calorimetric instrument that measures the heat evolved or absorbed during stepwise addition of a titrant to a sample solution at constant temperature, used to determine thermodynamic binding parameters."@en ;
                                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Isothermal_Titration_Calorimetry
chips:Isothermal_Titration_Calorimetry rdf:type owl:Class ;
                                       rdfs:subClassOf chips:Calorimetry ,
                                                       [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                owl:onProperty pmdco:characteristic ;
                                                                                owl:someValuesFrom [ owl:intersectionOf ( [ rdf:type owl:Class ;
                                                                                                                            owl:unionOf ( chips:Affinity
                                                                                                                                          chips:Enthalpy
                                                                                                                                        )
                                                                                                                          ]
                                                                                                                          [ rdf:type owl:Restriction ;
                                                                                                                            owl:onProperty pmdco:relates_to ;
                                                                                                                            owl:someValuesFrom chips:Chemical_Reaction
                                                                                                                          ]
                                                                                                                        ) ;
                                                                                                     rdf:type owl:Class
                                                                                                   ]
                                                                              ]
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty pmdco:output ;
                                                                                owl:someValuesFrom chips:Derived_Data
                                                                              ]
                                                                            ) ;
                                                         rdf:type owl:Class
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty prov:wasAssociatedWith ;
                                                         owl:someValuesFrom chips:Isothermal_Titration_Calorimeter
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty chips:measured ;
                                                         owl:someValuesFrom chips:Heat_Transfer
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty pmdco:belongsToProject ;
                                                         owl:someValuesFrom chips:Grand_Challenge_7
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty pmdco:characteristic ;
                                                         owl:someValuesFrom [ owl:intersectionOf ( chips:State_Variable
                                                                                                   [ rdf:type owl:Restriction ;
                                                                                                     owl:onProperty pmdco:characteristic ;
                                                                                                     owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                                                          owl:unionOf ( chips:Flow_Rate
                                                                                                                                        mo:Volumen
                                                                                                                                        [ owl:intersectionOf ( chips:Concentration
                                                                                                                                                               [ rdf:type owl:Restriction ;
                                                                                                                                                                 owl:onProperty pmdco:relates_to ;
                                                                                                                                                                 owl:someValuesFrom chips:Reactant
                                                                                                                                                               ]
                                                                                                                                                             ) ;
                                                                                                                                          rdf:type owl:Class
                                                                                                                                        ]
                                                                                                                                      )
                                                                                                                        ]
                                                                                                   ]
                                                                                                 ) ;
                                                                              rdf:type owl:Class
                                                                            ]
                                                       ] ;
                                       rdfs:label "Isothermal Titration Calorimetry"@en ;
                                       skos:definition "Isothermal Titration Calorimetry (ITC) is a thermodynamic technique that measures the heat released or absorbed during incremental additions of a ligand to a macromolecule at constant temperature to determine binding affinity, stoichiometry, and reaction enthalpy."@en ;
                                       pmdco:abbreviation "ITC"@en ;
                                       pmdco:definitionSource "claude-sonnet-4-6"@en .


