###  https://w3id.org/CHIPS/metrology-ontology/Cantilever_Bending
chips:Cantilever_Bending rdf:type owl:Class ;
                         rdfs:subClassOf chips:Cantilever_Testing_Process ,
                                         [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                  owl:onProperty pmdco:output ;
                                                                  owl:someValuesFrom chips:Residual_Stress
                                                                ]
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty pmdco:relates_to ;
                                                                  owl:someValuesFrom chips:Grand_Challenge_3
                                                                ]
                                                              ) ;
                                           rdf:type owl:Class
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty chips:measured ;
                                           owl:someValuesFrom chips:Fracture_Toughness
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty chips:measured ;
                                           owl:someValuesFrom chips:Youngs_Modulus
                                         ] ;
                         rdfs:label "Cantilever Bending"@en ;
                         skos:definition "Cantilever Bending is a mechanical testing process in which a beam fixed at one end is subjected to a transverse load at the free end to determine the elastic modulus, fracture toughness, or residual stress of thin films and micro-scale structures."@en ;
                         pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Cantilever_Bending_Instrument
chips:Cantilever_Bending_Instrument rdf:type owl:Class ;
                                    rdfs:subClassOf chips:Mechanical_Testing_Instrument ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty prov:wasAssociateFor ;
                                                      owl:someValuesFrom chips:Cantilever_Bending
                                                    ] ;
                                    rdfs:label "Cantilever Bending Instrument"@en ;
                                    skos:definition "Cantilever Bending Instrument is a mechanical testing device that applies a controlled load to the free end of a clamped cantilever specimen to measure bending stiffness or interfacial fracture energy."@en ;
                                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Cantilever_Testing_Process
chips:Cantilever_Testing_Process rdf:type owl:Class ;
                                 rdfs:subClassOf pmdco:Mechanischer_Testprozess ;
                                 rdfs:label "Cantilever Testing Process"@en ;
                                 skos:definition "Cantilever Testing Process is a mechanical test in which a specimen is clamped at one end and loaded at the free end to measure bending stiffness, fracture energy, or interfacial adhesion."@en ;
                                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Capacitance
chips:Capacitance rdf:type owl:Class ;
                  rdfs:subClassOf chips:Electric_Property ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty pmdco:characteristic ;
                                    owl:someValuesFrom chips:Scalar
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty pmdco:relates_to ;
                                    owl:someValuesFrom [ rdf:type owl:Class ;
                                                         owl:unionOf ( chips:Alternating_Current
                                                                       chips:Radio_Frequency
                                                                     )
                                                       ]
                                  ] ;
                  rdfs:label "Capacitance"@en ;
                  skos:definition "Capacitance is a high-frequency electrical property defined as the ratio of stored charge to applied voltage, characterizing the ability of a structure to store electrical energy in an electric field."@en ;
                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Carrier_Gas
chips:Carrier_Gas rdf:type owl:Class ;
                  rdfs:subClassOf chips:Gas ;
                  rdfs:label "Carrier Gas"@en ;
                  skos:definition "Carrier Gas is an inert gas used in a chromatographic or deposition system to transport a sample or precursor vapor through tubing, columns, or a process chamber without reacting with the analyte or substrate."@en ;
                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Carrier_Transport
chips:Carrier_Transport rdf:type owl:Class ;
                        rdfs:subClassOf chips:Electric_Property ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty chips:measuredBy ;
                                          owl:someValuesFrom chips:Electromagnetic_Measurement_Process
                                        ] ;
                        rdfs:label "Carrier Transport"@en ;
                        skos:definition "Carrier transport is an electric property describing the movement of charge carriers (electrons and holes) through a semiconductor in response to electric fields, concentration gradients, or temperature gradients."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Cathodoluminescence
chips:Cathodoluminescence rdf:type owl:Class ;
                          rdfs:subClassOf chips:Luminescence ;
                          rdfs:label "Cathodoluminescence"@en ;
                          skos:definition "Cathodoluminescence is a luminescence process in which a material emits visible or ultraviolet photons upon bombardment by high-energy electrons, used in electron microscopy to map optical bandgaps and defect distributions."@en ;
                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Cathodoluminescence_Spectrometer
chips:Cathodoluminescence_Spectrometer rdf:type owl:Class ;
                                       rdfs:subClassOf mo:Spektrometer ;
                                       rdfs:label "Cathodoluminescence Spectrometer"@en ;
                                       skos:definition "Cathodoluminescence Spectrometer is a spectrometer integrated with an electron microscope that disperses and detects photons emitted by a specimen under electron beam bombardment to characterize its optical bandgap and defect luminescence."@en ;
                                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Cation
chips:Cation rdf:type owl:Class ;
             rdfs:subClassOf chips:Ion ;
             rdfs:label "Cation"@en ;
             skos:definition "A cation is a positively charged ion formed by the loss of one or more electrons, present in electrolyte solutions and relevant to ion transport in semiconductor electrochemical processes."@en ;
             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Causal_Greens_Function
chips:Causal_Greens_Function rdf:type owl:Class ;
                             rdfs:subClassOf chips:Greens_Function ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty prov:wasUsedBy ;
                                               owl:someValuesFrom chips:Grand_Challenge_4
                                             ] ;
                             rdfs:label "Causal Greens Function"@en ;
                             skos:definition "Causal Green's Function is a Green's function that is defined to be zero for times before the application of the source term, ensuring that the system responds only after the cause, consistent with causality in quantum transport and many-body theory."@en ;
                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Cavity_Ringdown_Gas_Analyzer
chips:Cavity_Ringdown_Gas_Analyzer rdf:type owl:Class ;
                                   rdfs:subClassOf mo:Detector ,
                                                   [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                            owl:onProperty chips:measured ;
                                                                            owl:someValuesFrom chips:Gas
                                                                          ]
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty pmdco:executes ;
                                                                            owl:someValuesFrom pmdco:Analysing_Process
                                                                          ]
                                                                        ) ;
                                                     rdf:type owl:Class
                                                   ] ;
                                   rdfs:label "Cavity Ringdown Gas Analyzer"@en ;
                                   skos:definition "Cavity Ringdown Gas Analyzer is a detector instrument that measures trace gas concentrations by analyzing the exponential decay time of optical intensity in a high-finesse resonant cavity filled with the sample gas."@en ;
                                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Cavity_Ringdown_Spectroscopy
chips:Cavity_Ringdown_Spectroscopy rdf:type owl:Class ;
                                   rdfs:subClassOf chips:Laser_Absoption_Spectroscopy ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty prov:wasAssociatedWith ;
                                                     owl:someValuesFrom chips:Cavity_and_Resonator
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty pmdco:relates_to ;
                                                     owl:someValuesFrom chips:Cavity_Ringdown_Gas_Analyzer
                                                   ] ;
                                   rdfs:label "Cavity Ring-down Spectroscopy"@en ;
                                   skos:definition "Cavity Ringdown Spectroscopy (CRDS) is a laser absorption technique that measures the time constant of optical decay in a high-finesse cavity containing the sample, providing absolute absorption coefficients with high sensitivity independent of laser intensity fluctuations."@en ;
                                   pmdco:abbreviation "CRDS"@en ;
                                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Cavity_and_Resonator
chips:Cavity_and_Resonator rdf:type owl:Class ;
                           rdfs:subClassOf chips:Instrument ;
                           rdfs:comment "An instrument that produces resonance (tempory definition)"@en ;
                           rdfs:label "Cavity and Resonator"@en ;
                           skos:definition "Cavity and Resonator is a measurement instrument comprising an enclosed or partially open resonant structure that confines electromagnetic energy at discrete frequencies for permittivity measurement or frequency-selective filtering."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Cavityenhanced_Absorption_Spectroscopy
chips:Cavityenhanced_Absorption_Spectroscopy rdf:type owl:Class ;
                                             rdfs:subClassOf chips:Laser_Absoption_Spectroscopy ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty prov:wasAssociatedWith ;
                                                               owl:someValuesFrom chips:Cavity_and_Resonator
                                                             ] ;
                                             rdfs:label "Cavity-enhanced Absorption Spectroscopy"@en ;
                                             skos:definition "Cavity-Enhanced Absorption Spectroscopy (CEAS) is a laser absorption technique that uses an optical cavity to extend the effective path length of light through a sample by orders of magnitude, enabling detection of trace absorbers."@en ;
                                             pmdco:abbreviation "CEAS"@en ;
                                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Cell
chips:Cell rdf:type owl:Class ;
           rdfs:subClassOf chips:Sample_Environment ;
           rdfs:label "Cell"@en ;
           skos:definition "Cell is a sample environment component—such as an electrochemical cell or environmental cell—that encloses a specimen in a controlled chemical or atmospheric environment during measurement."@en ;
           pmdco:definitionSource "claude-sonnet-4-6"@en .


