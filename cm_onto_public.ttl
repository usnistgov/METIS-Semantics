                           rdfs:label "Engineered Structure"@en ;
                           skos:definition "Engineered Structure is an engineered material or device whose geometry, composition, and microstructure are deliberately designed to achieve specific functional properties not present in bulk constituents."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Entegris
chips:Entegris rdf:type owl:Class ;
               rdfs:subClassOf pmdco:Hersteller ;
               rdfs:label "Entegris"@en ;
               skos:definition "Entegris is a materials integrity management company that supplies advanced materials, contamination control products, and fluid handling components for semiconductor and other high-technology manufacturing processes."@en ;
               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Enthalpy
chips:Enthalpy rdf:type owl:Class ;
               rdfs:subClassOf chips:Thermodynamic_Property ;
               rdfs:label "Enthalpy"@en ;
               skos:definition "Enthalpy is a thermodynamic property defined as the sum of internal energy and the product of pressure and volume, measuring heat exchanged at constant pressure in chemical reactions and phase transitions."@en ;
               pmdco:definitionSource "claude-sonnet-4-6"@en .


