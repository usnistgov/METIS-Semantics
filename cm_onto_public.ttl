                             rdfs:subClassOf chips:Academia ;
                             rdfs:label "University of Missouri"@en ;
                             skos:definition "The University of Missouri is a public research university in Columbia, Missouri, that conducts research in materials science, nuclear science, and semiconductor characterization."@en ;
                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/University_of_Texas_Austin
chips:University_of_Texas_Austin rdf:type owl:Class ;
                                 rdfs:subClassOf chips:Academia ;
                                 rdfs:label "University of Texas Austin"@en ;
                                 skos:definition "The University of Texas at Austin is a public research university in Texas that conducts research in semiconductor materials, microelectronics, photonics, and two-dimensional materials."@en ;
                                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/University_of_Virginia
chips:University_of_Virginia rdf:type owl:Class ;
                             rdfs:subClassOf chips:Academia ;
                             rdfs:label "University of Virginia"@en ;
                             skos:definition "The University of Virginia is a public research university in Charlottesville, Virginia, that conducts research in materials science, semiconductor devices, and quantum information science."@en ;
                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Unsupervised_Learning
chips:Unsupervised_Learning rdf:type owl:Class ;
                            rdfs:subClassOf chips:AI_and_Machine_Learning ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty pmdco:executed_by ;
                                              owl:someValuesFrom chips:Grand_Challenge_5
                                            ] ;
                            rdfs:label "Unsupervised Learning"@en ;
                            skos:definition "Unsupervised Learning is a machine learning paradigm in which a model discovers latent structure, clusters, or representations from unlabeled data without explicit target outputs."@en ;
                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Vacancy
chips:Vacancy rdf:type owl:Class ;
              rdfs:subClassOf chips:Defect ;
              rdfs:label "Vacancy"@en ;
              skos:definition "A vacancy is a point defect in a crystal lattice where an atom is missing from its regular lattice site, acting as a scattering center and trap state that affects carrier mobility and lifetime."@en ;
              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Vacuum_Hardware
chips:Vacuum_Hardware rdf:type owl:Class ;
                      rdfs:subClassOf chips:Hardware ;
                      rdfs:label "Vacuum Hardware"@en ;
                      skos:definition "Vacuum Hardware is a hardware component used to create, maintain, or measure low-pressure environments, including pumps, gauges, valves, and flanges."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Valence_Band_Position
chips:Valence_Band_Position rdf:type owl:Class ;
                            rdfs:subClassOf chips:Physical_Property ;
                            rdfs:label "Valence Band Position"@en ;
                            skos:definition "Valence band position is the energy of the valence band maximum relative to a reference level such as the vacuum level or Fermi level, characterizing the electronic structure at semiconductor interfaces."@en ;
                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Valence_State
chips:Valence_State rdf:type owl:Class ;
                    rdfs:subClassOf chips:Chemical_Property ;
                    rdfs:label "Valence State"@en ;
                    skos:definition "Valence state is the number of electrons an atom uses to form chemical bonds, determining its chemical reactivity and the nature of its compounds."@en ;
                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Variability
chips:Variability rdf:type owl:Class ;
                  rdfs:subClassOf chips:Confidence_Concept ;
                  rdfs:label "Variability"@en ;
                  skos:definition "Variability is a confidence concept describing the extent of spread or dispersion in a set of measurements or material properties, arising from random variation in processes or instruments."@en ;
                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Variable
chips:Variable rdf:type owl:Class ;
               rdfs:subClassOf chips:Entity_Role ,
                               pmdco:Wertobjekt ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty prov:influenced ;
                                 owl:someValuesFrom pmdco:Metadaten
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty pmdco:relates_to ;
                                 owl:someValuesFrom chips:Parameter
                               ] ;
               rdfs:label "Variable"@en ;
               skos:definition "Variable is an entity role assigned to a symbol or quantity that can take on different numerical values within a mathematical expression, model, or experimental design."@en ;
               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Vector
chips:Vector rdf:type owl:Class ;
             rdfs:subClassOf pmdco:Wertobjekt ;
             rdfs:label "Vector"@en ;
             skos:definition "Vector is a value object representing a physical quantity that has both a magnitude and a direction in space, such as force, velocity, or electric field."@en ;
             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Vector_Network_Analyzer
chips:Vector_Network_Analyzer rdf:type owl:Class ;
                              rdfs:subClassOf chips:Signal_Analyzer ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty prov:wasAssociateFor ;
                                                owl:someValuesFrom [ rdf:type owl:Class ;
                                                                     owl:unionOf ( chips:Grand_Challenge_5
                                                                                 )
                                                                   ]
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty chips:measured ;
                                                owl:someValuesFrom chips:Scattering_Parameter
                                              ] ;
                              rdfs:label "Vector Network Analyzer"@en ;
                              skos:definition "Vector Network Analyzer (VNA) is a signal analyzer instrument that measures the amplitude and phase of the complex scattering parameters of a multi-port electrical network as a function of frequency."@en ;
                              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Verification_Process
chips:Verification_Process rdf:type owl:Class ;
                           rdfs:subClassOf chips:Quality_Control ,
                                           [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                    owl:onProperty prov:wasAssociatedWith ;
                                                                    owl:someValuesFrom chips:Grand_Challenge_7
                                                                  ]
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty chips:measured ;
                                                                    owl:someValuesFrom chips:Read_Error_Rate
                                                                  ]
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty pmdco:output ;
                                                                    owl:someValuesFrom chips:Binary
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ,
                                           [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                    owl:onProperty prov:wasInfluencedBy ;
                                                                    owl:someValuesFrom [ owl:intersectionOf ( chips:State_Variable
                                                                                                              [ rdf:type owl:Restriction ;
                                                                                                                owl:onProperty pmdco:characteristic ;
                                                                                                                owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                                                                     owl:unionOf ( pmdco:Algorithmus
                                                                                                                                                   [ owl:intersectionOf ( chips:Protocol
                                                                                                                                                                          [ rdf:type owl:Restriction ;
                                                                                                                                                                            owl:onProperty prov:wasInformedBy ;
                                                                                                                                                                            owl:someValuesFrom chips:Data_Sanitization_Process
                                                                                                                                                                          ]
                                                                                                                                                                        ) ;
                                                                                                                                                     rdf:type owl:Class
                                                                                                                                                   ]
                                                                                                                                                 )
                                                                                                                                   ]
                                                                                                              ]
                                                                                                            ) ;
                                                                                         rdf:type owl:Class
                                                                                       ]
                                                                  ]
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty pmdco:belongsToProject ;
                                                                    owl:someValuesFrom chips:Grand_Challenge_7
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ;
                           rdfs:label "Verification Process"@en ;
                           skos:definition "Verification Process is a quality control operation that confirms through objective evidence that a product, process, or system meets its specified requirements before acceptance or release."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Versailles_Project_on_Advanced_Materials_and_Standards
chips:Versailles_Project_on_Advanced_Materials_and_Standards rdf:type owl:Class ;
                                                             rdfs:subClassOf chips:Standards_Organization ;
                                                             rdfs:label "Versailles Project on Advanced Materials and Standards"@en ;
                                                             skos:definition "The Versailles Project on Advanced Materials and Standards (VAMAS) is an international organization that conducts pre-normative research to support the development of standards for advanced materials characterization."@en ;
                                                             pmdco:abbreviation "VAMAS"@en ;
                                                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Versioning_Software
chips:Versioning_Software rdf:type owl:Class ;
                          rdfs:subClassOf prov:Software_Agent ;
                          rdfs:label "Versioning Software"@en ;
                          skos:definition "Versioning Software is a software agent that tracks changes to files or code over time, supports branching and merging of development histories, and enables rollback to earlier versions."@en ;
                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Vibrating_Sample_Magnetometer
chips:Vibrating_Sample_Magnetometer rdf:type owl:Class ;
                                    rdfs:subClassOf chips:Magnetometer ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty prov:wasAssociateFor ;
                                                      owl:someValuesFrom chips:Grand_Challenge_3
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty prov:wasAssociateFor ;
                                                      owl:someValuesFrom chips:Grand_Challenge_6
                                                    ] ;
                                    rdfs:label "Vibrating Sample Magnetometer"@en ;
                                    skos:definition "Vibrating Sample Magnetometer (VSM) is a magnetometer in which a magnetized sample is vibrated sinusoidally in a static applied field, inducing a voltage in pickup coils proportional to the magnetic moment."@en ;
                                    pmdco:abbreviation "VSM" ;
                                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Vibration_Aging
chips:Vibration_Aging rdf:type owl:Class ;
                      rdfs:subClassOf pmdco:Alterungsprozess ;
                      rdfs:label "Vibration Aging"@en ;
                      skos:definition "Vibration Aging is an aging process in which a device or assembly is subjected to mechanical vibration loads over a defined duration and frequency profile to simulate service-life fatigue and assess structural integrity."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Virus
chips:Virus rdf:type owl:Class ;
            rdfs:subClassOf chips:Biological_Macromolecule ;
            rdfs:label "Virus"@en ;
            skos:definition "A virus is a submicroscopic infectious agent consisting of genetic material enclosed in a protein coat that replicates inside host cells, relevant as an analyte in biosensor and detection applications."@en ;
            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Viscoelastic_Bulk_Modulus
chips:Viscoelastic_Bulk_Modulus rdf:type owl:Class ;
                                rdfs:subClassOf chips:Bulk_Modulus ,
                                                chips:Viscoelastic_Property ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty chips:measuredBy ;
                                                  owl:someValuesFrom pmdco:Messprozess
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty pmdco:relates_to ;
                                                  owl:someValuesFrom chips:Viscosity
                                                ] ;
                                rdfs:label "Viscoelastic Bulk Modulus"@en ;
                                skos:definition "Viscoelastic Bulk Modulus is a complex mechanical modulus quantifying the frequency-dependent volumetric response of a viscoelastic material to hydrostatic stress, comprising real storage and imaginary loss components that reflect elastic energy storage and viscous dissipation respectively."@en ;
                                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Viscoelastic_Property
chips:Viscoelastic_Property rdf:type owl:Class ;
                            rdfs:subClassOf chips:Rheological_Property ;
                            rdfs:label "Viscoelastic Property"@en ;
                            skos:definition "A viscoelastic property is a mechanical property of a material that exhibits both elastic (recoverable) and viscous (dissipative) deformation in response to applied stress, characterized by storage and loss moduli."@en ;
                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Viscometer
chips:Viscometer rdf:type owl:Class ;
                 rdfs:subClassOf chips:Liquid_Flow_Measurement_Device ;
                 rdfs:label "Viscometer"@en ;
                 skos:definition "Viscometer is a liquid flow measurement instrument that determines the dynamic or kinematic viscosity of a fluid by measuring the resistance to flow under a defined driving force."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Viscosity
chips:Viscosity rdf:type owl:Class ;
                rdfs:subClassOf chips:Rheological_Property ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty chips:calculatedBy ;
                                  owl:someValuesFrom [ owl:intersectionOf ( chips:Computational_Process
                                                                            chips:Grand_Challenge_1
                                                                          ) ;
                                                       rdf:type owl:Class
                                                     ]
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty chips:measuredBy ;
                                  owl:someValuesFrom chips:Rheology
                                ] ;
                rdfs:label "Viscosity"@en ;
                skos:definition "Viscosity is a rheological property quantifying a fluid's resistance to flow under an applied shear stress, relevant to photoresist spin coating, slurry behavior in CMP, and adhesive dispensing."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Vision_Processing_Unit
chips:Vision_Processing_Unit rdf:type owl:Class ;
                             rdfs:subClassOf chips:Applicationspecific_Integrated_Circuit ;
                             rdfs:label "Vision Processing Unit"@en ;
                             skos:definition "Vision Processing Unit (VPU) is an application-specific integrated circuit optimized for low-power computer vision and image processing tasks, including convolution and feature extraction for AI inference at the edge."@en ;
                             pmdco:abbreviation "VPU"@en ;
                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Visualization_Process
chips:Visualization_Process rdf:type owl:Class ;
                            rdfs:subClassOf pmdco:Analysing_Process ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty prov:wasAssociatedWith ;
                                              owl:someValuesFrom chips:Visualization_Software
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty pmdco:executed_by ;
                                              owl:someValuesFrom chips:Grand_Challenge_7
                                            ] ;
                            rdfs:label "Visualization Process"@en ;
                            skos:definition "Visualization Process is an analytical process that generates graphical representations of data or simulation results to facilitate interpretation, communication, and insight."@en ;
                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Visualization_Software
chips:Visualization_Software rdf:type owl:Class ;
                             rdfs:subClassOf prov:Software_Agent ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty prov:wasAssociateFor ;
                                               owl:someValuesFrom chips:Grand_Challenge_7
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty prov:wasAssociateFor ;
                                               owl:someValuesFrom chips:Visualization_Process
                                             ] ;
                             rdfs:label "Visualization Software"@en ;
                             skos:definition "Visualization Software is a software agent that renders data as graphical representations—such as plots, maps, or three-dimensional renderings—to support interpretation and communication of results."@en ;
                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Void
chips:Void rdf:type owl:Class ;
           rdfs:subClassOf chips:Defect ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty chips:measuredBy ;
                             owl:someValuesFrom pmdco:Messprozess
                           ] ;
           rdfs:label "Void"@en ;
           skos:definition "A void is an unfilled region or cavity within a material or at an interface, such as a gap in a solder joint or via fill, which degrades mechanical integrity and electrical conductivity."@en ;
           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Volatilization_Kinetics
chips:Volatilization_Kinetics rdf:type owl:Class ;
                              rdfs:subClassOf chips:Reaction_Kinetics ;
                              rdfs:label "Volatilization Kinetics"@en ;
                              skos:definition "Volatilization kinetics is the rate at which a substance converts from a condensed phase to a gas phase under specified temperature and pressure conditions, relevant to thin-film processing."@en ;
                              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Voltammetry
chips:Voltammetry rdf:type owl:Class ;
                  rdfs:subClassOf chips:DC_Electrical_Measurement ;
                  rdfs:label "Voltammetry"@en ;
                  skos:definition "Voltammetry is a DC electrochemical measurement technique in which the current response of an electrochemical cell is recorded as the applied potential is varied in a defined waveform to characterize redox reactions and analyte concentrations."@en ;
                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Voltammogram
chips:Voltammogram rdf:type owl:Class ;
                   rdfs:subClassOf chips:Plot ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty prov:wasGeneratedBy ;
                                     owl:someValuesFrom chips:Cyclic_Voltammetry
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty pmdco:characteristic ;
                                     owl:someValuesFrom pmdco:Messwert
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty pmdco:characteristic ;
                                     owl:someValuesFrom mo:Spannung
                                   ] ;
                   rdfs:label "Voltammogram"@en ;
                   skos:definition "A voltammogram is an electrochemical measurement dataset of current as a function of applied electrode potential, used to characterize redox reactions and electrochemical kinetics."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Vulnerability_Management
chips:Vulnerability_Management rdf:type owl:Class ;
                               rdfs:subClassOf chips:Security_Management ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty pmdco:belongsToProject ;
                                                 owl:someValuesFrom chips:Grand_Challenge_7
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty pmdco:relates_to ;
                                                 owl:someValuesFrom chips:Supply_Chain
                                               ] ;
                               rdfs:label "Vulnerability Management"@en ;
                               skos:definition "Vulnerability Management is a security management process that continuously identifies, classifies, prioritizes, and remediates security weaknesses in software, hardware, and configurations."@en ;
                               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Vulnerability_Standard
chips:Vulnerability_Standard rdf:type owl:Class ;
                             rdfs:subClassOf chips:Standard ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty pmdco:relates_to ;
                                               owl:someValuesFrom chips:Supply_Chain
                                             ] ;
                             rdfs:label "Vulnerability Standard"@en ;
                             skos:definition "Vulnerability Standard is a normative specification that defines a common framework or scoring method for assessing and communicating the severity of cybersecurity vulnerabilities."@en ;
                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Wafer
chips:Wafer rdf:type owl:Class ;
            rdfs:subClassOf chips:Engineered_Structure ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty pmdco:input_of ;
                              owl:someValuesFrom [ owl:intersectionOf ( chips:Grand_Challenge_1
                                                                        chips:Ptychography
                                                                      ) ;
                                                   rdf:type owl:Class
                                                 ]
                            ] ;
            rdfs:label "Wafer"@en ;
            skos:definition "A wafer is a thin, flat disk of semiconductor material, typically silicon, on which integrated circuits or other semiconductor devices are fabricated through a series of deposition, lithography, and etch steps."@en ;
            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Wafer_Map
chips:Wafer_Map rdf:type owl:Class ;
                rdfs:subClassOf chips:Map ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty pmdco:characteristic_of ;
                                  owl:someValuesFrom chips:Process_Metadata
                                ] ;
                rdfs:label "Wafer Map"@en ;
                skos:definition "Wafer Map is a spatially resolved representation of a measured property across the area of a semiconductor wafer, used to assess process uniformity and identify yield-limiting defects."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Warpage
chips:Warpage rdf:type owl:Class ;
              rdfs:subClassOf chips:Defect ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty chips:measuredBy ;
                                owl:someValuesFrom pmdco:Messprozess
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty pmdco:characteristic_of ;
                                owl:someValuesFrom chips:Wafer
                              ] ;
              rdfs:label "Warpage"@en ;
              skos:definition "Warpage is a defect characterized by out-of-plane deformation of a wafer, substrate, or package resulting from asymmetric thermal expansion or residual stress, which can cause assembly failures."@en ;
              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Waste_Material
chips:Waste_Material rdf:type owl:Class ;
                     rdfs:subClassOf chips:Material ;
                     rdfs:label "Waste Material"@en ;
                     skos:definition "A waste material is a material that is a byproduct or spent residue of a manufacturing or research process, requiring disposal, treatment, or recovery in compliance with environmental regulations."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Water
chips:Water rdf:type owl:Class ;
            rdfs:subClassOf chips:Liquid ,
                            chips:Molecule ;
            rdfs:label "Water"@en ;
            skos:definition "Water is a chemical compound (H2O) that is the primary solvent used in semiconductor wet cleaning, ultrapure water rinsing, and electrochemical processes, with stringent purity requirements for semiconductor applications."@en ;
            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Wave
chips:Wave rdf:type owl:Class ;
           rdfs:subClassOf chips:Conceptual_Entity ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty pmdco:characteristic ;
                             owl:someValuesFrom chips:Temporal_Concept
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty pmdco:characteristic ;
                             owl:someValuesFrom chips:Wave_Characteristic
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty pmdco:composed_of ;
                             owl:someValuesFrom mo:Energie
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty pmdco:relates_to ;
                             owl:someValuesFrom chips:Particle
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty pmdco:relates_to ;
                             owl:someValuesFrom [ rdf:type owl:Class ;
                                                  owl:unionOf ( chips:Acoustic_Wave_Characteristic
                                                                chips:Electromagnetic_Property
                                                              )
                                                ]
                           ] ;
           rdfs:label "Wave"@en ;
           skos:definition "Wave is a value object representing a propagating periodic disturbance that transfers energy through a medium or vacuum without net displacement of matter."@en ;
           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Wave_Characteristic
chips:Wave_Characteristic rdf:type owl:Class ;
                          rdfs:subClassOf chips:Physical_Property ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty pmdco:characteristic_of ;
                                            owl:someValuesFrom chips:Wave
                                          ] ;
                          rdfs:label "Wave Characteristic"@en ;
                          skos:definition "A wave characteristic is a physical property that describes an attribute of a wave, including its frequency, amplitude, wavelength, phase, polarization, and propagation speed."@en ;
                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Waveform_Generator
chips:Waveform_Generator rdf:type owl:Class ;
                         rdfs:subClassOf chips:Signal_Generator ;
                         rdfs:label "Waveform Generator"@en ;
                         skos:definition "Waveform Generator is a signal generator instrument that synthesizes arbitrary or standard periodic waveforms—such as sine, square, and triangle waves—at user-defined frequencies, amplitudes, and phases."@en ;
                         pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Waveguide
chips:Waveguide rdf:type owl:Class ;
                rdfs:subClassOf chips:Hardware ;
                rdfs:label "Waveguide"@en ;
                skos:definition "Waveguide is a hardware component comprising a hollow metallic tube or dielectric structure that confines and guides electromagnetic waves along its length at microwave or millimeter-wave frequencies."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Wavelength
chips:Wavelength rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty chips:isInverselyProportionalTo ;
                                       owl:someValuesFrom chips:Frequency
                                     ] ;
                 rdfs:subClassOf chips:Wave_Characteristic ,
                                 pmdco:Lnge ;
                 rdfs:label "Wavelength"@en ;
                 skos:definition "Wavelength is the spatial period of a periodic wave, equal to the distance between successive wavefronts of the same phase, determining the diffraction limit in optical systems."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Wedge_Test
chips:Wedge_Test rdf:type owl:Class ;
                 rdfs:subClassOf pmdco:Mechanischer_Testprozess ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty chips:measured ;
                                   owl:someValuesFrom chips:Adhesion
                                 ] ;
                 rdfs:label "Wedge Test"@en ;
                 skos:definition "Wedge Test is a mechanical adhesion test in which a thin wedge is inserted between two bonded surfaces to introduce a defined mode I crack opening displacement, and the crack length is measured to calculate the adhesion fracture energy."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Western_Digital
chips:Western_Digital rdf:type owl:Class ;
                      rdfs:subClassOf pmdco:Hersteller ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty prov:hadDelegate ;
                                        owl:someValuesFrom chips:Magnetic_Hard_Disk_Drive
                                      ] ;
                      rdfs:label "Western Digital"@en ;
                      skos:definition "Western Digital is a data storage company that designs and manufactures hard disk drives, NAND flash memory, and solid-state drives for personal, enterprise, and cloud storage markets."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Wet_Chemistry
chips:Wet_Chemistry rdf:type owl:Class ;
                    rdfs:subClassOf chips:Chemical_Process ,
                                    chips:Nanofabrication ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty prov:wasAssociatedWith ;
                                      owl:someValuesFrom chips:Rate_Of_Change_Process
                                    ] ;
                    rdfs:label "Wet Chemistry"@en ;
                    skos:definition "Wet Chemistry is a class of analytical techniques performed in the liquid phase, including titration, gravimetry, and precipitation reactions, used to characterize the elemental or molecular composition of materials."@en ;
                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/White_Light
chips:White_Light rdf:type owl:Class ;
                  rdfs:subClassOf chips:Photon_Beam ;
                  rdfs:label "White Light"@en ;
                  skos:definition "White Light is a photon beam with a broad, continuous spectral distribution spanning the visible wavelength range from approximately 380 to 700 nm, used in full-spectrum illumination, white-light interferometry, and broadband optical characterisation."@en ;
                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/White_Paper
chips:White_Paper rdf:type owl:Class ;
                  rdfs:subClassOf chips:Design_Document ;
                  rdfs:label "White Paper"@en ;
                  skos:definition "White Paper is a design or policy document that provides a comprehensive, authoritative description of a technical approach, product specification, or policy position, intended to inform decision-makers or stakeholders."@en ;
                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Wide_Angle_Xray_Scattering
chips:Wide_Angle_Xray_Scattering rdf:type owl:Class ;
                                 rdfs:subClassOf chips:Xray_Scattering ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty pmdco:belongsToProject ;
                                                   owl:someValuesFrom chips:Grand_Challenge_7
                                                 ] ;
                                 rdfs:label "Wide Angle X-ray Scattering"@en ;
                                 skos:definition "Wide-Angle X-ray Scattering (WAXS) is an X-ray scattering technique that measures diffracted intensity at larger angles corresponding to d-spacings on the atomic scale, used to characterize crystalline phases, unit cell parameters, and crystallite size."@en ;
                                 pmdco:abbreviation "WAXS"@en ;
                                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Wide_Bandgap_Semiconductor
