                          rdfs:label "Aging Temperature"@en ,
                                     "Alterungstemperatur"@de ;
                          skos:definition "Variable Temperature during an Aging Process depending on the desired deposition formations."@en .


###  https://w3id.org/pmd/co/Alterungszeit
pmdco:Alterungszeit rdf:type owl:Class ;
                    rdfs:subClassOf pmdco:Zeit ;
