###  https://w3id.org/CHIPS/metrology-ontology/Noise
chips:Noise rdf:type owl:Class ;
            rdfs:subClassOf chips:Detection_Property ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty prov:wasGeneratedBy ;
                              owl:someValuesFrom [ rdf:type owl:Class ;
                                                   owl:unionOf ( chips:Computational_Process
                                                                 chips:Derived_Process
                                                                 pmdco:Messprozess
                                                               )
                                                 ]
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty chips:calculatedBy ;
                              owl:someValuesFrom chips:Noise_Analysis
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty pmdco:relates_to ;
                              owl:someValuesFrom chips:Electromagnetic_Property
                            ] ;
            rdfs:label "Noise"@en ;
            skos:definition "Noise is an unwanted stochastic fluctuation superimposed on a measured signal, arising from thermal agitation, shot noise, or environmental interference, that limits the precision and sensitivity of a measurement system."@en ;
            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Noise_Analysis
chips:Noise_Analysis rdf:type owl:Class ;
                     rdfs:subClassOf chips:Signal_Analysis ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty pmdco:belongsToProject ;
                                       owl:someValuesFrom [ owl:intersectionOf ( chips:Grand_Challenge_4
                                                                                 [ rdf:type owl:Restriction ;
                                                                                   owl:onProperty pmdco:characteristic ;
                                                                                   owl:someValuesFrom chips:Transistor
                                                                                 ]
                                                                               ) ;
                                                            rdf:type owl:Class
                                                          ]
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty pmdco:characteristic ;
                                       owl:someValuesFrom chips:Noise
                                     ] ;
                     rdfs:label "Noise Analysis"@en ;
                     skos:definition "Noise Analysis is a signal analysis process that characterizes the stochastic fluctuations in an electrical, optical, or mechanical signal by measuring their power spectral density, correlation functions, or statistical moments."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


