###  https://w3id.org/CHIPS/metrology-ontology/Dilatometer
chips:Dilatometer rdf:type owl:Class ;
                  rdfs:subClassOf pmdco:Dimensionsmesswerkzeug ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty prov:wasAssociateFor ;
                                    owl:someValuesFrom chips:Dilatometry
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty prov:wasAssociateFor ;
                                    owl:someValuesFrom [ rdf:type owl:Class ;
                                                         owl:unionOf ( chips:Grand_Challenge_3
                                                                       chips:Grand_Challenge_6
                                                                     )
                                                       ]
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty chips:measured ;
                                    owl:someValuesFrom chips:Coefficient_of_Thermal_Expansion
                                  ] ;
                  rdfs:label "Dilatometer"@en ;
                  skos:definition "Dilatometer is a dimensional measurement instrument that precisely measures the change in length or volume of a specimen as a function of temperature, used to determine thermal expansion coefficients and detect phase transitions."@en ;
                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Dilatometry
chips:Dilatometry rdf:type owl:Class ;
                  rdfs:subClassOf chips:Thermal_Measurement_Process ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty prov:wasAssociatedWith ;
                                    owl:someValuesFrom chips:Dilatometer
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty chips:measured ;
                                    owl:someValuesFrom [ rdf:type owl:Class ;
                                                         owl:unionOf ( chips:Coefficient_of_Thermal_Expansion
                                                                       [ owl:intersectionOf ( chips:Strain
                                                                                              [ rdf:type owl:Restriction ;
                                                                                                owl:onProperty pmdco:characteristic ;
                                                                                                owl:someValuesFrom pmdco:Temperatur
                                                                                              ]
                                                                                            ) ;
                                                                         rdf:type owl:Class
                                                                       ]
                                                                     )
                                                       ]
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty pmdco:hasFunction ;
                                    owl:someValuesFrom pmdco:Length_Changing_Process
                                  ] ;
                  rdfs:label "Dilatometry"@en ;
                  skos:definition "Dilatometry is a thermal measurement process that measures the dimensional change of a material as a function of temperature to determine the coefficient of thermal expansion and detect phase transformations."@en ;
                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Dimension
chips:Dimension rdf:type owl:Class ;
                skos:definition "Dimension is a measurable spatial extent of an object or structure, such as length, width, height, diameter, or thickness, expressed as a numerical value with associated units of length."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Dimensional_Metrology
chips:Dimensional_Metrology rdf:type owl:Class ;
                            rdfs:subClassOf chips:Metrology ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty prov:wasInfluencedBy ;
                                              owl:someValuesFrom chips:Grand_Challenge_5
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty prov:wasInfluencedBy ;
                                              owl:someValuesFrom pmdco:Dimensionsmesswerkzeug
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty pmdco:characteristic ;
                                              owl:someValuesFrom chips:Dimension
                                            ] ;
                            rdfs:label "Dimensional Metrology"@en ;
                            skos:definition """Dimensional metrology is a branch of metrology that:
-     Involves the measurement and analysis of physical dimensions of objects or systems
-    Focuses on quantifying and ensuring accuracy and precision in measurements of length, width, height, thickness, and other spatial parameters
-    Utilizes various tools and techniques such as coordinate measuring machines, optical measurement systems, and precision instruments to gather and analyze dimensional data."""@en ;
                            pmdco:definitionSource "CVCS 0.0.7"@en .


