chips:Sigray rdf:type owl:Class ;
             rdfs:subClassOf pmdco:Hersteller ;
             rdfs:label "Sigray"@en ;
             skos:definition "Sigray is a scientific instruments company that develops and manufactures high-brightness X-ray sources and advanced X-ray optics for laboratory-based X-ray microscopy and spectroscopy instruments."@en ;
             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Silicon_Interface
chips:Silicon_Interface rdf:type owl:Class ;
                        rdfs:subClassOf chips:Interface ;
                        rdfs:label "Silicon Interface"@en ;
                        skos:definition "A silicon interface is the boundary region between silicon and an adjacent material such as silicon dioxide or a metal, characterized by interface trap density, fixed charge, and band alignment."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Silicon_Photodiode
chips:Silicon_Photodiode rdf:type owl:Class ;
                         rdfs:subClassOf chips:Photodiode ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty prov:hadDerivation ;
                                           owl:someValuesFrom chips:Extreme_Ultraviolet
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty prov:wasAssociateFor ;
                                           owl:someValuesFrom chips:Grand_Challenge_2
                                         ] ;
                         rdfs:label "Silicon Photodiode"@en ;
                         skos:definition "Silicon Photodiode is a semiconductor photodetector based on a p-n or p-i-n junction in silicon that converts incident photons in the ultraviolet to near-infrared range into a photocurrent proportional to optical power."@en ;
                         pmdco:definitionSource "claude-sonnet-4-6"@en .


