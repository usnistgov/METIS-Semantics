###  https://w3id.org/pmd/co/Akkreditierungsdokument
pmdco:Akkreditierungsdokument rdf:type owl:Class ;
                              rdfs:subClassOf pmdco:Dokument ;
                              rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                              rdfs:label "Accreditation Document"@en ,
                                         "Akkreditierungsdokument"@de ;
                              skos:definition "Diese Entität beschreibt ein Dokument, welches aussagt, dass einer Organisation, Person oder Einrichtung eine offizielle Konformität mit einer Norm anerkannt wurde. Dies kann z. B. Prozesse, Ausrüstungen oder ganze Laboratorien umfassen."@de ,
                                              "This entity describes a document used to state that an official authorization or approval to recognize or vouch for a conformation with a standard was granted to an organization, person, or entity. This may include, e.g., processes, (sets of) equipment, or entire laboratories."@en ;
                              pmdco:definitionSource "https://www.merriam-webster.com/dictionary/accreditation"@en .


###  https://w3id.org/pmd/co/Algorithmus
pmdco:Algorithmus rdf:type owl:Class ;
                  rdfs:subClassOf pmdco:Digital_Entity ,
                                  [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                           owl:onProperty prov:wasUsedBy ;
