                                     ] ;
                     rdfs:label "Susceptibility"@en ;
                     skos:definition "Susceptibility is a dimensionless magnetic property defined as the ratio of magnetization to applied magnetic field strength, characterizing the degree of magnetization induced in a material."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


