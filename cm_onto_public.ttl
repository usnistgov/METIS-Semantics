                                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Research_Facility
chips:Research_Facility rdf:type owl:Class ;
                        rdfs:subClassOf chips:Facility ;
                        rdfs:label "Research Facility"@en ;
                        skos:definition "A research facility is a dedicated infrastructure that provides specialized equipment, expertise, and services for scientific research and development activities in materials science, semiconductor fabrication, or metrology."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Research_Grade_Testing_Material
chips:Research_Grade_Testing_Material rdf:type owl:Class ;
                                      rdfs:subClassOf chips:Benchmarking_Material ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty prov:wasAttributedTo ;
                                                        owl:someValuesFrom chips:National_Institute_of_Standards_and_Technology
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty pmdco:output_of ;
                                                        owl:someValuesFrom chips:Grand_Challenge_3
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty pmdco:output_of ;
                                                        owl:someValuesFrom chips:Grand_Challenge_4
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty pmdco:output_of ;
                                                        owl:someValuesFrom chips:Grand_Challenge_6
                                                      ] ;
                                      rdfs:label "Research Grade Testing Material"@en ;
