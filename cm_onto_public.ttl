###  https://w3id.org/CHIPS/metrology-ontology/Beamline_3
chips:Beamline_3 rdf:type owl:Class ;
                 rdfs:subClassOf chips:Beamline ,
                                 [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                          owl:onProperty pmdco:characteristic ;
                                                          owl:someValuesFrom [ owl:intersectionOf ( chips:Calibration
                                                                                                    [ rdf:type owl:Restriction ;
                                                                                                      owl:onProperty prov:wasAssociatedWith ;
                                                                                                      owl:someValuesFrom chips:Photodiode
                                                                                                    ]
                                                                                                  ) ;
                                                                               rdf:type owl:Class
                                                                             ]
                                                        ]
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty pmdco:relates_to ;
                                                          owl:someValuesFrom chips:Grand_Challenge_2
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty prov:actedOnBehalfOf ;
                                   owl:someValuesFrom chips:Synchrotron_Ultraviolet_Radiation_Facility_III
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty prov:wasAssociateFor ;
                                   owl:someValuesFrom [ rdf:type owl:Class ;
                                                        owl:unionOf ( chips:Grand_Challenge_2
                                                                    )
                                                      ]
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty pmdco:characteristic ;
                                   owl:someValuesFrom chips:Calibration
                                 ] ;
                 rdfs:label "Beamline 3"@en ;
                 skos:altLabel "BL3" ;
                 skos:definition "Beamline 3 is a specific experimental beamline at a synchrotron facility configured for a particular X-ray measurement technique."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Beamline_4
