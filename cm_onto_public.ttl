                                      rdfs:isDefinedBy <https://w3id.org/pmd/mo> ;
                                      rdfs:label "Elektronenbeugung ausgewählter Regionen"@de ,
                                                 "Selected Area Electron Diffraction"@en ;
                                      skos:definition "Selected Area Electron Diffraction is a technique used in transmission electron microscopy (TEM) to study the crystallographic orientation of small regions within a sample. By selecting a specific area of the sample and directing an electron beam onto it, diffraction patterns are generated. These patterns offer insights into the sample's crystal structure and orientation."@en ;
                                      pmdco:definitionSource "ChatGPT 3.5"@en ;
                                      mo:abbreviation "SAD"@en ,
                                                      "SAED"@en .


