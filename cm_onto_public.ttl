                                  rdfs:subClassOf pmdco:Messgert ;
                                  rdfs:label "Mass Measurement Instrument"@en ;
                                  skos:definition "Mass Measurement Instrument is a measurement device that determines the mass of a specimen using gravimetric, piezoelectric resonance, or inertial sensing principles."@en ;
                                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Mass_Spectrometer
chips:Mass_Spectrometer rdf:type owl:Class ;
                        rdfs:subClassOf mo:Spektrometer ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty prov:wasAssociateFor ;
                                          owl:someValuesFrom chips:Mass_Spectrometry
                                        ] ;
                        rdfs:label "Mass Spectrometer"@en ;
                        skos:definition "Mass Spectrometer is an analytical instrument that ionizes a sample and separates the resulting ions by their mass-to-charge ratio to identify and quantify chemical species."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Mass_Spectrometry
chips:Mass_Spectrometry rdf:type owl:Class ;
                        rdfs:subClassOf chips:Element_Identification ,
                                        chips:Spectrometry ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty prov:wasAssociatedWith ;
                                          owl:someValuesFrom chips:Mass_Spectrometer
