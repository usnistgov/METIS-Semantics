                  rdfs:label "Bioactivity"@en ;
                  skos:definition "Bioactivity is a domain of biology concerned with the capacity of a substance to produce a measurable physiological or biochemical effect in a living system."@en ;
                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Biochemistry
chips:Biochemistry rdf:type owl:Class ;
                   rdfs:subClassOf chips:Biology ,
                                   chips:Chemistry ;
                   rdfs:label "Biochemistry"@en ;
                   skos:definition "Biochemistry is the branch of biology and chemistry that investigates the chemical processes and molecular structures underlying living organisms, including metabolism, protein function, and nucleic acid biology."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Bioelectronic_Sensor
chips:Bioelectronic_Sensor rdf:type owl:Class ;
                           rdfs:subClassOf chips:Biosensor ;
                           rdfs:label "Bioelectronic Sensor"@en ;
                           skos:definition "Bioelectronic Sensor is a biosensor that transduces a biological recognition event into an electrical signal through integration of a biological sensing element with an electronic transducer."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Biofunctional_Interface
chips:Biofunctional_Interface rdf:type owl:Class ;
                              rdfs:subClassOf chips:Interface ;
                              rdfs:label "Biofunctional Interface"@en ;
                              skos:definition "A biofunctional interface is an engineered surface or boundary layer designed to present specific biochemical groups that mediate selective interactions with biological molecules or cells in biosensor and bioelectronic devices."@en ;
                              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Biological_Macromolecule
chips:Biological_Macromolecule rdf:type owl:Class ;
                               rdfs:subClassOf chips:Macromolecule ,
