                        dcterms:bibliographicCitation "National Institute of Standards and Technology. (2022). Strategic Opportunities for U.S. Semiconductor Manufacturing: Facilitating U.S. Leadership and Competitiveness through Advancements in Measurements and Standards (NIST Special Publication CHIPS 1000). U.S. Department of Commerce." ;
                        dcterms:title "Metrology to Enhance Security and Provenance of Microelectronic-based Components and Products"@en ;
                        rdfs:label "Grand Challenge 7"@en ;
                        rdfs:seeAlso "https://nvlpubs.nist.gov/nistpubs/CHIPS/NIST.CHIPS.1000.pdf"^^xsd:anyURI ;
                        skos:definition "Pursue a comprehensive approach to hardware security protection that includes standards, protocols, formal testing processes, and advanced computational technologies while providing avenues for assurance and provenance of microelectronic components across the supply chain and end products."@en ;
                        pmdco:abbreviation "GC 7" .


###  https://w3id.org/CHIPS/metrology-ontology/Graph_Neural_Network
chips:Graph_Neural_Network rdf:type owl:Class ;
                           rdfs:subClassOf chips:Neural_Network ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty pmdco:belongsToProject ;
                                             owl:someValuesFrom chips:Grand_Challenge_5
                                           ] ;
                           rdfs:label "Graph Neural Network"@en ;
                           skos:definition "Graph Neural Network (GNN) is a neural network architecture that operates directly on graph-structured data by aggregating feature information from neighboring nodes through message-passing to predict node, edge, or graph properties."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Graphics_Processing_Unit
chips:Graphics_Processing_Unit rdf:type owl:Class ;
                               rdfs:subClassOf pmdco:Computing_Node ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty prov:wasAssociateFor ;
                                                 owl:someValuesFrom chips:Grand_Challenge_4
                                               ] ;
                               rdfs:label "Graphics Processing Unit"@en ;
                               skos:definition "Graphics Processing Unit (GPU) is a massively parallel computing node comprising thousands of smaller processing cores optimized for concurrent floating-point arithmetic, used in machine learning training and scientific computing."@en ;
                               pmdco:abbreviation "GPU"@en ;
                               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Graphics_Software
chips:Graphics_Software rdf:type owl:Class ;
                        rdfs:subClassOf prov:Software_Agent ;
                        rdfs:label "Graphics Software"@en ;
                        skos:definition "Graphics Software is a software agent used to create, edit, and render two- or three-dimensional visual representations of data, structures, or designs."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Grating
chips:Grating rdf:type owl:Class ;
              rdfs:subClassOf chips:Engineered_Structure ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty prov:wasUsedBy ;
                                owl:someValuesFrom chips:Grand_Challenge_2
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty prov:wasUsedBy ;
                                owl:someValuesFrom chips:Grand_Challenge_5
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty pmdco:characteristic ;
                                owl:someValuesFrom chips:Period
                              ] ;
              rdfs:label "Grating"@en ;
              skos:definition "Grating is a periodic engineered structure with regularly spaced rulings, grooves, or refractive index modulations that diffracts electromagnetic radiation into discrete angular orders, used as a wavelength-dispersive or wavelength-selective optical component in spectrometers and laser cavities."@en ;
              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Greens_Function
chips:Greens_Function rdf:type owl:Class ;
                      rdfs:subClassOf chips:Mathematical_Concept ,
                                      [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                               owl:onProperty prov:wasUsedBy ;
                                                               owl:someValuesFrom chips:Grand_Challenge_4
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty pmdco:characteristic ;
                                                               owl:someValuesFrom chips:Fortran
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                      rdfs:label "Greens Function"@en ;
                      skos:definition "Green's Function is a quantum mechanics mathematical model that represents the propagator of a field equation, used to compute response functions, spectral properties, and correlations in quantum many-body systems."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Greenspan_Acoustic_Viscometer
chips:Greenspan_Acoustic_Viscometer rdf:type owl:Class ;
                                    rdfs:subClassOf chips:Viscometer ;
                                    rdfs:label "Greenspan Acoustic Viscometer"@en ;
                                    skos:altLabel "Greenspan Viscometer"@en ;
                                    skos:definition "Greenspan Acoustic Viscometer is a precision viscometer that determines the viscosity of a fluid by measuring the resonant frequency and quality factor of a torsional acoustic resonator immersed in the fluid."@en ;
                                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Guide
chips:Guide rdf:type owl:Class ;
            rdfs:subClassOf pmdco:Dokument ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty prov:wasGeneratedBy ;
                              owl:someValuesFrom [ owl:intersectionOf ( chips:Grand_Challenge_4
                                                                        pmdco:Messprozess
                                                                      ) ;
                                                   rdf:type owl:Class
                                                 ]
                            ] ;
            rdfs:label "Guide"@en ;
            skos:definition "Guide is a document that provides instructional or procedural information to assist users in performing a task, operating equipment, or following a defined workflow."@en ;
            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Gyromagnetic_Ratio
chips:Gyromagnetic_Ratio rdf:type owl:Class ;
                         rdfs:subClassOf chips:Magnetic_Property ;
                         rdfs:label "Gyromagnetic Ratio"@en ;
                         skos:altLabel "g-factor" ;
                         skos:definition "Gyromagnetic ratio is the ratio of a particle's or system's magnetic moment to its angular momentum, governing the precession frequency of magnetization in an applied field (Larmor precession)."@en ;
                         pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/HRL
chips:HRL rdf:type owl:Class ;
          rdfs:subClassOf chips:Research_and_Development_Agents ;
          rdfs:label "HRL"@en ;
          skos:definition "HRL Laboratories is a research and development organization that conducts advanced research in microelectronics, photonics, materials science, and information science for defense and commercial applications."@en ;
          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Hall_Mobility
chips:Hall_Mobility rdf:type owl:Class ;
                    rdfs:subClassOf chips:Electromagnetic_Property ;
                    rdfs:label "Hall Mobility"@en ;
                    skos:definition "Hall mobility is the drift mobility of charge carriers in a semiconductor extracted from Hall effect measurements, quantifying how quickly carriers move in response to an applied electric field."@en ;
                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Hamamatsu_Photonics
chips:Hamamatsu_Photonics rdf:type owl:Class ;
                          rdfs:subClassOf pmdco:Hersteller ;
                          rdfs:label "Hamamatsu Photonics"@en ;
                          skos:definition "Hamamatsu Photonics is a photonic device company that manufactures photodetectors, photomultiplier tubes, image sensors, and light sources used in scientific instrumentation, medical imaging, and semiconductor inspection."@en ;
                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Hard_Xray
chips:Hard_Xray rdf:type owl:Class ;
                rdfs:subClassOf chips:Xray_Beam ;
                rdfs:label "Hard X-ray"@en ;
                skos:definition "Hard X-ray is an X-ray beam with photon energies typically above 15 keV, characterised by high penetrating power that enables bulk and subsurface characterisation of materials through diffraction, fluorescence, and computed tomography."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Hardness
chips:Hardness rdf:type owl:Class ;
               rdfs:subClassOf chips:Mechanical_Property ,
                               [ rdf:type owl:Class ;
                                 owl:unionOf ( [ rdf:type owl:Restriction ;
                                                 owl:onProperty chips:calculatedBy ;
                                                 owl:someValuesFrom chips:Derived_Process
                                               ]
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty chips:measuredBy ;
                                                 owl:someValuesFrom pmdco:Messprozess
                                               ]
                                             )
                               ] ;
               rdfs:label "Hardness"@en ;
               skos:definition "Hardness is a material property that represents the resistance of a surface to localized plastic deformation, measured by the depth or area of an indentation left by a harder indenter under a prescribed load."@en ;
               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/HardnessTesting
chips:HardnessTesting rdf:type owl:Class ;
                      rdfs:subClassOf pmdco:Mechanischer_Testprozess ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty chips:measured ;
                                        owl:someValuesFrom chips:Hardness
                                      ] ;
                      skos:definition "Hardness Testing is a mechanical testing process that measures the resistance of a material surface to permanent plastic deformation by pressing a standardised indenter under a defined load and measuring the size or depth of the resulting indentation."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Hardware
chips:Hardware rdf:type owl:Class ;
               rdfs:subClassOf pmdco:Prozessknoten ;
               rdfs:comment "The distinction between Hardware and Instrument is that Hardware tends to produce or prepare the state of a material or a device for an Instrument to process."@en ;
               rdfs:label "Hardware"@en ;
               skos:definition "Hardware is a process node comprising the physical electronic, mechanical, or optical components and systems used to perform fabrication, measurement, or data processing operations."@en ;
               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Hardware_Security_Management
chips:Hardware_Security_Management rdf:type owl:Class ;
                                   rdfs:subClassOf chips:Cybersecurity_Management ,
                                                   chips:Vulnerability_Management ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty pmdco:belongsToProject ;
                                                     owl:someValuesFrom chips:Grand_Challenge_7
                                                   ] ;
                                   rdfs:label "Hardware Security Management"@en ;
                                   skos:definition "Hardware Security Management is a cybersecurity management process that implements physical and logical controls to protect hardware components, supply chains, and embedded systems from unauthorized access, tampering, or counterfeiting."@en ;
                                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Harmonic
chips:Harmonic rdf:type owl:Class ;
               rdfs:subClassOf chips:Wave_Characteristic ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty chips:hasMathematicalRelationshipWith ;
                                 owl:someValuesFrom chips:Integer
                               ] ;
               rdfs:label "Harmonic"@en ;
               skos:definition "A harmonic is a wave characteristic that represents a frequency component of a periodic signal at an integer multiple of the fundamental frequency, arising from nonlinearity or resonance in a physical system."@en ;
               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Harmonic_Number
chips:Harmonic_Number rdf:type owl:Class ;
                      rdfs:subClassOf chips:Integer ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty pmdco:characteristic_of ;
                                        owl:someValuesFrom chips:Wave
                                      ] ;
                      rdfs:label "Harmonic Number"@en ;
                      skos:definition "The harmonic number is a positive integer that specifies which harmonic multiple of a fundamental frequency a given wave component corresponds to, where the first harmonic is the fundamental and subsequent integers denote overtones."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


