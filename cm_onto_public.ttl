                          pmdco:definitionSource "claude-opus-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Ceramic_Material
chips:Ceramic_Material rdf:type owl:Class ;
                       rdfs:subClassOf chips:Material ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty prov:wasUsedBy ;
                                         owl:someValuesFrom chips:Grand_Challenge_3
                                       ] ;
                       rdfs:label "Ceramic Material"@en ;
                       skos:definition "A ceramic material is an inorganic, non-metallic solid material comprising metal, non-metal, or metalloid atoms bonded primarily by ionic and covalent bonds, exhibiting high hardness, brittleness, and thermal stability."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


