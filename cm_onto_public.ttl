                               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Electromagnetic_Wave_Absoption
chips:Electromagnetic_Wave_Absoption rdf:type owl:Class ;
                                     rdfs:subClassOf chips:Absorption_Process ;
                                     rdfs:label "Electromagnetic Wave Absoption"@en ;
                                     skos:definition "Electromagnetic Wave Absorption is a physical process in which a material converts incident electromagnetic radiation into other forms of energy, such as heat or electronic excitation, by coupling the wave to internal degrees of freedom."@en ;
                                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Electromagnetism
chips:Electromagnetism rdf:type owl:Class ;
                       rdfs:subClassOf chips:Physics ;
