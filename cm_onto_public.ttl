                                                 owl:onProperty prov:wasAssociateFor ;
                                                 owl:someValuesFrom chips:Optical_Measuring_Process
                                               ] ;
                               rdfs:label "Optical Measuring Device"@en ;
                               skos:definition "Optical Measuring Device is an electromagnetic measurement instrument that quantifies the optical properties of a material or radiation field, including reflectance, transmittance, refractive index, or film thickness."@en ;
                               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Optical_Measuring_Process
chips:Optical_Measuring_Process rdf:type owl:Class ;
                                rdfs:subClassOf pmdco:Messprozess ;
                                rdfs:label "Optical Measuring Process"@en ;
                                skos:definition "An optical measuring process is a measurement process that determines the properties of a specimen by detecting and analyzing the interaction of light or other electromagnetic radiation with the specimen."@en ;
                                pmdco:definitionSource "claude-opus-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Optical_Spectroscopy
chips:Optical_Spectroscopy rdf:type owl:Class ;
                           rdfs:subClassOf chips:Optical_Measuring_Process ,
                                           mo:Spectroscopy ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty prov:generated ;
