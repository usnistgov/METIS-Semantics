                                                      owl:someValuesFrom chips:Write_Error_Rate
                                                    ] ;
                                    rdfs:label "Write Error Rate Distribution"@en ;
                                    skos:definition "Write error rate distribution is the statistical characterization of write errors in a magnetic recording system as a function of applied write field, thermal fluctuations, or medium variability."@en ;
                                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Write_Head
chips:Write_Head rdf:type owl:Class ;
                 rdfs:subClassOf chips:Device ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty dcterms:isPartOf ;
                                   owl:someValuesFrom chips:Magnetic_Hard_Disk_Drive
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty prov:wasUsedBy ;
                                   owl:someValuesFrom chips:Grand_Challenge_5
                                 ] ;
                 rdfs:label "Write Head"@en ;
                 skos:definition "Write Head is a hardware device in a magnetic storage system that generates a localized magnetic field to record data bits onto a magnetic medium by aligning the magnetization of small regions."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/XRF_Consulting
chips:XRF_Consulting rdf:type owl:Class ;
                     rdfs:subClassOf chips:Service_Industry ;
                     rdfs:label "XRF Consulting"@en ;
                     skos:definition "XRF Consulting is a materials analysis services company that provides X-ray fluorescence spectrometry consulting, measurement services, and method development for elemental analysis of semiconductor and industrial materials."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Xray
chips:Xray rdf:type owl:Class ;
           rdfs:subClassOf chips:Photon ;
           rdfs:label "X-ray"@en ;
           skos:definition "X-ray is a photon with energy in the range of approximately 100 eV to 100 keV, used in diffraction, spectroscopy, imaging, and lithography due to its penetrating power and interaction with core electrons."@en ;
           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Xray_Absorbance_Spectrum
chips:Xray_Absorbance_Spectrum rdf:type owl:Class ;
                               rdfs:subClassOf chips:Xray_Spectrum ;
                               rdfs:label "X-ray Absorbance Spectrum"@en ;
                               skos:definition "An X-ray absorbance spectrum is a dataset of X-ray absorption as a function of photon energy across an absorption edge, providing information on oxidation state and local atomic structure."@en ;
                               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Xray_Absorption
chips:Xray_Absorption rdf:type owl:Class ;
                      rdfs:subClassOf chips:Electromagnetic_Wave_Absoption ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty prov:used ;
                                        owl:someValuesFrom chips:Xray_Beam
                                      ] ;
                      rdfs:label "X-ray Absorption"@en ;
                      skos:definition "X-ray Absorption is an electromagnetic wave absorption process in which a material absorbs X-ray photons by exciting core electrons to unoccupied states or into the continuum, with the absorption fine structure encoding local electronic and structural information."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Xray_Absorption_Fine_Structure_Process
chips:Xray_Absorption_Fine_Structure_Process rdf:type owl:Class ;
                                             rdfs:subClassOf chips:Xray_Absorption ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty prov:generated ;
                                                               owl:someValuesFrom chips:Table
                                                             ] ;
                                             rdfs:label "X-ray Absorption Fine Structure Process"@en ;
                                             skos:definition "X-ray Absorption Fine Structure (XAFS/EXAFS) is a synchrotron technique that measures the oscillatory modulation of X-ray absorption above a core-level edge to determine the radial distribution, coordination number, and identity of neighboring atoms."@en ;
                                             pmdco:abbreviation "XAFS" ;
                                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Xray_Beam
chips:Xray_Beam rdf:type owl:Class ;
                rdfs:subClassOf chips:Photon_Beam ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty pmdco:composed_of ;
                                  owl:someValuesFrom chips:Xray
                                ] ;
                rdfs:label "X-ray Beam"@en ;
                skos:definition "X-ray Beam is a directed photon beam with energies in the range from approximately 100 eV to several hundred keV, used as the primary probe in diffraction, fluorescence, imaging, and spectroscopy techniques for structural and compositional materials characterisation."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Xray_Computed_Tomography
chips:Xray_Computed_Tomography rdf:type owl:Class ;
