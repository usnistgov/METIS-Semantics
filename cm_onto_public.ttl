                                     owl:onProperty pmdco:relates_to ;
                                     owl:someValuesFrom mo:Spectroscopy
                                   ] ;
                   rdfs:label "Spectrometry"@en ;
                   skos:definition "Spectrometry is a measurement process that separates and quantifies different spectral components—such as mass-to-charge ratios or wavelengths—of a signal or flux to identify and measure constituents."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


