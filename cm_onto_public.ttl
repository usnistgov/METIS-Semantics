                                             owl:onProperty pmdco:output_of ;
                                             owl:someValuesFrom chips:Derived_Process
                                           ] ;
                           rdfs:label "Thermal Conductivity"@en ;
                           skos:definition "Thermal conductivity is an intrinsic material property that quantifies the rate of heat conduction through a unit area per unit temperature gradient, governing thermal management in semiconductor devices."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en ;
                           pmdco:symbol "η"@el .


