###  https://w3id.org/CHIPS/metrology-ontology/Saturation_Field
chips:Saturation_Field rdf:type owl:Class ;
                       rdfs:subClassOf chips:Magnetic_Field ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty pmdco:output_of ;
                                         owl:someValuesFrom pmdco:Messprozess
                                       ] ;
                       rdfs:label "Saturation Field"@en ;
                       skos:definition "Saturation field is the magnitude of applied magnetic field required to achieve saturation magnetization in a ferromagnetic material, beyond which magnetization no longer increases with field."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Saturation_Magnetization
