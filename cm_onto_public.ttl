                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty prov:wasAssociatedWith ;
                                          owl:someValuesFrom chips:Electrodeposition_Tool
                                        ] ;
                        rdfs:label "Electrodeposition"@en ;
                        skos:definition "Electrodeposition is a thin film growth process in which an electrical current drives the reduction of metal ions from an electrolyte solution to deposit a metallic layer onto a conductive substrate cathode."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Electrodeposition_Tool
chips:Electrodeposition_Tool rdf:type owl:Class ;
