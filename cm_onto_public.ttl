                                      owl:someValuesFrom chips:Derived_Process
                                    ] ;
                    rdfs:label "Strain Tensor"@en ;
                    skos:definition "Strain Tensor is a second-rank symmetric tensor that fully describes the local infinitesimal deformation state of a solid at a point, relating displacement gradients to elongations and shear deformations in all directions."@en ;
                    pmdco:definitionSource "claude-sonnet-4-6"@en .


