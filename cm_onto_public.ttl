pmdco:Umfang rdf:type owl:Class ;
             rdfs:subClassOf pmdco:Lnge ;
             rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
             rdfs:label "Perimeter"@en ,
                        "Umfang"@de ;
