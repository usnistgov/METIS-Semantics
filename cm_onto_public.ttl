                                                                      chips:Grand_Challenge_7
                                                                    )
                                                      ]
                                 ] ;
                 rdfs:label "Arc Melter"@en ;
                 skos:definition "Arc Melter is a temperature treatment instrument that uses an electric arc struck between a tungsten electrode and a metallic charge in a water-cooled copper hearth under an inert atmosphere to melt and alloy refractory metals."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


