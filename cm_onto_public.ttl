chips:Chamber rdf:type owl:Class ;
              rdfs:subClassOf chips:Sample_Environment ;
              rdfs:label "Chamber"@en ;
              skos:definition "Chamber is a sample environment component comprising an enclosed vessel that provides a controlled atmosphere, pressure, and temperature for specimen processing or measurement."@en ;
              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Change_Process
chips:Change_Process rdf:type owl:Class ;
                     rdfs:subClassOf pmdco:Prozess ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty prov:wasInformedBy ;
                                       owl:someValuesFrom chips:Timedependent_Process
                                     ] ;
                     rdfs:label "Change Process"@en ;
                     skos:definition "Change Process is an operation that modifies the state, content, or properties of an entity such as a material, dataset, or system."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Channel_Model
chips:Channel_Model rdf:type owl:Class ;
                    rdfs:subClassOf chips:Analytical_Model ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty prov:wasGeneratedBy ;
                                      owl:someValuesFrom chips:Derived_Process
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty prov:wasGeneratedBy ;
                                      owl:someValuesFrom pmdco:Messprozess
                                    ] ;
                    rdfs:label "Channel Model"@en ;
                    skos:definition "Channel Model is an analytical or empirical mathematical model that characterizes the propagation of electromagnetic signals through a physical transmission medium, accounting for path loss, multipath fading, and interference."@en ;
                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Channel_Sounder
chips:Channel_Sounder rdf:type owl:Class ;
                      rdfs:subClassOf chips:Electromagnetic_Measurement_Device ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty prov:wasAssociateFor ;
                                        owl:someValuesFrom chips:Channel_Sounding
                                      ] ;
                      rdfs:label "Channel Sounder"@en ;
                      skos:definition "Channel Sounder is an electromagnetic measurement device that characterizes the propagation channel between a transmit and receive antenna pair by measuring the channel's impulse response as a function of frequency, time, and spatial position."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Channel_Sounding
chips:Channel_Sounding rdf:type owl:Class ;
                       rdfs:subClassOf chips:Characterization_Process ,
                                       chips:Electromagnetic_Measurement_Process ,
                                       chips:Nondestructive_Measurement_Process ,
                                       chips:Transmitreceive ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty prov:generated ;
                                         owl:someValuesFrom chips:Channel_Model
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty prov:used ;
                                         owl:someValuesFrom chips:Geolocation
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty pmdco:belongsToProject ;
                                         owl:someValuesFrom chips:Grand_Challenge_4
                                       ] ;
                       rdfs:label "Channel Sounding"@en ;
                       skos:definition "Channel Sounding is an electromagnetic measurement process that characterises the propagation properties of a wireless communication channel by transmitting known signals and analysing received waveforms to determine path loss, delay spread, and multipath structure."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Characterization_Process
chips:Characterization_Process rdf:type owl:Class ;
                               rdfs:subClassOf pmdco:Prozess ;
                               rdfs:label "Characterization Process"@en ;
                               skos:definition "Characterization Process is an analytical process that measures and determines the properties, composition, structure, or behavior of a material, device, or system."@en ;
                               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Charged_Particle_Beam
chips:Charged_Particle_Beam rdf:type owl:Class ;
                            rdfs:subClassOf mo:Strahl ;
                            rdfs:label "Charged Particle Beam"@en ;
                            skos:definition "Charged Particle Beam is a collimated flux of electrically charged particles—such as electrons, ions, or protons—accelerated and focused to a defined energy and spot size for use in microscopy, lithography, or implantation."@en ;
                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Checkpoint_Technology
chips:Checkpoint_Technology rdf:type owl:Class ;
