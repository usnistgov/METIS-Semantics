                                          pmdco:abbreviation "NSLS II"@en ;
                                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/National_Vulnerability_Database
chips:National_Vulnerability_Database rdf:type owl:Class ;
                                      rdfs:subClassOf chips:Database ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty prov:wasAttributedTo ;
                                                        owl:someValuesFrom chips:National_Institute_of_Standards_and_Technology
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty prov:wasGeneratedBy ;
                                                        owl:someValuesFrom chips:Grand_Challenge_7
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty pmdco:characteristic ;
                                                        owl:someValuesFrom chips:Vulnerability_Standard
                                                      ] ;
                                      rdfs:comment "https://nvd.nist.gov/" ;
                                      rdfs:label "National Vulnerability Database"@en ;
