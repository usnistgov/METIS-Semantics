             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Doubletip_Indentation
chips:Doubletip_Indentation rdf:type owl:Class ;
                            rdfs:subClassOf chips:Indentation ;
                            rdfs:label "Double-tip Indentation"@en ;
                            skos:definition "Double-tip Indentation is an indentation technique employing an indenter with two tips to simultaneously probe two neighbouring surface regions, enabling differential measurements that isolate substrate effects and improve sensitivity to thin-film mechanical properties."@en ;
                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Drive_Pattern
chips:Drive_Pattern rdf:type owl:Class ;
                    rdfs:subClassOf chips:Pattern ;
                    rdfs:label "Drive Pattern"@en ;
                    skos:definition "Drive Pattern is a defined sequence of excitation waveforms or field values applied to a magnetic or electrical device to characterize its dynamic response, switching behavior, or reliability."@en ;
                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Dry_Plasma_Etchant_Gas
chips:Dry_Plasma_Etchant_Gas rdf:type owl:Class ;
