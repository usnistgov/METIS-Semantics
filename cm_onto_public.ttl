                                                      ) ;
                                   rdf:type owl:Class
                                 ] ;
                 rdfs:label "Dictionary"@en ;
                 skos:definition "A dictionary is a data structure consisting of key-value pairs that allows efficient lookup of values by their associated keys, used for structured metadata storage and ontology mappings."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Dielectric
chips:Dielectric rdf:type owl:Class ;
                 rdfs:subClassOf chips:Material ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty pmdco:characteristic ;
                                   owl:someValuesFrom chips:Ceramic_Material
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty pmdco:characteristic ;
                                   owl:someValuesFrom chips:Insulator
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty pmdco:input_of ;
                                   owl:someValuesFrom [ owl:intersectionOf ( chips:Grand_Challenge_1
                                                                             chips:Ptychography
                                                                           ) ;
                                                        rdf:type owl:Class
                                                      ]
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty pmdco:input_of ;
                                   owl:someValuesFrom [ rdf:type owl:Class ;
                                                        owl:unionOf ( chips:Grand_Challenge_3
                                                                      chips:Grand_Challenge_5
                                                                    )
                                                      ]
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty pmdco:relates_to ;
                                   owl:someValuesFrom chips:Grand_Challenge_4
                                 ] ;
                 rdfs:label "Dielectric"@en ;
                 skos:definition "A dielectric is a material that is an electrical insulator that can be polarized by an applied electric field, characterized by its permittivity and dielectric loss, and widely used in capacitors and gate oxides."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Dielectric_Breakdown
chips:Dielectric_Breakdown rdf:type owl:Class ;
                           rdfs:subClassOf chips:Failure_Process ;
                           rdfs:label "Dielectric Breakdown"@en ;
                           skos:definition "Dielectric Breakdown is a failure process in which an insulating material becomes electrically conductive under an applied electric field that exceeds the material's breakdown strength, resulting in irreversible damage."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Dielectric_Loss
chips:Dielectric_Loss rdf:type owl:Class ;
                      rdfs:subClassOf chips:Complex_Permittivity ,
                                      chips:Loss ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty pmdco:relates_to ;
                                        owl:someValuesFrom chips:Loss_Tangent
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty chips:hasImaginaryPart ;
                                        owl:someValuesFrom xsd:float
                                      ] ;
                      rdfs:label "Dielectric Loss"@en ;
                      skos:definition "Dielectric loss is the energy dissipated by a dielectric material per cycle when subjected to an alternating electric field, quantified by the loss tangent and the imaginary part of the complex permittivity."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Dielectric_Property
chips:Dielectric_Property rdf:type owl:Class ;
                          rdfs:subClassOf pmdco:Materialeigenschaft ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty chips:calculatedBy ;
                                            owl:someValuesFrom chips:Computational_Process
                                          ] ;
                          rdfs:label "Dielectric Property"@en ;
                          skos:definition "A dielectric property is a material property describing the polarization response of an insulating material to an applied electric field, characterized by permittivity and loss tangent."@en ;
                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Differential_Phase_Contrast
chips:Differential_Phase_Contrast rdf:type owl:Class ;
                                  rdfs:subClassOf pmdco:Elektronenmikroskopie ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty pmdco:belongsToProject ;
                                                    owl:someValuesFrom chips:Grand_Challenge_2
                                                  ] ;
                                  rdfs:label "Differential Phase Contrast"@en ;
                                  skos:definition "Differential Phase Contrast (DPC) is a scanning transmission electron microscopy technique that measures the deflection of the transmitted electron beam by local electric or magnetic fields within a specimen to image charge distributions and domain walls."@en ;
                                  pmdco:abbreviation "DPC"@en ;
                                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Differential_Scanning_Calorimeter
chips:Differential_Scanning_Calorimeter rdf:type owl:Class ;
                                        rdfs:subClassOf chips:Calorimeter ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty prov:wasAssociateFor ;
                                                          owl:someValuesFrom chips:Differential_Scanning_Calorimetry
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty prov:wasAssociateFor ;
                                                          owl:someValuesFrom [ rdf:type owl:Class ;
                                                                               owl:unionOf ( chips:Grand_Challenge_3
                                                                                             chips:Grand_Challenge_7
                                                                                           )
                                                                             ]
                                                        ] ;
                                        rdfs:label "Differential Scanning Calorimeter"@en ;
                                        skos:definition "Differential Scanning Calorimeter is a thermal analysis instrument that measures the difference in heat flow between a sample and a reference as a function of temperature or time to characterize phase transitions and reaction enthalpies."@en ;
                                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Differential_Scanning_Calorimetry
chips:Differential_Scanning_Calorimetry rdf:type owl:Class ;
                                        rdfs:subClassOf chips:Calorimetry ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty prov:wasAssociatedWith ;
                                                          owl:someValuesFrom chips:Differential_Scanning_Calorimeter
                                                        ] ;
                                        rdfs:label "Differential Scanning Calorimetry"@en ;
                                        skos:definition "Differential Scanning Calorimetry (DSC) is a thermal analysis technique that measures the difference in heat flow between a sample and an inert reference as a function of temperature or time to characterize phase transitions, glass transitions, and reaction enthalpies."@en ;
                                        pmdco:abbreviation "DSC"@en ;
                                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Diffraction_Order
chips:Diffraction_Order rdf:type owl:Class ;
                        rdfs:subClassOf chips:Geometric_Configuration ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty pmdco:characteristic ;
                                          owl:someValuesFrom chips:Integer
                                        ] ;
                        rdfs:label "Diffraction Order"@en ;
                        skos:definition "Diffraction order is an integer-valued geometric configuration that specifies the order of constructive interference in a diffraction pattern, corresponding to the number of wavelength path-length differences between diffracted beams from successive grating elements."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Diffractometry
chips:Diffractometry rdf:type owl:Class ;
                     rdfs:subClassOf pmdco:Messprozess ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty prov:wasInfluencedBy ;
                                       owl:someValuesFrom mo:Diffraktion
                                     ] ;
                     rdfs:label "Diffractometry"@en ;
                     skos:definition "Diffractometry is a measurement process that records the angular distribution of scattered radiation—X-rays, neutrons, or electrons—from a crystalline or nanostructured specimen to determine crystal structure and lattice parameters."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Diffusion
chips:Diffusion rdf:type owl:Class ;
                rdfs:subClassOf chips:Mass_Transport_Process ;
                rdfs:label "Diffusion"@en ;
                skos:definition "Diffusion is a mass transport process driven by concentration gradients in which atoms, molecules, or ions migrate from regions of higher chemical potential to lower chemical potential."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Digital_Asset_Identifier
chips:Digital_Asset_Identifier rdf:type owl:Class ;
                               rdfs:subClassOf pmdco:Identifikator ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty prov:wasAttributedTo ;
                                                 owl:someValuesFrom prov:Software_Agent
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty pmdco:characteristic_of ;
                                                 owl:someValuesFrom [ rdf:type owl:Class ;
