                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Soft_Xray
chips:Soft_Xray rdf:type owl:Class ;
                rdfs:subClassOf chips:Xray_Beam ;
                rdfs:label "Soft X-ray"@en ;
                skos:definition "Soft X-ray is an X-ray beam with photon energies typically in the range of 100 eV to 2 keV, characterised by strong interaction with matter and sensitivity to absorption edges of light elements, used for surface-sensitive and element-specific spectroscopy and imaging."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Soft_Xray_Reflectivity
chips:Soft_Xray_Reflectivity rdf:type owl:Class ;
                             rdfs:subClassOf chips:Resonant_Soft_Xray_Scattering ,
                                             chips:Xray_Reflectivity ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty prov:used ;
                                               owl:someValuesFrom chips:Soft_Xray
                                             ] ;
                             rdfs:label "Soft X-ray Reflectivity"@en ;
                             skos:definition "Soft X-ray Reflectivity is a soft X-ray scattering technique that measures the specular reflectivity of a sample as a function of angle or photon energy to determine the thickness, density, and chemical composition of thin films and multilayer structures with element-specific contrast."@en ;
                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Soft_Xray_Scattering
chips:Soft_Xray_Scattering rdf:type owl:Class ;
                           rdfs:subClassOf chips:Resonant_Soft_Xray_Scattering ;
                           rdfs:label "Soft X-ray Scattering"@en ;
                           skos:definition "Soft X-ray Scattering is a scattering technique that uses photons in the energy range of approximately 100 to 2000 eV to probe nanoscale structure, chemical ordering, and magnetic domains in materials by exploiting element-specific resonant absorption edges."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Soft_Xray_Spectroscopy
chips:Soft_Xray_Spectroscopy rdf:type owl:Class ;
                             rdfs:subClassOf chips:Resonant_Soft_Xray_Scattering ,
                                             chips:Xray_Spectroscopy ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty prov:wasAssociatedWith ;
                                               owl:someValuesFrom mo:Soft_Xray_Emission_Spectrometer
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty pmdco:belongsToProject ;
                                               owl:someValuesFrom chips:Grand_Challenge_2
                                             ] ;
                             rdfs:label "Soft X-ray Spectroscopy"@en ;
                             skos:definition "Soft X-ray Spectroscopy is a spectroscopy technique using soft X-ray photons tuned near absorption edges to probe the electronic structure, chemical state, and magnetic properties of materials with high surface and element sensitivity."@en ;
                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Software_Company
chips:Software_Company rdf:type owl:Class ;
