chips:IMEC rdf:type owl:Class ;
           rdfs:subClassOf chips:Research_and_Development_Agents ;
           rdfs:label "IMEC"@en ;
           skos:definition "IMEC is an independent semiconductor research and development center that conducts research in nanoelectronics, digital health, and smart energy, collaborating with industry partners on sub-nanometer process technologies."@en ;
           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/ISO_12963
chips:ISO_12963 rdf:type owl:Class ;
                rdfs:subClassOf chips:Standards_Activity ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty prov:wasAssociatedWith ;
                                  owl:someValuesFrom chips:International_Organization_for_Standardization
                                ] ;
                rdfs:label "ISO 12963"@en ;
                skos:definition "ISO 12963 is an international standard that specifies requirements for the preparation and certification of gas mixtures used as reference materials for gas analysis."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/ISO_6143
chips:ISO_6143 rdf:type owl:Class ;
               rdfs:subClassOf chips:Standards_Activity ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty prov:wasAssociatedWith ;
                                 owl:someValuesFrom chips:International_Organization_for_Standardization
                               ] ;
               rdfs:label "ISO 6143"@en ;
               skos:definition "ISO 6143 is an international standard that specifies comparison methods for determining the composition of gas mixtures used as reference standards."@en ;
               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/ISO_TC_158_Analysis_of_Gases
chips:ISO_TC_158_Analysis_of_Gases rdf:type owl:Class ;
                                   rdfs:subClassOf chips:Standards_Activity ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty prov:wasAssociatedWith ;
                                                     owl:someValuesFrom chips:International_Organization_for_Standardization
                                                   ] ;
                                   rdfs:label "ISO TC 158 Analysis of Gases"@en ;
                                   skos:definition "ISO TC 158 Analysis of Gases is an ISO technical committee that develops international standards for the sampling, analysis, and certification of gaseous materials including specialty gases used in semiconductor manufacturing."@en ;
                                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/IV_Curve
chips:IV_Curve rdf:type owl:Class ;
               rdfs:subClassOf chips:Plot ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty prov:wasGeneratedBy ;
                                 owl:someValuesFrom chips:IV_Measurement
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty pmdco:characteristic ;
                                 owl:someValuesFrom pmdco:Messwert
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty pmdco:characteristic ;
                                 owl:someValuesFrom [ owl:intersectionOf ( mo:Spannung
                                                                           mo:Strom
                                                                         ) ;
                                                      rdf:type owl:Class
                                                    ]
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty pmdco:characteristic_of ;
                                 owl:someValuesFrom chips:Electric_Property
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty pmdco:output_of ;
                                 owl:someValuesFrom [ rdf:type owl:Class ;
                                                      owl:unionOf ( chips:Computational_Process
                                                                    chips:DC_Electrical_Measurement
                                                                  )
                                                    ]
                               ] ;
               rdfs:label "IV Curve"@en ;
               skos:definition "An IV curve is a measured dataset representing the current through a device as a function of applied voltage, used to characterize the electrical behavior of diodes, transistors, and other two-terminal devices."@en ;
               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/IV_Measurement
chips:IV_Measurement rdf:type owl:Class ;
                     rdfs:subClassOf chips:DC_Electrical_Measurement ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty prov:generated ;
                                       owl:someValuesFrom chips:IV_Curve
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty pmdco:characteristic ;
                                       owl:someValuesFrom [ owl:intersectionOf ( [ owl:intersectionOf ( chips:Dependent_Variable
                                                                                                        [ rdf:type owl:Restriction ;
                                                                                                          owl:onProperty pmdco:composed_of ;
                                                                                                          owl:someValuesFrom mo:Strom
                                                                                                        ]
                                                                                                      ) ;
                                                                                   rdf:type owl:Class
                                                                                 ]
                                                                                 [ owl:intersectionOf ( chips:Independent_Variable
                                                                                                        [ rdf:type owl:Restriction ;
                                                                                                          owl:onProperty pmdco:composed_of ;
                                                                                                          owl:someValuesFrom mo:Spannung
                                                                                                        ]
                                                                                                      ) ;
                                                                                   rdf:type owl:Class
                                                                                 ]
                                                                               ) ;
                                                            rdf:type owl:Class
                                                          ]
                                     ] ;
                     rdfs:label "IV Measurement"@en ;
                     skos:definition "I-V Measurement is a DC electrical characterization technique that records the current flowing through a device or material as a function of applied voltage to extract resistance, diode parameters, or transistor characteristics."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/IV_Semiconductor
chips:IV_Semiconductor rdf:type owl:Class ;
                       rdfs:subClassOf chips:Semiconductor ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty prov:influenced ;
                                         owl:someValuesFrom chips:Grand_Challenge_4
                                       ] ;
                       rdfs:label "IV Semiconductor"@en ;
                       skos:definition "A group IV semiconductor is a semiconductor material composed of elements from group IV of the periodic table, including silicon and germanium, which form the basis of mainstream CMOS integrated circuit technology."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Identification_Process
chips:Identification_Process rdf:type owl:Class ;
                             rdfs:subClassOf chips:Characterization_Process ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty pmdco:relates_to ;
                                               owl:someValuesFrom chips:Classification_Process
                                             ] ;
                             rdfs:label "Identification Process"@en ;
                             skos:definition "Identification Process is a characterization operation that determines the identity, composition, or provenance of a material, analyte, or entity through measurement, database comparison, or pattern recognition."@en ;
                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Identification_Standard
chips:Identification_Standard rdf:type owl:Class ;
                              rdfs:subClassOf chips:Standard ;
                              rdfs:label "Identification Standard"@en ;
                              skos:definition "Identification Standard is a formal specification that defines a naming scheme or identifier format used to uniquely and unambiguously label entities such as materials, instruments, or vulnerabilities."@en ;
                              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Image_Analysis
chips:Image_Analysis rdf:type owl:Class ;
                     rdfs:subClassOf pmdco:Analysing_Process ;
                     rdfs:label "Image Analysis"@en ;
                     skos:definition "Image Analysis is an analytical process that applies digital image processing algorithms to extract quantitative measurements of features, dimensions, intensities, or spatial distributions from a captured image."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Image_Processing
chips:Image_Processing rdf:type owl:Class ;
                       rdfs:subClassOf pmdco:Analysing_Process ;
                       rdfs:label "Image Processing"@en ;
                       skos:definition "Image Processing is an analytical process that applies computational operations—such as filtering, segmentation, and enhancement—to a digital image to improve its quality or extract meaningful information."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Image_Recognition
chips:Image_Recognition rdf:type owl:Class ;
                        rdfs:subClassOf chips:AI_and_Machine_Learning ;
                        rdfs:label "Image Recognition"@en ;
                        skos:definition "Image Recognition is an AI computational process that assigns a semantic label or category to an entire input image by learning discriminative visual features from labeled training examples."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Imaging_Facility
chips:Imaging_Facility rdf:type owl:Class ;
                       rdfs:subClassOf chips:Research_Facility ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty prov:wasAssociateFor ;
                                         owl:someValuesFrom pmdco:Elektronenmikroskopie
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty prov:wasAssociateFor ;
                                         owl:someValuesFrom mo:Ionenmikroskopie
                                       ] ;
                       rdfs:label "Imaging Facility"@en ;
                       skos:definition "An imaging facility is a research facility that provides shared access to advanced microscopy, tomography, and imaging instrumentation for characterization of materials, devices, and biological specimens."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Imaging_Process
chips:Imaging_Process rdf:type owl:Class ;
                      rdfs:subClassOf chips:Characterization_Process ,
                                      chips:Spatiallyresolved_Measurement_Process ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty pmdco:output ;
                                        owl:someValuesFrom pmdco:Bild
                                      ] ;
                      rdfs:label "Imaging Process"@en ;
                      skos:definition "Imaging Process is a characterization operation that constructs a spatially resolved two- or three-dimensional representation of a specimen by recording signal intensity as a function of position."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Impedence
chips:Impedence rdf:type owl:Class ;
                rdfs:subClassOf chips:Electric_Property ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty pmdco:characteristic ;
                                  owl:someValuesFrom chips:Vector
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty pmdco:relates_to ;
                                  owl:someValuesFrom [ rdf:type owl:Class ;
                                                       owl:unionOf ( chips:Alternating_Current
                                                                     chips:Radio_Frequency
                                                                   )
                                                     ]
                                ] ;
                rdfs:label "Impedence"@en ;
                skos:definition "Impedance is a frequency-dependent complex quantity that extends resistance to AC circuits, combining resistance and reactance to describe opposition to current flow at a given frequency."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Impurity
chips:Impurity rdf:type owl:Class ;
               rdfs:subClassOf chips:Material ;
               rdfs:label "Impurity"@en ;
               skos:definition "An impurity is an unintended foreign atom or molecule incorporated into a material during synthesis or processing that alters its electrical, optical, or structural properties."@en ;
               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/In_Situ_Process
chips:In_Situ_Process rdf:type owl:Class ;
                      rdfs:subClassOf pmdco:Messprozess ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty pmdco:belongsToProject ;
                                        owl:someValuesFrom chips:Grand_Challenge_5
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty pmdco:relates_to ;
                                        owl:someValuesFrom chips:Operando_Process
                                      ] ;
                      rdfs:label "In Situ Process"@la ;
                      skos:definition "In Situ Process is a measurement process performed on a specimen within its native environment or during an ongoing physical, chemical, or fabrication process, enabling real-time monitoring of structural or property changes without removing the specimen from its operating conditions."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Incident_Angle
chips:Incident_Angle rdf:type owl:Class ;
                     rdfs:subClassOf mo:Winkel ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty pmdco:characteristic ;
                                       owl:someValuesFrom chips:Independent_Variable
                                     ] ;
                     rdfs:label "Incident Angle"@en ;
                     skos:definition "Incident angle is the angle between the direction of an incident beam and the normal to the surface at the point of incidence, affecting reflectivity, diffraction conditions, and ion implantation range."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Incident_Power
chips:Incident_Power rdf:type owl:Class ;
                     rdfs:subClassOf chips:Power ;
                     rdfs:label "Incident Power"@en ;
                     skos:definition "Incident Power is the optical or electromagnetic power delivered to a surface or sample by an illuminating beam, expressed in watts."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Incoherent_Beam
chips:Incoherent_Beam rdf:type owl:Class ;
                      rdfs:subClassOf mo:Monochromatischer_Strahl ;
                      skos:definition "Incoherent Beam is a radiation beam comprising photons or particles that lack a fixed phase relationship with each other, as in a beam from a conventional X-ray tube or thermal neutron source, distinguished from a coherent laser or synchrotron beam."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Indentation
chips:Indentation rdf:type owl:Class ;
                  rdfs:subClassOf pmdco:Mechanischer_Testprozess ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty prov:wasAssociatedWith ;
                                    owl:someValuesFrom chips:Indentation_Instrument
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty chips:measured ;
                                    owl:someValuesFrom chips:Hardness
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty chips:measured ;
                                    owl:someValuesFrom chips:Youngs_Modulus
                                  ] ;
                  skos:definition "Indentation is a mechanical testing process in which a hard indenter of defined geometry is pressed into a specimen surface under a controlled load to measure hardness, elastic modulus, creep, or fracture properties at the local contact scale."@en ;
                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Indentation_Instrument
chips:Indentation_Instrument rdf:type owl:Class ;
                             rdfs:subClassOf chips:Mechanical_Testing_Instrument ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty prov:wasAssociateFor ;
                                               owl:someValuesFrom chips:Indentation
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty chips:measured ;
                                               owl:someValuesFrom [ rdf:type owl:Class ;
                                                                    owl:unionOf ( chips:Creep_Process
                                                                                  chips:Relaxation_Process
                                                                                )
                                                                  ]
                                             ] ;
                             rdfs:label "Indentation Instrument"@en ;
                             skos:definition "Indentation Instrument is a mechanical testing device that drives a hard indenter into a material surface under a recorded load-displacement curve to determine hardness and elastic modulus."@en ;
                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Independent_Variable
chips:Independent_Variable rdf:type owl:Class ;
                           rdfs:subClassOf chips:Variable ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty pmdco:characteristic ;
                                             owl:someValuesFrom chips:Incident_Angle
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty pmdco:characteristic_of ;
                                             owl:someValuesFrom pmdco:Metadaten
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty pmdco:relates_to ;
                                             owl:someValuesFrom chips:Polarization
                                           ] ;
                           rdfs:label "Independent Variable"@en ;
                           skos:definition "Independent Variable is a variable whose value is set or controlled by the experimenter to investigate its effect on dependent variables in an experiment or model."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Indium
chips:Indium rdf:type owl:Class ;
             rdfs:subClassOf pmdco:Hersteller ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty prov:generated ;
                               owl:someValuesFrom chips:Advanced_Packaging_Component
                             ] ;
             rdfs:comment "A U.S. advanced packaging material supplier"@en ;
             rdfs:label "Indium"@en ;
             skos:definition "Indium Corporation is a specialty materials company that manufactures solder alloys, fluxes, and indium-based materials used in semiconductor packaging, bonding, and advanced electronics assembly."@en ;
             pmdco:definitionSource "claude-sonnet-4-6"@en ;
             pmdco:symbol "In" .


###  https://w3id.org/CHIPS/metrology-ontology/Indoor
chips:Indoor rdf:type owl:Class ;
             rdfs:subClassOf chips:Geolocation ;
             rdfs:label "Indoor"@en ;
             skos:definition "Indoor is a geolocation attribute specifying that a measurement or experiment is conducted within an enclosed building environment, relevant to wireless channel modeling and electromagnetic interference assessment."@en ;
             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Inductance
chips:Inductance rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty chips:isInverselyProportionalTo ;
                                       owl:someValuesFrom chips:Reluctance
                                     ] ;
                 rdfs:subClassOf chips:Electric_Property ,
                                 chips:Magnetic_Property ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty pmdco:characteristic ;
                                   owl:someValuesFrom chips:Scalar
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty pmdco:relates_to ;
                                   owl:someValuesFrom [ rdf:type owl:Class ;
                                                        owl:unionOf ( chips:Alternating_Current
                                                                      chips:Radio_Frequency
                                                                    )
                                                      ]
                                 ] ;
                 rdfs:label "Inductance"@en ;
                 skos:definition "Inductance is a high-frequency electrical property defined as the ratio of magnetic flux linkage to current, characterizing the ability of a conductor to store energy in a magnetic field."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Inductively_Coupled_Plasma_Atomic_Emission_Spectrometry
chips:Inductively_Coupled_Plasma_Atomic_Emission_Spectrometry rdf:type owl:Class ;
                                                              rdfs:subClassOf mo:Spectroscopy ,
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty pmdco:belongsToProject ;
                                                                                owl:someValuesFrom chips:Grand_Challenge_7
                                                                              ] ;
                                                              rdfs:label "Inductively Coupled Plasma Atomic Emission Spectrometry"@en ;
                                                              skos:definition "Inductively Coupled Plasma Atomic Emission Spectrometry (ICP-AES) is an elemental analysis technique in which a sample is nebulized and introduced into an argon ICP plasma, exciting atoms to emit characteristic wavelengths that are measured to identify and quantify elements."@en ;
                                                              pmdco:definitionSource "claude-sonnet-4-6"@en ;
                                                              pmdco:symbol "ICP-AES"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Inductively_Coupled_Plasma_Etcher_Tool
chips:Inductively_Coupled_Plasma_Etcher_Tool rdf:type owl:Class ;
                                             rdfs:subClassOf chips:Reactive_Ion_Etch_Tool ;
                                             rdfs:label "Inductively Coupled Plasma Etcher Tool"@en ;
                                             skos:definition "Inductively Coupled Plasma Etcher Tool is a reactive ion etch instrument that generates a high-density plasma using an inductively coupled RF source, enabling low-pressure, high-rate etching with independent control of ion energy and flux."@en ;
                                             pmdco:abbreviation "ICP Etch Tool"@en ;
                                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Industry
chips:Industry rdf:type owl:Class ;
               rdfs:subClassOf prov:Organization ;
               rdfs:label "Industry"@en ;
               skos:definition "Industry is a type of organization comprising commercial enterprises that develop, manufacture, and sell products or services, often partnering with academia and government in research and development."@en ;
               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Infrared
chips:Infrared rdf:type owl:Class ;
               rdfs:subClassOf chips:Electromagnetic_Spectrum ;
               skos:definition "Infrared is the region of the electromagnetic spectrum spanning wavelengths from approximately 700 nm to 1 mm, lying between visible light and microwave radiation, used extensively for thermal imaging, molecular spectroscopy, and optical communications."@en ;
               pmdco:abbreviation "IR"@en ;
               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Infrared_Absoption
chips:Infrared_Absoption rdf:type owl:Class ;
                         rdfs:subClassOf chips:Electromagnetic_Wave_Absoption ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty prov:used ;
                                           owl:someValuesFrom chips:Infrared
                                         ] ;
                         rdfs:label "Infrared Absoption"@en ;
                         skos:definition "Infrared Absorption is an electromagnetic wave absorption process in which a material absorbs photons with energies corresponding to molecular vibrational or rotational transitions in the infrared spectral region."@en ;
                         pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Infrared_Absorption_Spectroscopy
chips:Infrared_Absorption_Spectroscopy rdf:type owl:Class ;
                                       rdfs:subClassOf chips:Infrared_Spectroscopy ,
                                                       chips:Laser_Absoption_Spectroscopy ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty prov:wasInformedBy ;
                                                         owl:someValuesFrom chips:Infrared_Absoption
                                                       ] ;
                                       rdfs:label "Infrared Absorption Spectroscopy"@en ;
                                       skos:definition "Infrared Absorption Spectroscopy is a spectroscopic technique that measures the absorption of infrared radiation by a material as a function of wavenumber to identify molecular vibrational modes and chemical functional groups."@en ;
                                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Infrared_Spectroscopy
chips:Infrared_Spectroscopy rdf:type owl:Class ;
                            rdfs:subClassOf chips:Optical_Spectroscopy ,
                                            [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                     owl:onProperty pmdco:belongsToProject ;
                                                                     owl:someValuesFrom chips:Grand_Challenge_2
                                                                   ]
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty pmdco:output ;
                                                                     owl:someValuesFrom [ owl:intersectionOf ( pmdco:Bild
                                                                                                               [ rdf:type owl:Restriction ;
                                                                                                                 owl:onProperty pmdco:characteristic ;
                                                                                                                 owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                                                                      owl:unionOf ( <https://w3id.org/CHIPS/metrology-ontology/2D>
                                                                                                                                                    <https://w3id.org/CHIPS/metrology-ontology/3D>
                                                                                                                                                  )
                                                                                                                                    ]
                                                                                                               ]
                                                                                                             ) ;
                                                                                          rdf:type owl:Class
                                                                                        ]
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty prov:used ;
                                              owl:someValuesFrom chips:Infrared
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty pmdco:belongsToProject ;
                                              owl:someValuesFrom [ rdf:type owl:Class ;
                                                                   owl:unionOf ( chips:Grand_Challenge_2
                                                                                 chips:Grand_Challenge_5
                                                                               )
                                                                 ]
                                            ] ;
                            rdfs:label "Infrared Spectroscopy"@en ;
                            skos:definition "Infrared Spectroscopy is an optical spectroscopy technique that measures the absorption, reflection, or emission of infrared radiation by a material to identify molecular functional groups and chemical bonds through their characteristic vibrational and rotational transitions."@en ;
                            pmdco:abbreviation "IR Spectroscopy"@en ;
                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Infrared_Spectrum
chips:Infrared_Spectrum rdf:type owl:Class ;
                        rdfs:subClassOf chips:Spectrum ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty chips:calculatedBy ;
                                          owl:someValuesFrom chips:Grand_Challenge_5
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty pmdco:relates_to ;
                                          owl:someValuesFrom chips:Infrared
                                        ] ;
                        rdfs:label "Infrared Spectrum"@en ;
                        skos:definition "An infrared spectrum is a dataset of optical absorption or reflectance as a function of infrared wavelength or wavenumber, used to identify molecular bonds and functional groups by their vibrational fingerprints."@en ;
                        pmdco:abbreviation "IR Spectrum"@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Inhomogeneous
chips:Inhomogeneous rdf:type owl:Class ;
                    rdfs:subClassOf chips:Quality ;
                    rdfs:label "Inhomogeneous"@en ;
                    skos:definition "Inhomogeneous is a quality indicating that a material, field, or sample exhibits spatial variation in its composition, structure, or properties, such that different regions have measurably different characteristics."@en ;
                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Ink_Jet_Printing
chips:Ink_Jet_Printing rdf:type owl:Class ;
                       rdfs:subClassOf chips:Surface_Capture_and_Preconcentration ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty pmdco:belongsToProject ;
                                         owl:someValuesFrom chips:Grand_Challenge_1
                                       ] ;
                       rdfs:label "Ink Jet Printing"@en ;
                       skos:definition "Ink-Jet Printing is a surface capture and patterning process that deposits precise volumes of a functional ink solution onto a substrate by ejecting droplets from a nozzle array to create patterned chemical layers or sensor arrays."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Inphase_and_Quadrature
chips:Inphase_and_Quadrature rdf:type owl:Class ;
                             rdfs:subClassOf chips:Wave_Characteristic ,
                                             [ rdf:type owl:Class ;
                                               owl:unionOf ( [ rdf:type owl:Restriction ;
                                                               owl:onProperty prov:wasGeneratedBy ;
                                                               owl:someValuesFrom chips:Derived_Process
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty chips:measuredBy ;
                                                               owl:someValuesFrom pmdco:Messprozess
                                                             ]
                                                           )
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty pmdco:characteristic_of ;
                                               owl:someValuesFrom chips:Electromagnetic_Property
                                             ] ;
                             rdfs:label "In-phase and Quadrature"@en ;
                             skos:definition "In-phase and quadrature (I/Q) are the two orthogonal components of a complex-valued electromagnetic signal, used to fully characterize the amplitude and phase of a modulated radio-frequency waveform."@en ;
                             pmdco:abbreviation "I/Q"@en ;
                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Input_Data
chips:Input_Data rdf:type owl:Class ;
                 rdfs:subClassOf chips:Data ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty pmdco:input_of ;
                                   owl:someValuesFrom chips:Computational_Process
                                 ] ;
                 rdfs:label "Input Data"@en ;
                 skos:definition "Input data is data used as the starting parameters, boundary conditions, or training dataset for a computational model, simulation, or machine learning algorithm."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Instability
chips:Instability rdf:type owl:Class ;
                  rdfs:subClassOf chips:Confidence_Concept ;
                  owl:disjointWith chips:Stability ;
                  rdfs:label "Instability"@en ;
                  skos:definition "Instability is a confidence concept describing the tendency of a measurement result, material property, or device characteristic to change over time or under varying conditions in an unpredictable manner."@en ;
                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Institute_of_Electrical_and_Electronics_Engineers
chips:Institute_of_Electrical_and_Electronics_Engineers rdf:type owl:Class ;
                                                        rdfs:subClassOf chips:Standards_Organization ,
                                                                        chips:Trade_Organization ;
                                                        rdfs:label "Institute of Electrical and Electronics Engineers"@en ;
                                                        skos:definition "The Institute of Electrical and Electronics Engineers (IEEE) is a professional organization and standards body that develops technical standards for electrical, electronic, and computing technologies including semiconductor devices and communications."@en ;
                                                        pmdco:abbreviation "IEEE"@en ;
                                                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Instron
chips:Instron rdf:type owl:Class ;
              rdfs:subClassOf chips:Tensile_Testing_Instrument ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty prov:wasAssociateFor ;
                                owl:someValuesFrom chips:Grand_Challenge_3
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty chips:measured ;
                                owl:someValuesFrom chips:Youngs_Modulus
                              ] ;
              rdfs:label "Instron"@en ;
              skos:definition "Instron is a commercial tensile testing instrument brand that applies and records uniaxial tensile, compressive, or flexural loads on material specimens to measure mechanical properties such as Young's modulus and tensile strength."@en ;
              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Instrument
chips:Instrument rdf:type owl:Class ;
                 rdfs:subClassOf pmdco:Prozessknoten ;
                 rdfs:comment "The distinction between Hardware and Instrument is that Hardware tends to produce or prepare the state of a material or a device for an Instrument to process."@en ;
                 rdfs:label "Instrument"@en ;
                 skos:definition "Instrument is a process node comprising a measurement device or assembly that applies a defined principle to quantify a physical, chemical, or electronic property of a specimen."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Instrument_Barcode
chips:Instrument_Barcode rdf:type owl:Class ;
                         rdfs:subClassOf chips:Instrument_Identifier ;
                         rdfs:label "Instrument Barcode"@en ;
                         skos:definition "Instrument Barcode is an instrument identifier in the form of a machine-readable barcode label applied to laboratory equipment to track its location, calibration status, and maintenance history within an organization."@en ;
                         pmdco:definitionSource "claude-opus-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Instrument_Control_Software
chips:Instrument_Control_Software rdf:type owl:Class ;
                                  rdfs:subClassOf prov:Software_Agent ;
                                  rdfs:label "Instrument Control Software"@en ;
                                  skos:definition "Instrument Control Software is a software agent that communicates with measurement instruments over standard interfaces to configure settings, trigger measurements, and retrieve data."@en ;
                                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Instrument_Identifier
chips:Instrument_Identifier rdf:type owl:Class ;
                            rdfs:subClassOf pmdco:Identifikator ;
                            rdfs:label "Instrument Identifier"@en ;
                            skos:definition "Instrument Identifier is a unique identifier assigned to a specific physical instrument to distinguish it from other instruments and enable traceability of measurement results to the measuring device."@en ;
                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Instrument_Persistent_Identifier
chips:Instrument_Persistent_Identifier rdf:type owl:Class ;
                                       rdfs:subClassOf chips:Instrument_Identifier ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty pmdco:characteristic ;
                                                         owl:someValuesFrom chips:PIDINST
                                                       ] ;
                                       rdfs:label "Instrument Persistent Identifier"@en ;
                                       skos:definition "Instrument Persistent Identifier (PID) is a globally unique, persistent digital identifier assigned to a specific physical instrument to unambiguously reference it in research data records and publications."@en ;
                                       pmdco:abbreviation "Instrument PID"@en ;
                                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Instrumental_Neutron_Activation_Analysis
chips:Instrumental_Neutron_Activation_Analysis rdf:type owl:Class ;
                                               rdfs:subClassOf chips:Nuclear_Analysis ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty pmdco:characteristic ;
                                                                 owl:someValuesFrom [ owl:intersectionOf ( chips:Independent_Variable
                                                                                                           [ rdf:type owl:Restriction ;
                                                                                                             owl:onProperty pmdco:characteristic ;
                                                                                                             owl:someValuesFrom mo:Energie
                                                                                                           ]
                                                                                                         ) ;
                                                                                      rdf:type owl:Class
                                                                                    ]
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty pmdco:output ;
                                                                 owl:someValuesFrom [ owl:intersectionOf ( chips:Open_File_Format
                                                                                                           [ rdf:type owl:Restriction ;
                                                                                                             owl:onProperty pmdco:relates_to ;
                                                                                                             owl:someValuesFrom chips:International_Atomic_Energy_Agency
                                                                                                           ]
                                                                                                         ) ;
                                                                                      rdf:type owl:Class
                                                                                    ]
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty pmdco:output ;
                                                                 owl:someValuesFrom [ owl:intersectionOf ( chips:Proprietary_File_Format
                                                                                                           [ rdf:type owl:Restriction ;
                                                                                                             owl:onProperty pmdco:relates_to ;
                                                                                                             owl:someValuesFrom [ owl:intersectionOf ( chips:Canberra
                                                                                                                                                       chips:Ortec
                                                                                                                                                     ) ;
                                                                                                                                  rdf:type owl:Class
                                                                                                                                ]
                                                                                                           ]
                                                                                                         ) ;
                                                                                      rdf:type owl:Class
                                                                                    ]
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty pmdco:relates_to ;
                                                                 owl:someValuesFrom [ owl:intersectionOf ( chips:Count
                                                                                                           chips:Gamma_particle
                                                                                                         ) ;
                                                                                      rdf:type owl:Class
                                                                                    ]
                                                               ] ;
                                               rdfs:label "Instrumental Neutron Activation Analysis"@en ;
                                               skos:definition "Instrumental Neutron Activation Analysis (INAA) is a nuclear analytical technique in which a sample is irradiated with neutrons in a reactor, converting stable isotopes to radioactive ones whose characteristic gamma emissions identify and quantify elemental composition."@en ;
                                               pmdco:abbreviation "INAA" ;
                                               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Insulator
chips:Insulator rdf:type owl:Class ;
                rdfs:subClassOf chips:Material ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty prov:influenced ;
                                  owl:someValuesFrom chips:Grand_Challenge_4
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty prov:wasUsedBy ;
                                  owl:someValuesFrom chips:Grand_Challenge_2
                                ] ;
                rdfs:label "Insulator"@en ;
                skos:definition "An insulator is a material that strongly resists the transport of a specific form of energy or charge (e.g., electrical current, thermal energy, or acoustic vibration) thereby providing isolation between regions."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Integer
chips:Integer rdf:type owl:Class ;
              rdfs:subClassOf chips:Number ;
              skos:definition "An integer is a whole number (positive, negative, or zero) without a fractional component, used to represent counts, indices, and discrete physical quantities."@en ;
              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Integrated_Business_Professionals_US
chips:Integrated_Business_Professionals_US rdf:type owl:Class ;
                                           rdfs:subClassOf chips:Trade_Organization ;
                                           rdfs:label "Integrated Business Professionals US Group"@en ;
                                           skos:definition "Integrated Business Professionals US is a trade organization that supports networking and professional development for business and technology professionals in the United States semiconductor and electronics industries."@en ;
                                           pmdco:abbreviation "IBPUSA"@en ;
                                           pmdco:definitionSource "claude-opus-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Integrated_Circuit
chips:Integrated_Circuit rdf:type owl:Class ;
                         rdfs:subClassOf chips:Device ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty pmdco:input_of ;
                                           owl:someValuesFrom chips:Grand_Challenge_2
                                         ] ;
                         rdfs:label "Integrated Circuit"@en ;
                         skos:definition "Integrated Circuit (IC) is a hardware device in which multiple electronic components such as transistors, resistors, and capacitors are fabricated on a single semiconductor substrate and interconnected to perform a specified electronic function."@en ;
                         pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Integrated_Computational_Materials_Engineering
chips:Integrated_Computational_Materials_Engineering rdf:type owl:Class ;
                                                     rdfs:subClassOf chips:Design_Process ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty pmdco:relates_to ;
                                                                       owl:someValuesFrom chips:Modeling_Process
                                                                     ] ;
                                                     obo:definition_source "https://en.wikipedia.org/wiki/Integrated_computational_materials_engineering#Standardization_in_ICME"@en ;
                                                     rdfs:label "Integrated Computational Materials Engineering"@en ;
                                                     skos:definition "Integrated Computational Materials Engineering (ICME) is a design process that integrates multi-scale computational models of materials processing, microstructure, and properties to accelerate materials development for engineering applications."@en ;
                                                     pmdco:abbreviation "ICME" ;
                                                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Integrated_Photonics
chips:Integrated_Photonics rdf:type owl:Class ;
                           rdfs:subClassOf chips:Photonics_Technology ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty prov:contributed ;
                                             owl:someValuesFrom chips:Advanced_Packaging_Component
                                           ] ;
                           rdfs:label "Integrated Photonics"@en ;
                           skos:definition "Integrated Photonics is a technology field that fabricates optical components such as waveguides, modulators, and detectors on a common substrate to create compact photonic circuits for communications, sensing, and computing."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Integration_Time
chips:Integration_Time rdf:type owl:Class ;
                       rdfs:subClassOf pmdco:Dauer ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty pmdco:characteristic_of ;
                                         owl:someValuesFrom mo:Detector
                                       ] ;
                       rdfs:label "Integration Time"@en ;
                       skos:definition "Integration time is the duration over which a detector accumulates signal, trading off signal-to-noise ratio against temporal resolution and susceptibility to drift."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Intel
chips:Intel rdf:type owl:Class ;
