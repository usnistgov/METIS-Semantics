                                          pmdco:abbreviation "CVSS"@en ;
                                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Complex_Permittivity
chips:Complex_Permittivity rdf:type owl:Class ;
                           rdfs:subClassOf chips:Electromagnetic_Property ,
                                           [ owl:intersectionOf ( [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                           owl:onProperty chips:hasImaginaryPart ;
                                                                                           owl:someValuesFrom xsd:float
                                                                                         ]
                                                                                         [ rdf:type owl:Restriction ;
                                                                                           owl:onProperty chips:hasRealPart ;
                                                                                           owl:someValuesFrom xsd:float
                                                                                         ]
                                                                                       ) ;
                                                                    rdf:type owl:Class
                                                                  ]
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty chips:hasMathematicalRelationshipWith ;
                                                                    owl:someValuesFrom [ owl:intersectionOf ( chips:Dielectric_Loss
                                                                                                              chips:Permittivity
                                                                                                            ) ;
                                                                                         rdf:type owl:Class
                                                                                       ]
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty prov:wasGeneratedBy ;
                                             owl:someValuesFrom chips:Derived_Process
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty pmdco:characteristic ;
                                             owl:someValuesFrom [ rdf:type owl:Class ;
                                                                  owl:unionOf ( chips:Independent_Variable
                                                                                chips:State_Variable
                                                                              )
                                                                ]
                                           ] ;
                           rdfs:label "Complex Permittivity"@en ;
                           skos:definition "Complex permittivity is a frequency-dependent material property that describes the response of a dielectric to an electric field, with the real part representing energy storage and the imaginary part representing dielectric loss."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Complex_Refractive_Index
chips:Complex_Refractive_Index rdf:type owl:Class ;
                               rdfs:subClassOf pmdco:Optisch ,
                                               [ owl:intersectionOf ( [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                               owl:onProperty chips:hasImaginaryPart ;
                                                                                               owl:someValuesFrom xsd:float
                                                                                             ]
                                                                                             [ rdf:type owl:Restriction ;
                                                                                               owl:onProperty chips:hasRealPart ;
                                                                                               owl:someValuesFrom xsd:float
                                                                                             ]
                                                                                           ) ;
                                                                        rdf:type owl:Class
                                                                      ]
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty chips:hasMathematicalRelationshipWith ;
                                                                        owl:someValuesFrom [ owl:intersectionOf ( chips:Optical_Extinction_Coefficient
                                                                                                                  chips:Refractive_Index
                                                                                                                ) ;
                                                                                             rdf:type owl:Class
                                                                                           ]
                                                                      ]
                                                                    ) ;
                                                 rdf:type owl:Class
                                               ] ;
                               rdfs:label "Complex Refractive Index"@en ;
                               skos:definition "Complex refractive index is an optical material property whose real part describes the phase velocity of light in the medium and whose imaginary part (extinction coefficient) describes optical absorption."@en ;
                               pmdco:definitionSource "claude-sonnet-4-6"@en ;
                               pmdco:symbol "n+ik" .


