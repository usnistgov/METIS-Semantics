###  https://w3id.org/CHIPS/metrology-ontology/Monochromation
chips:Monochromation rdf:type owl:Class ;
                     rdfs:subClassOf chips:Beamformation_Process ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty prov:wasAssociatedWith ;
                                       owl:someValuesFrom mo:Monochromator
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty pmdco:output ;
                                       owl:someValuesFrom mo:Monochromatischer_Strahl
                                     ] ;
                     rdfs:label "Monochromation"@en ;
                     skos:definition "Monochromation is a beam formation process that selects a narrow band of wavelengths or energies from a polychromatic radiation source using a crystal monochromator, grating, or filter to produce a quasi-monochromatic beam."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Monoclonal_Antibody
chips:Monoclonal_Antibody rdf:type owl:Class ;
                          rdfs:subClassOf chips:Biological_Macromolecule ;
                          rdfs:label "Monoclonal Antibody"@en ;
                          skos:definition "A monoclonal antibody is a laboratory-produced protein that binds specifically to a single antigen epitope, used as a selective biorecognition element in biosensors and immunoassays."@en ;
                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Monte_Carlo_Simulation
chips:Monte_Carlo_Simulation rdf:type owl:Class ;
                             rdfs:subClassOf pmdco:Simulationsprozess ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty pmdco:belongsToProject ;
                                               owl:someValuesFrom chips:Grand_Challenge_5
                                             ] ;
                             rdfs:label "Monte Carlo Simulation"@en ;
                             skos:definition "Monte Carlo is a stochastic quantum mechanics simulation method that computes ground-state or finite-temperature properties of a quantum system by statistical sampling of configurations or paths."@en ;
                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Monte_Carlo_Software
chips:Monte_Carlo_Software rdf:type owl:Class ;
                           rdfs:subClassOf chips:Modeling_and_Simulation_Software ;
                           rdfs:label "Monte Carlo Software"@en ;
                           skos:definition "Monte Carlo Software is a software agent that implements stochastic sampling algorithms to compute properties of physical or statistical systems by averaging over a large number of randomly generated configurations."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Morphology
chips:Morphology rdf:type owl:Class ;
                 rdfs:subClassOf chips:Physical_Property ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty pmdco:characteristic_of ;
                                   owl:someValuesFrom pmdco:Materialstruktur
                                 ] ;
                 rdfs:label "Morphology"@en ;
                 skos:definition "Morphology is a physical property describing the shape, size, and surface texture of a material or structure as observable by microscopy, governing surface area, optical response, and reactivity."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Multibeam
chips:Multibeam rdf:type owl:Class ;
                rdfs:subClassOf pmdco:Hersteller ;
                rdfs:label "Multibeam"@en ;
                skos:definition "Multibeam Corporation is a semiconductor equipment company that develops multi-column electron beam lithography systems for high-throughput direct-write patterning of semiconductor features."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Multicomponent_Material
chips:Multicomponent_Material rdf:type owl:Class ;
                              rdfs:subClassOf chips:Material ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty prov:wasUsedBy ;
                                                owl:someValuesFrom chips:Grand_Challenge_6
                                              ] ;
                              rdfs:label "Multi-component Material"@en ;
                              skos:definition "A multi-component material is a material composed of two or more chemically distinct constituents combined to achieve properties superior to or distinct from those of any single component."@en ;
                              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Multilayer_Film
chips:Multilayer_Film rdf:type owl:Class ;
                      rdfs:subClassOf chips:Film ;
                      rdfs:label "Multi-layer Film"@en ;
                      skos:definition "A multi-layer film is a thin-film stack composed of two or more distinct material layers deposited sequentially, engineered to achieve specific optical, electrical, or magnetic properties through interface effects."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Multiparty_Measuring_Process
chips:Multiparty_Measuring_Process rdf:type owl:Class ;
                                   rdfs:subClassOf pmdco:Messprozess ;
                                   rdfs:label "Multiparty Measuring Process"@en ;
                                   skos:definition "Multiparty Measuring Process is a measurement operation involving two or more independent laboratories or measurement entities to assess measurement consistency and comparability."@en ;
                                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Multipath_Component
chips:Multipath_Component rdf:type owl:Class ;
                          rdfs:subClassOf chips:Electromagnetic_Property ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty prov:wasGeneratedBy ;
                                            owl:someValuesFrom chips:Derived_Process
                                          ] ;
                          rdfs:label "Multipath Component"@en ;
                          skos:definition "A multipath component is a copy of a transmitted electromagnetic signal that arrives at a receiver via a path other than the direct line-of-sight path, resulting from reflection, diffraction, or scattering."@en ;
                          pmdco:abbreviation "MPC"@en ;
                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Multiphase_Material
chips:Multiphase_Material rdf:type owl:Class ;
                          rdfs:subClassOf chips:Material ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty prov:wasUsedBy ;
                                            owl:someValuesFrom chips:Grand_Challenge_6
                                          ] ;
                          rdfs:label "Multi-phase Material"@en ;
                          skos:definition "A multi-phase material is a material that contains two or more distinct thermodynamic phases with different compositions or structures coexisting in the same system."@en ;
                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Multiphysics_Simulation_Software
chips:Multiphysics_Simulation_Software rdf:type owl:Class ;
                                       rdfs:subClassOf chips:Modeling_and_Simulation_Software ;
                                       rdfs:label "Multiphysics Simulation Software"@en ;
                                       skos:definition "Multiphysics simulation software is a modeling and simulation software tool that couples two or more distinct physical phenomena, such as electromagnetic, thermal, structural, and fluid fields, to simulate their mutual interactions within a system."@en ;
                                       pmdco:definitionSource "claude-opus-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Multiscale_Simulation_Software
chips:Multiscale_Simulation_Software rdf:type owl:Class ;
                                     rdfs:subClassOf chips:Modeling_and_Simulation_Software ;
                                     rdfs:label "Multiscale Simulation Software"@en ;
                                     skos:definition "Multiscale simulation software is a modeling and simulation software tool that integrates descriptions of a system at two or more length or time scales, passing information between scales to capture emergent behavior not accessible at any single scale."@en ;
                                     pmdco:definitionSource "claude-opus-4-6"@en .


