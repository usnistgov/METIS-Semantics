               rdfs:subClassOf chips:Elemental_Composition ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty prov:influenced ;
                                 owl:someValuesFrom chips:Thermal_Conductivity
                               ] ;
               rdfs:label "Alloying"@en ;
               skos:definition "Alloying is the elemental composition design process of intentionally introducing one or more alloying elements into a base metal to modify its mechanical, electrical, or corrosion properties."@en ;
               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Alpha_Particle
chips:Alpha_Particle rdf:type owl:Class ;
                     rdfs:subClassOf chips:Particle ;
                     rdfs:label "Alpha Particle"@en ;
                     skos:definition "An alpha particle is a helium-4 nucleus consisting of two protons and two neutrons emitted during alpha decay, used as a probe in alpha spectroscopy and Rutherford backscattering spectrometry."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Alpha_Spectroscopy
chips:Alpha_Spectroscopy rdf:type owl:Class ;
                         rdfs:subClassOf mo:Spectroscopy ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty chips:measured ;
                                           owl:someValuesFrom chips:Alpha_Particle
                                         ] ;
                         rdfs:label "Alpha Spectroscopy"@en ;
                         skos:definition "Alpha Spectroscopy is a nuclear analytical technique that measures the energy spectrum of alpha particles emitted by radioactive nuclides to identify and quantify alpha-emitting radionuclides in a sample."@en ;
                         pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Alternating_Current
chips:Alternating_Current rdf:type owl:Class ;
                          rdfs:subClassOf mo:Strom ;
                          rdfs:label "Alternating Current"@en ;
                          skos:definition "Alternating current is an electric current that periodically reverses direction and varies in magnitude over time, typically following a sinusoidal waveform."@en ;
                          pmdco:definitionSource "claude-opus-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Alternating_Gradient_Magnetometer
chips:Alternating_Gradient_Magnetometer rdf:type owl:Class ;
                                        rdfs:subClassOf chips:Magnetometer ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty prov:wasAssociateFor ;
                                                          owl:someValuesFrom chips:Grand_Challenge_6
                                                        ] ;
                                        rdfs:label "Alternating Gradient Magnetometer"@en ;
                                        skos:definition "Alternating Gradient Magnetometer (AGM) is a sensitive vibrating-sample-type magnetometer in which the sample is placed in an alternating magnetic field gradient that exerts a force proportional to the magnetic moment, detected by a resonant mechanical transducer."@en ;
                                        pmdco:abbreviation "AGM" ;
                                        pmdco:definitionSource "claude-sonnet-4-6"@en .


