                                       pmdco:Optische_Mikroskopie ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty prov:wasAssociatedWith ;
                                         owl:someValuesFrom chips:Raman_Microscope
                                       ] ;
                       rdfs:label "Raman Microscopy"@en ;
                       skos:definition "Raman Microscopy is a surface characterization technique that focuses a laser beam onto a specimen through a microscope objective and collects the inelastic Raman-scattered light to map chemical composition and molecular structure with micrometer spatial resolution."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


