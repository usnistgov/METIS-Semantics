                rdfs:label "Shrinkage"@en ;
                skos:definition "Shrinkage is a defect characterized by volumetric contraction of a material during solidification, curing, or processing, which can introduce mechanical stress or dimensional inaccuracy in semiconductor packaging."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Sidewall_Angle
chips:Sidewall_Angle rdf:type owl:Class ;
