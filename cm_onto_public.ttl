                                                                            )
                                                              ]
                                         ] ;
                         rdfs:label "Raman Spectroscopy"@en ;
                         skos:definition "Raman Spectroscopy is an optical spectroscopy technique that measures the inelastic scattering of monochromatic light from a specimen to identify vibrational, rotational, and phonon modes, enabling chemical identification, phase analysis, and stress mapping with micrometre spatial resolution."@en ;
                         pmdco:definitionSource "claude-sonnet-4-6"@en .


