###  https://w3id.org/CHIPS/metrology-ontology/Arc_Melter
chips:Arc_Melter rdf:type owl:Class ;
                 rdfs:subClassOf chips:Temperature_Treatment_Node ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty prov:wasAssociateFor ;
                                   owl:someValuesFrom chips:Arc_Melting
