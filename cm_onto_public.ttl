chips:Environmental_Protection_Agency rdf:type owl:Class ;
                                      rdfs:subClassOf chips:Government ;
                                      rdfs:label "Environmental Protection Agency"@en ;
                                      skos:definition "The United States Environmental Protection Agency is a federal regulatory agency that develops and enforces regulations for hazardous materials including semiconductor process chemicals and electronic waste."@en ;
                                      pmdco:abbreviation "EPA" ;
                                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Environmental_Stress
chips:Environmental_Stress rdf:type owl:Class ;
                           rdfs:subClassOf pmdco:Spannung ,
                                           [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                    owl:onProperty chips:measuredBy ;
                                                                    owl:someValuesFrom chips:Grand_Challenge_3
                                                                  ]
