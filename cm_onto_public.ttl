###  https://w3id.org/CHIPS/metrology-ontology/Sorbent_Separation
chips:Sorbent_Separation rdf:type owl:Class ;
                         rdfs:subClassOf chips:Separation_Process ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty pmdco:belongsToProject ;
                                           owl:someValuesFrom chips:Grand_Challenge_7
                                         ] ;
                         rdfs:label "Sorbent Separation"@en ;
