###  https://w3id.org/CHIPS/metrology-ontology/4DSTEM_data
<https://w3id.org/CHIPS/metrology-ontology/4DSTEM_data> rdf:type owl:Class ;
                                                        rdfs:subClassOf chips:Hyperdimensional_Image ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty prov:wasGeneratedBy ;
                                                                          owl:someValuesFrom mo:Elektronenbeugung
                                                                        ] ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty prov:wasGeneratedBy ;
                                                                          owl:someValuesFrom mo:Scanning_Transmission_Electron_Microscopy
                                                                        ] ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty pmdco:characteristic ;
                                                                          owl:someValuesFrom chips:Higher_Dimensions
                                                                        ] ;
                                                        rdfs:label "4D-STEM data"@en ;
                                                        skos:definition "4D-STEM data is a dataset acquired by four-dimensional scanning transmission electron microscopy in which a two-dimensional convergent-beam electron diffraction pattern is recorded at each point of a two-dimensional raster scan, yielding a four-dimensional dataset that encodes local structure, strain, electric field, and charge density."@en ;
                                                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/6BM_BMM
<https://w3id.org/CHIPS/metrology-ontology/6BM_BMM> rdf:type owl:Class ;
                                                    rdfs:subClassOf chips:Beamline ,
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty prov:actedOnBehalfOf ;
                                                                      owl:someValuesFrom chips:National_Institute_of_Standards_and_Technology
                                                                    ] ,
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty prov:actedOnBehalfOf ;
                                                                      owl:someValuesFrom chips:National_Synchrotron_Lightsource_II
                                                                    ] ,
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty prov:wasAssociateFor ;
                                                                      owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                           owl:unionOf ( chips:Grand_Challenge_2
                                                                                                         chips:Grand_Challenge_6
                                                                                                         chips:Grand_Challenge_7
                                                                                                       )
                                                                                         ]
                                                                    ] ;
                                                    rdfs:label "6-BM (BMM)"@en ;
                                                    skos:definition "6-BM (BMM) is the Beamline for Materials Measurement at the National Synchrotron Light Source II (NSLS-II) at Brookhaven National Laboratory, providing X-ray absorption spectroscopy capabilities for characterizing the local atomic structure and oxidation state of materials."@en ;
                                                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/7ID_SST1
