                                              owl:onProperty prov:influenced ;
                                              owl:someValuesFrom chips:Grand_Challenge_4
                                            ] ;
                            rdfs:label "Topological Insulator"@en ;
                            skos:definition "A topological insulator is a material that behaves as an insulator in its bulk but supports conducting surface or edge states protected by time-reversal symmetry, arising from strong spin-orbit coupling."@en ;
                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Topological_Property
