                               rdfs:label "Photothermal Corporation"@en ;
                               skos:definition "Photothermal Spectroscopy Corp is a scientific instruments company that develops and manufactures optical photothermal infrared microscopes for nanoscale chemical imaging and spectroscopy of thin films and surfaces."@en ;
                               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Photothermal_Induced_Resonance
chips:Photothermal_Induced_Resonance rdf:type owl:Class ;
                                     rdfs:subClassOf chips:Infrared_Spectroscopy ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty prov:wasInfluencedBy ;
                                                       owl:someValuesFrom chips:Atomic_Force_Microscopy
                                                     ] ,
