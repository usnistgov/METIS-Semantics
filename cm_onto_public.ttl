                                         owl:someValuesFrom chips:Rate_Of_Change_Process
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty prov:wasInfluencedBy ;
                                         owl:someValuesFrom pmdco:Zeit
                                       ] ;
                       rdfs:label "Dynamic Property"@en ;
                       skos:definition "Dynamic Property is a property that characterizes the time-dependent or frequency-dependent behavior of a material or system, such as damping, viscosity, or modulus as a function of strain rate."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/ELog
chips:ELog rdf:type owl:Class ;
           rdfs:subClassOf pmdco:Dokument ;
           rdfs:label "E-Log"@en ;
           skos:definition "An e-log (electronic log) is a structured digital record of experimental procedures, conditions, and observations maintained in an electronic laboratory notebook or database."@en ;
           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/EMD_Electronics
chips:EMD_Electronics rdf:type owl:Class ;
                      rdfs:subClassOf pmdco:Hersteller ;
                      rdfs:label "EMD Electronics"@en ;
                      skos:definition "EMD Electronics is a specialty chemicals and materials company that supplies high-purity process chemicals, gases, and materials for semiconductor manufacturing and display fabrication."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/EUV_Tech
chips:EUV_Tech rdf:type owl:Class ;
               rdfs:subClassOf pmdco:Hersteller ;
               rdfs:label "EUV Tech"@en ;
               skos:definition "EUV Tech is a company that develops and manufactures extreme ultraviolet light sources and EUV optical characterization tools for next-generation semiconductor lithography research and development."@en ;
               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Edgechipping
chips:Edgechipping rdf:type owl:Class ;
                   rdfs:subClassOf chips:Indentation ;
                   rdfs:label "Edge-chipping"@en ;
                   skos:definition "Edge-chipping is a mechanical testing technique in which a sharp indenter is pressed into a specimen near its free edge to fracture a chip, thereby measuring the edge fracture toughness or edge strength of brittle ceramic or glass materials."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Effective
chips:Effective rdf:type owl:Class ;
                rdfs:subClassOf chips:Equvalence ;
                rdfs:comment "For example, rms voltage is an effective measure of AC voltage, effective mass is an effective measure of holes."@en ;
                rdfs:label "Effective"@en ;
                skos:definition "Effective denotes an equivalence relationship in which a quantity represents the equivalent steady-state or root-mean-square value of a time-varying quantity that produces the same physical effect, such as effective mass for charge carriers or effective (RMS) voltage for alternating current."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Elastic_Scattering
chips:Elastic_Scattering rdf:type owl:Class ;
                         rdfs:subClassOf chips:Scattering ;
                         rdfs:label "Elastic Scattering"@en ;
                         skos:definition "Elastic Scattering is a scattering process in which the kinetic energy of the incident particle or photon is conserved upon interaction with a target, altering only the direction of propagation without energy transfer to internal degrees of freedom."@en ;
                         pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Electric_Field
chips:Electric_Field rdf:type owl:Class ;
                     rdfs:subClassOf chips:Quantity_Kind ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty chips:calculatedBy ;
                                       owl:someValuesFrom chips:Grand_Challenge_2
