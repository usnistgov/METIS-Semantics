                                                                        owl:unionOf ( chips:Grand_Challenge_2
                                                                                      chips:Grand_Challenge_4
                                                                                      chips:Grand_Challenge_5
                                                                                    )
                                                                      ]
                                                 ] ;
                                 rdfs:label "Wide Bandgap Semiconductor"@en ;
                                 skos:definition "A wide bandgap semiconductor is a semiconductor material with an electronic bandgap significantly larger than that of silicon (>2 eV), such as SiC and GaN, enabling high-power, high-frequency, and high-temperature device operation."@en ;
                                 pmdco:abbreviation "WBG"@en ;
                                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Wire_Bond
chips:Wire_Bond rdf:type owl:Class ;
                rdfs:subClassOf chips:Bond ;
                rdfs:label "Wire Bond"@en ;
                skos:definition "A wire bond is a thin metallic wire, typically gold or copper, used to create an electrical connection between an IC die pad and a package lead frame or substrate pad."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Wolfspeed
chips:Wolfspeed rdf:type owl:Class ;
                rdfs:subClassOf pmdco:Hersteller ;
                rdfs:label "Wolfspeed"@en ;
                skos:definition "Wolfspeed is a wide-bandgap semiconductor company that designs and manufactures silicon carbide and gallium nitride power devices and radio-frequency transistors for power electronics and wireless communications."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Work_Function
chips:Work_Function rdf:type owl:Class ;
                    rdfs:subClassOf chips:Physical_Property ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty chips:calculatedBy ;
                                      owl:someValuesFrom chips:Computational_Process
                                    ] ;
                    rdfs:label "Work Function"@en ;
                    skos:definition "Work function is a physical property of a material defined as the minimum energy required to remove an electron from the surface of the material to a point just outside it in vacuum."@en ;
                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Work_of_Adhesion
chips:Work_of_Adhesion rdf:type owl:Class ;
                       rdfs:subClassOf chips:Mechanical_Property ,
                                       pmdco:Materialeigenschaft ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty pmdco:characteristic_of ;
                                         owl:someValuesFrom [ rdf:type owl:Class ;
                                                              owl:unionOf ( chips:Interface
                                                                            chips:Surface
                                                                          )
                                                            ]
                                       ] ;
                       rdfs:label "Work of Adhesion"@en ;
                       skos:definition "Work of Adhesion is the thermodynamic work per unit area required to reversibly separate two surfaces in contact from equilibrium contact to infinite separation, equal to the sum of the individual surface energies minus the interfacial energy."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Workshop_Report
chips:Workshop_Report rdf:type owl:Class ;
                      rdfs:subClassOf chips:Report ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty prov:wasGeneratedBy ;
                                        owl:someValuesFrom chips:Conference_and_Workshop
                                      ] ;
                      rdfs:label "Workshop Report"@en ;
                      skos:definition "Workshop Report is a document that summarizes the discussions, findings, and recommendations from a technical workshop or symposium attended by subject-matter experts."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


