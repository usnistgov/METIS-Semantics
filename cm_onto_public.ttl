                                                      owl:onProperty pmdco:belongsToProject ;
                                                      owl:someValuesFrom chips:Grand_Challenge_5
                                                    ] ;
                                    rdfs:label "Molecular Dynamics Simulation"@en ;
                                    skos:definition "Molecular Dynamics is a force field-based atomistic simulation technique that numerically integrates Newton's equations of motion for a system of atoms to compute time-averaged thermodynamic and structural properties."@en ;
                                    pmdco:abbreviation "MD"@en ;
                                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Molecular_Dynamics_Software
chips:Molecular_Dynamics_Software rdf:type owl:Class ;
                                  rdfs:subClassOf chips:Atomistic_Simulation_Software ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty prov:wasAssociateFor ;
                                                    owl:someValuesFrom chips:Molecular_Dynamics_Simulation
                                                  ] ;
                                  rdfs:label "Molecular Dynamics Software"@en ;
                                  skos:definition "Molecular Dynamics Software is a software agent that integrates Newton's classical equations of motion for an ensemble of atoms interacting via empirical force fields to simulate the time evolution of materials at finite temperature."@en ;
                                  pmdco:definitionSource "claude-sonnet-4-6"@en .


