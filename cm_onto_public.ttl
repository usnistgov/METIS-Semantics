                                          owl:onProperty prov:wasInfluencedBy ;
                                          owl:someValuesFrom chips:Mass_Flow_Controller
                                        ] ;
                        rdfs:label "Mass Flow Process"@en ;
                        skos:definition "Mass Flow Process is a mass transport process driven by a pressure or velocity gradient in which a fluid bulk transports material, heat, or momentum through a conduit or medium."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Mass_Measurement_Instrument
