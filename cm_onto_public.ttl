                                                                           ]
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty pmdco:characteristic ;
                                                                             owl:someValuesFrom [ owl:intersectionOf ( chips:File_Format
                                                                                                                       [ rdf:type owl:Restriction ;
                                                                                                                         owl:onProperty pmdco:relates_to ;
                                                                                                                         owl:someValuesFrom chips:Computer_Aided_Design_Software
                                                                                                                       ]
                                                                                                                     ) ;
                                                                                                  rdf:type owl:Class
                                                                                                ]
                                                                           ]
                                                                         ) ;
                                                      rdf:type owl:Class
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty prov:wasGeneratedBy ;
                                                      owl:someValuesFrom chips:Computer_Aided_Design
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty prov:wasGeneratedBy ;
                                                      owl:someValuesFrom chips:Computer_Aided_Design_Software
                                                    ] ;
                                    rdfs:label "Computer Aided Design Drawing"@en ;
                                    skos:definition "Computer-Aided Design Drawing is a design document that represents the geometry, dimensions, and tolerances of a part, circuit layout, or system using CAD software, serving as the basis for manufacturing or fabrication."@en ;
                                    pmdco:abbreviation "CAD Drawing"@en ;
                                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Computer_Aided_Design_Software
chips:Computer_Aided_Design_Software rdf:type owl:Class ;
                                     rdfs:subClassOf prov:Software_Agent ,
