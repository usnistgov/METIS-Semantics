                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty pmdco:characteristic ;
                                      owl:someValuesFrom pmdco:Zeit
                                    ] ;
                    rdfs:label "Reaction Rate"@en ;
                    skos:definition "Reaction Rate is the time derivative of the extent of a chemical reaction, expressing how rapidly reactants are consumed or products are formed per unit volume."@en ;
                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Reactive_Ion_Etch_Tool
chips:Reactive_Ion_Etch_Tool rdf:type owl:Class ;
                             rdfs:subClassOf chips:Etch_Tool ,
                                             chips:Reaction_Chamber ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty prov:wasAssociateFor ;
                                               owl:someValuesFrom chips:Reactive_Ion_Etching
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty prov:wasAssociateFor ;
                                               owl:someValuesFrom [ rdf:type owl:Class ;
                                                                    owl:unionOf ( chips:Grand_Challenge_2
                                                                                  chips:Grand_Challenge_3
                                                                                )
                                                                  ]
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty pmdco:characteristic ;
                                               owl:someValuesFrom [ rdf:type owl:Class ;
                                                                    owl:unionOf ( chips:Ion
                                                                                  chips:Plasma
                                                                                )
                                                                  ]
                                             ] ;
                             rdfs:label "Reactive Ion Etch Tool"@en ;
                             skos:definition "Reactive Ion Etch Tool is a fabrication instrument that generates a plasma from reactive gases in a vacuum chamber and accelerates ions toward the substrate surface to perform anisotropic plasma etching."@en ;
                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Reactive_Ion_Etching
chips:Reactive_Ion_Etching rdf:type owl:Class ;
                           rdfs:subClassOf chips:Plasma_Etch_Process ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty prov:used ;
                                             owl:someValuesFrom chips:Ion
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty prov:wasAssociatedWith ;
                                             owl:someValuesFrom chips:Reactive_Ion_Etch_Tool
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty pmdco:belongsToProject ;
                                             owl:someValuesFrom chips:Grand_Challenge_5
                                           ] ;
                           rdfs:label "Reactive Ion Etching"@en ;
                           skos:definition "Reactive Ion Etching (RIE) is a plasma etch process that combines chemical etching by reactive radicals with physical sputtering by energetic ions accelerated toward the substrate, achieving anisotropic pattern transfer."@en ;
                           pmdco:abbreviation "RIE" ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Read_Error_Rate
chips:Read_Error_Rate rdf:type owl:Class ;
                      rdfs:subClassOf chips:Bit_Error_Rate ;
                      rdfs:label "Read Error Rate"@en ;
                      skos:definition "Read error rate is a magnetic property quantifying the fraction of bits incorrectly retrieved from a magnetic storage medium during a read operation."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Read_Head
chips:Read_Head rdf:type owl:Class ;
                rdfs:subClassOf chips:Device ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty prov:actedOnBehalfOf ;
                                  owl:someValuesFrom chips:Magnetic_Hard_Disk_Drive
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty prov:wasAssociateFor ;
                                  owl:someValuesFrom chips:Grand_Challenge_5
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty pmdco:composed_of ;
                                  owl:someValuesFrom chips:Magnetic_Tunnel_Junction
                                ] ;
                rdfs:label "Read Head"@en ;
                skos:definition "Read Head is a hardware device in a magnetic storage system that detects the magnetic flux from recorded data bits on a rotating disk or tape using magnetoresistive sensing elements."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Reciprocal_Lattice_Vector
chips:Reciprocal_Lattice_Vector rdf:type owl:Class ;
                                owl:equivalentClass [ rdf:type owl:Restriction ;
                                                      owl:onProperty chips:isMathematicalInverseOf ;
                                                      owl:someValuesFrom chips:Lattice_Parameter
                                                    ] ;
                                rdfs:subClassOf pmdco:Materialeigenschaft ;
                                rdfs:label "Reciprocal Lattice Vector"@en ;
                                skos:definition "A reciprocal lattice vector is a vector in the Fourier transform space of a crystal lattice that defines the positions of diffraction peaks in X-ray, electron, and neutron diffraction experiments."@en ;
                                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Reconstruction_Algorithm
chips:Reconstruction_Algorithm rdf:type owl:Class ;
                               rdfs:subClassOf pmdco:Algorithmus ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty prov:wasGeneratedBy ;
                                                 owl:someValuesFrom chips:Grand_Challenge_7
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty prov:wasUsedBy ;
                                                 owl:someValuesFrom mo:Rekonstruktion
                                               ] ;
                               rdfs:label "Reconstruction Algorithm"@en ;
                               skos:definition "Reconstruction Algorithm is a computational algorithm that synthesizes a two- or three-dimensional image or model from a set of one- or two-dimensional projections or partial measurements using mathematical inversion methods."@en ;
                               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Recovery_Process
chips:Recovery_Process rdf:type owl:Class ;
                       rdfs:subClassOf pmdco:Prozess ;
                       rdfs:label "Recovery Process"@en ;
                       skos:definition "Recovery Process is a process that reclaims, purifies, or recycles materials or energy from waste streams or end-of-life products."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Recycled_Materials_Association
chips:Recycled_Materials_Association rdf:type owl:Class ;
                                     rdfs:subClassOf chips:Trade_Organization ;
                                     rdfs:label "Recycled Materials Association"@en ;
                                     skos:definition "The Recycled Materials Association is a trade organization that represents companies involved in the collection, processing, and recycling of scrap metals and other materials, including electronic waste streams relevant to semiconductor supply chains."@en ;
                                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Recyling_Process
chips:Recyling_Process rdf:type owl:Class ;
                       rdfs:subClassOf chips:Recovery_Process ;
                       rdfs:label "Recyling Process"@en ;
                       skos:definition "Recycling Process is a recovery process that collects and reprocesses used materials into secondary raw materials or new products, reducing waste and demand for virgin resources."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Reduced_Data
chips:Reduced_Data rdf:type owl:Class ;
                   rdfs:subClassOf chips:Derived_Data ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty prov:wasAttributedTo ;
                                     owl:someValuesFrom chips:Data_Reduction_Algorithm
                                   ] ;
                   rdfs:label "Reduced Data"@en ;
                   skos:definition "Reduced data is processed measurement data from which background contributions, instrument response functions, or systematic artifacts have been subtracted or corrected."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Reference_Data
chips:Reference_Data rdf:type owl:Class ;
                     rdfs:subClassOf chips:Data ;
                     rdfs:label "Reference Data"@en ;
                     skos:definition "Reference data is a curated dataset of known or accepted values for material properties or physical constants, used to validate measurements, calibrate instruments, or parameterize models."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Reference_Material
chips:Reference_Material rdf:type owl:Class ;
                         rdfs:subClassOf chips:Benchmarking_Material ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty prov:wasAttributedTo ;
                                           owl:someValuesFrom chips:National_Institute_of_Standards_and_Technology
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty pmdco:output_of ;
                                           owl:someValuesFrom chips:Grand_Challenge_6
                                         ] ;
                         rdfs:label "Reference Material"@en ;
                         skos:definition "Reference Material is a material sufficiently homogeneous and stable with respect to specified properties, established to be fit for use in measurement or examination of a nominal property."@en ;
                         pmdco:abbreviation "RM"@en ;
                         pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Reflectance
chips:Reflectance rdf:type owl:Class ;
                  rdfs:subClassOf chips:Wave_Characteristic ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty pmdco:relates_to ;
                                    owl:someValuesFrom chips:Scattering_Parameter
                                  ] ;
                  rdfs:label "Reflectance"@en ;
                  skos:definition "Reflectance is the ratio of reflected to incident electromagnetic power at a surface, a dimensionless optical property ranging from zero to one that depends on wavelength and angle of incidence."@en ;
                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Reflected_Power
chips:Reflected_Power rdf:type owl:Class ;
                      rdfs:subClassOf chips:Power ;
                      rdfs:label "Reflected Power"@en ;
                      skos:definition "Reflected Power is the portion of incident electromagnetic power returned from an interface, load, or sample due to impedance mismatch or reflectance, quantified as the ratio to incident power."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Reflection_Particle
chips:Reflection_Particle rdf:type owl:Class ;
                          rdfs:subClassOf chips:Optic_System_Parameter ;
                          rdfs:label "Reflection_[Particle]"@en ;
                          skos:definition "Reflection, in the context of particle optics, is the property of a particle beam being redirected by a barrier or potential, analogous to optical reflection."@en ;
                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Reflection_Process_Scattering_of_Particles
chips:Reflection_Process_Scattering_of_Particles rdf:type owl:Class ;
                                                 rdfs:subClassOf chips:Scattering ;
                                                 rdfs:label "Reflection Process [Scattering of Particles]"@en ;
                                                 skos:definition "Reflection Process [Scattering of Particles] is a scattering process in which particles or radiation incident on an interface or specimen are redirected back into the incident medium, encompassing specular, diffuse, and Bragg reflection geometries used in surface and structural characterisation."@en ;
                                                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Reflection_Wave
chips:Reflection_Wave rdf:type owl:Class ;
                      rdfs:subClassOf chips:Electric_Property ,
                                      chips:Wave_Characteristic ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty pmdco:characteristic ;
                                        owl:someValuesFrom chips:Radio_Frequency
                                      ] ;
                      rdfs:label "Reflection_[Wave]"@en ;
                      skos:definition "Reflection coefficient is a high-frequency property quantifying the fraction of an incident electromagnetic wave reflected from a discontinuity in a transmission line or waveguide, characterized by the S11 parameter."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Reflectivity
chips:Reflectivity rdf:type owl:Class ;
                   rdfs:subClassOf pmdco:Messprozess ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty chips:measured ;
                                     owl:someValuesFrom chips:Reflection_Process_Scattering_of_Particles
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty pmdco:relates_to ;
                                     owl:someValuesFrom chips:Reflectometry
                                   ] ;
                   rdfs:label "Reflectivity"@en ;
                   skos:definition "Reflectivity is a measurement process or material property that quantifies the fraction of incident electromagnetic radiation reflected from an interface or surface at a specified wavelength and angle."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Reflectometer
chips:Reflectometer rdf:type owl:Class ;
                    rdfs:subClassOf chips:Optical_Measuring_Device ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty prov:wasAssociateFor ;
                                      owl:someValuesFrom chips:Grand_Challenge_2
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty prov:wasAssociateFor ;
                                      owl:someValuesFrom chips:Reflectometry
                                    ] ;
                    rdfs:label "Reflectometer"@en ;
                    skos:definition "Reflectometer is an optical measuring device that measures the fraction of incident light reflected from a surface or film as a function of wavelength or angle to determine reflectance, optical constants, or film thickness."@en ;
                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Reflectometry
chips:Reflectometry rdf:type owl:Class ;
                    rdfs:subClassOf pmdco:Messprozess ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty prov:wasAssociatedWith ;
                                      owl:someValuesFrom chips:Reflectometer
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty chips:measured ;
                                      owl:someValuesFrom chips:Reflection_Process_Scattering_of_Particles
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty pmdco:relates_to ;
                                      owl:someValuesFrom chips:Reflectivity
                                    ] ;
                    rdfs:label "Reflectometry"@en ;
                    skos:definition "Reflectometry is a measurement process that determines the wavelength- or angle-dependent reflectance of a surface or thin film to extract optical constants, film thickness, or surface roughness."@en ;
                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Refractive_Index
chips:Refractive_Index rdf:type owl:Class ;
                       rdfs:subClassOf pmdco:Optisch ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty chips:measuredBy ;
                                         owl:someValuesFrom pmdco:Messprozess
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty chips:hasRealPart ;
                                         owl:someValuesFrom xsd:float
                                       ] ;
                       rdfs:label "Refractive Index"@en ;
                       skos:definition "Refractive index is the ratio of the speed of light in vacuum to the phase velocity of light in a material, determining the degree of refraction and optical path length in thin-film optics."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en ;
                       pmdco:symbol "n" .


###  https://w3id.org/CHIPS/metrology-ontology/Relational_Database_Agent
chips:Relational_Database_Agent rdf:type owl:Class ;
                                rdfs:subClassOf chips:Database_Agent ;
                                rdfs:label "Relational Database Agent"@en ;
                                skos:definition "Relational Database Agent is a software agent that manages a relational database storing data in structured tables with defined schemas and enforcing ACID transaction properties, queried using SQL."@en ;
                                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Relaxation_Process
chips:Relaxation_Process rdf:type owl:Class ;
                         rdfs:subClassOf mo:Physikalischer_Prozess ;
                         rdfs:label "Relaxation Process"@en ;
                         skos:definition "Relaxation Process is a physical process in which a system perturbed from equilibrium returns toward its equilibrium state over a characteristic time scale through dissipative mechanisms."@en ;
                         pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Reliability
chips:Reliability rdf:type owl:Class ;
                  rdfs:subClassOf chips:Confidence_Concept ,
                                  [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                           owl:onProperty chips:measuredBy ;
                                                           owl:someValuesFrom chips:Grand_Challenge_1
                                                         ]
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty pmdco:characteristic ;
                                                           owl:someValuesFrom [ owl:intersectionOf ( chips:Defect
                                                                                                     chips:Dopant
                                                                                                     chips:Interface
                                                                                                     chips:Vacancy
                                                                                                     chips:Warpage
                                                                                                   ) ;
                                                                                rdf:type owl:Class
                                                                              ]
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
                  rdfs:label "Reliability"@en ;
                  skos:definition "Reliability is a confidence concept describing the probability that a device, material, or measurement system performs its intended function without failure under specified conditions for a specified period."@en ;
                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Reliability_Testing
chips:Reliability_Testing rdf:type owl:Class ;
                          rdfs:subClassOf chips:Testing_Process ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty chips:measured ;
                                            owl:someValuesFrom chips:Reliability
                                          ] ;
                          rdfs:label "Reliability Testing"@en ;
                          skos:definition "Reliability Testing is a testing process that subjects devices or systems to accelerated stress conditions such as elevated temperature, humidity, or electrical cycling to characterize failure modes and predict lifetime under use conditions."@en ;
                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Reluctance
chips:Reluctance rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty chips:isInverselyProportionalTo ;
                                       owl:someValuesFrom chips:Inductance
                                     ] ;
                 rdfs:subClassOf chips:Magnetic_Property ;
                 rdfs:label "Reluctance"@en ;
                 skos:definition "Reluctance is the opposition of a magnetic circuit to magnetic flux, analogous to resistance in an electric circuit, determined by the geometry and permeability of the magnetic path."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Report
chips:Report rdf:type owl:Class ;
             rdfs:subClassOf pmdco:Dokument ;
             rdfs:label "Report"@en ;
             skos:definition "Report is a document that presents the results, analysis, and conclusions of a scientific investigation, technical study, or administrative review in a structured format."@en ;
             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Repository
chips:Repository rdf:type owl:Class ;
                 rdfs:subClassOf pmdco:Digital_Entity ;
                 rdfs:label "Repository"@en ;
                 skos:definition "Repository is a digital entity that provides versioned storage and management of files, data, or code, enabling collaborative development, history tracking, and distribution."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Reproducibility
chips:Reproducibility rdf:type owl:Class ;
                      rdfs:subClassOf chips:Confidence_Concept ;
                      rdfs:label "Reproducibility"@en ;
                      skos:altLabel "Repeatability"@en ;
                      skos:definition "Reproducibility is a confidence concept describing the closeness of agreement between independent measurement results obtained under changed conditions, including different operators, instruments, or laboratories."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Research_Data_Infrastructure
chips:Research_Data_Infrastructure rdf:type owl:Class ;
                                   rdfs:subClassOf prov:Agent ;
                                   rdfs:label "Research Data Infrastructure"@en ;
                                   skos:definition "Research Data Infrastructure is an agent comprising the combined hardware, software, network, and organizational resources that enable management, storage, curation, and sharing of scientific research data."@en ;
                                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Research_Equipment_Network
chips:Research_Equipment_Network rdf:type owl:Class ;
                                 rdfs:subClassOf chips:Research_Data_Infrastructure ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty prov:wasAssociateFor ;
