                       pmdco:definitionSource "claude-opus-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Solder_Ball
chips:Solder_Ball rdf:type owl:Class ;
                  rdfs:subClassOf chips:Bond ;
                  rdfs:label "Solder Ball"@en ;
                  skos:definition "A solder ball is a spherical solder joint used to connect a ball-grid-array package to a printed circuit board or to connect stacked packages in package-on-package configurations."@en ;
                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Solder_Bump
chips:Solder_Bump rdf:type owl:Class ;
                  rdfs:subClassOf chips:Bond ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty prov:wasUsedBy ;
                                    owl:someValuesFrom chips:Grand_Challenge_3
                                  ] ;
                  rdfs:label "Solder Bump"@en ;
                  skos:definition "A solder bump is a controlled-collapse chip connection element composed of a fusible metal alloy that forms an electrical and mechanical joint between an IC die and its substrate upon reflow."@en ;
                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Solder_Joint
chips:Solder_Joint rdf:type owl:Class ;
                   rdfs:subClassOf chips:Bond ;
                   rdfs:label "Solder Joint"@en ;
                   skos:definition "A solder joint is the permanent electrical and mechanical connection formed by the solidification of a molten solder alloy between two metal surfaces in electronic packaging."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Solder_Material
chips:Solder_Material rdf:type owl:Class ;
                      rdfs:subClassOf chips:Bond_Material ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty prov:wasUsedBy ;
                                        owl:someValuesFrom chips:Grand_Challenge_3
                                      ] ;
                      rdfs:label "Solder Material"@en ;
                      skos:definition "A solder material is a fusible metal alloy used to create permanent electrical and mechanical joints between electronic components, melted and resolidified at temperatures below the melting points of the joined materials."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Solid
chips:Solid rdf:type owl:Class ;
            rdfs:subClassOf chips:Matter ;
            rdfs:label "Solid"@en ;
            skos:definition "A solid is a state of matter characterized by structural rigidity and resistance to changes in shape or volume, in which constituent atoms or molecules are tightly packed in fixed positions."@en ;
            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/SolidState_Nuclear_Magnetic_Resonance
chips:SolidState_Nuclear_Magnetic_Resonance rdf:type owl:Class ;
                                            rdfs:subClassOf chips:Nuclear_Magnetic_Resonance ;
                                            rdfs:label "Solid-State Nuclear Magnetic Resonance"@en ;
                                            skos:definition "Solid-State Nuclear Magnetic Resonance is a nuclear magnetic resonance spectroscopy technique applied to solid specimens using magic-angle spinning and dipolar decoupling methods to resolve chemical shift anisotropy and extract structural and dynamic information from crystalline, amorphous, and nanostructured materials."@en ;
                                            pmdco:abbreviation "Solid-State NMR"@en ,
                                                               "SS NMR" ;
                                            pmdco:definitionSource "claude-sonnet-4-6"@en .


