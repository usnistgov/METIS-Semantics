               rdfs:label "Ericsson"@en ;
               skos:definition "Ericsson is a telecommunications equipment and services company that develops and manufactures radio access network hardware, core network software, and semiconductor components for wireless communications infrastructure."@en ;
               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Error
chips:Error rdf:type owl:Class ;
            rdfs:subClassOf chips:Confidence_Concept ;
            skos:definition "Error is a confidence concept quantifying the difference between a measured or calculated value and the true or reference value, including systematic (bias) and random (noise) contributions."@en ;
            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Etch_Depth
chips:Etch_Depth rdf:type owl:Class ;
                 rdfs:subClassOf pmdco:Lnge ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty pmdco:characteristic_of ;
                                   owl:someValuesFrom chips:Process_Metadata
                                 ] ;
                 rdfs:label "Etch Depth"@en ;
                 skos:definition "Etch depth is the vertical distance removed from a surface during an etch process, measured by profilometry or cross-sectional microscopy to characterize etch rate and uniformity."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Etch_Process
chips:Etch_Process rdf:type owl:Class ;
                   rdfs:subClassOf chips:Nanofabrication ,
                                   chips:Rate_Of_Change_Process ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty prov:influenced ;
                                     owl:someValuesFrom chips:Grand_Challenge_5
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty prov:wasAssociatedWith ;
                                     owl:someValuesFrom chips:Etch_Tool
                                   ] ;
                   rdfs:label "Etch Process"@en ;
                   skos:definition "Etch Process is a material removal process that selectively dissolves or ablates material from a substrate surface using chemical reagents, plasma species, or laser pulses to achieve patterning or surface modification."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Etch_Tool
chips:Etch_Tool rdf:type owl:Class ;
                rdfs:subClassOf chips:Fabrication_Instrument ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty prov:wasAssociateFor ;
                                  owl:someValuesFrom chips:Etch_Process
                                ] ;
                rdfs:label "Etch Tool"@en ;
                skos:definition "Etch Tool is a fabrication instrument that removes material from a substrate surface using chemical, plasma, or laser-based processes to create patterns or modify surface properties."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Evaporation_Process
chips:Evaporation_Process rdf:type owl:Class ;
                          rdfs:subClassOf chips:Physical_Vapor_Deposition ;
                          rdfs:label "Evaporation Process"@en ;
                          skos:definition "Evaporation Process is a physical vapor deposition technique in which a solid or liquid source material is thermally heated or electron-beam heated to vaporize atoms that condense on a cooler substrate to form a thin film."@en ;
                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Everspin
chips:Everspin rdf:type owl:Class ;
               rdfs:subClassOf pmdco:Hersteller ;
               rdfs:label "Everspin"@en ;
               skos:definition "Everspin Technologies is a semiconductor company that designs and manufactures magnetoresistive random-access memory products, including spin-transfer torque MRAM, for storage-class memory and industrial applications."@en ;
               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Exchange_Energy
chips:Exchange_Energy rdf:type owl:Class ;
                      rdfs:subClassOf chips:Magnetic_Property ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty chips:measuredBy ;
                                        owl:someValuesFrom pmdco:Messprozess
                                      ] ;
                      rdfs:label "Exchange Energy"@en ;
                      skos:definition "Exchange energy is a quantum mechanical contribution to the total energy of a magnetic system that arises from the Pauli exclusion principle and Coulomb interaction, determining the alignment of neighboring magnetic moments."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Exchange_Stiffness_Constant
chips:Exchange_Stiffness_Constant rdf:type owl:Class ;
                                  rdfs:subClassOf chips:Magnetic_Property ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty chips:measuredBy ;
                                                    owl:someValuesFrom pmdco:Messprozess
                                                  ] ;
                                  rdfs:label "Exchange Stiffness Constant"@en ;
                                  skos:definition "Exchange stiffness constant is a material parameter that quantifies the energy cost of nonuniform magnetization, determining the length scale of magnetization variations such as domain walls."@en ;
                                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Experiment_Process
chips:Experiment_Process rdf:type owl:Class ;
                         rdfs:subClassOf pmdco:Prozess ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty prov:generated ;
                                           owl:someValuesFrom pmdco:Metadaten
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty prov:wasInformedBy ;
                                           owl:someValuesFrom chips:Calibration
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty pmdco:relates_to ;
                                           owl:someValuesFrom pmdco:Messprozess
                                         ] ;
                         rdfs:label "Experiment Process"@en ;
                         skos:definition "An experiment process is a planned scientific procedure that is carried out to test a hypothesis, characterize a material or system, or acquire measurement data, encompassing all sub-processes from setup and calibration through data acquisition."@en ;
                         pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Experimental_Condition_Application
chips:Experimental_Condition_Application rdf:type owl:Class ;
                                         rdfs:subClassOf chips:Setup_Process ;
                                         rdfs:label "Experimental Condition Application"@en ;
                                         skos:definition "An experimental condition application is a setup process in which specific physical or environmental parameters—such as temperature, pressure, field strength, or stimulus—are imposed on a specimen or system prior to or during a measurement."@en ;
                                         pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Exposure_Time
chips:Exposure_Time rdf:type owl:Class ;
                    rdfs:subClassOf chips:Acquisition_Time ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty prov:wasAttributedTo ;
                                      owl:someValuesFrom chips:Camera
                                    ] ;
                    rdfs:label "Exposure Time"@en ;
                    skos:definition "Exposure time is the duration for which a detector, sensor, or photosensitive element is exposed to incident radiation or signal during a single acquisition event, controlling the total signal integrated per frame."@en ;
                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Extreme_Ultraviolet
chips:Extreme_Ultraviolet rdf:type owl:Class ;
                          rdfs:subClassOf chips:Electromagnetic_Spectrum ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty prov:wasGeneratedBy ;
                                            owl:someValuesFrom chips:Extreme_Ultraviolet_Source
                                          ] ;
                          rdfs:label "Extreme Ultraviolet"@en ;
                          skos:definition """Extreme ultraviolet refers to electromagnetic radiation that
-    Has wavelengths in the range of 10 to 124 nanometers
-    Lies between the ultraviolet and X-ray regions of the spectrum
-    Is used in advanced lithography systems for semiconductor manufacturing."""@en ;
                          pmdco:abbreviation "EUV"@en ;
                          pmdco:definitionSource "CVCS 0.0.7"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Extreme_Ultraviolet_Lithography
chips:Extreme_Ultraviolet_Lithography rdf:type owl:Class ;
                                      rdfs:subClassOf chips:Optical_Lithography ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty prov:used ;
                                                        owl:someValuesFrom chips:Extreme_Ultraviolet_Source
                                                      ] ;
                                      rdfs:label "Extreme Ultraviolet Lithography"@en ;
                                      skos:definition "Extreme Ultraviolet Lithography (EUV) is an optical lithography technique that uses 13.5 nm wavelength radiation from a plasma source, reflected by multilayer mirrors through a patterned mask onto a photoresist, to define features below 10 nm."@en ;
                                      pmdco:abbreviation "EUV Lithography"@en ;
                                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Extreme_Ultraviolet_Mirror
chips:Extreme_Ultraviolet_Mirror rdf:type owl:Class ;
                                 rdfs:subClassOf chips:Extreme_Ultraviolet_Optics ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty prov:wasAssociateFor ;
                                                   owl:someValuesFrom chips:Grand_Challenge_2
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty prov:wasInfluencedBy ;
                                                   owl:someValuesFrom chips:Extreme_Ultraviolet
                                                 ] ;
                                 rdfs:label "Extreme Ultraviolet Mirror"@en ;
                                 skos:definition "Extreme Ultraviolet Mirror is a reflective optical element for the EUV spectral range, typically a multilayer Bragg reflector composed of alternating Mo/Si or similar thin film pairs that achieves moderate reflectivity around 13.5 nm."@en ;
                                 pmdco:abbreviation "EUV Mirror"@en ;
                                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Extreme_Ultraviolet_Optics
chips:Extreme_Ultraviolet_Optics rdf:type owl:Class ;
                                 rdfs:subClassOf mo:Optical_Element ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty prov:wasAssociateFor ;
                                                   owl:someValuesFrom chips:Grand_Challenge_2
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty pmdco:composed_of ;
                                                   owl:someValuesFrom [ owl:intersectionOf ( chips:Multilayer_Film
                                                                                             chips:Thin_Film
                                                                                           ) ;
                                                                        rdf:type owl:Class
                                                                      ]
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty pmdco:relates_to ;
                                                   owl:someValuesFrom chips:Extreme_Ultraviolet
                                                 ] ;
                                 rdfs:label "Extreme Ultraviolet Optics"@en ;
                                 skos:definition """Extreme ultraviolet (EUV) optics are optical components that
-    Are designed to manipulate and control light in the extreme ultraviolet region of the electromagnetic spectrum
-    Enable the generation, focusing, and shaping of EUV radiation
-    Are crucial for precise imaging and projection in EUV lithography and other high-resolution applications."""@en ;
                                 pmdco:abbreviation "EUV Optics"@en ;
                                 pmdco:definitionSource "CVCS 0.0.7"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Extreme_Ultraviolet_Source
chips:Extreme_Ultraviolet_Source rdf:type owl:Class ;
                                 rdfs:subClassOf mo:Source ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty prov:generated ;
                                                   owl:someValuesFrom chips:Extreme_Ultraviolet
                                                 ] ;
                                 rdfs:label "Extreme Ultraviolet Source"@en ;
                                 skos:definition "Extreme Ultraviolet Source is a radiation source that produces photons in the EUV spectral range (approximately 10–120 eV), including laser-produced plasma, discharge-produced plasma, and high harmonic generation sources."@en ;
                                 pmdco:abbreviation "EUV Source"@en ;
                                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Extrinsic_Breakdown
chips:Extrinsic_Breakdown rdf:type owl:Class ;
                          rdfs:subClassOf chips:Dielectric_Breakdown ;
                          rdfs:label "Extrinsic Breakdown"@en ;
                          skos:definition "Extrinsic Breakdown is a dielectric failure mode in which localized defects, contaminants, or pin-holes in the dielectric layer cause premature electrical breakdown at fields well below the intrinsic breakdown strength."@en ;
                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Fabrication_Facility
chips:Fabrication_Facility rdf:type owl:Class ;
                           rdfs:subClassOf chips:Facility ,
                                           [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                    owl:onProperty prov:actedOnBehalfOf ;
                                                                    owl:someValuesFrom [ rdf:type owl:Class ;
