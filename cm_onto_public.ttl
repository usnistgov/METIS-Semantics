                             owl:someValuesFrom pmdco:Metadaten
                           ] ;
           rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
           rdfs:label "Time"@en ,
                      "Zeit"@de ;
           skos:definition "A nonspatial continuum that is measured in terms of events which succeed one another from past through present to future."@en ;
           pmdco:definitionSource "“Time.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/time. Accessed 25 Nov. 2022."@en .


###  https://w3id.org/pmd/co/quivalentdurchmesser
pmdco:quivalentdurchmesser rdf:type owl:Class ;
