                                       owl:onProperty pmdco:subordinate_process ;
                                       owl:someValuesFrom chips:Development_Process
                                     ] ;
                     rdfs:label "Design Process"@en ;
                     skos:definition "Design Process is a systematic creative and analytical process that defines the architecture, specifications, and geometry of a product, circuit, or system to meet defined functional requirements."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Desorption
chips:Desorption rdf:type owl:Class ;
                 rdfs:subClassOf chips:Kinetic_Process ;
                 rdfs:label "Desorption"@en ;
                 skos:definition "Desorption is a surface kinetic process in which atoms or molecules bound to a solid or liquid surface are released back into the gas or liquid phase upon thermal activation or other stimulation."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Destructive_Measurement_Process
chips:Destructive_Measurement_Process rdf:type owl:Class ;
                                      rdfs:subClassOf chips:Change_Process ,
