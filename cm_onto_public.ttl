                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/BeerLambert_Law
chips:BeerLambert_Law rdf:type owl:Class ;
                      rdfs:subClassOf chips:Empirical_Model ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty prov:wasDerivedFrom ;
                                        owl:someValuesFrom [ owl:intersectionOf ( chips:Chemical_Property
                                                                                  chips:Electromagnetic_Wave_Absoption
                                                                                  chips:Physical_Property
                                                                                  pmdco:Materialeigenschaft
                                                                                ) ;
                                                             rdf:type owl:Class
                                                           ]
                                      ] ;
                      rdfs:label "Beer–Lambert Law"@en ;
                      skos:definition "Beer-Lambert Law is an empirical model relating the attenuation of light passing through a medium to the product of the molar absorptivity, concentration, and path length of the absorbing species."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Benchmark_Technologies
chips:Benchmark_Technologies rdf:type owl:Class ;
                             rdfs:subClassOf chips:Fabrication_Facility ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty prov:wasAssociateFor ;
                                               owl:someValuesFrom chips:Grand_Challenge_5
                                             ] ;
                             rdfs:label "Benchmark Technologies"@en ;
                             skos:definition "Benchmark Technologies is a semiconductor fabrication and test services facility that provides prototype fabrication, process development, and device characterization services for research and commercial clients."@en ;
                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Benchmarking_Material
chips:Benchmarking_Material rdf:type owl:Class ;
                            rdfs:subClassOf chips:Material ;
                            rdfs:label "Benchmarking Material"@en ;
                            skos:definition "A benchmarking material is a material used as a reference to evaluate, compare, or validate measurement instruments, processes, or computational methods against known or agreed-upon property values."@en ;
                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Benchmarking_Process
chips:Benchmarking_Process rdf:type owl:Class ;
                           rdfs:subClassOf pmdco:Prozess ;
                           rdfs:label "Benchmarking Process"@en ;
                           skos:definition "Benchmarking Process is a systematic process that compares the performance of instruments, methods, or models against established standards or best-in-class references to identify performance gaps and improvement opportunities."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Best_Practice
chips:Best_Practice rdf:type owl:Class ;
                    rdfs:subClassOf chips:Report ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty pmdco:output_of ;
                                      owl:someValuesFrom chips:Grand_Challenge_6
                                    ] ;
                    rdfs:label "Best Practice"@en ;
                    skos:definition "Best Practice is a report or guideline document that describes a recommended method, procedure, or approach identified through experience and evidence as the most effective way to achieve a defined outcome."@en ;
                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Beta_particle
chips:Beta_particle rdf:type owl:Class ;
                    rdfs:subClassOf chips:Electron ;
                    rdfs:label "Beta particle"@en ;
                    skos:definition "A beta particle is a high-energy electron or positron emitted by a radioactive nucleus during beta decay, used in nuclear analysis techniques and as a radiation source in detector testing."@en ;
                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Bin
chips:Bin rdf:type owl:Class ;
          rdfs:subClassOf chips:Statistical_Concept ;
          rdfs:label "Bin"@en ;
          skos:definition "A bin is a discrete interval or category used to partition a continuous range of values into a finite set of contiguous sub-ranges for the purpose of statistical aggregation or histogram representation."@en ;
          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Binary
chips:Binary rdf:type owl:Class ;
             rdfs:subClassOf chips:File_Format ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty pmdco:output_of ;
                               owl:someValuesFrom chips:Grand_Challenge_4
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty pmdco:output_of ;
                               owl:someValuesFrom chips:Grand_Challenge_6
                             ] ;
             rdfs:label "Binary"@en ;
