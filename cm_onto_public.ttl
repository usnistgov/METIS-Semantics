                                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Data_Analysis_and_Reduction_Software
chips:Data_Analysis_and_Reduction_Software rdf:type owl:Class ;
                                           rdfs:subClassOf prov:Software_Agent ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty prov:wasAssociateFor ;
