             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/NanoPrinTek
chips:NanoPrinTek rdf:type owl:Class ;
                  rdfs:subClassOf pmdco:Hersteller ;
                  rdfs:label "NanoPrinTek"@en ;
                  skos:definition "NanoPrinTek is a nanofabrication company that develops nanoimprint lithography templates and processes for patterning nanostructures in semiconductor and optical device fabrication."@en ;
                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Nanocalorimetry
chips:Nanocalorimetry rdf:type owl:Class ;
                      rdfs:subClassOf chips:Calorimetry ;
                      skos:definition "Nanocalorimetry is a calorimetric technique that measures heat flows or heat capacities of nanogram-scale or nanoscale specimens using miniaturised calorimeter devices, enabling thermodynamic characterisation of thin films, nanoparticles, and small-volume materials."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Nanofabrication
chips:Nanofabrication rdf:type owl:Class ;
                      rdfs:subClassOf pmdco:Manufacture_Process ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty prov:wasAssociatedWith ;
                                        owl:someValuesFrom chips:Fabrication_Facility
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty pmdco:belongsToProject ;
                                        owl:someValuesFrom [ rdf:type owl:Class ;
                                                             owl:unionOf ( chips:Grand_Challenge_3
                                                                           chips:Grand_Challenge_6
                                                                         )
                                                           ]
                                      ] ;
                      skos:definition "Nanofabrication is a manufacturing process that creates structures, devices, or patterns with feature dimensions in the nanometre range using techniques such as electron-beam lithography, focused ion beam milling, atomic layer deposition, or directed self-assembly."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Nanoindentation
chips:Nanoindentation rdf:type owl:Class ;
                      rdfs:subClassOf chips:Indentation ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty prov:wasAssociatedWith ;
                                        owl:someValuesFrom chips:Nanoindenter
                                      ] ;
                      rdfs:label "Nanoindentation"@en ;
                      skos:definition "Nanoindentation is an indentation technique that continuously monitors the load and displacement of a sharp indenter during contact with a material surface at the nanoscale, enabling determination of hardness, elastic modulus, and time-dependent deformation at shallow depths."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Nanoindenter
chips:Nanoindenter rdf:type owl:Class ;
                   rdfs:subClassOf chips:Indentation_Instrument ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty prov:wasAssociateFor ;
                                     owl:someValuesFrom chips:Nanoindentation
                                   ] ;
                   rdfs:label "Nanoindenter"@en ;
                   skos:definition "Nanoindenter is a mechanical testing instrument that drives a diamond-tipped indenter into a material surface under continuously recorded load and displacement to extract hardness and elastic modulus at the nanometer scale."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Nanoparticle
chips:Nanoparticle rdf:type owl:Class ;
                   rdfs:subClassOf pmdco:Engineered_Material ;
                   rdfs:label "Nanoparticle"@en ;
                   skos:definition "Nanoparticle is an engineered material particle with at least one dimension in the range of 1 to 100 nanometers, exhibiting size-dependent optical, electronic, or catalytic properties distinct from bulk material."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


