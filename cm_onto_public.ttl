                                                                                                       chips:Seagate
                                                                                                     )
                                                                                       ]
                                                                  ]
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty prov:wasAssociateFor ;
                                                                    owl:someValuesFrom chips:Grand_Challenge_5
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty prov:wasAssociateFor ;
                                             owl:someValuesFrom chips:Nanofabrication
                                           ] ;
                           rdfs:label "Fabrication Facility"@en ;
                           skos:definition "A fabrication facility is a specialized infrastructure that provides the equipment, processes, and environment required for the manufacturing or prototyping of semiconductor devices, MEMS, or other micro- and nanoscale structures."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Fabrication_Instrument
chips:Fabrication_Instrument rdf:type owl:Class ;
                             rdfs:subClassOf chips:Instrument ,
                                             pmdco:Manufacturing_Node ;
                             rdfs:label "Fabrication Instrument"@en ;
                             skos:definition "Fabrication Instrument is a tool or apparatus used to deposit, etch, pattern, or otherwise physically modify a material or device during a manufacturing or sample preparation process."@en ;
                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Fabry_Perot_Open_Resonator
chips:Fabry_Perot_Open_Resonator rdf:type owl:Class ;
                                 rdfs:subClassOf chips:Cavity_and_Resonator ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty prov:wasAssociateFor ;
                                                   owl:someValuesFrom chips:Fabry_Perot_Open_Resonator_Measurement
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty prov:wasAssociateFor ;
                                                   owl:someValuesFrom chips:Grand_Challenge_3
                                                 ] ;
                                 rdfs:label "Fabry Perot Open Resonator"@en ;
                                 skos:definition "Fabry-Perot Open Resonator is a quasi-optical resonant structure consisting of two facing mirrors that trap millimeter-wave or submillimeter-wave radiation, used to measure the complex permittivity of low-loss dielectric materials."@en ;
                                 pmdco:abbreviation "FPOR" ;
                                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Fabry_Perot_Open_Resonator_Measurement
chips:Fabry_Perot_Open_Resonator_Measurement rdf:type owl:Class ;
                                             rdfs:subClassOf chips:Resonator_Measurements ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty prov:wasAssociatedWith ;
                                                               owl:someValuesFrom chips:Fabry_Perot_Open_Resonator
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty chips:measured ;
                                                               owl:someValuesFrom chips:Permittivity
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty pmdco:belongsToProject ;
                                                               owl:someValuesFrom chips:Grand_Challenge_3
                                                             ] ;
                                             rdfs:label "Fabry Perot Open Resonator Measurement"@en ;
                                             skos:definition "Fabry-Perot Open Resonator Measurement is a quasi-optical resonator measurement in which a flat dielectric slab is inserted between two facing mirrors and the resonant frequency shift is used to measure the complex permittivity at millimeter-wave frequencies."@en ;
                                             pmdco:abbreviation "FPOR Measurement" ;
                                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Facility
chips:Facility rdf:type owl:Class ;
               rdfs:subClassOf prov:Agent ;
               rdfs:label "Facility"@en ;
               skos:definition "Facility is a physical agent comprising a building, laboratory, or infrastructure installation that provides the environment and resources necessary to conduct scientific experiments, manufacturing, or data operations."@en ;
               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Failure_Analysis
chips:Failure_Analysis rdf:type owl:Class ;
                       rdfs:subClassOf pmdco:Analysing_Process ,
                                       [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                owl:onProperty prov:wasInformedBy ;
                                                                owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                     owl:unionOf ( chips:Xray_Computed_Tomography
                                                                                                   pmdco:Elektronenmikroskopie
                                                                                                 )
                                                                                   ]
                                                              ]
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty pmdco:belongsToProject ;
                                                                owl:someValuesFrom chips:Grand_Challenge_3
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty prov:wasInformedBy ;
                                         owl:someValuesFrom chips:Failure_Process
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty prov:wasInformedBy ;
                                         owl:someValuesFrom chips:Imaging_Process
                                       ] ;
                       rdfs:label "Failure Analysis"@en ;
                       skos:definition "Failure Analysis is an analytical process that investigates a failed device or material to identify the physical, chemical, or electrical mechanism responsible for its loss of function."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Failure_Process
chips:Failure_Process rdf:type owl:Class ;
                      rdfs:subClassOf pmdco:Prozess ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty prov:informed ;
                                        owl:someValuesFrom chips:Failure_Analysis
                                      ] ;
                      rdfs:label "Failure Process"@en ;
                      skos:definition "Failure Process is a physical or chemical mechanism by which a material, device, or system loses the ability to perform its intended function."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Failure_Time
chips:Failure_Time rdf:type owl:Class ;
                   rdfs:subClassOf pmdco:Zeit ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty pmdco:output_of ;
                                     owl:someValuesFrom chips:Grand_Challenge_5
                                   ] ;
                   rdfs:label "Failure Time"@en ;
                   skos:definition "Failure time is the elapsed time from the start of operation until a device or material exhibits a specified failure mode, used to characterize reliability and estimate lifetime distributions."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Fatigue_Process
chips:Fatigue_Process rdf:type owl:Class ;
                      rdfs:subClassOf chips:Failure_Process ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty pmdco:relates_to ;
                                        owl:someValuesFrom chips:Grand_Challenge_3
                                      ] ;
                      rdfs:label "Fatigue Process"@en ;
                      skos:definition "Fatigue Process is a failure mechanism in which a material or device accumulates progressive damage under cyclic mechanical, thermal, or electrical stress, ultimately leading to crack initiation and propagation."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Federated_Learning
chips:Federated_Learning rdf:type owl:Class ;
                         rdfs:subClassOf chips:AI_and_Machine_Learning ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty pmdco:belongsToProject ;
                                           owl:someValuesFrom chips:Grand_Challenge_5
                                         ] ;
                         rdfs:label "Federated Learning"@en ;
                         skos:definition "Federated Learning is a distributed machine learning paradigm in which model training is performed locally on multiple edge devices or servers holding private data, with only model parameter updates aggregated on a central server, preserving data privacy."@en ;
                         pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Feedback_Process
chips:Feedback_Process rdf:type owl:Class ;
                       rdfs:subClassOf pmdco:Prozess ;
                       rdfs:label "Feedback Process"@en ;
                       skos:definition "Feedback Process is a process in which output information from a system is returned to the input to regulate, correct, or optimize the system's behavior."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Femtosecond
chips:Femtosecond rdf:type owl:Class ;
                  rdfs:subClassOf chips:Time_Scale ;
                  rdfs:label "Femtosecond"@en ;
                  skos:definition "A femtosecond is a unit of time equal to 10⁻¹⁵ seconds, the timescale of ultrafast laser pulses and electronic dephasing processes in pump-probe spectroscopy."@en ;
                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Ferromagnetic_Resonance
chips:Ferromagnetic_Resonance rdf:type owl:Class ;
                              rdfs:subClassOf chips:Magnetic_Measurement ,
                                              chips:Resonanant_Process ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty prov:used ;
                                                owl:someValuesFrom chips:Microwave
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty chips:measured ;
                                                owl:someValuesFrom chips:Magnetic_Material
                                              ] ;
                              rdfs:label "Ferromagnetic Resonance"@en ;
                              skos:definition "Ferromagnetic Resonance is a resonance technique that measures the precession of magnetisation in a ferromagnetic or ferrimagnetic material about an applied magnetic field at microwave frequencies to determine magnetic damping, anisotropy fields, and spin-wave properties."@en ;
                              pmdco:abbreviation "FMR"@en ;
                              pmdco:definitionSource "claude-sonnet-4-6"@en .


