chips:Photonic_Integrated_Circuit rdf:type owl:Class ;
                                  rdfs:subClassOf chips:Integrated_Circuit ;
                                  rdfs:label "Photonic Integrated Circuit"@en ;
                                  skos:definition "Photonic Integrated Circuit (PIC) is an integrated circuit that confines and routes optical signals on a chip using waveguides, splitters, modulators, and detectors fabricated on a common substrate."@en ;
                                  pmdco:abbreviation "PIC"@en ;
                                  pmdco:definitionSource "claude-sonnet-4-6"@en .


