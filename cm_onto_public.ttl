chips:Sandia_National_Laboratory rdf:type owl:Class ;
                                 rdfs:subClassOf chips:National_Laboratory ,
                                                 [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                          owl:onProperty prov:contributed ;
                                                                          owl:someValuesFrom chips:Integrated_Circuit
                                                                        ]
                                                                        [ rdf:type owl:Restriction ;
