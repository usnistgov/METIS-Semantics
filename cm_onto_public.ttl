                                                     ] ;
                                     rdfs:label "Physical Vapor Deposition Tool"@en ;
                                     skos:definition "Physical Vapor Deposition Tool is a fabrication instrument that deposits thin films by physical vaporization of a solid source material through thermal evaporation or sputtering in a vacuum chamber."@en ;
                                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Physics
chips:Physics rdf:type owl:Class ;
              rdfs:subClassOf chips:Domain_Activities ;
              rdfs:label "Physics"@en ;
              skos:definition "Physics is the scientific discipline that investigates the fundamental laws governing matter, energy, space, and time through experiment and mathematical theory."@en ;
              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Physicsinformed_AI
chips:Physicsinformed_AI rdf:type owl:Class ;
                         rdfs:subClassOf chips:AI_and_Machine_Learning ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty pmdco:belongsToProject ;
                                           owl:someValuesFrom chips:Grand_Challenge_2
                                         ] ;
                         rdfs:label "Physics-informed AI"@en ;
                         skos:definition "Physics-Informed AI is a machine learning approach that incorporates known physical laws, constraints, or governing equations directly into the model architecture or training loss to improve accuracy and generalizability on scientific problems."@en ;
                         pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Physicsinformed_Neural_Network
chips:Physicsinformed_Neural_Network rdf:type owl:Class ;
                                     rdfs:subClassOf chips:Neural_Network ,
                                                     chips:Physicsinformed_AI ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty prov:activity ;
                                                       owl:someValuesFrom chips:Grand_Challenge_5
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty prov:activity ;
                                                       owl:someValuesFrom chips:Grand_Challenge_7
                                                     ] ;
                                     rdfs:label "Physics-informed Neural Network"@en ;
                                     skos:definition "Physics-Informed Neural Network (PINN) is a neural network architecture whose training loss incorporates residuals of governing physical equations alongside data misfit, enabling solution of differential equations and parameter inference with limited training data."@en ;
                                     pmdco:definitionSource "claude-sonnet-4-6"@en .


