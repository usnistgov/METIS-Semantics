                                     ] ;
                     rdfs:label "Plasma Process"@en ;
                     skos:definition "Plasma Process is a physical and chemical process that uses ionized gas (plasma) containing reactive radicals, ions, and electrons to etch, deposit, or modify the surface chemistry of a material."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Plasmaenhanced_Atomic_Layer_Deposition
chips:Plasmaenhanced_Atomic_Layer_Deposition rdf:type owl:Class ;
                                             rdfs:subClassOf chips:Atomic_Layer_Deposition ;
                                             rdfs:label "Plasma-enhanced Atomic Layer Deposition"@en ;
                                             skos:definition "Plasma-Enhanced Atomic Layer Deposition (PE-ALD) is a variant of ALD in which a plasma is used to generate reactive radical species, enabling deposition of conformal thin films at lower substrate temperatures than thermal ALD."@en ;
                                             pmdco:abbreviation "PEALD" ;
                                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Plasmaenhanced_Chemical_Vapor_Deposition
chips:Plasmaenhanced_Chemical_Vapor_Deposition rdf:type owl:Class ;
                                               rdfs:subClassOf chips:Chemical_Vapor_Deposition ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty prov:used ;
                                                                 owl:someValuesFrom chips:Plasma
                                                               ] ;
                                               rdfs:label "Plasma-enhanced Chemical Vapor Deposition"@en ;
                                               skos:definition "Plasma-Enhanced Chemical Vapor Deposition (PECVD) is a CVD process that uses a plasma to dissociate precursor gases at lower substrate temperatures than thermal CVD, enabling deposition of dielectric and semiconductor films on temperature-sensitive substrates."@en ;
                                               pmdco:abbreviation "PECVD"@en ;
                                               pmdco:definitionSource "claude-sonnet-4-6"@en .


