                                         skos:definition "Total Reflection X-ray Fluorescence (TXRF) is a non-destructive elemental analysis technique in which X-rays strike a flat specimen surface at an angle below the critical angle for total external reflection, exciting characteristic X-ray fluorescence from surface impurities at very low detection limits."@en ;
                                         pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Toughness
chips:Toughness rdf:type owl:Class ;
                rdfs:subClassOf chips:Mechanical_Property ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty chips:measuredBy ;
                                  owl:someValuesFrom pmdco:Messprozess
                                ] ;
                rdfs:label "Toughness"@en ;
                skos:definition "Toughness is a material property quantifying the total energy per unit volume absorbed by a material before fracture, numerically equal to the area under the engineering stress-strain curve to the point of rupture."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Traceable_Process
chips:Traceable_Process rdf:type owl:Class ;
                        rdfs:subClassOf pmdco:Prozess ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty prov:used ;
                                          owl:someValuesFrom chips:Provenance
                                        ] ;
                        rdfs:label "Traceable Process"@en ;
                        skos:definition "Traceable Process is a measurement or manufacturing process whose results can be linked through an unbroken chain of documented comparisons to national or international measurement standards."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Tracer
chips:Tracer rdf:type owl:Class ;
             rdfs:subClassOf chips:Material ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty prov:wasUsedBy ;
                               owl:someValuesFrom chips:Grand_Challenge_3
                             ] ;
             rdfs:label "Tracer"@en ;
             skos:definition "A tracer is a material, often isotopically labeled or fluorescently tagged, introduced in small quantities to track transport, diffusion, or contamination pathways in a system."@en ;
             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Trade_Organization
chips:Trade_Organization rdf:type owl:Class ;
                         rdfs:subClassOf prov:Organization ;
                         rdfs:label "Trade Organization"@en ;
                         skos:definition "A trade organization is an organization that represents and promotes the collective interests of companies or professionals within a specific industry or sector."@en ;
                         pmdco:definitionSource "claude-opus-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Training_Data
chips:Training_Data rdf:type owl:Class ;
                    rdfs:subClassOf chips:Data ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty pmdco:input_of ;
                                      owl:someValuesFrom chips:AI_and_Machine_Learning
                                    ] ;
                    rdfs:label "Training Data"@en ;
                    skos:definition "Training data is a labeled dataset used to develop and optimize a machine learning model by exposing it to examples from which it learns to make predictions or classifications."@en ;
                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Transient_Photothermal_Expansion
chips:Transient_Photothermal_Expansion rdf:type owl:Class ;
                                       rdfs:subClassOf chips:Thermal_Expansion ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty chips:measuredBy ;
                                                         owl:someValuesFrom chips:Pumpprobe_Process
                                                       ] ;
                                       rdfs:label "Transient Photothermal Expansion"@en ;
                                       skos:definition "Transient photothermal expansion is the rapid, time-resolved dimensional change of a surface or thin film resulting from laser heating, used to measure thermal properties by pump-probe techniques."@en ;
                                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Transistor
chips:Transistor rdf:type owl:Class ;
                 rdfs:subClassOf chips:Device ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty prov:wasUsedBy ;
                                   owl:someValuesFrom chips:Grand_Challenge_4
                                 ] ;
                 rdfs:label "Transistor"@en ;
                 skos:definition "Transistor is a semiconductor device with three terminals that can amplify electrical signals or act as an electronic switch by controlling current flow between two terminals via a signal applied to the third."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Transition_Edge_Sensor
chips:Transition_Edge_Sensor rdf:type owl:Class ;
                             rdfs:subClassOf chips:Xray_Microcalorimeters ,
                                             mo:Spektrometer ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty prov:generated ;
                                               owl:someValuesFrom chips:Xray_Fluorescence_Spectrum
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty prov:wasAssociateFor ;
                                               owl:someValuesFrom chips:Grand_Challenge_3
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty prov:wasAssociateFor ;
                                               owl:someValuesFrom chips:Grand_Challenge_6
                                             ] ;
                             rdfs:label "Transition Edge Sensor"@en ;
                             skos:definition "Transition Edge Sensor (TES) is a cryogenic X-ray microcalorimeter detector comprising a superconducting thin film biased at its transition temperature whose resistance is extremely sensitive to the temperature rise caused by individual X-ray photon absorption."@en ;
                             pmdco:abbreviation "TES" ;
                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Transmission_Electron_Backscatter_Diffraction
chips:Transmission_Electron_Backscatter_Diffraction rdf:type owl:Class ;
                                                    rdfs:subClassOf mo:Rckstreuelektronenbeugung ;
                                                    rdfs:label "Transmission Electron Backscatter Diffraction"@en ;
                                                    skos:altLabel "Transmission Kikuchi Diffraction"@en ;
                                                    skos:definition "Transmission Electron Backscatter Diffraction (t-EBSD) is an electron diffraction technique in which a thin specimen is tilted steeply in an SEM and the transmitted electrons are diffracted and collected on an EBSD detector to enable high-resolution crystallographic mapping."@en ;
                                                    pmdco:abbreviation "t-EBSD" ;
                                                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Transmission_Electron_Microscopy_Image
chips:Transmission_Electron_Microscopy_Image rdf:type owl:Class ;
                                             rdfs:subClassOf pmdco:Bild ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty prov:wasGeneratedBy ;
                                                               owl:someValuesFrom mo:Transmission_Electron_Microscopy
                                                             ] ;
                                             rdfs:label "Transmission Electron Microscopy Image"@en ;
                                             skos:definition "A transmission electron microscopy (TEM) image is a high-resolution image of a thin specimen formed by the transmitted electron beam, revealing atomic-scale structure, defects, and interfaces."@en ;
                                             pmdco:abbreviation "TEM Image"@en ;
                                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Transmission_Mode
chips:Transmission_Mode rdf:type owl:Class ;
                        rdfs:subClassOf chips:Soft_Xray_Spectroscopy ;
                        rdfs:label "Transmission Mode"@en ;
                        skos:definition "Transmission Mode is an operational configuration of a measurement instrument in which the interrogating beam passes completely through the specimen, enabling characterization of bulk absorption, refractive index, or diffraction properties."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Transmission_Particle
chips:Transmission_Particle rdf:type owl:Class ;
                            rdfs:subClassOf chips:Optic_System_Parameter ;
                            rdfs:label "Transmission_[Particle]"@en ;
                            skos:definition "Transmission, in the context of particle optics, is the property of a particle beam passing through a specimen or aperture, with intensity dependent on specimen thickness and scattering cross-section."@en ;
                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Transmission_Process_Scattering_of_Particles
chips:Transmission_Process_Scattering_of_Particles rdf:type owl:Class ;
                                                   rdfs:subClassOf chips:Scattering ,
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty prov:influenced ;
                                                                     owl:someValuesFrom chips:Resonant_Soft_Xray_Scattering
                                                                   ] ,
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty prov:influenced ;
                                                                     owl:someValuesFrom mo:Transmission_Electron_Microscopy
                                                                   ] ;
                                                   rdfs:label "Transmission Process [Scattering of Particles]"@en ;
                                                   skos:definition "Transmission Process [Scattering of Particles] is a scattering process in which particles or radiation pass through a specimen and are detected on the far side, with their angular or energy distribution analysed to determine structural, compositional, or electronic properties of the material."@en ;
                                                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Transmission_Scanning_Electron_Microscopy
chips:Transmission_Scanning_Electron_Microscopy rdf:type owl:Class ;
                                                rdfs:subClassOf mo:Scanning_Electron_Microscopy ;
                                                rdfs:label "Transmission Scanning Electron Microscopy"@en ;
                                                skos:altLabel "STEM-in-SEM"@en ;
                                                skos:definition "Transmission Scanning Electron Microscopy (TSEM) is a scanning electron microscopy technique in which electrons transmitted through an ultrathin specimen are detected to produce transmission contrast images with the beam optics of an SEM."@en ;
                                                pmdco:abbreviation "t-SEM"@en ;
                                                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Transmission_Wave
chips:Transmission_Wave rdf:type owl:Class ;
                        rdfs:subClassOf chips:Electric_Property ;
                        rdfs:label "Transmission_[Wave]"@en ;
                        skos:definition "Transmission coefficient is a high-frequency property quantifying the fraction of an incident electromagnetic wave transmitted through a two-port network, characterized by the S21 parameter."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Transmitreceive
chips:Transmitreceive rdf:type owl:Class ;
                      rdfs:subClassOf pmdco:Messprozess ;
                      rdfs:label "Transmit-receive"@en ;
                      skos:definition "Transmit-Receive is a measurement process in which a signal is transmitted through or toward a medium or object and the received signal is analyzed to determine transmission loss, time of flight, or target characteristics."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Transmittance
chips:Transmittance rdf:type owl:Class ;
                    rdfs:subClassOf chips:Wave_Characteristic ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty prov:wasDerivedFrom ;
                                      owl:someValuesFrom chips:Scattering_Parameter
                                    ] ;
                    rdfs:label "Transmittance"@en ;
                    skos:definition "Transmittance is the ratio of transmitted to incident electromagnetic power through a sample or film, used to characterize optical absorption and interference in thin-film systems."@en ;
                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Trap_Density
chips:Trap_Density rdf:type owl:Class ;
                   rdfs:subClassOf chips:Electromagnetic_Property ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty prov:wasGeneratedBy ;
                                     owl:someValuesFrom chips:Derived_Process
                                   ] ;
                   rdfs:label "Trap Density"@en ;
                   skos:definition "Trap density is the number of electrically active defect states per unit area or volume within the bandgap of a semiconductor or at a dielectric interface, affecting carrier lifetime and device reliability."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Trap_State
chips:Trap_State rdf:type owl:Class ;
                 rdfs:subClassOf chips:Electromagnetic_Property ;
                 rdfs:label "Trap State"@en ;
                 skos:definition "A trap state is a localized electronic energy state within the bandgap of a semiconductor or at an interface that can capture (trap) and release charge carriers, affecting device performance and reliability."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Tunable_Laser_Absorption_Spectroscopy
chips:Tunable_Laser_Absorption_Spectroscopy rdf:type owl:Class ;
                                            rdfs:subClassOf chips:Laser_Absoption_Spectroscopy ,
                                                            chips:Plasma_Diagnostic_Process ;
                                            rdfs:label "Tunable Laser Absorption Spectroscopy"@en ;
                                            skos:definition "Tunable Laser Absorption Spectroscopy (TLAS) is a gas-phase sensing technique that measures the absorption of a wavelength-scanned laser beam by a target gas species to determine its concentration and temperature."@en ;
                                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Twoterminal_Device
chips:Twoterminal_Device rdf:type owl:Class ;
                         rdfs:subClassOf chips:Device ;
                         rdfs:label "Two-terminal Device"@en ;
                         skos:definition "Two-Terminal Device is a hardware device with only two electrical contacts, such as a diode, resistor, or capacitor, whose electrical characteristics are fully described by the current-voltage relationship between the two terminals."@en ;
                         pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/UC_Irvine
chips:UC_Irvine rdf:type owl:Class ;
                rdfs:subClassOf chips:University_of_California ;
                rdfs:label "UC Irvine"@en ;
                skos:definition "UC Irvine is a University of California campus in Irvine, California, that conducts research in semiconductor physics, materials science, and photonics."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/UC_San_Diego
chips:UC_San_Diego rdf:type owl:Class ;
                   rdfs:subClassOf chips:University_of_California ;
                   rdfs:label "UC San Diego"@en ;
                   skos:definition "UC San Diego is a University of California campus in La Jolla, California, that conducts research in photonics, semiconductor materials, and nano-electronics."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/US_Naval_Academy
chips:US_Naval_Academy rdf:type owl:Class ;
                       rdfs:subClassOf chips:Academia ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty prov:actedOnBehalfOf ;
                                         owl:someValuesFrom chips:Department_of_Defense
                                       ] ;
                       rdfs:label "U.S. Naval Academy"@en ;
                       skos:definition "The United States Naval Academy is a federal service academy in Annapolis, Maryland, that conducts research in materials science and physics relevant to defense electronics and semiconductor applications."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/UV_Photoluminescence
chips:UV_Photoluminescence rdf:type owl:Class ;
                           rdfs:subClassOf chips:Photoluminescence ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty prov:used ;
                                             owl:someValuesFrom chips:Ultraviolet
                                           ] ;
                           rdfs:label "UV Photoluminescence"@en ;
                           skos:definition "UV Photoluminescence is a photoluminescence measurement in which ultraviolet photons excite a wide-bandgap material and the emitted ultraviolet luminescence is analyzed to characterize bandgap, defects, and excitonic recombination."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/UVvis_Spectrometer
chips:UVvis_Spectrometer rdf:type owl:Class ;
                         rdfs:subClassOf mo:Spektrometer ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty prov:wasAssociateFor ;
                                           owl:someValuesFrom chips:Grand_Challenge_5
                                         ] ;
                         rdfs:label "UV-vis Spectrometer"@en ;
                         skos:definition "UV-Vis Spectrometer is an optical spectrometer that measures the absorption or transmittance of a sample as a function of wavelength across the ultraviolet and visible spectral range."@en ;
                         pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Ultraviolet
chips:Ultraviolet rdf:type owl:Class ;
                  rdfs:subClassOf chips:Electromagnetic_Spectrum ;
                  rdfs:label "Ultraviolet"@en ;
                  skos:definition "Ultraviolet (UV) is a spectral region of the electromagnetic spectrum with wavelengths ranging from approximately 10 to 400 nanometers, lying between X-rays and visible light, and used for photolithography, spectroscopy, and sterilization."@en ;
                  pmdco:abbreviation "UV"@en ;
                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Ultraviolet_Photoelectron_Spectroscopy
chips:Ultraviolet_Photoelectron_Spectroscopy rdf:type owl:Class ;
                                             rdfs:subClassOf chips:Photoemission_Spectroscopy ;
                                             rdfs:label "Ultraviolet Photoelectron Spectroscopy"@en ;
                                             skos:definition "Ultraviolet Photoelectron Spectroscopy (UPS) is a photoemission technique that uses low-energy UV photons to eject valence-band electrons and measure their kinetic energy spectrum, revealing the electronic band structure and work function of a surface."@en ;
                                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Uncertainty
chips:Uncertainty rdf:type owl:Class ;
                  rdfs:subClassOf chips:Confidence_Concept ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty pmdco:characteristic_of ;
                                    owl:someValuesFrom pmdco:Messwert
                                  ] ;
                  rdfs:label "Uncertainty"@en ;
                  skos:definition "Uncertainty is a quantitative parameter, associated with a measurement result, that characterizes the dispersion of values that could reasonably be attributed to the measurand."@en ;
                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Underfill
chips:Underfill rdf:type owl:Class ;
                rdfs:subClassOf chips:Bond ;
                rdfs:label "Underfill"@en ;
                skos:definition "An underfill is a polymeric encapsulant material dispensed beneath a flip-chip or BGA package to fill the gap between the die and substrate, reinforcing solder joints against thermomechanical fatigue."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Uniform_Resource_Identifier
chips:Uniform_Resource_Identifier rdf:type owl:Class ;
                                  rdfs:subClassOf chips:Identification_Standard ,
                                                  pmdco:Identifikator ;
                                  rdfs:label "Uniform Resource Identifier"@en ;
                                  skos:definition "Uniform Resource Identifier (URI) is an identification standard that provides a compact string of characters used to uniquely identify and locate a resource on the internet or within a namespace."@en ;
                                  pmdco:abbreviation "URI" ;
                                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Uniform_Resource_Locator
chips:Uniform_Resource_Locator rdf:type owl:Class ;
                               rdfs:subClassOf chips:Uniform_Resource_Identifier ;
                               rdfs:label "Uniform Resource Locator"@en ;
                               skos:definition "Uniform Resource Locator (URL) is a Uniform Resource Identifier that specifies the location of a resource on a network by encoding the access protocol, host name, and path to the resource."@en ;
                               pmdco:abbreviation "URL" ;
                               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Uniformity
chips:Uniformity rdf:type owl:Class ;
                 rdfs:subClassOf chips:Confidence_Concept ;
                 owl:disjointWith chips:Variability ;
                 rdfs:label "Uniformity"@en ;
                 skos:definition "Uniformity is a confidence concept describing the spatial consistency of a property across a wafer, film, or sample, quantified as the variation in a measured quantity normalized by its mean."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/United_Nations_Entity
chips:United_Nations_Entity rdf:type owl:Class ;
                            rdfs:subClassOf prov:Organization ;
                            rdfs:label "United Nations Entity"@en ;
                            skos:definition "United Nations Entity is a specialized agency, program, or body within the United Nations system that addresses defined international issues such as health, environment, or scientific cooperation."@en ;
                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Universal_Verification_Methodology
chips:Universal_Verification_Methodology rdf:type owl:Class ;
                                         rdfs:subClassOf chips:Design_Process ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty prov:wasAssociatedWith ;
                                                           owl:someValuesFrom chips:Integrated_Circuit
                                                         ] ;
                                         rdfs:label "Universal Verification Methodology"@en ;
                                         skos:definition "Universal Verification Methodology (UVM) is a standardized design verification process for digital hardware that uses an object-oriented SystemVerilog framework to create reusable, scalable testbenches for integrated circuit validation."@en ;
                                         pmdco:abbreviation "UVM"@en ;
                                         pmdco:definitionSource "claude-sonnet-4-6"@en .


