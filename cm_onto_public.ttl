###  https://w3id.org/CHIPS/metrology-ontology/Assembly_and_Test_Technology_Unit
chips:Assembly_and_Test_Technology_Unit rdf:type owl:Class ;
                                        rdfs:subClassOf chips:Intel ;
                                        rdfs:label "Assembly and Test Technology Unit"@en ;
                                        skos:definition "The Assembly and Test Technology Unit is an Intel business unit that develops advanced semiconductor packaging technologies, including heterogeneous integration, chiplet assembly, and wafer-level packaging."@en ;
                                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Atom_Probe_Tomography
chips:Atom_Probe_Tomography rdf:type owl:Class ;
                            rdfs:subClassOf chips:Tomography_Process ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty prov:wasAssociatedWith ;
                                              owl:someValuesFrom chips:Atom_Probe_Tomography_Microscope
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty pmdco:belongsToProject ;
                                              owl:someValuesFrom [ rdf:type owl:Class ;
                                                                   owl:unionOf ( chips:Grand_Challenge_1
                                                                                 chips:Grand_Challenge_2
                                                                                 chips:Grand_Challenge_6
                                                                               )
                                                                 ]
                                            ] ;
                            rdfs:label "Atom Probe Tomography"@en ;
                            skos:definition "Atom Probe Tomography (APT) is a tomographic imaging process that field-evaporates individual atoms from a sharp specimen tip and reconstructs their three-dimensional positions and identities from time-of-flight mass spectrometry data."@en ;
                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Atom_Probe_Tomography_Data
chips:Atom_Probe_Tomography_Data rdf:type owl:Class ;
                                 rdfs:subClassOf chips:Tomogram ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty prov:wasGeneratedBy ;
                                                   owl:someValuesFrom chips:Atom_Probe_Tomography
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty pmdco:output_of ;
                                                   owl:someValuesFrom chips:Grand_Challenge_6
                                                 ] ;
                                 rdfs:label "Atom Probe Tomography Data"@en ;
                                 skos:altLabel "Atom Probe Tomogram"@en ;
                                 skos:definition "Atom probe tomography data is a three-dimensional dataset of individual atom identities and positions reconstructed from field-evaporated ions, providing sub-nanometer compositional mapping."@en ;
                                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Atom_Probe_Tomography_Microscope
chips:Atom_Probe_Tomography_Microscope rdf:type owl:Class ;
                                       rdfs:subClassOf pmdco:Mikroskop ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty prov:wasAssociateFor ;
                                                         owl:someValuesFrom chips:Atom_Probe_Tomography
                                                       ] ;
                                       rdfs:label "Atom Probe Tomography Microscope"@en ;
                                       skos:definition "Atom Probe Tomography Microscope is a microscope instrument that field-evaporates individual atoms from a sharp specimen tip and reconstructs their three-dimensional elemental positions from time-of-flight mass spectra."@en ;
                                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Atomic_Coordinate
chips:Atomic_Coordinate rdf:type owl:Class ;
                        rdfs:subClassOf chips:Coordinates_and_Location ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty pmdco:input_of ;
                                          owl:someValuesFrom chips:Grand_Challenge_4
                                        ] ;
                        rdfs:label "Atomic Coordinate"@en ;
                        skos:definition "An atomic coordinate is the spatial position of an atom within a crystal structure, defined by its fractional or Cartesian coordinates within the unit cell."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Atomic_Force_Microscope
chips:Atomic_Force_Microscope rdf:type owl:Class ;
                              rdfs:subClassOf mo:Scanning_Probe_Microscope ,
                                              [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                       owl:onProperty prov:generated ;
                                                                       owl:someValuesFrom chips:Map
                                                                     ]
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty chips:measured ;
                                                                       owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                            owl:unionOf ( mo:Spannung
                                                                                                          mo:Strom
                                                                                                        )
                                                                                          ]
                                                                     ]
                                                                   ) ;
                                                rdf:type owl:Class
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty prov:wasAssociateFor ;
                                                owl:someValuesFrom chips:Atomic_Force_Microscopy
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty prov:wasAssociateFor ;
                                                owl:someValuesFrom chips:Grand_Challenge_6
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty chips:measured ;
                                                owl:someValuesFrom [ rdf:type owl:Class ;
                                                                     owl:unionOf ( chips:Height
                                                                                   pmdco:Breite
                                                                                   pmdco:Lnge
                                                                                 )
                                                                   ]
                                              ] ;
                              rdfs:label "Atomic Force Microscope"@en ;
                              skos:definition "Atomic Force Microscope (AFM) is a scanning probe microscope that rasters a sharp tip mounted on a cantilever across a surface and measures tip-sample interaction forces to map topography and physical properties at the nanometer scale."@en ;
                              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Atomic_Force_Microscopy
chips:Atomic_Force_Microscopy rdf:type owl:Class ;
                              rdfs:subClassOf mo:Scanning_Probe_Microscopy ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty pmdco:belongsToProject ;
                                                owl:someValuesFrom chips:Grand_Challenge_2
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty pmdco:relates_to ;
                                                owl:someValuesFrom chips:Electromagnetic_Measurement_Process
                                              ] ;
                              rdfs:label "Atomic Force Microscopy"@en ;
                              skos:definition "Atomic Force Microscopy is a scanning probe microscopy technique that maps surface topography and local mechanical, electrical, or magnetic properties by measuring forces between a sharp cantilever tip and the specimen surface with sub-nanometre vertical resolution."@en ;
                              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Atomic_Layer_Deposition
chips:Atomic_Layer_Deposition rdf:type owl:Class ;
                              rdfs:subClassOf chips:Deposition_and_Film_Growth ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty prov:wasAssociatedWith ;
                                                owl:someValuesFrom chips:Atomic_Layer_Deposition_Tool
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty prov:wasInfluencedBy ;
                                                owl:someValuesFrom chips:Plasma
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty prov:wasInformedBy ;
                                                owl:someValuesFrom chips:Plasma_Process
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty pmdco:belongsToProject ;
                                                owl:someValuesFrom [ rdf:type owl:Class ;
                                                                     owl:unionOf ( chips:Grand_Challenge_5
                                                                                 )
                                                                   ]
                                              ] ;
                              rdfs:label "Atomic Layer Deposition"@en ;
                              skos:definition "Atomic Layer Deposition (ALD) is a thin film growth process in which self-limiting surface reactions of alternating precursor pulses deposit material one atomic layer at a time, enabling conformal films of precisely controlled thickness."@en ;
                              pmdco:abbreviation "ALD" ;
                              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Atomic_Layer_Deposition_Tool
chips:Atomic_Layer_Deposition_Tool rdf:type owl:Class ;
                                   rdfs:subClassOf chips:Deposition_Tool ,
                                                   chips:Reaction_Chamber ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty prov:wasAssociateFor ;
                                                     owl:someValuesFrom chips:Atomic_Layer_Deposition
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty prov:wasAssociateFor ;
                                                     owl:someValuesFrom [ rdf:type owl:Class ;
                                                                          owl:unionOf ( chips:Grand_Challenge_2
                                                                                        chips:Grand_Challenge_5
                                                                                      )
                                                                        ]
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty prov:wasInfluencedBy ;
                                                     owl:someValuesFrom [ rdf:type owl:Class ;
                                                                          owl:unionOf ( chips:Ion
                                                                                        chips:Plasma
                                                                                      )
                                                                        ]
                                                   ] ;
                                   rdfs:label "Atomic Layer Deposition Tool"@en ;
                                   skos:definition "Atomic Layer Deposition Tool is a fabrication instrument that alternately exposes a substrate to self-limiting precursor gases separated by purge steps to deposit conformal thin films with atomic-layer thickness control."@en ;
                                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Atomic_Layer_Etching
chips:Atomic_Layer_Etching rdf:type owl:Class ;
                           rdfs:subClassOf chips:Reactive_Ion_Etching ;
                           rdfs:label "Atomic Layer Etching"@en ;
                           skos:definition "Atomic Layer Etching (ALE) is a reactive ion etching process that removes material one atomic layer at a time through self-limiting half-reactions of alternating modification and removal steps, enabling precise sub-nanometer etch control."@en ;
                           pmdco:abbreviation "ALE"@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Atomic_Map
chips:Atomic_Map rdf:type owl:Class ;
                 rdfs:subClassOf chips:Elemental_Map ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty prov:wasGeneratedBy ;
                                   owl:someValuesFrom chips:Atom_Probe_Tomography
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty prov:wasGeneratedBy ;
                                   owl:someValuesFrom chips:Imaging_Process
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty prov:wasGeneratedBy ;
                                   owl:someValuesFrom mo:Spectroscopy
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty pmdco:characteristic ;
                                   owl:someValuesFrom chips:Chemical_Map
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty pmdco:characteristic ;
                                   owl:someValuesFrom chips:Elemental_Map
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty pmdco:characteristic ;
                                   owl:someValuesFrom [ rdf:type owl:Class ;
                                                        owl:unionOf ( <https://w3id.org/CHIPS/metrology-ontology/2D>
                                                                      <https://w3id.org/CHIPS/metrology-ontology/3D>
                                                                    )
                                                      ]
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty pmdco:hasFunction ;
                                   owl:someValuesFrom chips:Input_Data
                                 ] ;
                 rdfs:label "Atomic Map"@en ;
                 skos:definition "An atomic map is an elemental map in which signal intensity represents the position, identity, or electronic state of individual atoms in a material, obtained by atom probe tomography, scanning probe microscopy, or electron microscopy."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Atomistic_Model
chips:Atomistic_Model rdf:type owl:Class ;
                      rdfs:subClassOf chips:Analytical_Model ;
                      rdfs:label "Atomistic Model"@en ;
                      skos:definition "An atomistic model is an analytical model that represents a material or molecular system by explicitly resolving individual atoms and their interactions, using potentials or quantum mechanical methods to predict structure, energy, and dynamics."@en ;
                      pmdco:definitionSource "claude-opus-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Atomistic_Simulation
chips:Atomistic_Simulation rdf:type owl:Class ;
                           rdfs:subClassOf pmdco:Simulationsprozess ,
                                           [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                    owl:onProperty pmdco:belongsToProject ;
                                                                    owl:someValuesFrom chips:Grand_Challenge_5
                                                                  ]
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty pmdco:input_of ;
                                                                    owl:someValuesFrom [ owl:intersectionOf ( chips:Model
                                                                                                              [ rdf:type owl:Restriction ;
                                                                                                                owl:onProperty pmdco:relates_to ;
                                                                                                                owl:someValuesFrom chips:Superfilling
                                                                                                              ]
                                                                                                            ) ;
                                                                                         rdf:type owl:Class
                                                                                       ]
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ;
                           rdfs:label "Atomistic Simulation"@en ;
                           skos:definition "Atomistic Simulation is a computational simulation process that models the behavior of a material or molecule at the level of individual atoms using quantum mechanical or classical interatomic potential methods."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Atomistic_Simulation_Software
chips:Atomistic_Simulation_Software rdf:type owl:Class ;
                                    rdfs:subClassOf chips:Modeling_and_Simulation_Software ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty prov:wasAssociateFor ;
                                                      owl:someValuesFrom chips:Quantum_Chemistry_Model
                                                    ] ;
                                    rdfs:label "Atomistic Simulation Software"@en ;
                                    skos:definition "Atomistic Simulation Software is a software agent that performs quantum mechanical or classical force-field-based calculations on atomic systems to predict structure, energy, and material properties."@en ;
                                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Attempt_Frequency
chips:Attempt_Frequency rdf:type owl:Class ;
                        rdfs:subClassOf chips:Magnetic_Property ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty pmdco:output_of ;
                                          owl:someValuesFrom pmdco:Messprozess
                                        ] ;
                        rdfs:label "Attempt Frequency"@en ;
                        skos:definition "Attempt frequency is a magnetic property characterizing the rate at which a magnetic moment attempts to thermally reverse over an energy barrier in the Arrhenius model of thermally activated switching."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Attenuated_Total_Reflection_Fourier_Transform_Infrared_Spectroscopy
chips:Attenuated_Total_Reflection_Fourier_Transform_Infrared_Spectroscopy rdf:type owl:Class ;
                                                                          rdfs:subClassOf chips:Infrared_Spectroscopy ;
                                                                          rdfs:label "Attenuated Total Reflection Fourier Transform Infrared Spectroscopy"@en ;
                                                                          skos:definition "Attenuated Total Reflection Fourier Transform Infrared Spectroscopy (ATR-FTIR) is a surface-sensitive infrared technique that uses the evanescent wave produced at a total internal reflection interface to probe the molecular composition of thin films, coatings, or liquids in contact with the ATR crystal."@en ;
                                                                          pmdco:abbreviation "ATR-FTIR"@en ;
                                                                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Auburn_University
chips:Auburn_University rdf:type owl:Class ;
                        rdfs:subClassOf chips:Academia ;
                        rdfs:label "Auburn University"@en ;
                        skos:definition "Auburn University is a public research university located in Auburn, Alabama, that conducts research in materials science, electrical engineering, and semiconductor devices."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Automation_Algorithm
chips:Automation_Algorithm rdf:type owl:Class ;
                           rdfs:subClassOf pmdco:Algorithmus ;
                           rdfs:label "Automation Algorithm"@en ;
                           skos:definition "Automation Algorithm is a computational algorithm that executes a defined sequence of operations on data or instruments without human intervention to improve throughput and reproducibility of measurement or data processing workflows."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Automation_Process
chips:Automation_Process rdf:type owl:Class ;
                         rdfs:subClassOf chips:Computational_Process ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty prov:wasInfluencedBy ;
                                           owl:someValuesFrom chips:AI_and_Machine_Learning
                                         ] ;
                         rdfs:label "Automation Process"@en ;
                         skos:definition "Automation Process is a computational process that executes a sequence of operations or workflows with minimal human intervention, using scripts, robots, or control software to improve throughput and reproducibility."@en ;
                         pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Autosampler
chips:Autosampler rdf:type owl:Class ;
                  rdfs:subClassOf chips:Positioning_Device ;
                  rdfs:label "Autosampler"@en ;
                  skos:definition "Autosampler is a positioning device that automatically introduces a sequence of specimens or solutions into an analytical instrument without manual intervention, improving throughput and reproducibility."@en ;
                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Ayar_Labs
chips:Ayar_Labs rdf:type owl:Class ;
                rdfs:subClassOf pmdco:Hersteller ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty prov:generated ;
                                  owl:someValuesFrom chips:Photonics_Technology
                                ] ;
                rdfs:label "Ayar Labs"@en ;
                skos:definition "Ayar Labs is a photonics company that develops optical interconnect chiplets using silicon photonics to replace electrical I/O in high-bandwidth computing and data center applications."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Backendofline_Process
chips:Backendofline_Process rdf:type owl:Class ;
                            rdfs:subClassOf chips:Semiconductor_Manufacturing_Process ;
                            rdfs:label "Back-end-of-line Process"@en ;
                            skos:definition "Back-End-of-Line (BEOL) Process is a semiconductor manufacturing process sequence that forms the multilevel metal interconnect structure and interlayer dielectrics above the transistor layer to electrically connect circuit elements."@en ;
                            pmdco:abbreviation "BEOL"@en ;
                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Balanced_Circular_Disk_Resonator
chips:Balanced_Circular_Disk_Resonator rdf:type owl:Class ;
                                       rdfs:subClassOf chips:Cavity_and_Resonator ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty prov:wasAssociateFor ;
                                                         owl:someValuesFrom chips:Balanced_Circular_Disk_Resonator_Measurement
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty prov:wasAssociateFor ;
                                                         owl:someValuesFrom chips:Grand_Challenge_3
                                                       ] ;
                                       rdfs:label "Balanced Circular Disk Resonator"@en ;
                                       skos:definition "Balanced Circular Disk Resonator is a microwave resonant structure comprising a circular dielectric or metallic disk operated in a balanced configuration to measure the complex permittivity of materials at microwave frequencies."@en ;
                                       pmdco:abbreviation "BCDR" ;
                                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Balanced_Circular_Disk_Resonator_Measurement
chips:Balanced_Circular_Disk_Resonator_Measurement rdf:type owl:Class ;
                                                   rdfs:subClassOf chips:Resonator_Measurements ,
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty prov:generatedAsDerivation ;
                                                                     owl:someValuesFrom chips:Permittivity
                                                                   ] ,
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty prov:wasAssociatedWith ;
                                                                     owl:someValuesFrom chips:Balanced_Circular_Disk_Resonator
                                                                   ] ,
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty pmdco:belongsToProject ;
                                                                     owl:someValuesFrom chips:Grand_Challenge_3
                                                                   ] ;
                                                   rdfs:label "Balanced Circular Disk Resonator Measurement"@en ;
                                                   skos:definition "Balanced Circular Disk Resonator Measurement is a microwave resonator measurement in which a dielectric specimen is placed in a balanced circular disk resonator and the shift in resonant frequency and Q-factor is used to extract complex permittivity."@en ;
                                                   pmdco:abbreviation "BCDR Mesaurement" ;
                                                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Band_Diagram
chips:Band_Diagram rdf:type owl:Class ;
                   rdfs:subClassOf chips:Computational_Data ,
                                   chips:Plot ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty pmdco:characteristic ;
                                     owl:someValuesFrom chips:Computational_Data
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty pmdco:characteristic ;
                                     owl:someValuesFrom chips:Measurand
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty pmdco:characteristic_of ;
                                     owl:someValuesFrom chips:Electromagnetic_Property
                                   ] ;
                   rdfs:label "Band Diagram"@en ;
                   skos:definition "A band diagram is a graphical representation of the allowed electron energy levels as a function of position in a semiconductor device, showing conduction and valence bands, Fermi level, and band bending."@en ;
                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Band_Offset
chips:Band_Offset rdf:type owl:Class ;
                  rdfs:subClassOf chips:Electric_Property ,
                                  chips:Physical_Property ;
                  rdfs:label "Band Offset"@en ;
                  skos:definition "Band offset is the discontinuity in the conduction band (CBO) or valence band (VBO) energy at a semiconductor heterojunction interface, determining carrier confinement and device band alignment."@en ;
                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Bandgap
chips:Bandgap rdf:type owl:Class ;
              rdfs:subClassOf chips:Electric_Property ,
                              chips:Physical_Property ,
                              pmdco:Materialeigenschaft ;
              rdfs:label "Bandgap"@en ;
              skos:definition "Bandgap is the energy difference between the top of the valence band and the bottom of the conduction band in a semiconductor or insulator, determining its optical absorption edge and intrinsic carrier concentration."@en ;
              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Bandwidth
chips:Bandwidth rdf:type owl:Class ;
                rdfs:subClassOf chips:Distribution ;
                rdfs:label "Bandwidth"@en ;
                skos:definition "Bandwidth is a measure of the range of frequencies or wavelengths over which a signal, instrument, or system can operate effectively, typically defined as the interval between the upper and lower frequency bounds at half-power (-3 dB)."@en ;
                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Bayesian_Analysis
chips:Bayesian_Analysis rdf:type owl:Class ;
                        rdfs:subClassOf chips:Statistical_Analysis ;
                        rdfs:label "Bayesian Analysis"@en ;
                        skos:definition "Bayesian Analysis is a statistical analysis method that applies Bayes' theorem to update the probability distribution of model parameters given observed data, combining prior knowledge with the likelihood of the data."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Beamformation_Process
chips:Beamformation_Process rdf:type owl:Class ;
                            rdfs:subClassOf mo:Physikalischer_Prozess ;
                            rdfs:label "Beam-formation Process"@en ;
                            skos:definition "Beam Formation Process is a physical process that shapes, selects, or polarizes a radiation beam—such as X-rays, neutrons, or electrons—to prepare it for a specific measurement or experiment."@en ;
                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Beamline
chips:Beamline rdf:type owl:Class ;
               rdfs:subClassOf mo:Source ;
               rdfs:label "Beamline"@en ;
               skos:definition "A beamline is a specialized experimental station at a synchrotron or neutron facility that directs radiation from the source to experimental end-stations equipped for specific measurement techniques such as X-ray diffraction or spectroscopy."@en ;
               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Beamline_1A
chips:Beamline_1A rdf:type owl:Class ;
