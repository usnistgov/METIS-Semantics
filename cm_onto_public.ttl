              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Robomet
chips:Robomet rdf:type owl:Class ;
              rdfs:subClassOf chips:Polisher ,
                              chips:Sectioning_Instrument ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty prov:wasAssociateFor ;
                                owl:someValuesFrom chips:Serial_Sectioning
                              ] ;
              rdfs:label "Robomet"@en ;
              skos:definition "Robomet is an automated robotic polishing and metallographic specimen preparation instrument that sequentially grinds, polishes, and images material cross-sections for serial sectioning and three-dimensional microstructure reconstruction."@en ;
              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Robotic_Agent
chips:Robotic_Agent rdf:type owl:Class ;
