                                                                            chips:University_of_Missouri
                                                                            chips:University_of_Texas_Austin
                                                                          )
                                                            ]
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty prov:hadDelegate ;
                                         owl:someValuesFrom chips:Neutron_Source
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty pmdco:characteristic ;
                                         owl:someValuesFrom [ rdf:type owl:Class ;
                                                              owl:unionOf ( chips:Neutron
                                                                            chips:Neutron_Beam
                                                                          )
                                                            ]
                                       ] ;
                       rdfs:label "Neutron Facility"@en ;
                       skos:definition "A neutron facility is a research facility that operates neutron sources such as reactors or spallation sources to provide neutron beams for materials characterization, including neutron diffraction and reflectometry."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Neutron_Reflectivity
