                                   rdfs:label "Electronic Design Automation"@en ;
                                   skos:definition "Electronic Design Automation (EDA) is a software agent that supports the design, simulation, verification, and layout of integrated circuits and electronic systems."@en ;
                                   pmdco:abbreviation "EDA"@en ;
                                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Electronic_Lab_Notebook
chips:Electronic_Lab_Notebook rdf:type owl:Class ;
                              rdfs:subClassOf prov:Software_Agent ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty prov:wasAssociateFor ;
                                                owl:someValuesFrom chips:Grand_Challenge_2
                                              ] ;
                              rdfs:label "Electronic Lab Notebook"@en ;
