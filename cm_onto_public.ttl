                         pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Computational_Fluid_Dynamics
chips:Computational_Fluid_Dynamics rdf:type owl:Class ;
                                   rdfs:subClassOf chips:Continuum_Simulation ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty prov:wasAssociatedWith ;
                                                     owl:someValuesFrom chips:Computational_Fluid_Dynamics_Module
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty pmdco:output ;
                                                     owl:someValuesFrom [ rdf:type owl:Class ;
                                                                          owl:unionOf ( [ owl:intersectionOf ( chips:Density
                                                                                                               [ rdf:type owl:Class ;
                                                                                                                 owl:unionOf ( chips:Electron
                                                                                                                               chips:Ion
                                                                                                                             )
                                                                                                               ]
                                                                                                               [ rdf:type owl:Restriction ;
                                                                                                                 owl:onProperty prov:wasAssociatedWith ;
                                                                                                                 owl:someValuesFrom chips:Plasma
                                                                                                               ]
                                                                                                             ) ;
                                                                                          rdf:type owl:Class
                                                                                        ]
                                                                                        [ owl:intersectionOf ( chips:Parameter
                                                                                                               [ rdf:type owl:Restriction ;
                                                                                                                 owl:onProperty prov:wasAssociatedWith ;
                                                                                                                 owl:someValuesFrom chips:Etch_Process
                                                                                                               ]
                                                                                                             ) ;
                                                                                          rdf:type owl:Class
                                                                                        ]
                                                                                      )
                                                                        ]
                                                   ] ;
                                   rdfs:label "Computational Fluid Dynamics"@en ;
                                   skos:definition "Computational Fluid Dynamics (CFD) is a continuum simulation method that numerically solves the governing equations of fluid flow, heat transfer, and mass transport over discretized spatial domains."@en ;
                                   pmdco:abbreviation "CFD"@en ;
                                   pmdco:definitionSource "claude-sonnet-4-6"@en .


