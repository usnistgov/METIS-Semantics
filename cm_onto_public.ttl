                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Decay_Time
chips:Decay_Time rdf:type owl:Class ;
                 rdfs:subClassOf pmdco:Zeit ,
                                 [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                          owl:onProperty prov:wasGeneratedBy ;
                                                          owl:someValuesFrom chips:Grand_Challenge_1
                                                        ]
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty pmdco:characteristic ;
                                                          owl:someValuesFrom chips:Derived_Data
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ;
                 rdfs:label "Decay Time"@en ;
                 skos:definition "Decay time is the characteristic time constant over which an excited state, signal amplitude, or concentration decays exponentially to 1/e of its initial value."@en ;
                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Decommission_Time
chips:Decommission_Time rdf:type owl:Class ;
                        rdfs:subClassOf pmdco:Endzeit ;
                        rdfs:label "Decommission Time"@en ;
                        skos:definition "Decommission time is the date or time at which an instrument, component, or dataset is retired from active service and removed from the inventory of operational resources."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Deep_Level_Optical_Spectroscopy
chips:Deep_Level_Optical_Spectroscopy rdf:type owl:Class ;
                                      rdfs:subClassOf chips:Optical_Spectroscopy ;
                                      rdfs:label "Deep Level Optical Spectroscopy"@en ;
                                      skos:definition "Deep Level Optical Spectroscopy (DLOS) is an optical spectroscopy technique that probes deep-level defect states in wide-bandgap semiconductors by measuring the optical excitation spectrum of thermally stimulated capacitance or current transients."@en ;
                                      pmdco:abbreviation "DLOS" ;
                                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Deep_Level_Optical_Spectroscopy_Image
chips:Deep_Level_Optical_Spectroscopy_Image rdf:type owl:Class ;
                                            rdfs:subClassOf pmdco:Bild ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty prov:wasGeneratedBy ;
                                                              owl:someValuesFrom chips:Deep_Level_Optical_Spectroscopy
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty pmdco:characteristic ;
                                                              owl:someValuesFrom chips:Higher_Dimensions
                                                            ] ;
                                            rdfs:label "Deep Level Optical Spectroscopy Image"@en ;
                                            skos:definition "A deep level optical spectroscopy (DLOS) image is a spatially resolved map of optical transitions associated with deep-level defects in a semiconductor, obtained by scanning optical spectroscopy."@en ;
                                            pmdco:abbreviation "DLOS Image"@en ;
                                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Deep_Level_Thermal_Spectroscopy
chips:Deep_Level_Thermal_Spectroscopy rdf:type owl:Class ;
                                      rdfs:subClassOf chips:Thermal_Spectroscopy ;
                                      rdfs:label "Deep Level Thermal Spectroscopy"@en ;
                                      skos:definition "Deep Level Transient Spectroscopy (DLTS) is a thermal spectroscopy technique that measures capacitance or current transients in a semiconductor junction as a function of temperature to identify the energy levels, capture cross sections, and concentrations of electrically active deep-level defects."@en ;
                                      pmdco:abbreviation "DLTS" ;
                                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Deep_Neural_Network
chips:Deep_Neural_Network rdf:type owl:Class ;
                          rdfs:subClassOf chips:Neural_Network ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty pmdco:executed_by ;
                                            owl:someValuesFrom chips:Grand_Challenge_4
                                          ] ;
                          rdfs:label "Deep Neural Network"@en ;
                          skos:definition "Deep Neural Network (DNN) is a neural network architecture with many hidden layers that learns hierarchical representations of data, enabling high-accuracy classification, regression, and generative modeling."@en ;
                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Deep_Reactive_Ion_Etch_Tool
chips:Deep_Reactive_Ion_Etch_Tool rdf:type owl:Class ;
                                  rdfs:subClassOf chips:Reactive_Ion_Etch_Tool ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty prov:wasAssociateFor ;
                                                    owl:someValuesFrom chips:Deep_Reactive_Ion_Etching
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty prov:wasAssociateFor ;
                                                    owl:someValuesFrom chips:Grand_Challenge_5
                                                  ] ;
                                  rdfs:label "Deep Reactive Ion Etch Tool"@en ;
                                  skos:definition "Deep Reactive Ion Etch Tool is a reactive ion etch instrument that uses alternating etch and passivation cycles (Bosch process) or cryogenic conditions to etch deep, high-aspect-ratio structures in silicon."@en ;
                                  pmdco:abbreviation "DRIE Tool" ;
                                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Deep_Reactive_Ion_Etching
chips:Deep_Reactive_Ion_Etching rdf:type owl:Class ;
                                rdfs:subClassOf chips:Reactive_Ion_Etching ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty prov:used ;
                                                  owl:someValuesFrom [ owl:intersectionOf ( chips:Void
                                                                                            [ rdf:type owl:Restriction ;
                                                                                              owl:onProperty pmdco:relates_to ;
                                                                                              owl:someValuesFrom [ owl:intersectionOf ( chips:Grand_Challenge_3
                                                                                                                                        pmdco:Probe
                                                                                                                                      ) ;
                                                                                                                   rdf:type owl:Class
                                                                                                                 ]
                                                                                            ]
                                                                                          ) ;
                                                                       rdf:type owl:Class
                                                                     ]
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty prov:wasAssociatedWith ;
                                                  owl:someValuesFrom chips:Deep_Reactive_Ion_Etch_Tool
                                                ] ;
                                rdfs:label "Deep Reactive Ion Etching"@en ;
                                skos:definition "Deep Reactive Ion Etching (DRIE) is a reactive ion etch process that combines alternating etch and sidewall passivation cycles to produce deep trenches and vias with high aspect ratios and near-vertical sidewalls in silicon."@en ;
                                pmdco:abbreviation "DRIE"@en ;
                                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Defect
chips:Defect rdf:type owl:Class ;
             rdfs:subClassOf pmdco:Materialstruktur ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty prov:influenced ;
                               owl:someValuesFrom pmdco:Materialeigenschaft
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty pmdco:output_of ;
                               owl:someValuesFrom chips:Identification_Process
                             ] ;
             rdfs:label "Defect"@en ;
             skos:definition "A defect is any deviation from the ideal atomic arrangement, composition, or geometry of a material or device structure that can adversely affect electrical, mechanical, or optical performance."@en ;
             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Defect_Concentration
chips:Defect_Concentration rdf:type owl:Class ;
                           rdfs:subClassOf pmdco:Materialeigenschaft ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty prov:influenced ;
                                             owl:someValuesFrom chips:Electromagnetic_Property
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty pmdco:characteristic ;
                                             owl:someValuesFrom chips:Defect
                                           ] ;
                           rdfs:label "Defect Concentration"@en ;
                           skos:definition "Defect concentration is the number of crystallographic or chemical defects per unit volume in a material, governing carrier lifetime, trap-mediated transport, and electromigration in semiconductor devices."@en ;
                           pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Defect_Density
chips:Defect_Density rdf:type owl:Class ;
                     rdfs:subClassOf pmdco:Materialeigenschaft ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty pmdco:characteristic ;
                                       owl:someValuesFrom chips:Defect
                                     ] ;
                     rdfs:label "Defect Density"@en ;
                     skos:definition "Defect density is a measure of the number of crystallographic defects per unit area or volume in a material, used as a key figure of merit for semiconductor substrate and epitaxial layer quality."@en ;
                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Defect_Levels
chips:Defect_Levels rdf:type owl:Class ;
                    rdfs:subClassOf chips:Electromagnetic_Property ,
                                    [ rdf:type owl:Class ;
                                      owl:unionOf ( [ rdf:type owl:Restriction ;
                                                      owl:onProperty chips:calculatedBy ;
                                                      owl:someValuesFrom chips:Computational_Process
                                                    ]
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty chips:measuredBy ;
                                                      owl:someValuesFrom pmdco:Messprozess
                                                    ]
                                                  )
                                    ] ;
                    rdfs:label "Defect Levels"@en ;
                    skos:definition "Defect levels are discrete electronic energy states within the bandgap of a semiconductor introduced by crystallographic defects, dopants, or impurities that act as generation-recombination centers or traps."@en ;
                    pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Defect_Location_Map
chips:Defect_Location_Map rdf:type owl:Class ;
                          rdfs:subClassOf chips:Map ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty pmdco:characteristic ;
                                            owl:someValuesFrom [ owl:intersectionOf ( chips:Defect
                                                                                      [ rdf:type owl:Restriction ;
                                                                                        owl:onProperty pmdco:characteristic ;
                                                                                        owl:someValuesFrom prov:Location
                                                                                      ]
                                                                                    ) ;
                                                                 rdf:type owl:Class
                                                               ]
                                          ] ;
                          rdfs:label "Defect Location Map"@en ;
                          skos:definition "Defect Location Map is a spatially resolved image that identifies and localizes defects, inclusions, or anomalies within a material or device, compiled from imaging or scattering measurements."@en ;
                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Defense_Advanced_Research_Projects_Agency
chips:Defense_Advanced_Research_Projects_Agency rdf:type owl:Class ;
                                                rdfs:subClassOf chips:Department_of_Defense ;
                                                rdfs:label "Defense Advanced Research Projects Agency"@en ;
                                                skos:definition "The Defense Advanced Research Projects Agency (DARPA) is a U.S. Department of Defense research agency that invests in breakthrough technologies including electronics, photonics, quantum computing, and semiconductor manufacturing."@en ;
                                                pmdco:abbreviation "DARPA"@en ;
                                                pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Degradation_Model
chips:Degradation_Model rdf:type owl:Class ;
                        rdfs:subClassOf chips:Analytical_Model ,
                                        [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                 owl:onProperty pmdco:output_of ;
                                                                 owl:someValuesFrom chips:Grand_Challenge_5
                                                               ]
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty pmdco:relates_to ;
                                                                 owl:someValuesFrom [ owl:intersectionOf ( chips:Power_Device
                                                                                                           chips:Reliability
