                                                        owl:onProperty pmdco:characteristic ;
                                                        owl:someValuesFrom chips:Xray
                                                      ] ;
                                      rdfs:label "X-ray Computed Tomography System"@en ;
                                      skos:definition "X-ray Computed Tomography System is an imaging instrument that acquires multiple X-ray projection images of a specimen from different angles and reconstructs a three-dimensional volumetric image of its internal structure."@en ;
                                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Xray_Diffraction_Data
chips:Xray_Diffraction_Data rdf:type owl:Class ;
                            rdfs:subClassOf mo:Diffraction_Pattern ;
                            rdfs:label "X-ray Diffraction Data"@en ;
                            skos:definition "X-ray diffraction data is a dataset of diffracted X-ray intensity as a function of scattering angle or momentum transfer, used to determine crystal structure, phase, and strain."@en ;
                            pmdco:abbreviation "XRD Data"@en ;
                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Xray_Diffractometer
chips:Xray_Diffractometer rdf:type owl:Class ;
                          rdfs:subClassOf chips:Scattering_Instrument ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty prov:generated ;
                                            owl:someValuesFrom chips:Xray_Diffraction_Data
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty prov:wasAssociateFor ;
                                            owl:someValuesFrom mo:Xray_Diffraction
                                          ] ;
                          rdfs:label "X-ray Diffractometer"@en ;
                          skos:definition "X-ray Diffractometer is a scattering instrument that directs a monochromatic X-ray beam at a specimen and measures the angular distribution of diffracted intensity to determine crystalline phase, lattice parameters, and texture."@en ;
                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Xray_Fluorescence_Instrument
chips:Xray_Fluorescence_Instrument rdf:type owl:Class ;
                                   rdfs:subClassOf chips:Luminescence_Measuring_Instrument ,
                                                   chips:Optical_Measuring_Device ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty prov:wasAssociateFor ;
                                                     owl:someValuesFrom chips:Fluorescence
                                                   ] ;
                                   rdfs:label "X-ray Fluorescence Instrument"@en ;
                                   skos:definition "X-ray Fluorescence Instrument is a luminescence measurement device that irradiates a specimen with primary X-rays to excite characteristic secondary X-ray fluorescence from its constituent elements, enabling non-destructive elemental analysis."@en ;
                                   pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Xray_Fluorescence_Spectroscopy
chips:Xray_Fluorescence_Spectroscopy rdf:type owl:Class ;
