                                              pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Superconducting_Quantum_Interference_Device
chips:Superconducting_Quantum_Interference_Device rdf:type owl:Class ;
                                                  rdfs:subClassOf chips:Magnetometer ,
