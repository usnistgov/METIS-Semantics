                                          owl:onProperty pmdco:belongsToProject ;
                                          owl:someValuesFrom chips:Grand_Challenge_1
                                        ] ;
                        rdfs:label "Chelating Ligands"@en ;
                        skos:definition "Chelating Ligands are surface-functionalized molecular agents bearing multiple donor groups that form stable multi-dentate complexes with target metal ions to enable selective capture and preconcentration from dilute solutions."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Chemical_Change
chips:Chemical_Change rdf:type owl:Class ;
                      rdfs:subClassOf chips:Chemical_Property ,
                                      [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                               owl:onProperty prov:wasGeneratedBy ;
                                                               owl:someValuesFrom chips:Rate_Of_Change_Process
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty pmdco:relates_to ;
                                                               owl:someValuesFrom chips:Chemistry
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                      rdfs:label "Chemical Change"@en ;
                      skos:definition "Chemical change is a process in which substances are transformed into chemically different substances through the breaking and formation of chemical bonds."@en ;
                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Chemical_Conversion
chips:Chemical_Conversion rdf:type owl:Class ;
                          rdfs:subClassOf chips:Reaction_Kinetics ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty chips:measuredBy ;
                                            owl:someValuesFrom chips:Infrared_Spectroscopy
                                          ] ;
                          rdfs:label "Chemical Conversion"@en ;
                          skos:definition "Chemical Conversion is the fractional extent to which a reactant is consumed in a chemical reaction, expressed as the ratio of moles reacted to initial moles of reactant."@en ;
                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Chemical_Element
chips:Chemical_Element rdf:type owl:Class ;
                       rdfs:subClassOf obo:Chemical_Entity ;
                       rdfs:label "Chemical Element"@en ;
                       skos:definition "A chemical element is a pure substance consisting of atoms that all have the same number of protons, which cannot be decomposed into simpler substances by chemical means."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Chemical_Map
chips:Chemical_Map rdf:type owl:Class ;
                   rdfs:subClassOf chips:Composition_Map ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty prov:wasGeneratedBy ;
                                     owl:someValuesFrom chips:Imaging_Process
