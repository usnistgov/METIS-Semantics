                                                   owl:someValuesFrom chips:Adhesion
                                                 ] ;
                                 rdfs:label "Single-cantilever Beam Test"@en ;
                                 skos:definition "Single-Cantilever Beam Test is a mechanical testing method in which a layered specimen clamped at one end is loaded at the free end to measure interfacial adhesion fracture energy."@en ;
                                 pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Sintering
chips:Sintering rdf:type owl:Class ;
