                                                         pmdco:Optische_Mikroskopie ;
                                         rdfs:label "Super-resolution Optical Microscopy"@en ;
                                         skos:definition "Super-Resolution Optical Microscopy is a surface characterization technique that surpasses the optical diffraction limit using methods such as STORM, PALM, or STED to image biological and materials structures at the nanometer scale."@en ;
                                         pmdco:definitionSource "claude-sonnet-4-6"@en .


