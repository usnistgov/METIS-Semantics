###  https://w3id.org/CHIPS/metrology-ontology/Scattering_Parameter
chips:Scattering_Parameter rdf:type owl:Class ;
                           rdfs:subClassOf chips:Electromagnetic_Property ,
                                           chips:Parameter ,
                                           [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                    owl:onProperty chips:hasImaginaryPart ;
                                                                    owl:someValuesFrom xsd:float
                                                                  ]
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty chips:hasRealPart ;
                                                                    owl:someValuesFrom xsd:float
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ,
                                           [ rdf:type owl:Class ;
                                             owl:unionOf ( [ rdf:type owl:Restriction ;
                                                             owl:onProperty chips:calculatedBy ;
                                                             owl:someValuesFrom chips:Computational_Process
                                                           ]
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty chips:measuredBy ;
                                                             owl:someValuesFrom pmdco:Messprozess
                                                           ]
                                                         )
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty chips:measuredBy ;
                                             owl:someValuesFrom chips:Vector_Network_Analyzer
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty pmdco:characteristic ;
                                             owl:someValuesFrom chips:Electromagnetic_Property
                                           ] ;
                           rdfs:label "Scattering Parameter"@en ;
                           skos:altLabel "S-Parameters"@en ;
                           skos:definition """Scattering parameters are electrical measurements that
-    Characterize the electrical behavior of linear electrical networks
-    Represent how radio frequency (RF) signals are transmitted and reflected through the network
-    Are used in the analysis and design of high-frequency circuits and systems."""@en ;
                           pmdco:definitionSource "CVCS 0.0.7"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Scatterometry
