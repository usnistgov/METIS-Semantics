                             skos:definition "Signal Processing Node is an electronic instrument that conditions, transforms, amplifies, attenuates, or converts signals between different representations within a measurement or communication chain."@en ;
                             pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Signal_to_Noise_Ratio
chips:Signal_to_Noise_Ratio rdf:type owl:Class ;
                            rdfs:subClassOf chips:Detection_Property ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty chips:hasMathematicalRelationshipWith ;
                                              owl:someValuesFrom chips:Noise
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty chips:measuredBy ;
                                              owl:someValuesFrom pmdco:Messprozess
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty pmdco:characteristic_of ;
                                              owl:someValuesFrom pmdco:Messwert
                                            ] ;
                            rdfs:label "Signal to Noise Ratio"@en ;
                            skos:definition "Signal-to-Noise Ratio (SNR) is a dimensionless metric comparing the amplitude or power of a desired signal to the background noise level, used to quantify the quality and detection capability of a measurement system."@en ;
                            pmdco:abbreviation "SNR"@en ;
                            pmdco:definitionSource "claude-sonnet-4-6"@en .


