                  rdfs:label "Algorithm"@en ,
                             "Algorithmus"@de ;
                  skos:definition "A procedure for solving a mathematical problem (as of finding the greatest common divisor) in a finite number of steps that frequently involves repetition of an operation."@en ;
                  pmdco:definitionSource "“Algorithm.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/algorithm. Accessed 24 Nov. 2022."@en .


###  https://w3id.org/pmd/co/Alterungsintervall
pmdco:Alterungsintervall rdf:type owl:Class ;
                         rdfs:subClassOf pmdco:Alterungszeit ;
                         rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                         rdfs:label "Aging Interval"@en ,
                                    "Alterungsintervall"@de ;
                         skos:definition "Timespan a Temperature during  an Aging Process is hold."@en .


###  https://w3id.org/pmd/co/Alterungsprozess
pmdco:Alterungsprozess rdf:type owl:Class ;
                       rdfs:subClassOf chips:Timedependent_Process ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty chips:measured ;
                                         owl:someValuesFrom chips:Reliability
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty chips:measured ;
                                         owl:someValuesFrom chips:Stability
                                       ] ;
                       rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                       rdfs:label "Aging Process"@en ,
                                  "Alterungsprozess"@de ;
                       skos:definition "A process that applies a method that causes a constituent to precipitate from solid solution."@en ,
                                       "Das Aging oder Auslagern ist ein Anlassvorgang, der den Martensit (Härtungsgefüge) wieder duktil und verformbar macht. Dabei wird ein Agingvorgang genutzt, nämlich die Bildung von Ausscheidungen in Form von FeXCY - Carbiden"@de ;
                       skos:example "The Process of austenitizing and quenching a steel alloy to achieve a martensitic microstructure for hardness increase."@en .


###  https://w3id.org/pmd/co/Alterungstemperatur
pmdco:Alterungstemperatur rdf:type owl:Class ;
