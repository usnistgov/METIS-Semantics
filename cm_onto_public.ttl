                                    owl:onProperty prov:wasAssociateFor ;
                                    owl:someValuesFrom chips:Spin_Coating
                                  ] ;
                  rdfs:label "Spin Coater"@en ;
                  skos:definition "Spin Coater is a fabrication instrument that deposits a uniform thin film by dispensing a liquid solution onto a rotating substrate, spreading the liquid by centrifugal force to achieve controlled film thickness."@en ;
                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Spin_Coating
chips:Spin_Coating rdf:type owl:Class ;
