###  https://w3id.org/CHIPS/metrology-ontology/Mass_Flow_Process
chips:Mass_Flow_Process rdf:type owl:Class ;
                        rdfs:subClassOf chips:Mass_Transport_Process ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty prov:used ;
                                          owl:someValuesFrom [ rdf:type owl:Class ;
