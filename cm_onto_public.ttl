                                      pmdco:abbreviation "NVD"@en ;
                                      pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/NearAmbientPressure_Xray_Photoelectron_Spectroscopy
chips:NearAmbientPressure_Xray_Photoelectron_Spectroscopy rdf:type owl:Class ;
                                                          rdfs:subClassOf mo:Xray_Photoelectron_Spectroscopy ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty pmdco:belongsToProject ;
                                                                            owl:someValuesFrom chips:Grand_Challenge_5
                                                                          ] ;
                                                          rdfs:label "Near-Ambient-Pressure X-ray Photoelectron Spectroscopy"@en ;
                                                          skos:definition "Near-Ambient Pressure X-ray Photoelectron Spectroscopy (NAP-XPS) is an XPS technique that extends the operating pressure range of conventional XPS toward ambient conditions to enable in situ characterization of solid-gas and solid-liquid interfaces."@en ;
                                                          pmdco:abbreviation "NAP XPS"@en ;
                                                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Near_Xray_Absorption_Fine_Structure_Process
chips:Near_Xray_Absorption_Fine_Structure_Process rdf:type owl:Class ;
                                                  rdfs:subClassOf chips:Xray_Absorption ;
                                                  rdfs:label "Near X-ray Absorption Fine Structure Process"@en ;
                                                  skos:definition "Near-Edge X-ray Absorption Fine Structure (NEXAFS/XANES) is a synchrotron X-ray technique that measures the absorption spectrum near a core-level edge to probe unoccupied electronic states, oxidation state, and local bonding geometry."@en ;
                                                  pmdco:abbreviation "NEXAFS" ;
                                                  pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Nearfield_Scanning_Optical_Microscopy
chips:Nearfield_Scanning_Optical_Microscopy rdf:type owl:Class ;
                                            rdfs:subClassOf chips:Surface_Characterization_Process ,
                                                            pmdco:Optische_Mikroskopie ,
                                                            mo:Scanning_Probe_Microscopy ;
                                            rdfs:label "Near-field Scanning Optical Microscopy"@en ;
                                            skos:definition "Near-Field Scanning Optical Microscopy (NSOM/SNOM) is a surface characterization technique that collects or illuminates with light through a sub-wavelength aperture or tip held in the optical near-field of a specimen, achieving spatial resolution beyond the diffraction limit."@en ;
                                            pmdco:abbreviation "SNOM"@en ;
                                            pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Nearinfrared
chips:Nearinfrared rdf:type owl:Class ;
                   rdfs:subClassOf chips:Electromagnetic_Spectrum ;
                   rdfs:label "Near-infrared"@en ;
                   skos:definition "Near-Infrared is a spectral region of the electromagnetic spectrum spanning approximately 0.75 to 2.5 micrometers in wavelength, used in spectroscopy, remote sensing, and optical communications."@en ;
