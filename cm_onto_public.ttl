###  https://w3id.org/pmd/mo/SekundrionenMassenspektrometrie
mo:SekundrionenMassenspektrometrie rdf:type owl:Class ;
                                   rdfs:subClassOf chips:Mass_Spectrometry ,
                                                   chips:Profiling_Process ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty prov:wasAssociatedWith ;
                                                     owl:someValuesFrom chips:Secondary_Ion_Mass_Spectrometer
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty chips:measured ;
                                                     owl:someValuesFrom [ owl:intersectionOf ( chips:Assay
                                                                                               [ rdf:type owl:Restriction ;
                                                                                                 owl:onProperty pmdco:characteristic ;
                                                                                                 owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                                                      owl:unionOf ( chips:Impurity
                                                                                                                                    chips:Purity
                                                                                                                                  )
                                                                                                                    ]
                                                                                               ]
                                                                                             ) ;
                                                                          rdf:type owl:Class
                                                                        ]
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty chips:measured ;
                                                     owl:someValuesFrom [ owl:intersectionOf ( chips:Intensity
                                                                                               [ rdf:type owl:Restriction ;
                                                                                                 owl:onProperty prov:wasInfluencedBy ;
                                                                                                 owl:someValuesFrom [ owl:intersectionOf ( chips:Independent_Variable
                                                                                                                                           [ rdf:type owl:Restriction ;
                                                                                                                                             owl:onProperty pmdco:characteristic ;
                                                                                                                                             owl:someValuesFrom chips:Mass
                                                                                                                                           ]
                                                                                                                                         ) ;
                                                                                                                      rdf:type owl:Class
                                                                                                                    ]
                                                                                               ]
                                                                                             ) ;
                                                                          rdf:type owl:Class
                                                                        ]
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty chips:measured ;
                                                     owl:someValuesFrom [ rdf:type owl:Class ;
                                                                          owl:unionOf ( chips:Contaminant_Identification
                                                                                        chips:Element_Identification
                                                                                        chips:Elemental_Map
                                                                                      )
                                                                        ]
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty pmdco:belongsToProject ;
                                                     owl:someValuesFrom [ rdf:type owl:Class ;
                                                                          owl:unionOf ( chips:Grand_Challenge_1
                                                                                        chips:Grand_Challenge_6
                                                                                      )
                                                                        ]
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty pmdco:output ;
                                                     owl:someValuesFrom [ owl:intersectionOf ( chips:Spectrum
                                                                                               [ rdf:type owl:Restriction ;
                                                                                                 owl:onProperty pmdco:characteristic_of ;
                                                                                                 owl:someValuesFrom [ owl:intersectionOf ( <https://w3id.org/CHIPS/metrology-ontology/1D>
                                                                                                                                           <https://w3id.org/CHIPS/metrology-ontology/2D>
                                                                                                                                         ) ;
                                                                                                                      rdf:type owl:Class
                                                                                                                    ]
                                                                                               ]
                                                                                             ) ;
                                                                          rdf:type owl:Class
                                                                        ]
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty pmdco:relates_to ;
                                                     owl:someValuesFrom chips:Surface_Characterization_Process
                                                   ] ;
                                   rdfs:isDefinedBy <https://w3id.org/pmd/mo> ;
                                   rdfs:label "Secondary Ion Mass Spectrometry"@en ,
                                              "Sekundärionen-Massenspektrometrie"@de ;
                                   skos:definition """Secondary Ion Mass Spectrometry (SIMS) is an advanced analytical technique used to determine the elemental and isotopic composition of solid surfaces and thin films at a very high sensitivity and spatial resolution. It is widely employed in various scientific and industrial applications, including materials science, semiconductor research, and surface analysis.
In SIMS, a focused beam of high-energy primary ions is directed at a sample's surface. The impact of these primary ions causes the ejection of secondary ions from the sample's surface. These secondary ions are then extracted, mass-separated, and detected using a mass spectrometer. The mass spectrometer measures the mass-to-charge ratios of the secondary ions, providing information about the elemental and isotopic composition of the sample.
The sensitivity and spatial resolution of SIMS allow researchers to analyze very small areas, often down to the micrometer or nanometer scale. This makes SIMS particularly valuable for investigating surface composition, depth profiling of layered structures, and detecting trace elements in complex materials. The technique is non-destructive in its elemental analysis, which is beneficial for studying delicate samples or preserving valuable materials.
SIMS has applications in diverse fields, including materials characterization, semiconductor device analysis, biological and medical research, and geological studies. It provides essential information about the chemical composition, structure, and distribution of elements in complex samples, contributing to advancements in materials science and various technological developments."""@en ;
                                   pmdco:definitionSource "ChatGPT 3.5"@en ;
                                   mo:abbreviation "SIMS"@en .


