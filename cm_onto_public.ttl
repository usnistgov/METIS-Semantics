                                          rdfs:subClassOf pmdco:Messprozess ;
                                          rdfs:label "Electromagnetic Measurement Process"@en ;
                                          skos:definition "Electromagnetic Measurement Process is a measurement operation that quantifies properties of electromagnetic fields, waves, or material responses including permittivity, permeability, conductivity, and scattering parameters."@en ;
                                          pmdco:definitionSource "claude-sonnet-4-6"@en .


