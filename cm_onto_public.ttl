                           rdfs:label "Project Identifier"@en ,
                                      "Projektidentifikator"@de ;
                           skos:definition "A colloquial, human-generated, descriptive text qualifying the nature of a project."@en ,
                                           "Ein umgangssprachlicher, von Menschen erstellter, beschreibender Text, der die Art eines Projekts qualifiziert."@de .


###  https://w3id.org/pmd/co/Provided_Identifier
pmdco:Provided_Identifier rdf:type owl:Class ;
                          rdfs:subClassOf pmdco:Identifikator ;
                          rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                          rdfs:label "Bereitgestellter Identifikator"@de ,
                                     "Provided Identifier"@en ;
                          skos:definition "A colloquial, human-generated descriptor."@en .


###  https://w3id.org/pmd/co/Prozess
pmdco:Prozess rdf:type owl:Class ;
              rdfs:subClassOf prov:Activity ;
              obo:term_editor "A process is an activity comprising a series of actions or operations conducing to an end. In PMD, a process is conducted via processing nodes and has a discernable duration as part of a workflow. A process consumes objects and parameters. A process potentially generates new objects and measurements."@en ;
              rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
              rdfs:label "Process"@en ,
                         "Prozess"@de ;
              skos:definition "A process is an activity including a series of actions or operations conducing to an end. In PMD, a process is conducted via processing nodes and has a discernable duration as part of a workflow. A process consumes objects and parameters. A process potentially generates new objects and measurements."@en .


###  https://w3id.org/pmd/co/Prozessbeschreibung
pmdco:Prozessbeschreibung rdf:type owl:Class ;
                          rdfs:subClassOf pmdco:Beschreibung ,
                                          [ owl:intersectionOf ( pmdco:Beschreibung
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty pmdco:characteristic_of ;
                                                                   owl:someValuesFrom pmdco:Prozess
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ;
                          rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                          rdfs:label "Process Description"@en ,
                                     "Prozessbeschreibung"@de ;
                          skos:definition "A descriptive text qualifying the nature of a process instance used as an identifier that is not strictly intended to be unique, e.g. \"1050°C30 840°C10/ÖL\"."@en ,
                                          "A human readable order of steps. Might include additional information that likes sketches and notes."@en .


###  https://w3id.org/pmd/co/Prozessdauer
pmdco:Prozessdauer rdf:type owl:Class ;
                   rdfs:subClassOf pmdco:Dauer ;
                   rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                   rdfs:label "Process Duration"@en ,
                              "Prozessdauer"@de ;
                   skos:definition "A length of an interval of time in which a process is conducted."@en .


###  https://w3id.org/pmd/co/Prozessidentifikator
pmdco:Prozessidentifikator rdf:type owl:Class ;
                           rdfs:subClassOf [ owl:intersectionOf ( pmdco:Identifikator
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty prov:wasAssociateFor ;
                                                                    owl:someValuesFrom pmdco:Prozess
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty pmdco:characteristic_of ;
                                             owl:someValuesFrom chips:Process_Metadata
                                           ] ;
                           rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                           rdfs:label "Process Identifier"@en ,
                                      "Prozessidentifikator"@de ;
                           skos:definition "A colloquial, human-generated, descriptive text qualifying the nature of a process instance used as an identifier that is not strictly intended to be unique, e.g. “1050°C30 840°C10/ÖL”."@en ,
                                           "Ein umgangssprachlicher, von Menschen erstellter, beschreibender Text, der die Art einer Prozessinstanz qualifiziert, die als Kennung verwendet wird, die nicht unbedingt eindeutig sein muss, z.B. “1050°C30 840°C10/ÖL”."@de .


###  https://w3id.org/pmd/co/Prozessknoten
pmdco:Prozessknoten rdf:type owl:Class ;
                    rdfs:subClassOf prov:Agent ;
                    rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                    rdfs:label "Processing Node"@en ,
                               "Prozessknoten"@de ;
                    skos:definition "Processing nodes are tools, equipment and accessories as well as software that are relevant for the performance of processes, such as e.g. mechanical and chemical test as well as simulation, prediction, and machine learning. Accordingly, processing nodes may be machines, parts of machines, and software applications."@en ,
                                    "Prozessknoten sind Werkzeuge, Geräte und Zubehör sowie Software, die für die Durchführung von Prozessen relevant sind, wie z. B. mechanische und chemische Tests sowie Simulationen, Vorhersagen und maschinelles Lernen. Dementsprechend können Prozessknoten Maschinen, Teile von Maschinen und Softwareanwendungen sein."@de .


###  https://w3id.org/pmd/co/Quadratisch
pmdco:Quadratisch rdf:type owl:Class ;
                  rdfs:subClassOf pmdco:Form ;
                  rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
                  rdfs:label "Quadratisch"@de ,
                             "Squared"@en ;
                  skos:definition "Geformt mit vier gleichen Seiten und vier rechten Winkeln."@de ,
                                  "Having four equal sides and four right angles."@en ;
                  pmdco:definitionSource "“Square.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/square. Accessed 13 Jan. 2023."@en .


###  https://w3id.org/pmd/co/Qualifying_Node_Annotation
pmdco:Qualifying_Node_Annotation rdf:type owl:Class ;
                                 rdfs:subClassOf pmdco:Node_Info ;
                                 rdfs:isDefinedBy <https://w3id.org/pmd/co> ;
