                                                     chips:In_Situ_Process ;
                                     rdfs:label "On-wafer Electrical Measurement"@en ;
                                     skos:definition "On-Wafer Electrical Measurement is an electrical characterization technique in which probes make direct contact with conductive pads of devices or circuits fabricated on a semiconductor wafer prior to dicing, enabling full wafer-level testing."@en ;
                                     pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Open_File_Format
chips:Open_File_Format rdf:type owl:Class ;
                       rdfs:subClassOf chips:File_Format ;
                       rdfs:label "Open File Format"@en ;
                       skos:definition "Open File Type is a digital data format whose specification is publicly available and not encumbered by proprietary restrictions, enabling any software to read and write the format."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Opensource_Hardware
chips:Opensource_Hardware rdf:type owl:Class ;
                          rdfs:subClassOf chips:Hardware ;
                          rdfs:label "Open-source Hardware"@en ;
                          skos:definition "Open-Source Hardware is a hardware component whose design files, schematics, and fabrication documentation are publicly released under a license permitting free use, modification, and redistribution."@en ;
                          pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Operando_Process
chips:Operando_Process rdf:type owl:Class ;
                       rdfs:subClassOf pmdco:Messprozess ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty pmdco:belongsToProject ;
                                         owl:someValuesFrom chips:Grand_Challenge_5
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty pmdco:relates_to ;
                                         owl:someValuesFrom chips:In_Situ_Process
                                       ] ;
                       rdfs:label "Operando Process"@la ;
                       skos:definition "Operando Process is a measurement process performed on a specimen or device while it is actively operating under functional conditions, providing direct observation of structural, chemical, or physical changes during real working states rather than at static snapshots."@en ;
                       pmdco:definitionSource "claude-sonnet-4-6"@en .


