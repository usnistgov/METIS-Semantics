                        rdfs:subClassOf chips:Electromagnetic_Measurement_Process ,
                                        chips:Optical_Measuring_Process ;
                        rdfs:label "Photonic Coupling"@en ;
                        skos:definition "Photonic Coupling is an optical electromagnetic measurement technique that characterizes the efficiency and mode of optical power transfer between photonic waveguides, fibers, or devices using grating couplers, edge couplers, or evanescent coupling structures."@en ;
                        pmdco:definitionSource "claude-sonnet-4-6"@en .


