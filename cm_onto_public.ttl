                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty pmdco:belongsToProject ;
                                                 owl:someValuesFrom chips:Grand_Challenge_7
                                               ] ;
                               rdfs:label "Circular Economy Process"@en ;
                               skos:definition "Circular Economy Process is a recovery process that designs material flows to keep products, components, and materials at their highest utility through reuse, remanufacturing, and recycling, minimizing waste and resource consumption."@en ;
                               pmdco:definitionSource "claude-sonnet-4-6"@en .


###  https://w3id.org/CHIPS/metrology-ontology/Circularity_Design_Process
