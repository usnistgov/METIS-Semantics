skos:prefLabel rdf:type owl:DatatypeProperty .


#################################################################
#    Individuals
#################################################################

###  http://data.nist.gov/od/dm/chips-metrology/topics/Ag
:Ag rdf:type owl:NamedIndividual ,
                 skos:Concept ;
        skos:broader :Metal ;
        skos:definition """Research topic that focuses on:
(1) The use of silver in semiconductor materials or devices
(2) The characterization and measurement of silver properties in semiconductors 
(3) The impact of silver on semiconductor performance or reliability."""@en ;
        skos:prefLabel "CHIPS Metrology: Materials Research: Metal: Ag" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Al2O3
:Al2SO3 rdf:type owl:NamedIndividual ,
                 skos:Concept ;
        skos:broader :Dielectric_and_Insulator ;
        skos:definition """Research topic that: 
(1) focuses on the study of aluminum oxide as a material for semiconductor devices; 
(2) investigates its properties, fabrication, and application in the microelectronics industry; 
(3) relates to the specific measurements and standards required for ensuring device performance and quality."""@en ;
        skos:prefLabel "CHIPS Metrology: Materials Research: Dielectric and Insulator: Al2O3" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Au
:Au rdf:type owl:NamedIndividual ,
             skos:Concept ;
    skos:broader :Metal ;
    skos:definition """Research topic that: 
(1) explores the use of gold in semiconductor device fabrication; 
(2) examines gold's properties and performance in electronic components; 
(3) evaluates the metrological methods used to assess gold's characteristics and quality in chip manufacturing."""@en ;
    skos:prefLabel "CHIPS Metrology: Materials Research: Metal: Au" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/CHIPS_Metrology
:CHIPS_Metrology rdf:type owl:NamedIndividual ,
                          skos:Concept ;
                 skos:broader :Research_Topic ;
                 skos:prefLabel "CHIPS Metrology" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/CMOS
:CMOS rdf:type owl:NamedIndividual ,
               skos:Concept ;
      skos:broader :Transistor ;
      skos:definition """Research topic that: 
(1) focuses on the precise measurement and characterization of CMOS (Complementary Metal-Oxide-Semiconductor) transistors; 
(2) involves the development and optimization of CMOS transistors for better performance; 
(3) includes the study and implementation of CMOS transistors; 
(4) aims to enhance the reliability, efficiency, and scalability of CMOS transistors for various applications.""" ;
      skos:prefLabel "CHIPS Metrology: Microelectronics: Electronic Device: Transistor: CMOS" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Calorimetry
:Calorimetry rdf:type owl:NamedIndividual ,
                      skos:Concept ;
             skos:broader :Thermal ;
             skos:definition """Research topic that: 
(1) develops and refines measurement techniques to accurately profile thermal characteristics of semiconductor chips; 
(2) focuses on enhancing experimental methods to study heat generation and dissipation to optimize chip design and function; 
(3) utilizes calorimetric data to improve metrology tools for more precise thermal management solutions in semiconductor technology."""@en ;
             skos:prefLabel "CHIPS Metrology: Metrology: Experimental Technique: Thermal: Calorimetry" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Computational_Technique
:Computational_Technique rdf:type owl:NamedIndividual ,
                                  skos:Concept ;
                         skos:broader :CHIPS_Metrology ;
                         skos:definition """Research topic that: 
(1) applies computational techniques in the field of semiconductor metrology; 
(2) develops and utilizes computational models, algorithms, and simulations to enhance metrological measurements and processes for the semiconductor industry; 
(3) advances the accuracy, precision, and efficiency of metrology through the integration of computational techniques in semiconductor metrology."""@en ;
                         skos:prefLabel "CHIPS Metrology: Metrology: Computational Technique" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Cryogenics
:Cryogenics rdf:type owl:NamedIndividual ,
                     skos:Concept ;
            skos:broader :Experimental_Technique ;
            skos:definition """Research topic that:
(1) involves the measurement and characterization of microelectronic devices and systems;
(2) employs specialized experimental techniques to investigate device behavior and performance;
(3) utilizes cryogenic temperatures to enable or enhance the measurement and analysis of devices and materials."""@en ;
            skos:prefLabel "CHIPS Metrology: Metrology: Experimental Technique: Cryogenics" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Cu
:Cu rdf:type owl:NamedIndividual ,
                 skos:Concept ;
        skos:broader :Metal ;
        skos:definition """Research topic about:
(1) The presence and characteristics of copper within semiconductor materials or devices
(2) Methods for measuring and analyzing copper concentrations, distribution, and behavior in semiconductors
(3) Impacts of copper on semiconductor performance and reliability."""@en ;
        skos:prefLabel "CHIPS Metrology: Materials Research: Metal: Cu" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Deposition
:Deposition rdf:type owl:NamedIndividual ,
                     skos:Concept ;
            skos:broader :Processes ;
            skos:definition """Research topic that focuses on: 
(1) thin film deposition techniques used in semiconductor manufacturing; 
(2) measurement and characterization of deposited materials; 
(3) integration of metrology and deposition processes for improved yield and productivity; 
(4) characterization of deposition process-induced defects and their impact on device performance.""" ;
            skos:prefLabel "CHIPS Metrology: Manufacturing: Processes: Deposition" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Dielectric_and_Insulator
:Dielectric_and_Insulator rdf:type owl:NamedIndividual ,
                                   skos:Concept ;
                          skos:broader :Semiconductor ;
                          skos:definition """Research topic that: 
(1) develops metrology methods to accurately measure the electrical properties of dielectric and insulator materials; 
(2) investigates the structural and chemical properties of these materials to understand their performance and reliability; 
(3) explores advanced materials and processes for improved dielectric and insulator performance in semiconductor devices; 
(4) investigates the impact of dielectric and insulator materials on device performance, power consumption, and reliability; 
(5) develops techniques to detect defects and analyze the failure mechanisms in dielectric and insulator materials."""@en ;
                          skos:prefLabel "CHIPS Metrology: Materials Research: Dielectric and Insulator" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Diffraction_and_Scattering
:Diffraction_and_Scattering rdf:type owl:NamedIndividual ,
                                     skos:Concept ;
                            skos:broader :Experimental_Technique ;
                            skos:definition """Research topic that: 
(1) focuses on the measurement and analysis of semiconductor materials and devices; 
(2) utilizes experimental methods to investigate properties and structures; 
(3) employs diffraction and scattering techniques to obtain detailed information about atomic and molecular arrangements; 
(4) aims to improve the quality and performance of semiconductor products."""@en ;
                            skos:prefLabel "CHIPS Metrology: Metrology: Experimental Technique: Diffraction and Scattering" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Dimensional
:Dimensional rdf:type owl:NamedIndividual ,
                              skos:Concept ;
                     skos:broader :Measurement ;
                     skos:definition """Research topic that:
(1) Focuses on the precision measurement and characterization of semiconductor materials and devices.
(2) Develops and utilizes experimental techniques for accurate data acquisition. 
(3) Involves advanced methods for dimensional analysis and metrology."""@en ;
                     skos:prefLabel "CHIPS Metrology: Metrology: Measurement: Dimensional" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/EBSD
:EBSD rdf:type owl:NamedIndividual ,
               skos:Concept ;
      skos:broader :Diffraction_and_Scattering ;
      skos:definition """Research topic that: 
(1) focuses on the measurement and analysis of physical properties in microelectronics, and involves advanced experimental methods for materials characterization; 
(2) utilizes diffraction and scattering techniques to study material structures; 
(3) incorporates Electron Backscatter Diffraction (EBSD) for crystallographic analysis."""@en ;
      skos:prefLabel "CHIPS Metrology: Metrology: Experimental Technique: Diffraction and Scattering: EBSD" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Electrical
:Electrical rdf:type owl:NamedIndividual ,
                     skos:Concept ;
            skos:broader :Experimental_Technique ;
            skos:definition """Research topic that: 
(1) involves the measurement and characterization of microelectronic devices and systems; 
(2) employs electrical experimental techniques to analyze and understand the properties and behavior of these devices; 
(3) aims to advance the development and manufacturing of microelectronic components and systems."""@en ;
            skos:prefLabel "CHIPS Metrology: Metrology: Experimental Technique: Electrical" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Electro-Optical
:Electro-Optical rdf:type owl:NamedIndividual ,
                          skos:Concept ;
                 skos:broader :Experimental_Technique ;
                 skos:definition """Research topic that:
(1) involves the measurement and characterization of semiconductor devices and materials;
(2) employs various experimental methods to investigate and analyze physical properties and behaviors;
(3) focuses on the interactions between electrical and optical phenomena in electronic devices."""@en ;
                 skos:prefLabel "CHIPS Metrology: Metrology: Experimental Technique: Electro-Optical" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Electron_Microscopy
:Electron_Microscopy rdf:type owl:NamedIndividual ,
                              skos:Concept ;
                     skos:broader :Imaging ;
                     skos:definition """Research topic that: 
(1) involves the study and characterization of semiconductor materials and devices; 
(2) utilizes advanced experimental techniques and imaging methods; 
(3) employs electron microscopy for high-resolution visualization and analysis."""@en ;
                     skos:prefLabel "CHIPS Metrology: Metrology: Experimental Technique: Imaging: Electron Microscopy" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Electronic_Device
:Electronic_Device rdf:type owl:NamedIndividual ,
                            skos:Concept ;
                   skos:broader :Microelectronics ;
                   skos:definition """Research topic that:
(1) investigates the development, accuracy, and application of metrology tools specific to the needs of manufacturing microelectronic devices;
(2) ensures devices meet performance, reliability, and quality standards;
(3) involves improving measurement techniques for better detection and analysis of defects, performance metrics, and process optimization;
(4) addresses challenges in miniaturization, material properties, and advanced fabrication techniques;
(5) aims to innovate and enhance the manufacturing ecosystem of advanced electronic devices through precise and reliable metrology.""" ;
                   skos:prefLabel "CHIPS Metrology: Microelectronics: Electronic Device" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Etching
:Etching rdf:type owl:NamedIndividual ,
                  skos:Concept ;
         skos:broader :Processes ;
         skos:definition """Research topic that focuses on: 
(1) semiconductor fabrication processes that involve the measurement and analysis of etched patterns and structures; 
(2) the application of metrology techniques to monitor and control etching processes in microelectronics manufacturing; 
(3) the development of new etching technologies and methods that require advanced metrology and process control capabilities; 
(4) the integration of metrology data and etching process data to optimize manufacturing yields and product quality.""" ;
         skos:prefLabel "CHIPS Metrology: Manufacturing: Processes: Etching" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Etching_Gas_Flow_Control
:Etching_Gas_Flow_Control rdf:type owl:NamedIndividual ,
                                   skos:Concept ;
                          skos:broader :Etching ;
                          skos:definition """Research topic that: 
(1) involves the measurement and characterization of semiconductor devices and manufacturing processes; 
(2) examines the effects of plasma etching on device performance and yield; 
(3) investigates the role of gas flow control in etching to optimize device fabrication.""" ;
                          skos:prefLabel "CHIPS Metrology: Manufacturing: Processes: Etching: Gas Flow Control" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Experimental_Technique
:Experimental_Technique rdf:type owl:NamedIndividual ,
                                 skos:Concept ;
                        skos:broader :Metrology ;
                        skos:definition """Research topic that:
(1) focuses on the measurement and characterization of semiconductor materials and devices, and involves the use of advanced experimental methods and tools;
(2) aims to improve the accuracy, precision, and reliability of measurements in semiconductor manufacturing."""@en ;
                        skos:prefLabel "CHIPS Metrology: Metrology: Experimental Technique" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Gas_Flow_Control
:Gas_Flow_Control rdf:type owl:NamedIndividual ,
                           skos:Concept ;
                  skos:broader :Deposition ;
                  skos:definition """Research topic that: 
(1) involves the measurement and characterization of semiconductor devices and manufacturing processes; 
(2) examines the relationship between deposition techniques, gas flow control, and the resulting device properties; 
(3) aims to optimize manufacturing processes involving deposition and gas flow control for improved yield, performance, and reliability of semiconductor devices.""" ;
                  skos:prefLabel "CHIPS Metrology: Manufacturing: Processes: Deposition: Gas Flow Control" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Geometric_Structure
:Geometric_Structure rdf:type owl:NamedIndividual ,
                              skos:Concept ;
                     skos:broader :Structure_and_Geometry ;
                     skos:definition """Research topic that: 
(1) investigates the physical arrangement and spatial characteristics of semiconductor materials; 
(2) focuses on the precision measurement and control of these structures; 
(3) aims to improve the performance, reliability, and scalability of semiconductor devices."""@en ;
                     skos:prefLabel "CHIPS Metrology: Materials Research: Semiconductor: Structure and Geometry: Geometric Structure" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Grand_Challenge
:Grand_Challenge rdf:type owl:NamedIndividual ,
                           skos:Concept ;
                  skos:broader :Metrology ;
                  skos:definition "Research topic that focuses on experimental techniques that support CHIPS Grand Challenges."@en ;
                  skos:prefLabel "CHIPS Metrology: Metrology: Grand Challenge" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/HfO2
:HfO2 rdf:type owl:NamedIndividual ,
               skos:Concept ;
      skos:broader :Dielectric_and_Insulator ;
      skos:definition """Research topic that: 
(1) Characterization of hafnium dioxide (HfO2) properties and performance.
(2) Evaluation of HfO2 as a dielectric and insulator in semiconductor devices.
(3) Methods and techniques for measuring the structural, electrical, and thermal properties of HfO2.
(4) Investigation of the manufacturing processes and quality control for HfO2-based materials and components."""@en ;
      skos:prefLabel "CHIPS Metrology: Materials Research: Dielectric and Insulator: HfO2" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/High-Frequency
:High-Frequency rdf:type owl:NamedIndividual ,
                         skos:Concept ;
                skos:broader :Electrical ;
                skos:definition """Research topic that: 
(1) involves the measurement and characterization of microelectronic devices and integrated circuits; 
(2) uses high-frequency electrical experimental techniques to analyze and test the performance of these devices; 
(3) aims to develop new methods and tools for evaluating the electrical properties and behavior of advanced semiconductor devices and materials."""@en ;
                skos:prefLabel "CHIPS Metrology: Metrology: Experimental Technique: Electrical: High-Frequency" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Imaging
:Imaging rdf:type owl:NamedIndividual ,
                  skos:Concept ;
         skos:broader :Experimental_Technique ;
         skos:definition """Research topic that: 
(1) focuses on the measurement and characterization of microelectronic devices and systems; 
(2) employs advanced experimental techniques and imaging methods to analyze and understand the properties and behavior of these devices; 
(3) seeks to develop new methodologies and tools for inspecting, testing, and validating the performance of microelectronic components and systems."""@en ;
         skos:prefLabel "CHIPS Metrology: Metrology: Experimental Technique: Imaging" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Interferometry
:Interferometry rdf:type owl:NamedIndividual ,
                         skos:Concept ;
                skos:broader :Experimental_Technique ;
                skos:definition """Research topic that: 
(1) focuses on the development and application of precise measurement techniques for semiconductor and microelectronics industries; 
(2) utilizes experimental methods to investigate and analyze the performance and properties of devices and systems; 
(3) employs interferometric methods to achieve high-resolution and accurate measurements at the nanoscale."""@en ;
                skos:prefLabel "CHIPS Metrology: Metrology: Experimental Technique: Interferometry" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/MEMS
:MEMS rdf:type owl:NamedIndividual ,
               skos:Concept ;
      skos:broader :Mechanical_Device ;
      skos:definition """Research topic that focuses on: 
(1) developing precise and accurate measurement methods specifically tailored for Microelectromechanical Systems (MEMS) devices; 
(2) analyzing the mechanical behavior and performance of MEMS devices under various operating conditions; 
(3) evaluating the reliability, durability, and functionality of MEMS devices; 
(4) improving the design, fabrication, and performance of microelectronic mechanical devices; 
(5) advancing the understanding of microscale mechanical phenomena and their interaction with microelectronics.""" ;
      skos:prefLabel "CHIPS Metrology: Microelectronics: Mechanical Device: MEMS" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/MRAM
:MRAM rdf:type owl:NamedIndividual ,
               skos:Concept ;
      skos:broader :Magnetic_Device ;
      skos:definition """Research topic that: 
(1) focuses on the development and application of measurement techniques and tools in the context of microelectronics and magnetic devices; 
(2) is specifically related to Magnetoresistive Random Access Memory (MRAM).""" ;
      skos:prefLabel "CHIPS Metrology: Microelectronics: Magnetic Device: MRAM" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Magnetic_Device
:Magnetic_Device rdf:type owl:NamedIndividual ,
                          skos:Concept ;
                 skos:broader :Microelectronics ;
                 skos:definition """Research topic that focuses on: 
(1) developing measurement techniques for assessing the performance and properties of magnetic devices used in microelectronics; 
(2) investigating the impact of magnetic materials and structures on the overall functionality of microelectronic devices; 
(3) exploring novel approaches for fabricating and integrating magnetic devices into microelectronics; 
(4) analyzing the reliability and durability of magnetic devices in microelectronic systems.""" ;
                 skos:prefLabel "CHIPS Metrology: Microelectronics: Magnetic Device" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Magnetic_Materials
:Magnetic_Materials rdf:type owl:NamedIndividual ,
                             skos:Concept ;
                    skos:broader :Metal ;
                    skos:definition """Research topic that: 
(1) examines magnetic material use in the development of microelectronic devices, such as sensors, actuators, and memory storage devices; 
(2) focuses on magnetic material metrological properties."""@en ;
                    skos:prefLabel "CHIPS Metrology: Materials Research: Metal: Magnetic Materials" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Manufacturing
:Manufacturing rdf:type owl:NamedIndividual ,
                        skos:Concept ;
               skos:broader :CHIPS_Metrology ;
               skos:definition """Research topic that:
(1) studies of measurement and quality control methods for integrated circuit manufacturing processes integrated circuits; 
(2) focuses on developing techniques and tools for accurately measuring and assessing various parameters and characteristics of the chips during the manufacturing process; 
(3) centers on ensuring precise dimensional control, detecting and analyzing defects, optimizing process parameters, and improving overall chip yield and performance.""" ;
               skos:prefLabel "CHIPS Metrology: Manufacturing" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Materials_Research
:Materials_Research rdf:type owl:NamedIndividual ,
                             skos:Concept ;
                    skos:broader :CHIPS_Metrology ;
                    skos:definition """Research topic that: 
(1) focuses on the study of the properties, behaviors, and applications of materials; 
(2) involves the use, development, and improvement of measurement techniques and tools for characterizing materials relevant to the semiconductor industry; 
(3) aims to enhance the quality, reliability, and performance of semiconductor materials and devices."""@en ;
                    skos:prefLabel "CHIPS Metrology: Materials Research" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Metrology
:Metrology rdf:type owl:NamedIndividual ,
                             skos:Concept ;
                    skos:broader :CHIPS_Metrology ;
                    skos:definition """Research topic that:
(1) Focuses on the measurement science and techniques;
(2) Pertains to the characterization and analysis of semiconductor materials and devices;
(3) Supports the development and manufacturing of advanced semiconductor technologies."""@en ;
                    skos:prefLabel "CHIPS Metrology: Metrology" .

###  http://data.nist.gov/od/dm/chips-metrology/topics/Measurement
:Measurement rdf:type owl:NamedIndividual ,
                      skos:Concept ;
             skos:broader :Metrology ;
             skos:definition """A research topic that:
(1) focuses on the precise and accurate characterization of semiconductor materials and devices, and involves the use of specialized tools and methodologies to gather experimental data;
(2) aims to improve the measurement processes and standards applied in the semiconductor industry."""@en ;
             skos:prefLabel "CHIPS Metrology: Metrology: Measurement" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Mechanical_Device
:Mechanical_Device rdf:type owl:NamedIndividual ,
                            skos:Concept ;
                   skos:broader :Microelectronics ;
                   skos:definition """Research topic that focuses on the:
(1) intersection of mechanical engineering, materials science, and microelectronics to advance the field of microelectromechanical systems (MEMS) and nanoelectromechanical systems (NEMS);
(2) development of measurement techniques and instrumentation for micro-scale mechanical metrology;
(3) measurement and characterization of behavior and properties of mechanical devices for microelectronics under various operating conditions (e.g. temperature, humidity, vibration);
(4) application of metrology techniques to ensure quality control, reliability, and performance of mechanical devices in microelectronic systems.""" ;
                   skos:prefLabel "CHIPS Metrology: Microelectronics: Mechanical Device" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Magnetic
:Magnetic rdf:type owl:NamedIndividual ,
                            skos:Concept ;
                   skos:broader :Materials_Research ;
                   skos:definition """Research topic that:
(1)  Focuses on the investigation and development of materials with magnetic properties;
(2)  Aims to understand the behavior and characteristics of magnetic materials;  
(3)  Explores applications of magnetic materials in technology and industry"""@en;
                   skos:prefLabel "CHIPS Metrology: Materials Research: Magnetic" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Metal
:Metal rdf:type owl:NamedIndividual ,
                            skos:Concept ;
                   skos:broader :Materials_Research ;
                   skos:definition """Research topic about:
(1) The role of metals in semiconductor device fabrication
(2) The electrical and thermal conductivity properties of metals
(3) Techniques for measuring and analyzing metal films and structures in semiconductors
(4) The impact of metal impurities on semiconductor performance and reliability"""@en;
                   skos:prefLabel "CHIPS Metrology: Materials Research: Metal" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Microelectronics
:Microelectronics rdf:type owl:NamedIndividual ,
                           skos:Concept ;
                  skos:broader :CHIPS_Metrology ;
                  skos:definition """Research topic that:
(1) investigates the development, accuracy, and application of metrology tools specific to the needs of manufacturing microelectronic devices;
(2) ensures devices meet performance, reliability, and quality standards;
(3) involves improving measurement techniques for better detection and analysis of defects, performance metrics, and process optimization;
(4) addresses challenges in miniaturization, material properties, and advanced fabrication techniques;
(5) aims to innovate and enhance the manufacturing ecosystem of advanced electronic devices through precise and reliable metrology."""@en ;
                  skos:prefLabel "CHIPS Metrology: Microelectronics" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Nanoparticle
:Nanoparticle rdf:type owl:NamedIndividual ,
                          skos:Concept ;
                 skos:broader :Materials_Research ;
                 skos:definition """Research topic that: 
(1) Focuses on the measurement and characterization of particles at the nanoscale 
(2) Involves techniques to determine size, shape, surface area, and distribution of nanoparticles 
(3) Aims to ensure precision and accuracy in the application and study of nanomaterials."""@en ;
                 skos:prefLabel "CHIPS Metrology: Materials Research: Nanoparticle" .

###  http://data.nist.gov/od/dm/chips-metrology/topics/On-wafer
:On-wafer rdf:type owl:NamedIndividual ,
                   skos:Concept ;
          skos:broader :Measurement ;
          skos:definition "Research topic that: (1) Focuses on the development and refinement of techniques to measure electrical and physical characteristics directly on semiconductor wafers. (2) Enhances process control, yields, and quality assurance in semiconductor manufacturing. (3) Is critical for scaling down integrated circuits to meet advanced technological demands."@en ;
          skos:prefLabel "CHIPS Metrology: Metrology: Measurement: On-wafer" .


###  http://data.nist.gov/od/dm/chips-metrology/topics/Organic_Semiconductor
:Organic_Semiconductor rdf:type owl:NamedIndividual ,
                                skos:Concept ;
                       skos:broader :Semiconductor ;
                       skos:definition """Research topic that: 
(1) focuses on the study and characterization of organic materials capable of conducting electricity; 
(2) involves the investigation of the properties and behaviors of these materials for use in electronic and optoelectronic devices; 
(3) entails the development and application of precise measurement techniques and standards to ensure the quality, reliability, and performance of organic semiconductor materials for use in various electronic components."""@en ;
                       skos:prefLabel "CHIPS Metrology: Materials Research: Semiconductor: Organic Semiconductor" .


